@{
    Layout = "~/Views/Shared/_LayoutEmpty.cshtml";
}

<style>
    * {
        box-sizing: border-box;
    }

    body {
        font-family: 'Outfit', sans-serif;
        margin: 0;
    }

    .tray {
        width: 56px;
        height: 18px;
        border-radius: 3px;
        border: 1.5px solid rgba(0,0,0,0.15);
        transition: all 0.6s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .arm {
        transition: all 0.8s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .gripper {
        transition: all 0.3s ease;
    }

    @@keyframes pulse-glow {
        0%, 100% {
            box-shadow: 0 0 8px rgba(16, 185, 129, 0.2);
        }

        50% {
            box-shadow: 0 0 20px rgba(16, 185, 129, 0.4);
        }
    }

    .status-active {
        animation: pulse-glow 1.5s ease-in-out infinite;
    }

    @@keyframes slideIn {
        from {
            opacity: 0;
            transform: translateY(8px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .log-entry {
        animation: slideIn 0.3s ease;
    }

    .mono {
        font-family: 'JetBrains Mono', monospace;
    }

    /*.rack-slot {
            width: 62px;
            height: 22px;
            border: 1.5px dashed rgba(0,0,0,0.1);
            border-radius: 4px;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: all 0.3s ease;
        }

            .rack-slot:hover {
                border-color: #3b82f6;
                box-shadow: 0 0 8px rgba(59, 130, 246, 0.2);
            }

            .rack-slot.rack-selected {
                border-color: #10b981;
                box-shadow: 0 0 12px rgba(16, 185, 129, 0.3);
                background: rgba(16, 185, 129, 0.08);
            } */

    .rack-selected {
        border-color: #10b981;
        box-shadow: 0 0 12px rgba(16, 185, 129, 0.3);
        background: rgba(16, 185, 129, 0.08);
    }

    .trolley-slot {
        width: 62px;
        height: 22px;
        border: 1.5px dashed rgba(0,0,0,0.1);
        border-radius: 4px;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        transition: all 0.3s ease;
    }

        .trolley-slot:hover {
            border-color: #3b82f6;
            box-shadow: 0 0 8px rgba(59, 130, 246, 0.2);
        }

        .trolley-slot.empty-selected {
            border-color: #10b981;
            box-shadow: 0 0 12px rgba(16, 185, 129, 0.3);
            background: rgba(16, 185, 129, 0.08);
        }

    .tray.empty-selected {
        background-color: #10b981;
    }

    .scene-container {
        position: relative;
        width: 100%;
        height: 280px;
        border-radius: 12px;
        overflow: hidden;
    }

    .rack-section, .trolley-column {
        display: flex;
        flex-direction: column;
        gap: 1.5px;
        align-items: center;
    }

    .trolley-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 1.5px;
        padding: 8px;
        background: rgba(243, 244, 246, 0.6);
        border-radius: 8px;
        width: fit-content;
    }

    .rack-selector, .trolley-target {
        cursor: pointer;
        border: 2px solid transparent;
        border-radius: 6px;
        transition: all 0.3s ease;
        padding: 8px;
    }

        .rack-selector:hover {
            border-color: #d1d5db;
            background: rgba(209, 213, 219, 0.15);
        }

        .rack-selector.selected {
            border-color: #10b981;
            background: rgba(16, 185, 129, 0.1);
            box-shadow: 0 0 12px rgba(16, 185, 129, 0.2);
        }

    .trolley-target {
        position: relative;
    }

        .trolley-target::after {
            content: '';
            position: absolute;
            inset: 0;
            border: 2px solid transparent;
            border-radius: 4px;
            pointer-events: none;
            transition: all 0.3s ease;
        }

        .trolley-target:hover::after {
            border-color: #3b82f6;
            box-shadow: 0 0 8px rgba(59, 130, 246, 0.2);
        }

        .trolley-target.target-selected::after {
            border-color: #10b981;
            box-shadow: 0 0 12px rgba(16, 185, 129, 0.3);
            background: rgba(16, 185, 129, 0.08);
        }

    .step-line::before {
        content: '';
        position: absolute;
        left: 15px;
        top: 32px;
        bottom: -8px;
        width: 2px;
        background: lightgrey; /* #1e293b; */
    }

    .step-line:last-child::before {
        display: none;
    }

    .step-dot {
        width: 12px;
        height: 12px;
        border-radius: 50%;
        border: 2px solid lightgrey; /* #334155; */
        background: lightgrey; /* #0f172a; */
        flex-shrink: 0;
        transition: all 0.3s;
        position: relative;
        z-index: 2;
    }

        .step-dot.active {
            border-color: #22c55e;
            background: #22c55e;
            box-shadow: 0 0 10px rgba(34,197,94,0.5);
        }

        .step-dot.done {
            border-color: #22c55e;
            background: #22c55e;
        }

        .step-dot.waiting {
            border-color: lightgrey; /* #475569; */
            background: lightgrey; /* #1e293b; */
        }

    .status-badge {
        font-size: 10px;
        padding: 2px 8px;
        border-radius: 9999px;
        font-weight: 600;
        letter-spacing: 0.5px;
        text-transform: uppercase;
    }

    .badge-idle {
        background: #1e293b;
        color: #64748b;
    }

    .badge-running {
        background: #052e16;
        color: #4ade80;
    }

    .badge-done {
        background: #022c22;
        color: #34d399;
    }

    .hidden {
        display: none;
    }

    .fade-out {
        opacity: 0;
        /* This transition duration should match the delay in the JavaScript setTimeout */
        transition: opacity 0.5s ease-out;
    }

    .trolley-selected {
        border-color: #10b981;
        box-shadow: 0 0 12px rgba(16, 185, 129, 0.3);
        background: rgba(16, 185, 129, 0.08);
    }

    .selected {
        border-color: #10b981;
        box-shadow: 0 0 12px rgba(16, 185, 129, 0.3);
        background: rgba(16, 185, 129, 0.08);
    }

    #start-btn:disabled {
        background-color: darkgray !important;
        cursor: not-allowed;
    }

    #stop-btn:disabled {
        background-color: darkgray !important;
        cursor: not-allowed;
    }

    #cont-btn:disabled {
        background-color: darkgray !important;
        cursor: not-allowed;
    }

    #end-btn:disabled {
        background-color: darkgray !important;
        cursor: not-allowed;
    }

    #btnRetrieveStart:disabled {
        background-color: darkgray !important;
        cursor: not-allowed;
    }

    #btnPutawayStart:disabled {
        background-color: darkgray !important;
        cursor: not-allowed;
    }

    #btnR1:disabled {
        color: darkgray !important;
        cursor: not-allowed;
    }

    #btnR2:disabled {
        color: darkgray !important;
        cursor: not-allowed;
    }

    #btnR3:disabled {
        color: darkgray !important;
        cursor: not-allowed;
    }

    #btnPA1:disabled {
        color: darkgray !important;
        cursor: not-allowed;
    }

    #btnPA2:disabled {
        color: darkgray !important;
        cursor: not-allowed;
    }

    #btnPA3:disabled {
        color: darkgray !important;
        cursor: not-allowed;
    }
</style>

<input type="hidden" id="xToken" value="@ViewBag.xToken" autocomplete="off">
<input type="hidden" id="xQId" value="@ViewBag.QId" autocomplete="off">
<input type="hidden" id="xDeviceId" value="@ViewBag.DeviceId" autocomplete="off">
<input type="hidden" id="xQContinuos" value="@ViewBag.QContinuos" autocomplete="off">
<input type="hidden" id="xDocType" value="@ViewBag.DocType" autocomplete="off">
<input type="hidden" id="xDocId" value="@ViewBag.DocId" autocomplete="off">
<input type="hidden" id="txtTrolleyId" autocomplete="off">
<input type="hidden" id="txtDtlId" autocomplete="off">

<div id="app" class="h-full w-full overflow-auto" style="background: #f8f9fa;">
    <!-- Title -->
    <header class="px-6 py-4 flex items-center justify-between border-b" style="border-color: #e5e7eb;">
        <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-lg flex items-center justify-center" style="background: #475569;">
                <i class="bi-eye" style="width:20px;height:20px;color:#fff;"></i>
            </div>
            <div>
                <h1 id="pageTitle" class="text-lg font-bold" style="color:#1f2937;">SRMS <span style="color:grey"> [Viewer]</span></h1>
                <p id="statusLabel" class="text-xs mono" style="color:#6b7280;">Put away reels from SRMS to Trolley</p>
            </div>
        </div>
        <div class="flex items-center gap-3">
            <button id="addressLogBtn" class="flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-semibold transition-all" style="background:#f3f4f6;color:#374151;border:1px solid #e5e7eb;" onclick="showAddressResponseLog()">
                <i class="bi-cpu" style="width:12px;height:12px;"></i> PLC Address Log
            </button>
            <div id="statusBadge" class="flex items-center gap-2 px-3 py-1.5 rounded-full text-xs font-semibold mono" style="background:#f3f4f6;color:#6b7280;">
                <span id="statusDot" class="w-2 h-2 rounded-full" style="background:#6b7280;"></span> <span id="statusText">IDLE</span>
            </div>
        </div>
    </header>
    <!-- Body -->
    <div class="p-6 flex flex-col gap-4" style="min-height: 90vh;">
        <!-- Scene -->
        <div class="scene-container" style="background: linear-gradient(180deg, #ffffff 0%, #f3f4f6 100%); border: 1px solid #e5e7eb; height: 160px;">
            <!-- Grid overlay -->
            <svg class="absolute inset-0 w-full h-full" style="opacity:0.08;">
                <defs>
                    <pattern id="grid" width="30" height="30" patternunits="userSpaceOnUse">
                        <path d="M 30 0 L 0 0 0 30" fill="none" stroke="#fff" stroke-width="0.5" />
                    </pattern>
                </defs>
                <rect width="100%" height="100%" fill="url(#grid)" />
            </svg><!-- Left Racks -->
            <div class="absolute left-6 top-10 flex" style="bottom: 16px;">
                <!-- Rack Left -->
                <div class="rack-section rack-selector" id="rackLeftSelector">
                    <div class="text-xs mono mb-1" style="color:#374151;">
                        RACK LEFT
                    </div>
                    <input type="text" id="left-input" class="w-full px-2.5 py-1.5 rounded-lg text-xs border" style="border-color:#e5e7eb;color:#374151;background:#fff;" autocomplete="off">
                    <div class="flex flex-row gap-1.5" id="rackLeftSlots"></div>
                </div><!-- Rack Right -->
                <div class="rack-section rack-selector" id="rackRightSelector">
                    <div class="text-xs mono mb-1" style="color:#374151;">
                        RACK RIGHT
                    </div>
                    <input type="text" id="right-input" class="w-full px-2.5 py-1.5 rounded-lg text-xs border" style="border-color:#e5e7eb;color:#374151;background:#fff;" autocomplete="off">
                    <div class="flex flex-row gap-1.5" id="rackRightSlots"></div>
                </div>
            </div><!-- PLC Arm Assembly -->
            <div id="armAssembly" class="arm absolute" style="left: 50%; top: 80px; transform: translateX(-50%);">
                <!-- Vertical rail -->
                <div class="absolute left-1/2 -translate-x-1/2" style="width:4px;height:80px;background:#334155;border-radius:2px;top:-30px;">
                    <div style="width:8px;height:8px;background:#475569;border-radius:50%;position:absolute;top:0;left:-2px;"></div>
                    <div style="width:8px;height:8px;background:#475569;border-radius:50%;position:absolute;bottom:0;left:-2px;"></div>
                </div>
                <!-- Arm head -->
                <div id="armHead" class="absolute arm" style="left:50%;transform:translateX(-50%);top:0;">
                    <div style="width:40px;height:14px;background:#3b82f6;border-radius:4px;margin:0 auto;"></div>
                    <!-- Grippers -->
                    <div id="gripperLeft" class="gripper" style="width:8px;height:16px;background:#60a5fa;border-radius:0 0 3px 3px;position:absolute;left:4px;top:14px;"></div>
                    <div id="gripperRight" class="gripper" style="width:8px;height:16px;background:#60a5fa;border-radius:0 0 3px 3px;position:absolute;right:4px;top:14px;"></div><!-- Held tray -->
                    <div id="heldTray" class="tray absolute hidden" style="left:50%;transform:translateX(-50%);top:28px;"></div>
                </div>
            </div>
            <!-- Trolley Indicator Light -->
            <div class="absolute right-6 top-10 flex flex-col items-center" style="bottom: 16px;">
                <div class="text-xs mono" style="color:#475569;">
                    TROLLEY
                </div>
                <div id="trolleyGrid" class="trolley-grid">
                    <div class="trolley-slot" data-position="trolley-1" id="trolley-1">
                        <div class="tray" id="tray-1"></div>
                    </div>
                    <div class="trolley-slot" data-position="trolley-2" id="trolley-2">
                        <div class="tray" id="tray-2"></div>
                    </div>
                    <div class="trolley-slot" data-position="trolley-3" id="trolley-3">
                        <div class="tray" id="tray-3"></div>
                    </div>
                </div>
                <input type="text" id="txtTrolleySlot" class="w-full px-2.5 py-1.5 rounded-lg text-xs border" style="border-color:#e5e7eb;color:#374151;background:#fff;" autocomplete="off">
            </div>
        </div>
        <!-- Controls + List -->
        <div class="flex gap-4 flex-row">
            <!-- System Control -->
            <div class="rounded-xl p-6 w-1/2" style="background:#fff;border:1px solid #e5e7eb;">
                <h2 class="text-xs font-semibold mb-2 flex items-center gap-2" style="color:#4b5563;">
                    <i class="bi-controller" data-lucide="sliders-horizontal" style="width:14px;height:14px;"></i> System Control
                </h2>
                <div class="flex flex-wrap gap-1.5 mb-2">
                    <div class="flex items-center gap-2">
                        <label for="job-input" class="text-xs font-semibold" style="color:#4b5563;white-space:nowrap;">Job : </label>
                        <input type="text" id="job-input" value="@ViewBag.QNo" class="flex-1 px-2.5 py-1.5 rounded-lg text-xs border" style="border-color:#e5e7eb;color:#374151;background:#fff;" disabled>
                    </div>
                    <div class="flex items-center gap-2">
                        <label for="trolley-input" class="text-xs font-semibold" style="color:#4b5563;white-space:nowrap;">Trolley : </label>
                        <input type="text" id="trolley-input" class="flex-1 px-2.5 py-1.5 rounded-lg text-xs border" style="border-color:#e5e7eb;color:#374151;background:#fff;">
                        <select id="side-input" width="50px;" class="flex-1 px-2.5 py-1.5 rounded-lg text-xs border" style="border-color:#e5e7eb;color:#374151;background:#fff;">
                            <option id="A">A</option>
                            <option id="B">B</option>
                        </select>
                    </div>
                    <div class="flex items-center gap-2">
                        <label for="chkAutoRun" class="text-xs font-semibold" style="color:#4b5563;white-space:nowrap;">Auto : </label>
                        <input type="checkbox" id="chkAutoRun" style="width:14px;height:14px;cursor:pointer;">
                    </div>
                    <div class="flex items-center gap-2 hidden">
                        <label for="chkSensor" class="text-xs font-semibold" style="color:#4b5563;white-space:nowrap;">Sensor : </label>
                        <input type="checkbox" id="chkSensor" style="width:14px;height:14px;cursor:pointer;">
                    </div>
                </div>
                <div class="grid grid-cols-3 gap-3 mb-6">
                    <div class="rounded-lg p-3 text-center" style="background:#fef3c7;border:1px solid #fde68a;">
                        <div class="text-xs mono" style="color:#92400e;">
                            Pending
                        </div>
                        <div id="pendingCount" class="text-2xl font-bold mono" style="color:#f59e0b;">
                            0
                        </div>
                    </div>
                    <div class="rounded-lg p-3 text-center" style="background:#dbeafe;border:1px solid #bfdbfe;">
                        <div class="text-xs mono" style="color:#1e40af;">
                            Completed
                        </div>
                        <div id="completedCount" class="text-2xl font-bold mono" style="color:#3b82f6;">
                            0
                        </div>
                    </div>
                    <div class="rounded-lg p-3 text-center" style="background:#fee2e2;border:1px solid #fecaca;">
                        <div class="text-xs mono" style="color:#7f1d1d;">
                            Insufficient
                        </div>
                        <div id="insufficientCount" class="text-2xl font-bold mono" style="color:#ef4444;">
                            0
                        </div>
                    </div>
                </div>
            </div>
            <!-- Step -->
            <!-- Retrieve Steps -->
            <div class="rounded-xl p-6 w-1/2" style="background:#fff;border:1px solid #e5e7eb; width: 25%;">
                <h2 class="text-xs font-semibold mb-2 flex items-center gap-2" style="color:#4b5563;">
                    <i class="bi-rocket-takeoff" style="width:14px;height:14px;"></i> Retrieve Process
                </h2>
                <div class="mb-6" id="cartesian-session">
                    <div class="flex flex-col gap-2" id="retrieveStepsContainer">
                        <div class="step-line relative flex items-start gap-3 py-1">
                            <div class="step-dot waiting mt-1" id="rDot1"></div>
                            <div>
                                <p class="text-sm font-semibold" style="color:#0f172a;">PC → DB</p>
                                <p class="text-xs" style="color:#64748b;">Get Reel and Slot</p>
                            </div>
                        </div>
                        <div class="step-line relative flex items-start gap-3 py-1">
                            <div class="step-dot waiting mt-1" id="rDot2"></div>
                            <div>
                                <p class="text-sm font-semibold" style="color:#0f172a;">Robot → SRMS</p>
                                <p class="text-xs" style="color:#64748b;">Retrieve</p>
                            </div>
                        </div>
                        <div class="step-line relative flex items-start gap-3 py-1">
                            <div class="step-dot waiting mt-1" id="rDot3"></div>
                            <div>
                                <p class="text-sm font-semibold" style="color:#0f172a;">Robot → Center</p>
                                <p class="text-xs" style="color:#64748b;">Retrieve Status</p>
                            </div>
                        </div>
                    </div>
                    <div class="pt-4 mt-4 border-t" style="border-color:#e2e8f0;">
                        <div class="flex flex-grid items-start gap-3 py-1">
                            <input type="text" id="txtRetrieveSlot" placeholder="Retrieve Slot" autocomplete="off" class="px-2.5 py-1.5 rounded-lg text-xs border" style="width: 40%;">
                            <input type="text" id="txtReelCode" placeholder="Reel Code" autocomplete="off" class="px-2.5 py-1.5 rounded-lg text-xs border" style="width: 40%;">
                            <input type="text" id="txtReelId" placeholder="Reel Id" autocomplete="off" class="px-2.5 py-1.5 rounded-lg text-xs border" style="width: 20%;">
                        </div>
                    </div>
                </div>
            </div>
            <!-- Putaway Steps -->
            <div class="rounded-xl p-6 w-1/2" style="background:#fff;border:1px solid #e5e7eb; width: 25%;">
                <h2 class="text-xs font-semibold mb-2 flex items-center gap-2" style="color:#4b5563;">
                    <i class="bi-rocket-takeoff" style="width:14px;height:14px;"></i> Putaway Process
                </h2>
                <div class="mb-6" id="trolley-session">
                    <div class="flex flex-col gap-2" id="putAwayStepsContainer">
                        <div class="step-line relative flex items-start gap-3 py-1">
                            <div class="step-dot waiting mt-1" id="pDot1"></div>
                            <div>
                                <p class="text-sm font-semibold" style="color:#0f172a;">PC → DB</p>
                                <p class="text-xs" style="color:#64748b;">Get Trolley Slot</p>
                            </div>
                        </div>
                        <div class="step-line relative flex items-start gap-3 py-1">
                            <div class="step-dot waiting mt-1" id="pDot2"></div>
                            <div>
                                <p class="text-sm font-semibold" style="color:#0f172a;">Robot → Trolley</p>
                                <p class="text-xs" style="color:#64748b;">PutAway</p>
                            </div>
                        </div>
                        <div class="step-line relative flex items-start gap-3 py-1">
                            <div class="step-dot waiting mt-1" id="pDot3"></div>
                            <div>
                                <p class="text-sm font-semibold" style="color:#0f172a;">Robot → Center</p>
                                <p class="text-xs" style="color:#64748b;">PutAway Status</p>
                            </div>
                        </div>
                    </div>
                    <div class="pt-4 mt-4 border-t" style="border-color:#e2e8f0;">
                        <div class="flex flex-grid items-start gap-3 py-1">
                            <input type="text" id="txtPutSlot" placeholder="Put Slot" autocomplete="off" class="px-2.5 py-1.5 rounded-lg text-xs border" style="width: 50%;">
                            <input type="number" id="txtPutSlotTake" placeholder="Slot Take" autocomplete="off" class="px-2.5 py-1.5 rounded-lg text-xs border" style="width: 25%;">
                            <input type="number" id="txtActHeight" placeholder="Height" autocomplete="off" class="px-2.5 py-1.5 rounded-lg text-xs border" style="width: 25%;">
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="jobDoneModal" role="dialog" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <div class="modal-body" style="padding: 50px;">
                <div class="row">
                    <div class="col-6">
                        <img src="~/assets/img/task.gif" style="width:100%;" />
                    </div>
                    <div class="col-6">
                        <p style="font-size:2em;">Job is done. Click the 'Close' button to Close this window.</p>
                        <button class="btn btn-success w-100" style="height: 100px;" onclick="closeTab()">Close</button>
                        <button class="btn btn-secondary w-100" style="height: 100px;" onclick="exportLogFile()">Export Log</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="trolleyEndModal" role="dialog" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <div class="modal-body" style="padding: 50px;">
                <div class="row">
                    <div class="col-6">
                        <img src="~/assets/img/trolley-slot.gif" style="width:100%;" />
                    </div>
                    <div class="col-6">
                        <p style="font-size:2em;">Trolley is fully loaded. Please change to another side or Trolley.</p>
                        <button class="btn btn-success" style="width: 100%; height: 150px;" onclick="closeTab()">Close</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="jsonModal" role="dialog">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Update</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="row">
                    <div id="jsonColumns"></div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- PLC Address Response Log Side Panel -->
<div id="addressLogOverlay" class="hidden" style="position:fixed;inset:0;background:rgba(15,23,42,0.35);z-index:1040;" onclick="hideAddressResponseLog()"></div>
<div id="addressLogPanel" style="position:fixed;top:0;right:-420px;width:420px;height:100vh;background:#fff;box-shadow:-8px 0 24px rgba(0,0,0,0.12);z-index:1050;transition:right 0.3s ease;display:flex;flex-direction:column;">
    <div class="px-4 py-3 flex items-center justify-between border-b" style="border-color:#e5e7eb;">
        <h2 class="text-sm font-bold flex items-center gap-2" style="color:#1f2937;">
            <i class="bi-cpu" style="width:14px;height:14px;"></i> PLC Address Response Log
        </h2>
        <div class="flex items-center gap-2">
            <button class="px-2 py-1 rounded text-xs font-semibold" style="background:#f3f4f6;color:#374151;" onclick="loadAddressResponseLog()">
                <i class="bi-arrow-clockwise" style="width:12px;height:12px;"></i> Refresh
            </button>
            <button class="btn-close" aria-label="Close" onclick="hideAddressResponseLog()"></button>
        </div>
    </div>
    <div class="px-4 py-2 text-xs mono" style="color:#9ca3af;border-bottom:1px solid #e5e7eb;">
        Sorted by most recent reading. Rows updated in the last 5s are highlighted.
    </div>
    <div id="addressLogList" class="flex-1" style="overflow-y:auto;padding:8px 12px;">
        <div class="text-xs" style="color:#9ca3af;">Loading...</div>
    </div>
</div>

@section Scripts
{
    <link href="~/css/tailwind.css" rel="stylesheet" />
    <link href="~/css/jetbrains.css" rel="stylesheet" />

    <link href="~/css/datatables.min.css" rel="stylesheet">
    <link rel="stylesheet" href="~/css/sweetalert2.min.css">

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/js/datatables.min.js"></script>
    <script src="~/js/sweetalert2.all.min.js"></script>

    <script type="text/javascript">

        // Centralized state management with system status
        let sharedDrawerState = {
            drawerStatus: 'None', // States: 'Drawer', 'None'
            cartesianRobotState: 'Ready', // 'Ready', 'Retrieving', 'Proceed Put Away'
            cartesianLocation: 'center',
            systemRunning: false, // Overall system run status
            trolleyLocation: 'none', // 'PickedAndHolding', 'Placing', 'Returning'
        };

        var cartesianAutoTimer;
        let inRetrieveMove = false;
        let inPutAwayMove = false;

        let endTask = false;
        let readyToEnd = false;

        let token = '';
        let qId = 0;
        let deviceId = '';
        let qCont = 0;

        let attemptsRetrieve = 1;
        let attemptsPutAway = 1;
        let changeTakeSlot = false;
        let changePutSlot = false;

        let totalReels = 0;
        let totalCompleted = 0;
        let totalInsufficient = 0;

        let lastItemCount = 0;
        let lastItemId = '0';

        const TRAY_COLORS = ['#f59e0b', '#ef4444', '#8b5cf6', '#06b6d4', '#ec4899'];
        let rack = [0, 1, 2, 3, 4]; // indices into TRAY_COLORS
        let trolley = [];
        let heldTray = null;
        let running = false;
        let phase = 'idle'; // idle, picking, moving, placing

        // Viewer-only: this page never issues PLC/DB commands, it only reads
        // shared state (GetRackJobJson + GetAddressResponseLog) and renders it.
        const isViewerOnly = true;
        let viewerPollTimer = null;

        const jsonModal = document.getElementById("jsonModal");
        const formJSON = document.getElementById("formJSON");

        function closeTab() {
            window.close();
        }

        function applyViewerRestrictions() {
            ['start-btn', 'cont-btn', 'stop-btn', 'end-btn'].forEach(function (id) {
                const el = document.getElementById(id);
                if (el) { el.disabled = true; }
            });
            $('#trolley-input, #side-input, #chkAutoRun, #chkSensor').prop('disabled', true);
            $('#txtRetrieveSlot, #txtReelCode, #txtReelId, #txtPutSlot, #txtPutSlotTake, #txtActHeight').prop('disabled', true);
            disableDivContent(true);
        }

        // Show the rack slot values persisted from the control page's JSON
        // editor (RackLeftSlots / RackRightSlots), rather than guessing.
        function renderRackSlots(data) {
            // console.log(data.rackLeftSlot);
            $("#left-input").val(data.rackLeftSlot);
            $("#right-input").val(data.rackRightSlot);
        }

        // Fill the trolley trays from the values persisted via the control
        // page's JSON editor (Tray1 / Tray2 / Tray3).
        function renderTrolleyTrays(data) {
            // console.log(data.trolleySlot);
            $("#txtTrolleySlot").val(data.trolleySlot);
        }

        // Mirror the Retrieve/Putaway step-dot status persisted from the
        // control page (RDot1-3 / PDot1-3): 'waiting' | 'active' | 'done'.
        function renderSteps(data) {
            setDotStatus('rDot1', data.rDot1);
            setDotStatus('rDot2', data.rDot2);
            setDotStatus('rDot3', data.rDot3);
            setDotStatus('pDot1', data.pDot1);
            setDotStatus('pDot2', data.pDot2);
            setDotStatus('pDot3', data.pDot3);
        }

        function setDotStatus(id, status) {
            const el = document.getElementById(id);
            if (!el) return;
            el.className = 'step-dot ' + (status || 'waiting') + ' mt-1';
        }

        // Derive the arm/gripper/tray animation purely from shared, persisted state
        // (CartesianLocation / CartesianRobotState / DrawerStatus) so a second
        // device can mirror what the controlling device is doing in real time.
        function renderScene(data) {
            if (data.cartesianLocation === 'left' || data.cartesianLocation === 'right') {
                moveArmX('rack');
            } else {
                moveArmX('center');
            }

            var isActiveMove = (data.cartesianRobotState === 'Retrieving' || data.cartesianRobotState === 'In Put Away');
            moveArm(isActiveMove ? 20 : 0);

            var holding = data.drawerStatus === 'Drawer';
            setGrip(!holding);
            showHeld(holding ? 2 : null);

            updateCartesianUIState();
            updateTrolleyUIState();
            renderRackSlots(data);
            renderTrolleyTrays(data);
            renderSteps(data);
            
            $("#txtRetrieveSlot").val(data.retrieveSlot);
            $("#txtReelCode").val(data.reelCode);
            $("#txtReelId").val(data.reelId);
            $("#txtPutSlot").val(data.putAwaySlot);
            $("#txtPutSlotTake").val(data.slotTake);
            $("#txtActHeight").val(data.actualHeight);
        }

        let docType = '';
        let docId = 0;
        let jobIsDone = false;

        async function loadJobStatus() {
            if (jobIsDone || !docType || !docId) { return; }

            await $.ajax({
                url: '/api/PLCHubOut/GetJobStatus/' + docType + '/' + docId,
                type: 'GET',
                headers: {
                    'Authorization': 'Bearer ' + token
                },
                dataType: 'JSON',
                contentType: 'application/json; charset=utf-8',
                success: function (result) {
                    if (result.success == true && result.data == 'Done') {
                        jobIsDone = true;
                        setStatus('DONE', '#1c7a52');
                    }
                },
                error: function (error) {
                    console.log(error);
                }
            });
        }

        $(document).ready(function() {
            document.getElementById('chkAutoRun').checked = true;
            $("#txtTrolleyId").val('0');
            $("#txtActHeight").val('0');
            $('#side-input').val('A');
            $('#txtDtlId').val('');
            updateSystemStatusUI();
            applyViewerRestrictions();

            token = $('#xToken').val();
            qId = Number($('#xQId').val());
            deviceId = $('#xDeviceId').val();
            qCont = $('#xQContinuos').val();
            docType = $('#xDocType').val();
            docId = Number($('#xDocId').val());

            getJson();
            loadJobStatus();
            viewerPollTimer = setInterval(getJson, 1000);
            setInterval(loadJobStatus, 1000);
        });

        async function showJSONModal() {

            var data = "";

            await $.ajax({
                url: '/api/PLCHubOut/GetRackJobJson',
                type: 'GET',
                headers: {
                    'Authorization': 'Bearer ' + token
                },
                dataType: 'JSON',
                contentType: 'application/json; charset=utf-8',
                beforeSend: function() {
                },
                success: function(result) {
                    data = result.data;
                },
                error: function(error) {
                }
            });


            let cols = ['SystemStart', 'TrolleyCode', 'TrolleyId', 'TrolleySide', 'DrawerStatus',
                'ReelId', 'ReelCode', 'ActualHeight', 'CartesianRobotState', 'CartesianLocation',
                'RetrieveSlot', 'PutAwaySlot', 'SlotTake',
                'TrolleyLocation', 'ReelBalance',
                'RackLeftSlot', 'RackRightSlot', 'TrolleySlot',
                'RDot1', 'RDot2', 'RDot3', 'PDot1', 'PDot2', 'PDot3'];

            let columnInputs = '';
            let v = '';

            cols.forEach((column, index) => {
                Object.entries(data).forEach(([key, value]) => {
                    // console.log(`${key}: ${value}`);
                    if (key.toUpperCase() == column.toUpperCase()) {
                        v = value;
                    }
                });

                columnInputs += `
                            <div class="row justify-content-center align-items-center mb-3">
                                <div class="col-5">
                                    <label class="form-label mb-0">${column}</label>
                                </div>
                                <div class="col-5">
                                    <input type="text" id="col${column}" class="form-modal" value="${v}" />
                                </div>
                            </div>`;
            });

            document.getElementById('jsonColumns').innerHTML = columnInputs;
            $('#jsonModal').modal("show");
        }

        // ----------- PLC Address Response Log
        let addressLogInterval = null;

        function showAddressResponseLog() {
            document.getElementById('addressLogOverlay').classList.remove('hidden');
            document.getElementById('addressLogPanel').style.right = '0px';
            loadAddressResponseLog();
            if (addressLogInterval) { clearInterval(addressLogInterval); }
            addressLogInterval = setInterval(loadAddressResponseLog, 3000);
        }

        function hideAddressResponseLog() {
            document.getElementById('addressLogOverlay').classList.add('hidden');
            document.getElementById('addressLogPanel').style.right = '-420px';
            if (addressLogInterval) {
                clearInterval(addressLogInterval);
                addressLogInterval = null;
            }
        }

        async function loadAddressResponseLog() {
            await $.ajax({
                url: '/api/PLCHubOut/GetAddressResponseLog',
                type: 'GET',
                headers: {
                    'Authorization': 'Bearer ' + token
                },
                dataType: 'JSON',
                contentType: 'application/json; charset=utf-8',
                success: function(result) {
                    if (result.success == true) {
                        renderAddressResponseLog(result.data);
                    }
                },
                error: function(error) {
                    console.log(error);
                }
            });
        }

        function renderAddressResponseLog(list) {
            const container = document.getElementById('addressLogList');
            if (!list || list.length === 0) {
                container.innerHTML = '<div class="text-xs" style="color:#9ca3af;">No address response yet.</div>';
                return;
            }

            // sort by last reading datetime, most recent first
            list.sort((a, b) => new Date(b.createdDate) - new Date(a.createdDate));

            const now = new Date();
            let html = '';
            list.forEach(item => {
                const dt = new Date(item.createdDate);
                const ageSec = (now - dt) / 1000;
                const isFresh = ageSec <= 5;
                const isErr = item.isErr === true;

                let bg = '#fff';
                let border = '#e5e7eb';
                if (isErr) { bg = '#fef2f2'; border = '#fecaca'; }
                else if (isFresh) { bg = '#ecfdf5'; border = '#6ee7b7'; }

                html += `
                            <div class="log-entry rounded-lg mb-1.5 px-3 py-2" style="background:${bg};border:1px solid ${border};">
                                <div class="flex items-center justify-between">
                                    <span class="text-xs font-bold mono" style="color:#1f2937;">Addr ${item.address}</span>
                                    <span class="text-xs font-semibold mono" style="color:${isErr ? '#b91c1c' : '#059669'};">
                                        ${isFresh ? '<i class="bi-broadcast" style="width:10px;height:10px;"></i> ' : ''}${item.action}
                                    </span>
                                </div>
                                <div class="flex items-center justify-between mt-0.5">
                                    <span class="text-xs mono" style="color:#4b5563;">Value: <b>${item.value}</b></span>
                                    <span class="text-xs mono" style="color:#9ca3af;">${dt.toLocaleTimeString()}</span>
                                </div>
                                <div class="text-xs mono" style="color:#9ca3af;">${item.methodName}</div>
                            </div>`;
            });

            container.innerHTML = html;
        }

        // ----------- HMI UI
        function disableDivContent(status) {
            const div2 = document.getElementById('trolley-session');
            if (div2) {
                const interactiveElements = div2.querySelectorAll('button'); // input, select, textarea,
                interactiveElements.forEach(element => {
                    element.setAttribute('disabled', status);
                    if (status == false) {
                        element.removeAttribute('disabled');
                    }
                });
            }

            const div = document.getElementById('cartesian-session');
            if (div) {
                const interactiveElements = div.querySelectorAll('button'); // input, select, textarea,
                interactiveElements.forEach(element => {
                    element.setAttribute('disabled', status);
                    if (status == false) {
                        element.removeAttribute('disabled');
                    }
                });
            }

        }

        function updateSystemStatusUI() {
            if (jobIsDone) { return; }

            const badge = document.getElementById('statusBadge');
            const dot = document.getElementById('statusDot');
            const st = document.getElementById('statusText');

            if (sharedDrawerState.systemRunning) {
                st.textContent = 'PROCESSING';
                dot.style.background = '#f59e0b';
                badge.classList.add('status-active');
            }
            else {
                st.textContent = 'STOPPED';
                dot.style.background = "#f59e0b";
                badge.classList.remove('status-active');
            }
        }

        function updateCartesianUIState() {
            // document.querySelector('#rackLeftSelector').classList.remove('selected');
            // document.querySelector('#rackRightSelector').classList.remove('selected');

            // if (sharedDrawerState.cartesianLocation === 'left') {
            //     document.querySelector('#rackLeftSelector').classList.add('selected');
            // } else if (sharedDrawerState.cartesianLocation === 'right') {
            //     document.querySelector('#rackRightSelector').classList.add('selected');
            // } else {
            //     $("#left-input").val('');
            //     $("#right-input").val('');
            // }
            document.querySelector('#left-input').classList.remove('selected');
            document.querySelector('#right-input').classList.remove('selected');

            if (sharedDrawerState.cartesianLocation === 'left') {
                document.querySelector('#left-input').classList.add('selected');
            } else if (sharedDrawerState.cartesianLocation === 'right') {
                document.querySelector('#right-input').classList.add('selected');
            } else {
                $("#left-input").val('');
                $("#right-input").val('');
            }
        }

        function updateTrolleyUIState() {
            document.querySelector('#trolley-1').classList.remove('empty-selected');
            document.querySelector('#trolley-2').classList.remove('empty-selected');
            document.querySelector('#trolley-3').classList.remove('empty-selected');
            document.querySelector('#tray-1').classList.remove('empty-selected');
            document.querySelector('#tray-2').classList.remove('empty-selected');
            document.querySelector('#tray-3').classList.remove('empty-selected');

            if (sharedDrawerState.trolleyLocation === 'left') {
                document.querySelector('#trolley-1').classList.add('empty-selected');
                document.querySelector('#tray-1').classList.add('empty-selected');
            } else if (sharedDrawerState.trolleyLocation === 'right') {
                document.querySelector('#trolley-2').classList.add('empty-selected');
                document.querySelector('#tray-2').classList.add('empty-selected');
            } else if (sharedDrawerState.trolleyLocation === 'center') {
                document.querySelector('#trolley-3').classList.add('empty-selected');
                document.querySelector('#tray-3').classList.add('empty-selected');
            } else {
                // $("#txtTrolleySlot").val('');
            }
        }

        function updateDash() {
            document.getElementById('pendingCount').innerHTML = totalReels;
            document.getElementById('completedCount').innerHTML = totalCompleted;
            document.getElementById('insufficientCount').innerHTML = totalInsufficient;
        }

        function setStatus(text, color) {
            const badge = document.getElementById('statusBadge');
            const dot = document.getElementById('statusDot');
            const st = document.getElementById('statusText');
            st.textContent = text;
            dot.style.background = color;
            if (text !== 'IDLE' && text !== 'DONE') badge.classList.add('status-active');
            else badge.classList.remove('status-active');
        }

        function moveArm(top) {
            document.getElementById('armHead').style.top = top + 'px';
        }

        function setGrip(open) {
            document.getElementById('gripperLeft').style.transform = open ? 'translateX(-4px)' : '';
            document.getElementById('gripperRight').style.transform = open ? 'translateX(4px)' : '';
        }

        function showHeld(colorIdx) {
            const h = document.getElementById('heldTray');
            if (colorIdx !== null) {
                h.style.background = TRAY_COLORS[colorIdx];
                h.classList.remove('hidden');
            } else {
                h.classList.add('hidden');
            }
        }

        function moveArmX(side) {
            const asm = document.getElementById('armAssembly');
            if (side === 'rack') { asm.style.left = '47%'; }
            else if (side === 'trolley') { asm.style.left = '53%'; }
            else { asm.style.left = '50%'; }
        }

        async function retrieveMove() {
            // Move to rack
            setStatus('RETRIEVE', '#f59e0b');
            // log('Moving arm to rack...');
            moveArmX('rack');
            setGrip(true);
            await delay(900);

            // Lower & grab
            moveArm(20);
            await delay(600);
            setGrip(false);
            await delay(300);

        }

        async function retrieveMoveDone() {
            rack.pop();
            heldTray = 2;
            showHeld(2);

            // Lift
            moveArm(0);
            await delay(600);

            moveArmX('center');

            // await delay(1000);
            // putawayMove();
        }

        async function retrieveMoveNext() {
            moveArm(0);
            await delay(400);
            setGrip(false);
            moveArmX('center');
        }

        async function putawayMove() {
            // Move to trolley
            setStatus('PUTAWAY', '#3b82f6');
            // log('Transferring to trolley...');
            moveArmX('trolley');
            await delay(900);

        }

        async function putawayMoveDone() {
            // Lower & release
            // setStatus('PLACING', '#8b5cf6');
            moveArm(20);
            await delay(600);
            setGrip(true);
            await delay(300);
            trolley.push(3);
            heldTray = null;
            showHeld(null);
            // renderSlots();
            // log(`Placed tray <span style="color:${TRAY_COLORS[trayIdx]}">■</span> on trolley`);

            // Return center
            moveArm(0);
            await delay(400);
            setGrip(false);
            moveArmX('center');
            await delay(600);

        }

        // ----------- Log
        function log(msg, typ) {
            const list = document.getElementById('logList');
            const d = document.createElement('div');
            d.className = 'log-entry';
            const ts = new Date().toLocaleTimeString('en', { hour12: false });
            if (typ == 'info') {
                d.innerHTML = `<span style="color:#475569">[${ts}]</span> ${msg}`;
            }
            if (typ == 'alert') {
                d.innerHTML = `<span style="color:#e74c3c">[${ts}]</span> <span style="color:#e74c3c">${msg} </span>`;
            }
            list.prepend(d);
            if (list.children.length > 30) list.lastChild.remove();
        }

        // ----------- JSON
        function updateJson() {
            var data = {
                SystemStart: sharedDrawerState.systemRunning,

                TrolleyCode: $("#trolley-input").val(),
                TrolleyId: Number($("#txtTrolleyId").val()),
                TrolleySide: $("#side-input").val(),

                DrawerStatus: sharedDrawerState.drawerStatus,

                ReelId: $("#txtReelId").val(),
                ReelCode: $("#txtReelCode").val(),
                ActualHeight: Number($("#txtActHeight").val()),
                DtlId: Number($("#txtDtlId").val()) || 0,

                CartesianRobotState: sharedDrawerState.cartesianRobotState,
                CartesianLocation: sharedDrawerState.cartesianLocation,

                RetrieveSlot: $("#txtRetrieveSlot").val(),
                PutAwaySlot: $("#txtPutSlot").val(),
                SlotTake: Number($("#txtPutSlotTake").val()),

                TrolleyLocation: sharedDrawerState.trolleyLocation,

                ReelBalance: totalReels,
            }

            $.ajax({
                url: '/api/PLCHubOut/UpdateRackJobJson',
                type: 'POST',
                headers: {
                    'Authorization': 'Bearer ' + token
                },
                data: JSON.stringify(data),
                dataType: 'JSON',
                contentType: 'application/json; charset=utf-8',
                beforeSend: function() {
                },
                success: function(result) {
                    if (result.success == true) {
                    }
                    else {
                        console.log(result.errMessage);
                    }
                },
                error: function(error) {
                    console.log(error);
                }
            });
        }

        async function getJson() {
            var fResult = false;

            await $.ajax({
                url: '/api/PLCHubOut/GetRackJobJson',
                type: 'GET',
                headers: {
                    'Authorization': 'Bearer ' + token
                },
                dataType: 'JSON',
                contentType: 'application/json; charset=utf-8',
                beforeSend: function() {
                },
                success: function(result) {
                    sharedDrawerState.systemRunning = result.data.systemStart;

                    $("#trolley-input").val(result.data.trolleyCode);
                    $("#txtTrolleyId").val(result.data.trolleyId);
                    $("#side-input").val(result.data.trolleySide);

                    sharedDrawerState.drawerStatus = result.data.drawerStatus;

                    $("#txtReelId").val(result.data.reelId);
                    $("#txtReelCode").val(result.data.reelCode);
                    $("#txtActHeight").val(result.data.actualHeight);
                    $("#txtDtlId").val(result.data.dtlId);

                    sharedDrawerState.cartesianRobotState = result.data.cartesianRobotState;
                    sharedDrawerState.cartesianLocation = result.data.cartesianLocation;

                    $("#txtRetrieveSlot").val(result.data.retrieveSlot);
                    $("#txtPutSlot").val(result.data.putAwaySlot);
                    $("#txtPutSlotTake").val(result.data.slotTake);

                    sharedDrawerState.trolleyLocation = result.data.trolleyLocation;

                    updateSystemStatusUI();
                    applyViewerRestrictions();
                    renderScene(result.data);

                    fResult = true;

                    return fResult;
                },
                error: function(error) {
                    console.log(error);
                }
            });

            return fResult;
        }

        // ----------- Database
        function loadDBUpcoming() {
            const pendingList = document.getElementById('pendingList');
            const insufficientList = document.getElementById('insufficientList');

            // var count = document.querySelectorAll('.reel-card').length;
            // if (count.length === 0) {
            //     pendingList.innerHTML = '<div class="text-xs" style="color:#9ca3af;">No pending items</div>';
            //     return;
            // }
            // count = document.querySelectorAll('.reel-card-in').length;
            // if (count.length === 0) {
            //     insufficientList.innerHTML = '<div class="text-xs" style="color:#9ca3af;">No pending items</div>';
            //     return;
            // }

            $.ajax({
                url: "/api/PLCHubOut/GetUpcomingReels/" + qId + "/" + lastItemCount + "/" + lastItemId,
                type: "GET",
                headers: {
                    'Authorization': 'Bearer ' + token
                },
                dataType: 'JSON',
                // data: JSON.stringify(jsonInput),
                contentType: 'application/json; charset=utf-8',
                beforeSend: function() {

                },
                success: function(result) {
                    // console.log(result);

                    if (result.totalRecords > 0) {
                        for (var i = 0; i < result.data.length; i++) {
                            let id = result.data[i].detail_Id;
                            let r = result.data[i].reel_Id;
                            let code = result.data[i].itemCode;
                            let qty = result.data[i].qty;

                            if (r == "") {
                                const item = document.createElement('div');
                                item.id = id;
                                item.className = 'reel-card text-xs px-2.5 py-1.5 rounded-lg flex items-center gap-2';
                                item.style.background = 'lemonchiffon';
                                item.style.borderLeft = `3px solid #ef4444`;
                                item.style.color = '#166534';
                                item.innerHTML = `<span style="color:#ef4444;font-weight:bold;">■</span> Reel ${r} • ${qty} x ${code} `;
                                insufficientList.appendChild(item);
                                totalInsufficient = totalInsufficient + 1;
                            }
                            else {
                                const item = document.createElement('div');
                                item.id = id;
                                item.className = 'reel-card-in text-xs px-2.5 py-1.5 rounded-lg flex items-center gap-2';
                                item.style.background = '#f0fdf4';
                                item.style.borderLeft = `3px solid ${TRAY_COLORS[i]}`;
                                item.style.color = '#166534';
                                item.innerHTML = `<span style="color:${TRAY_COLORS[i]};font-weight:bold;">■</span> ${qty} x ${code} `;
                                pendingList.appendChild(item);
                            }

                            lastItemId = id;
                            lastItemCount = lastItemCount + 1;
                            updateDash();
                        }
                    }

                    return true;
                },
                error: function(error) {
                    log('End Loader :: ' + error.val, 'alert');
                }
            });

        }

        function removeDBUpcoming(id) {
            // const pendingList = document.getElementById('pendingList');
            // const insufficientList = document.getElementById('insufficientList');

            const item = document.getElementById(id);

            // 3. Check if the element exists and then remove it
            if (item) {
                item.classList.add('fade-out');

                // 2. Wait for the animation to finish (500ms in this example) and then remove the element
                setTimeout(() => {
                    item.remove(); // The .remove() method is simple and widely supported
                }, 500); // The delay must match the CSS transition duration
            }
        }

        // ----------- Trolley
        async function getTrolley(code, isCont) {
            var fResult = false;

            await $.ajax({
                url: "/api/PLCHubOut/StartHubOut/" + code + "/" + qId,
                type: "GET",
                headers: {
                    'Authorization': 'Bearer ' + token
                },
                dataType: 'JSON',
                // data: JSON.stringify(jsonInput),
                contentType: 'application/json; charset=utf-8',
                beforeSend: function() {
                    Swal.fire({
                        text: 'Please Wait',
                        width: '300px',

                        allowEscapeKey: false,
                        allowOutsideClick: false,
                        showConfirmButton: false,
                    });
                    Swal.showLoading()
                },
                success: function(result) {
                    // console.log(result);
                    swal.close();

                    if (result.success == true) {
                        fResult = true;

                        $("#txtTrolleyId").val(result.data.trolleyInfo.trolley_Id);
                        // if (result.data.dtlList.length > 0) {
                        //     totalReels = result.data.dtlList.length;
                        // }
                        // else {
                        //     totalReels = result.data.eDtlList.length;
                        // }totalRecords
                        totalReels = result.totalRecords;
                        updateDash();

                        log('Trolley :: Done check ' + code, 'info');
                        log('Trolley :: totalReels  ' + totalReels, 'info');
                    }
                    else {
                        log('Trolley :: ' + result.errMessage, 'alert');
                    }
                },
                error: function(error) {
                    log('Trolley :: ' + error.val, 'alert');
                }
            });

            return fResult;
        }

