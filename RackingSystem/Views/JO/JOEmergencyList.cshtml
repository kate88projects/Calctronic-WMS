} *@

@{
    string menuItemClass = "tw:block tw:rounded-lg tw:px-3 tw:py-2 tw:text-sm tw:text-gray-700 tw:no-underline tw:hover:bg-gray-100 tw:dark:text-gray-300 tw:dark:hover:bg-white/5";
}

<div class="tw:flex tw:w-full tw:items-center tw:justify-between">
    <h2 class="tw:text-lg tw:mb-0 tw:ml-2 tw:font-semibold tw:text-gray-800 tw:dark:text-white/90">Emergency JOB Order List</h2>
    <div class="tw:flex tw:items-center tw:gap-2">
        <div class="tw:relative" x-data="{ importOpen: false }" @@click.outside="importOpen = false">
            <button type="button" class="tw:rounded-lg tw:border-0 tw:bg-yellow-400 tw:px-4 tw:py-2.5 tw:text-sm tw:font-medium tw:text-white tw:hover:bg-yellow-500" @@click="importOpen = !importOpen">
                Import
                <i class="bi bi-chevron-down tw:text-xs"></i>
            </button>
            <div x-show="importOpen" x-cloak class="tw:shadow-theme-lg tw:absolute tw:right-0 tw:z-10 tw:mt-2 tw:w-64 tw:rounded-xl tw:border tw:border-gray-200 tw:bg-white tw:p-2 tw:dark:border-gray-800 tw:dark:bg-gray-900">
                <a href="#" class="@menuItemClass" id="dTemp" onclick="downloadTemp()" @@click="importOpen = false">Download Template</a>
                <a href="#" class="@menuItemClass" onclick="triggerFileInput()" @@click="importOpen = false">Import Emergency JO by Excel</a>
            </div>
        </div>
        <input type="file" id="fileInput" accept=".xlsx" class="tw:hidden" onchange="handleFileUpload(event)">
        <button type="button" class="tw:border-0 tw:inline-flex tw:items-center tw:gap-2 tw:rounded-lg tw:bg-brand-500 tw:px-4 tw:py-2.5 tw:text-sm tw:font-medium tw:text-white tw:transition
            tw:hover:bg-brand-600" onclick="navigateToNew('new')">
            Add New Emergency JOB
        </button>
    </div>
</div>

<div class="tw:mt-3">
    <div class="dt-tailadmin tw:overflow-hidden tw:rounded-xl tw:border tw:border-gray-200 tw:bg-white tw:text-gray-700 tw:dark:border-gray-800 tw:dark:bg-white/[0.03] tw:dark:text-gray-300">
        <table id="listTable" class="row-border dataTable hover order-column tw:w-full">
            <thead>
                <tr class="tw:border-b tw:border-gray-200">
                    @{
                        string[] listHeaders = { "Doc No", "Doc Date", "Description", "Status", "Created Date", "Action" };
                    }
                    @foreach (var header in listHeaders)
                    {
                        <th class="tw:px-5 tw:py-3.5 tw:text-left sm:tw:px-6"><span class="tw:text-sm tw:font-semibold tw:text-gray-700 tw:dark:text-gray-300">@header</span></th>
                    }
                </tr>
            </thead>
        </table>
    </div>
</div>

@section Scripts
{
    <link rel="stylesheet" href="~/css/sweetalert2.min.css">
    <link rel="stylesheet" href="~/css/dataTables.dataTables.css">

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="../js/dataTables.js"></script>
    <script src="~/js/sweetalert2.all.min.js"></script>
    <script src="../js/exceljs.min.js"></script>

    <script type="text/javascript">
        let gridInstance = null;
        let originalFileContent = null;

        $(document).ready(function() {
            loadList();
        });

        function loadList() {
            $.ajax({
                url: "/JO/GetJOEmergencyList/",
                type: "GET",
                dataType: "JSON",
                contentType: "application/json; charset=utf-8",
                beforeSend: function() {
                    Swal.fire({
                        text: 'Please Wait',
                        width: '300px',
                        allowEscapeKey: false,
                        allowOutsideClick: false,
                        showConfirmButton: false,
                    });
                    Swal.showLoading();
                },
                success: function(result) {
                    Swal.close();
                    if (result.success == true) {
                        const cellClass = 'tw:px-5 tw:py-4 tw:whitespace-nowrap sm:tw:px-6 tw:text-theme-sm tw:text-gray-700 tw:dark:text-gray-300';
                        const designClass = 'tw:px-5 tw:py-4 tw:whitespace-nowrap sm:tw:px-6';

                        $('#listTable').DataTable({
                           data: result.data.sort((a, b) => b.jobOrderEmergency_Id - a.jobOrderEmergency_Id), // newest first
                           paging: true,
                           searching: true,
                           "info": true,
                           "bDestroy": true,
                           order: [],
                           columns: [
                              { data: 'docNo', className: cellClass },
                              {
                                  data: null ,
                                  className: cellClass, 
                                  render: function (data, type, row, meta) {
                                      const docDate = new Date(row.docDate.split('.')[0]);
                                        if (isNaN(docDate)) return 'Invalid Date';

                                        return docDate.toLocaleString('en-GB', {
                                            year: 'numeric',
                                            month: 'numeric',
                                            day: 'numeric',
                                            hour: 'numeric',
                                            minute: 'numeric',
                                            hour: 'numeric',
                                            hour12: true
                                        });
                                      return formattedDate;
                                  }
                              },
                              {
                                  data: 'description' ,
                                  className: cellClass, 
                                  render: function (data, type, row, meta) {
                                      const maxLength = 50;
                                      const desc = row.description || "";
                                      const shortDesc = desc.length > maxLength
                                          ? desc.substring(0, maxLength) + "..."
                                          : desc;

                                      return `
                                           <p style="margin: 0;">
                                              <span title="${desc}">${shortDesc}</span><br/>
                                              <span style="font-size:13px;color:grey;">${row.desc2 || ""}</span>
                                          </p>
                                      `;
                                  }
                              },
                              { data: 'status', className: designClass },
                              {
                                  data: 'createdDate',
                                  className: cellClass, 
                                  render: function (data, type, row, meta) {
                                      const date = new Date(data.split('.')[0]);
                                      if (isNaN(date)) return 'Invalid Date';

                                      return date.toLocaleString('en-GB', {
                                          year: 'numeric',
                                          month: 'numeric',
                                          day: 'numeric',
                                          hour: 'numeric',
                                          minute: 'numeric',
                                          hour: 'numeric',
                                          hour12: true
                                      });
                                  }
                              },
                              {
                                  data: null,
                                  className: designClass, 
                                  render: function (data, type, row, meta) {
                                      const rawData = JSON.stringify(row).replace(/"/g, "&quot;");
                                      return `<div class="tw:flex tw:items-center tw:gap-2">
                                          <button class="view-btn tw:inline-flex tw:items-center tw:gap-1.5 tw:rounded-lg tw:bg-taupe-200 tw:font-medium tw:text-taupe-600
                                              tw:transition-colors tw:hover:bg-taupe-300 tw:dark:bg-taupe-500/15 tw:dark:text-taupe-400 tw:dark:hover:bg-taupe-500/25" data-row='${rawData}' onclick="navigateToSimulate(${row.jobOrderEmergency_Id})">
                                              <i class="bi bi-boxes"></i>
                                              Simulate
                                          </button>
                                          <button class="view-btn tw:inline-flex tw:items-center tw:gap-1.5 tw:rounded-lg tw:bg-brand-50 tw:font-medium tw:text-brand-600
                                              tw:transition-colors tw:hover:bg-brand-100 tw:dark:bg-brand-500/15 tw:dark:text-brand-400 tw:dark:hover:bg-brand-500/25" data-row='${rawData}' onclick="navigateToView(${row.jobOrderEmergency_Id}, 'view')">
                                              <i class="bi bi-eye"></i> 
                                              View
                                          </button>
                                          <button class="edit-btn tw:inline-flex tw:items-center tw:gap-1.5 tw:rounded-lg tw:bg-amber-50 tw:font-medium tw:text-amber-600
                                               tw:transition-colors tw:hover:bg-amber-100 tw:dark:bg-amber-500/15 tw:dark:text-amber-400 tw:dark:hover:bg-amber-500/25" data-row='${rawData}' onclick="navigateToEdit(${row.jobOrderEmergency_Id}, 'edit')">
                                              <i class="bi bi-pencil-square"></i> 
                                              Edit
                                          </button>
                                          <button class="delete-btn tw:inline-flex tw:items-center tw:gap-1.5 tw:rounded-lg tw:bg-error-50 tw:font-medium tw:text-error-600
                                               tw:transition-colors tw:hover:bg-error-100 tw:dark:bg-error-500/15 tw:dark:text-error-400 tw:dark:hover:bg-error-500/25" data-id="${row.jobOrderEmergency_Id}">
                                              <i class="bi bi-trash"></i> 
                                              Delete
                                          </button>
                                      </div>`;
                                  }
                              },
                          ],
                          language: {
                                searchPlaceholder: "🔍︎ Search",
                                search: ""
                          }
                      });
                   }
                   else {
                       Swal.fire({
                           icon: 'error',
                           title: "Wait",
                            text: result.errMessage
                        });
                    }
                },
                error: function (error) {
                    Swal.fire({
                        icon: 'error',
                        title: "Wait",
                        text: error.val
                    });
                }
            });
        }

        function navigateToNew(mode) {
            window.location.href = '@Url.Action("JOEmergencyDetails", "JO", new { id = "_id_", mode = "_mode_" })'.replace('_id_', 0).replace('_mode_', mode);
        }

        function navigateToView(id, mode) {
            window.location.href = '@Url.Action("JOEmergencyDetails", "JO", new { id = "_id_", mode = "_mode_" })'.replace('_id_', id).replace('_mode_', mode);
        }

        function navigateToEdit(id, mode) {
            window.location.href = '@Url.Action("JOEmergencyDetails", "JO", new { id = "_id_", mode = "_mode_" })'.replace('_id_', id).replace('_mode_', mode);
        }

        function navigateToSimulate(id) {
            var baseUrl = '@Url.Action("JOESimulate", "JO")';

            // Append your dynamic query parameters
            var finalUrl = baseUrl + '?id=' + id;

            // Open the compiled link in a new tab
            window.open(finalUrl, '_blank');
        }

        $('#listTable').on('click', '.delete-btn', function () {
            const id = $(this).attr('data-id');
            deleteEmergency(id);
        });

        function deleteEmergency(id) {
            Swal.fire({
                title: "Are you sure want to delete?",
                text: "You won't be able to recover this record!",
                icon: 'warning', 
                showCancelButton: true,
                confirmButtonText: 'Yes',
                cancelButtonText: 'Cancel',
                allowOutsideClick: false,
            }).then(function(r) {
                if (r.isConfirmed == true) {
                    var data = {
                        JobOrderEmergency_Id: id,
                    };
                    $.ajax({
                        url: '/JO/DeleteEmergency',
                        type: 'DELETE',
                        data: JSON.stringify(data),
                        dataType: 'json',
                        contentType: 'application/json; charset=utf-8',
                        beforeSend: function () {
                            Swal.fire({
                                text: 'Please Wait',
                                width: '300px',
                                allowEscapeKey: false,
                                allowOutsideClick: false,
                                showConfirmButton: false,
                            });
                            Swal.showLoading();
                        },
                        success: function (result) {
                            if (result.success == true) {
                                Swal.fire({
                                    icon: 'success',
                                    title: "Success Deleted",
                                    text: "",
                                    didClose: () => {
                                      window.location.reload();
                                    }
                                });
                            }
                            else {
                                Swal.fire({
                                    icon: 'error',
                                    title: "Wait",
                                    text: result.errMessage
                                });
                            }
                        },
                        error: function (error) {
                            Swal.fire({
                                icon: 'error',
                                title: "Wait",
                                text: error.val
                            });
                        }
                    });

                } else {
                    return;
                }
            });
        }

        function downloadTemp() {
            var workbook = new ExcelJS.Workbook();
            workbook.creator = "Flex Software Consulting Sdn Bhd";
            workbook.created = new Date();
            workbook.properties.title = "Template";
            workbook.properties.subject = "Import Emergency JO";

            var worksheet = workbook.addWorksheet("Sheet1");
            var jo_header = [
                ["Description", "Remark"],
                [],
                [],
                ["Item Code", "Qty", "Buffer Qty"]
            ];

            jo_header.forEach(function(row) {
                worksheet.addRow(row);
            });
            worksheet.columns = [
                { width: 30 },
                { width: 15 }
            ];

            worksheet.getRow(1).font = { name: 'Calibri', size: 11, bold: true };
            worksheet.getRow(4).font = { name: 'Calibri', size: 11, bold: true };

            const starred = title => ({ richText: [
                { text: title, font: { name: 'Calibri', size: 11, bold: true } },
                { text: ' *', font: { name: 'Calibri', size: 11, bold: true, color: { argb: 'FFFF0000' } } }
            ] });

            worksheet.getCell('A4').value = starred('Item Code');
            worksheet.getCell('B4').value = starred('Qty');

            workbook.xlsx.writeBuffer().then(function(buffer) {
                var blob = new Blob([buffer], { type: "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" });

                var link = document.createElement("a");
                link.href = URL.createObjectURL(blob);
                link.download = "EmergencyJO_Template.xlsx";
                link.click();
                URL.revokeObjectURL(link.href);
            }).catch(function(err) {
                console.error("Error creating Excel file:", err);
            });
        }

        function triggerFileInput() {
            document.getElementById('fileInput').click();
        }

        function handleFileUpload(event) {
            const input = event.target;
            const file = input.files[0];

            if (!file) return;

            const fileExtension = file.name.split('.').pop().toLowerCase();
            if (fileExtension !== 'xlsx') {
                alert("Only XLSX files are supported.");
                input.value = '';
                return;
            }

            const reader = new FileReader();
            reader.onload = function(e) {
                const content = e.target.result;
                originalFileContent = content;
                processFileContent(content)
                    .then((excelData) => {
                        if (excelData)
                            saveExcelEmergency(excelData);
                    })
                    .catch((err) => {
                        console.error("Error processing the file:", err);
                    })
                    .finally(function() {
                        input.value = '';
                    });
            };
            reader.readAsArrayBuffer(file);
        }

        function cellText(cell) {
            const v = cell.value;
            if (v === null || v === undefined) return "";
            if (typeof v === "object") {
                if (v.richText) 
                    return v.richText.map(t => t.text).join("").trim();
                if (v.result !== undefined && v.result !== null) 
                    return String(v.result).trim();
                if (v.text !== undefined) 
                    return String(v.text).trim();
            }
            return String(v).trim();
        }

        function headerText(cell) {
            return cellText(cell).replace(/\*/g, "").trim().toLowerCase();
        }

        function processFileContent(arraybuffer) {
            const workbook = new ExcelJS.Workbook();
            return workbook.xlsx.load(arraybuffer).then(function() {
                const worksheet = workbook.worksheets[0];

                if (!worksheet) {
                    alert("The upload file appears to be empty.");
                    return;
                }

                const description = cellText(worksheet.getRow(2).getCell(1));
                const remark = cellText(worksheet.getRow(2).getCell(2));

                let headerRow = -1;
                for (let r = 1; r <= 50; r++) {
                    if (headerText(worksheet.getRow(r).getCell(1)) === "item code") {
                        headerRow = r;
                        break;
                    }
                }

                if (headerRow === -1) {
                    alert("Invalid template: 'Item Code' header not found.");
                    return;
                }

                const details = [];
                const errors = [];
                for (let rowNum = headerRow + 1; rowNum <= worksheet.rowCount; rowNum++) {
                    const row = worksheet.getRow(rowNum);
                    const itemCode = cellText(row.getCell(1));
                    const qtyText = cellText(row.getCell(2)).replace(/,/g, "");
                    const bufferText = cellText(row.getCell(3)).replace(/,/g, "");

                    if (itemCode === "" && qtyText === "") continue;

                    let qty = 0;
                    if (qtyText !== "") {
                        qty = Number(qtyText);
                        if (!Number.isInteger(qty)) {
                            errors.push(`Row ${rowNum}: Qty [${qtyText}] must be a whole number`);
                            qty = 0;
                        }
                    }
                    let bufferQty = 0;
                    if (bufferText !== "") {
                        bufferQty = Number(bufferText);
                        if (!Number.isInteger(bufferQty)) {
                            errors.push(`Row ${rowNum}: Qty [${bufferText}] must be a whole number`);
                            bufferQty = 0;
                        }
                    }

                    details.push({ ExcelRow: rowNum, ItemCode: itemCode, Qty: qty, BufferQty: bufferQty });
                }

                if (errors.length > 0) {
                    Swal.fire({
                        icon: 'error',
                        title: "Wait",
                        text: errors.slice(0, 10).join('; ') + (errors.length > 10 ? ` ... and ${errors.length - 10} more` : '')
                    });
                    return;
                }

                if (details.length === 0) {
                    alert("No items found.");
                    return;
                }

                return {
                    Description: description,
                    Remark: remark,
                    EmergencyDetails: details
                };
            });
        }

        function saveExcelEmergency(excelData) {
            $.ajax({
                url: '/JO/SaveExcelEmergency',
                type: 'POST',
                data: JSON.stringify(excelData),
                dataType: 'JSON',
                contentType: 'application/json; charset=utf-8',
                beforeSend: function () {
                    Swal.fire({
                        text: 'Please Wait',
                        width: '300px',
                        allowEscapeKey: false,
                        allowOutsideClick: false,
                        showConfirmButton: false,
                    });
                    Swal.showLoading()
                },
                success: function (result) {
                    if (result.success == true) {
                        Swal.fire({
                            icon: 'success',
                            title: "Success Import",
                            text: "",
                            didClose: () => {
                                window.location.reload();
                            }
                        });
                    }
                    else {
                        if (result.data && result.data.emergencyDetails && result.data.emergencyDetails.length > 0) {
                            generateErrorExcelFile(originalFileContent, result.data);
                            Swal.fire({
                                icon: 'warning',
                                title: "Validation Issues Found",
                                text: "Review on returned file and fix errors."
                            });
                        } else {
                            Swal.fire({
                                icon: 'error',
                                title: "Wait",
                                text: result.errMessage
                            });
                        }
                    }
                },
                error: function (error) {
                    Swal.fire({
                        icon: 'error',
                        title: "Wait",
                        text: "Failed to import the file. Please try again."
                    });
                }
            });
        }

        function generateErrorExcelFile(buffer, errorData) {
            const workbook = new ExcelJS.Workbook();
            workbook.xlsx.load(buffer).then(() => {
                var worksheet = workbook.worksheets[0];
                var headerRowNumber = -1;
                for (let r = 1; r <= 50; r++) {
                    if (headerText(worksheet.getCell(`A${r}`)) === "item code") {
                        headerRowNumber = r;
                        break;
                    }
                }

                if (headerRowNumber === -1) {
                    alert("Header 'item code' not found");
                    return;
                }

                let lastCol = 1;
                for (let c = 1; c <= 20; c++) {
                    const h = headerText(worksheet.getRow(headerRowNumber).getCell(c));
                    if (h !== "" && h !== "error message") lastCol = c;
                }
                const errCol = lastCol + 1;

                const headerCell = worksheet.getCell(headerRowNumber, errCol);
                headerCell.value = "Error Message";
                headerCell.font = { name: 'Calibri', size: 11, bold: true };

                const errorFill = {
                    type: "pattern",
                    pattern: "solid",
                    fgColor: { argb: "FFFFC7CE" }
                };
                const errorFont = { name: 'Calibri', size: 10, color: { argb: "FF9C0006" } };

                errorData.emergencyDetails.forEach(dtl => {
                    if (dtl.errorMsg) {
                        const rowNumber = dtl.excelRow;
                        const cell = worksheet.getCell(rowNumber, errCol);
                        cell.value = dtl.errorMsg;
                        cell.fill = errorFill;
                        cell.font = errorFont;

                        (dtl.errorFields || []).forEach(field => {
                            const col = field === "Qty" ? "B" : "A";
                            worksheet.getCell(`${col}${rowNumber}`).fill = errorFill;
                        });
                    }
                });

                worksheet.getColumn(errCol).width = 60;

                workbook.xlsx.writeBuffer().then(function(buffer) {
                    const blob = new Blob([buffer], { type: "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" });
                    const link = document.createElement("a");
                    link.href = URL.createObjectURL(blob);
                    link.download = `EmergencyJO_Errors_${new Date().toISOString().slice(0,10)}.xlsx`;
                    link.click();
                    URL.revokeObjectURL(link.href);
                });

            }).catch(err => {
                console.error("Error loading workbook:", err);
            });
        }
    </script>
}
