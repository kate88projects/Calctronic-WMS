<div class="tw:flex tw:w-full tw:items-center tw:justify-between">
    <h2 class="tw:text-lg tw:mb-0 tw:ml-2 tw:font-semibold tw:text-gray-800 tw:dark:text-white/90">Emergency JOB Order List</h2>
    <div class="tw:flex">
        <button type="button" class="tw:border-0 tw:inline-flex tw:items-center tw:gap-2 tw:rounded-lg tw:bg-brand-500 tw:px-4 tw:py-2.5 tw:text-sm tw:font-medium tw:text-white tw:transition
            tw:hover:bg-brand-600" onclick="navigateToNew('new')">
            Add New Emergency JOB
        </button>
    </div>
</div>

<div class="tw:mt-3">
    <div class="dt-tailadmin tw:overflow-hidden tw:rounded-xl tw:border tw:border-gray-200 tw:bg-white tw:text-gray-700 tw:dark:border-gray-800 tw:dark:bg-white/[0.03] tw:dark:text-gray-300">
        <table id="listTable" class="row-border dataTable hover order-column tw:w-full">
            <thead>
                <tr class="tw:border-b tw:border-gray-200">
                    @{
                        string[] listHeaders = { "Doc No", "Doc Date", "Description", "Status", "Created Date", "Action" };
                    }
                    @foreach (var header in listHeaders)
                    {
                        <th class="tw:px-5 tw:py-3.5 tw:text-left sm:tw:px-6"><span class="tw:text-sm tw:font-semibold tw:text-gray-700 tw:dark:text-gray-300">@header</span></th>
                    }
                </tr>
            </thead>
        </table>
    </div>
</div>

@section Scripts
{
    <link rel="stylesheet" href="~/css/sweetalert2.min.css">
    <link rel="stylesheet" href="~/css/dataTables.dataTables.css">

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="../js/dataTables.js"></script>
    <script src="~/js/sweetalert2.all.min.js"></script>

    <script type="text/javascript">
        let gridInstance = null;

        $(document).ready(function() {
            loadList();
        });

        function loadList() {
            $.ajax({
                url: "/JO/GetJOEmergencyList/",
                type: "GET",
                dataType: "JSON",
                contentType: "application/json; charset=utf-8",
                beforeSend: function() {
                    Swal.fire({
                        text: 'Please Wait',
                        width: '300px',
                        allowEscapeKey: false,
                        allowOutsideClick: false,
                        showConfirmButton: false,
                    });
                    Swal.showLoading();
                },
                success: function(result) {
                    Swal.close();
                    if (result.success == true) {
                        const cellClass = 'tw:px-5 tw:py-4 tw:whitespace-nowrap sm:tw:px-6 tw:text-theme-sm tw:text-gray-700 tw:dark:text-gray-300';
                        const designClass = 'tw:px-5 tw:py-4 tw:whitespace-nowrap sm:tw:px-6';

                        $('#listTable').DataTable({
                           data: result.data,
                           paging: true,
                           searching: true,
                           "info": true,
                           "bDestroy": true,
                           columns: [
                              { data: 'docNo', className: cellClass },
                              {
                                  data: null ,
                                  className: cellClass, 
                                  render: function (data, type, row, meta) {
                                      const docDate = new Date(row.docDate.split('.')[0]);
                                        if (isNaN(docDate)) return 'Invalid Date';

                                        return docDate.toLocaleString('en-GB', {
                                            year: 'numeric',
                                            month: 'numeric',
                                            day: 'numeric',
                                            hour: 'numeric',
                                            minute: 'numeric',
                                            hour: 'numeric',
                                            hour12: true
                                        });
                                      return formattedDate;
                                  }
                              },
                              {
                                  data: 'description' ,
                                  className: cellClass, 
                                  render: function (data, type, row, meta) {
                                      const maxLength = 50;
                                      const desc = row.description || "";
                                      const shortDesc = desc.length > maxLength
                                          ? desc.substring(0, maxLength) + "..."
                                          : desc;

                                      return `
                                           <p style="margin: 0;">
                                              <span title="${desc}">${shortDesc}</span><br/>
                                              <span style="font-size:13px;color:grey;">${row.desc2 || ""}</span>
                                          </p>
                                      `;
                                  }
                              },
                              { data: 'status', className: designClass },
                              {
                                  data: 'createdDate',
                                  className: cellClass, 
                                  render: function (data, type, row, meta) {
                                      const date = new Date(data.split('.')[0]);
                                      if (isNaN(date)) return 'Invalid Date';

                                      return date.toLocaleString('en-GB', {
                                          year: 'numeric',
                                          month: 'numeric',
                                          day: 'numeric',
                                          hour: 'numeric',
                                          minute: 'numeric',
                                          hour: 'numeric',
                                          hour12: true
                                      });
                                  }
                              },
                              {
                                  data: null,
                                  className: designClass, 
                                  render: function (data, type, row, meta) {
                                      const rawData = JSON.stringify(row).replace(/"/g, "&quot;");
                                      return `<div class="tw:flex tw:items-center tw:gap-2">
                                          <button class="view-btn tw:inline-flex tw:items-center tw:gap-1.5 tw:rounded-lg tw:bg-brand-50 tw:font-medium tw:text-brand-600
                                              tw:transition-colors tw:hover:bg-brand-100 tw:dark:bg-brand-500/15 tw:dark:text-brand-400 tw:dark:hover:bg-brand-500/25" data-row='${rawData}' onclick="navigateToView(${row.jobOrderEmergency_Id}, 'view')">
                                              <i class="bi bi-eye"></i> 
                                              View
                                          </button>
                                          <button class="edit-btn tw:inline-flex tw:items-center tw:gap-1.5 tw:rounded-lg tw:bg-amber-50 tw:font-medium tw:text-amber-600
                                               tw:transition-colors tw:hover:bg-amber-100 tw:dark:bg-amber-500/15 tw:dark:text-amber-400 tw:dark:hover:bg-amber-500/25" data-row='${rawData}' onclick="navigateToEdit(${row.jobOrderEmergency_Id}, 'edit')">
                                              <i class="bi bi-pencil-square"></i> 
                                              Edit
                                          </button>
                                          <button class="delete-btn tw:inline-flex tw:items-center tw:gap-1.5 tw:rounded-lg tw:bg-error-50 tw:font-medium tw:text-error-600
                                               tw:transition-colors tw:hover:bg-error-100 tw:dark:bg-error-500/15 tw:dark:text-error-400 tw:dark:hover:bg-error-500/25" data-id="${row.jobOrderEmergency_Id}">
                                              <i class="bi bi-trash"></i> 
                                              Delete
                                          </button>
                                      </div>`;
                                  }
                              },
                          ],
                          language: {
                                searchPlaceholder: "🔍︎ Search",
                                search: ""
                          }
                      });
                   }
                   else {
                       Swal.fire({
                           icon: 'error',
                           title: "Wait",
                            text: result.errMessage
                        });
                    }
                },
                error: function (error) {
                    Swal.fire({
                        icon: 'error',
                        title: "Wait",
                        text: error.val
                    });
                }
            });
        }

        function navigateToNew(mode) {
            window.location.href = '@Url.Action("JOEmergencyDetails", "JO", new { id = "_id_", mode = "_mode_" })'.replace('_id_', 0).replace('_mode_', mode);
        }

        function navigateToView(id, mode) {
            window.location.href = '@Url.Action("JOEmergencyDetails", "JO", new { id = "_id_", mode = "_mode_" })'.replace('_id_', id).replace('_mode_', mode);
        }

        function navigateToEdit(id, mode) {
            window.location.href = '@Url.Action("JOEmergencyDetails", "JO", new { id = "_id_", mode = "_mode_" })'.replace('_id_', id).replace('_mode_', mode);
        }

        function navigateToSimulate(id) {
            var baseUrl = '@Url.Action("JOESimulate", "JO")';

            // Append your dynamic query parameters
            var finalUrl = baseUrl + '?id=' + id;

            // Open the compiled link in a new tab
            window.open(finalUrl, '_blank');
        }

        $('#listTable').on('click', '.delete-btn', function () {
            const id = $(this).attr('data-id');
            deleteEmergency(id);
        });

        function deleteEmergency(id) {
            Swal.fire({
                title: "Are you sure want to delete?",
                text: "You won't be able to recover this record!",
                icon: 'warning', 
                showCancelButton: true,
                confirmButtonText: 'Yes',
                cancelButtonText: 'Cancel',
                allowOutsideClick: false,
            }).then(function(r) {
                if (r.isConfirmed == true) {
                    var data = {
                        JobOrderEmergency_Id: id,
                    };
                    $.ajax({
                        url: '/JO/DeleteEmergency',
                        type: 'DELETE',
                        data: JSON.stringify(data),
                        dataType: 'json',
                        contentType: 'application/json; charset=utf-8',
                        beforeSend: function () {
                            Swal.fire({
                                text: 'Please Wait',
                                width: '300px',
                                allowEscapeKey: false,
                                allowOutsideClick: false,
                                showConfirmButton: false,
                            });
                            Swal.showLoading();
                        },
                        success: function (result) {
                            if (result.success == true) {
                                Swal.fire({
                                    icon: 'success',
                                    title: "Success Deleted",
                                    text: "",
                                    didClose: () => {
                                      window.location.reload();
                                    }
                                });
                            }
                            else {
                                Swal.fire({
                                    icon: 'error',
                                    title: "Wait",
                                    text: result.errMessage
                                });
                            }
                        },
                        error: function (error) {
                            Swal.fire({
                                icon: 'error',
                                title: "Wait",
                                text: error.val
                            });
                        }
                    });

                } else {
                    return;
                }
            });
        }
    </script>
}
