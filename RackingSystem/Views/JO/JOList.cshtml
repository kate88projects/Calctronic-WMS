        function loadList() {
             $.ajax({
                 url: "/JO/GetJOList/",
                 type: "GET",
                 dataType: 'JSON',
                 contentType: 'application/json; charset=utf-8',
                 beforeSend: function () {
                    Swal.fire({
                        text: 'Please Wait',
                        width: '300px',
                        allowEscapeKey: false,
                        allowOutsideClick: false,
                        showConfirmButton: false,
                    });
                    Swal.showLoading();
                },
                success: function (result) {
                    Swal.close();
                    if (result.success == true) {
                        const cellClass = 'tw:px-5 tw:py-4 tw:whitespace-nowrap sm:tw:px-6 tw:text-theme-sm tw:text-gray-700 tw:dark:text-gray-300';

                        $('#listTable').DataTable( {
                            data: result.data,
                            paging: true,
                            searching: true,
                            "info": true,
                            "bDestroy": true,
                            columns: [
                                // { data: 'jobOrder_Id' },
                                { data: 'docNo', className: cellClass },
                                { 
                                    data: null ,
                                    className: cellClass,
                                    render: function (data, type, row, meta) {
                                        const docDate = new Date(row.docDate.split('.')[0]);
                                        if (isNaN(docDate)) return 'Invalid Date';

                                        return docDate.toLocaleString('en-GB', {
                                            year: 'numeric',
                                            month: 'numeric',
                                            day: 'numeric',
                                            hour: 'numeric',
                                            minute: 'numeric',
                                            hour: 'numeric',
                                            hour12: true
                                        });
                                    }
                                },
                                {
                                    data: 'description' ,
                                    className: cellClass,
                                    render: function (data, type, row, meta) {
                                        const maxLength = 50;
                                        const desc = row.description || "";
                                        const shortDesc = desc.length > maxLength
                                            ? desc.substring(0, maxLength) + "..."
                                            : desc;

                                        return `
                                            <p style="margin: 0;">
                                                <span title="${desc}">${shortDesc}</span><br/>
                                                <span style="font-size:13px;color:grey;">${row.desc2 || ""}</span>
                                            </p>
                                        `;
                                    }
                                },
                                { data: 'status', className: cellClass },
                                { 
                                    data: 'createdDate',
                                    className: cellClass,
                                    render: function (data, type, row, meta) {
                                        const date = new Date(data.split('.')[0]);
                                        if (isNaN(date)) return 'Invalid Date';

                                        return date.toLocaleString('en-GB', {
                                            year: 'numeric',
                                            month: 'numeric',
                                            day: 'numeric',
                                            hour: 'numeric',
                                            minute: 'numeric',
                                            hour: 'numeric',
                                            hour12: true
                                        });
                                    }
                                },
                                // { data: 'createdBy' },
                                // { data: 'updatedDate' },
                                // { data: 'updatedBy' },
                                {
                                    data: null,
                                    className: 'tw:px-5 tw:py-4 tw:whitespace-nowrap sm:tw:px-6',
                                    render: function (data, type, row, meta) {
                                        const rawData = JSON.stringify(row).replace(/"/g, "&quot;");
                                        return `<div class="tw:flex tw:items-center tw:gap-2">
                                            <button class="view-btn tw:inline-flex tw:items-center tw:gap-1.5 tw:rounded-lg tw:bg-taupe-200 tw:font-medium tw:text-taupe-600
                                                tw:transition-colors tw:hover:bg-taupe-300 tw:dark:bg-taupe-500/15 tw:dark:text-taupe-400 tw:dark:hover:bg-taupe-500/25" data-row='${rawData}' onclick="navigateToSimulate(${row.jobOrder_Id})">
                                                <i class="bi bi-boxes"></i>
                                                Simulate
                                            </button>
                                            <button class="view-btn tw:inline-flex tw:items-center tw:gap-1.5 tw:rounded-lg tw:bg-brand-50 tw:font-medium tw:text-brand-600
                                                tw:transition-colors tw:hover:bg-brand-100 tw:dark:bg-brand-500/15 tw:dark:text-brand-400 tw:dark:hover:bg-brand-500/25" data-row='${rawData}' onclick="navigateToView(${row.jobOrder_Id}, 'view')">
                                                <i class="bi bi-eye"></i> 
                                                View
                                            </button>
                                            <button class="edit-btn tw:inline-flex tw:items-center tw:gap-1.5 tw:rounded-lg tw:bg-amber-50 tw:font-medium tw:text-amber-600
                                                tw:transition-colors tw:hover:bg-amber-100 tw:dark:bg-amber-500/15 tw:dark:text-amber-400 tw:dark:hover:bg-amber-500/25" data-row='${rawData}' onclick="navigateToEdit(${row.jobOrder_Id}, 'edit')">
                                                <i class="bi bi-pencil-square"></i> 
                                                Edit
                                            </button>
                                            <button class="delete-btn tw:inline-flex tw:items-center tw:gap-1.5 tw:rounded-lg tw:bg-error-50 tw:font-medium tw:text-error-600
                                                tw:transition-colors tw:hover:bg-error-100 tw:dark:bg-error-500/15 tw:dark:text-error-400 tw:dark:hover:bg-error-500/25" data-id="${row.jobOrder_Id}">
                                                <i class="bi bi-trash"></i> 
                                                Delete
                                            </button>
                                        </div>`;
                                    }
                                },
                            ],
                            language: {
                                searchPlaceholder: "🔍︎ Search",
                                search: ""
                            }
                        });

                    }
                    else {
                        Swal.fire({
                            icon: 'error',
                            title: "Wait",
                            text: result.errMessage
                        });
                    }
                },
                error: function (error) {
                    Swal.fire({
                        icon: 'error',
                        title: "Wait",
                        text: error.val
                    });
                }
             });
        }

        function navigateToNew(mode) {
            window.location.href = '@Url.Action("JODetails", "JO", new { id = "_id_", mode = "_mode_" })'.replace('_id_', 0).replace('_mode_', mode);
        }

        function navigateToView(id, mode) {
            window.location.href = '@Url.Action("JODetails", "JO", new { id = "_id_", mode = "_mode_" })'.replace('_id_', id).replace('_mode_', mode);
        }

        function navigateToEdit(id, mode) {
            window.location.href = '@Url.Action("JODetails", "JO", new { id = "_id_", mode = "_mode_" })'.replace('_id_', id).replace('_mode_', mode);
        }
        
        function navigateToSimulate(id) {
            var baseUrl = '@Url.Action("JOSimulate", "JO")';

            // Append your dynamic query parameters
            var finalUrl = baseUrl + '?id=' + id;

            // Open the compiled link in a new tab
            window.open(finalUrl, '_blank');
        }

        $('#listTable').on('click', '.delete-btn', function () {
            const id = $(this).attr('data-id');
            deleteJob(id);
        });

        function deleteJob(id) {
            Swal.fire({
                title: "Are you sure want to delete?",
                text: "You won't be able to recover this record!",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonText: 'Yes',
                cancelButtonText: 'Cancel',
                allowOutsideClick: false,
            }).then(function(r) {
                if (r.isConfirmed == true) {
                    var data = {
                        JobOrder_Id: id,
                    };
                    $.ajax({
                        url: '/JO/DeleteJob',
                        type: 'DELETE',
                        data: JSON.stringify(data),
                        dataType: 'json',
                        contentType: 'application/json; charset=utf-8',
                        beforeSend: function () {
                            Swal.fire({
                                text: 'Please Wait',
                                width: '300px',

                                allowEscapeKey: false,
                                allowOutsideClick: false,
                                showConfirmButton: false,
                            });
                            Swal.showLoading();
                        },
                        success: function (result) {
                            if (result.success == true) {
                                Swal.fire({
                                    icon: 'success',
                                    title: "Success Deleted",
                                    text: "",
                                    didClose: () => {
                                      window.location.reload();
                                    }
                                });
                            }
                            else {
                                Swal.fire({
                                    icon: 'error',
                                    title: "Wait",
                                    text: result.errMessage
                                });
                            }
                        },
                        error: function (error) {
                            Swal.fire({
                                icon: 'error',
                                title: "Wait",
                                text: error.val
                            });
                        }
                    });

                } else {
                    return;
                }
              });
        }
    </script>
