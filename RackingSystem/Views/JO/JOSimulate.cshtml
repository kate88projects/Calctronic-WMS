@{
    ViewData["Title"] = "JO Simulate";
    string labelClass = "tw:mb-2 tw:block tw:text-sm tw:font-medium tw:text-gray-700 tw:dark:text-gray-300";
    string smallBtn = "tw:inline-flex tw:items-center tw:gap-1.5 tw:rounded-lg tw:border-0 tw:px-3 tw:py-1.5 tw:text-sm tw:font-medium tw:transition-colors";
}

<div class="tw:space-y-4">
    <h2 class="tw:mb-0 tw:ml-2 tw:text-lg tw:font-semibold tw:text-gray-800 tw:dark:text-white/90">JO Simulate - Raw Material Stock Check</h2>

    <!-- Status -->
    <div class="tw:grid tw:grid-cols-6 tw:gap-4 tw:mt-3">
        @{
            const string plain = "tw:text-gray-800 tw:dark:text-white/90";
            var statusCards = new[]
            {
                new { Key = "all-details", Label = "Total Details", ValueId = "txtTtlDtl", Color = plain },
                new { Key = "all-raw", Label = "Total Raw Materials", ValueId = "txtTtlRaw", Color = plain },
                new { Key = "details-can", Label = "Details Can Fulfill", ValueId = "txtTtlCanDtl", Color = "tw:text-success-500" },
                new { Key = "details-cannot", Label = "Details Cannot Fulfill", ValueId = "txtTtlCannotDtl", Color = "tw:text-error-500" },
                new { Key = "raw-can", Label = "Raw Materials Can Fulfill", ValueId = "txtTtlCanRaw", Color = "tw:text-success-500" },
                new { Key = "raw-cannot", Label = "Raw Materials Cannot Fulfill", ValueId = "txtTtlCannotRaw", Color = "tw:text-error-500" },
            };
        }
        @foreach (var card in statusCards)
        {
            <div class="status-card tw:cursor-pointer tw:rounded-xl tw:border tw:border-gray-200 tw:bg-white tw:p-4 tw:text-center tw:transition tw:hover:-translate-y-0.5 tw:hover:shadow-theme-md tw:dark:border-gray-800 tw:dark:bg-white/[0.03]"
                 id="card_@(card.Key)" onclick="showTab2('@card.Key')">
                <h3 class="tw:mb-1.5 tw:text-theme-xs tw:text-gray-500 tw:dark:text-gray-400">@card.Label</h3>
                <div class="tw:text-xl tw:font-semibold @card.Color" id="@card.ValueId">-</div>
            </div>
        }
    </div>

    <!-- Action Buttons -->
    <div id="actionButtons" class="tw:flex tw:flex-wrap tw:items-center tw:gap-2" style="display: none;">
        <button type="button" class="tw:inline-flex tw:items-center tw:gap-2 tw:rounded-lg tw:border-0 tw:bg-success-500 tw:px-4 tw:py-2.5 tw:text-sm tw:font-medium tw:text-white tw:transition-colors tw:hover:bg-success-600" onclick="openGenerateModal()">
            <i class="bi bi-play-circle"></i> Generate Report
        </button>
        <button type="button" class="tw:inline-flex tw:items-center tw:gap-2 tw:rounded-lg tw:border tw:border-gray-300 tw:bg-transparent tw:px-4 tw:py-2.5 tw:text-sm tw:font-medium tw:text-gray-700 tw:transition-colors tw:hover:bg-gray-100 tw:dark:border-gray-700 tw:dark:text-gray-400 tw:dark:hover:bg-white/5" onclick="showAppliedFilters()">
            <i class="bi bi-funnel"></i> Applied Filters
        </button>
        @* <button type="button" class="btn btn-warning" onclick="toggleShortOnly()">
            <i class="bi bi-funnel"></i> <span id="shortOnlyBtnText">Show Short Only</span>
        </button> *@
        <button type="button" class="tw:inline-flex tw:items-center tw:gap-2 tw:rounded-lg tw:border-0 tw:bg-indigo-500 tw:px-4 tw:py-2.5 tw:text-sm tw:font-medium tw:text-white tw:transition-colors tw:hover:bg-indigo-600" onclick="exportToExcel()">
            <i class="bi bi-file-earmark-excel"></i> Export to Excel
        </button>
    </div>

    <div id="loading" class="tw:flex tw:flex-col tw:items-center tw:gap-3 tw:py-8 tw:text-sm tw:text-gray-500 tw:dark:text-gray-400">
        <div class="tw:h-8 tw:w-8 tw:animate-spin tw:rounded-full tw:border-2 tw:border-gray-200 tw:border-t-brand-500" role="status">
            <span class="tw:sr-only">Loading...</span>
        </div>
        <p class="tw:mb-0">Checking raw material stock availability...</p>
    </div>

    <!-- Results Tabs -->
    <div id="resultsTabs" x-data="{ tab: 'all' }" class="tw:rounded-xl tw:border tw:border-gray-200 tw:bg-white tw:dark:border-gray-800 tw:dark:bg-white/[0.03]">
        <div class="tw:flex tw:gap-1 tw:border-b tw:border-gray-200 tw:p-2 tw:dark:border-gray-800" role="tablist">
            <button type="button" id="allDetailsView-tab" role="tab" aria-controls="allDetailsView" :aria-selected="tab === 'all'" @@click="tab = 'all'"
                class="tw:inline-flex tw:items-center tw:gap-2 tw:rounded-lg tw:border-0 tw:px-4 tw:py-2 tw:text-sm tw:font-medium tw:transition-colors"
                :class="tab === 'all' ? 'tw:bg-brand-50 tw:text-brand-600 tw:dark:bg-brand-500/15 tw:dark:text-brand-400' : 'tw:bg-transparent tw:text-gray-500 tw:hover:bg-gray-100 tw:dark:text-gray-400 tw:dark:hover:bg-white/5'">
                <i class="bi bi-list-ul"></i> All Details
            </button>
            <button type="button" id="detailsView-tab" role="tab" aria-controls="detailsView" :aria-selected="tab === 'filtered'" @@click="tab = 'filtered'"
                class="tw:inline-flex tw:items-center tw:gap-2 tw:rounded-lg tw:border-0 tw:px-4 tw:py-2 tw:text-sm tw:font-medium tw:transition-colors"
                :class="tab === 'filtered' ? 'tw:bg-brand-50 tw:text-brand-600 tw:dark:bg-brand-500/15 tw:dark:text-brand-400' : 'tw:bg-transparent tw:text-gray-500 tw:hover:bg-gray-100 tw:dark:text-gray-400 tw:dark:hover:bg-white/5'">
                <i class="bi bi-funnel"></i> <span id="tab2Label">Filtered View</span>
            </button>
        </div>

        <div class="tw:p-4">
            <!-- Tab 1 :: always shows every detail with its raw materials -->
            <div x-show="tab === 'all'" id="allDetailsView" role="tabpanel" aria-labelledby="allDetailsView-tab">
                <div class="tw:mb-3 tw:flex tw:gap-2">
                    <button type="button" class="@smallBtn tw:bg-amber-50 tw:text-amber-600 tw:hover:bg-amber-100 tw:dark:bg-amber-500/15 tw:dark:text-amber-400 tw:dark:hover:bg-amber-500/25" onclick="expandShortagesOnly('#resultsContainer')">
                        <i class="bi bi-exclamation-triangle"></i> Expand Shortages Only
                    </button>
                    <button type="button" class="@smallBtn tw:bg-gray-100 tw:text-gray-700 tw:hover:bg-gray-200 tw:dark:bg-white/5 tw:dark:text-gray-300 tw:dark:hover:bg-white/10" onclick="collapseAll('#resultsContainer')">
                        <i class="bi bi-arrow-up"></i> Collapse All
                    </button>
                </div>
                <div id="resultsContainer"></div>
            </div>

            <!-- Tab 2 :: refreshed whenever a status card above is clicked -->
            <div x-show="tab === 'filtered'" style="display: none;" id="detailsView" role="tabpanel" aria-labelledby="detailsView-tab">
                <div class="tw:mb-3 tw:flex tw:gap-2">
                    <button type="button" class="@smallBtn tw:bg-amber-50 tw:text-amber-600 tw:hover:bg-amber-100 tw:dark:bg-amber-500/15 tw:dark:text-amber-400 tw:dark:hover:bg-amber-500/25" onclick="expandAll('#resultsContainer2')">
                        <i class="bi bi-arrow-down"></i> Expand All
                    </button>
                    <button type="button" class="@smallBtn tw:bg-gray-100 tw:text-gray-700 tw:hover:bg-gray-200 tw:dark:bg-white/5 tw:dark:text-gray-300 tw:dark:hover:bg-white/10" onclick="collapseAll('#resultsContainer2')">
                        <i class="bi bi-arrow-up"></i> Collapse All
                    </button>
                </div>
                <div id="resultsContainer2"></div>
            </div>
        </div>
    </div>
</div>

<!-- Generate Report Modal -->
<div class="modal fade" id="generateModal" tabindex="-1" aria-labelledby="generateModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content tw:overflow-hidden tw:rounded-2xl tw:border-0 tw:bg-white tw:text-gray-700 tw:shadow-theme-lg tw:dark:bg-gray-900 tw:dark:text-gray-300">
            <div class="tw:flex tw:items-center tw:justify-between tw:border-b tw:border-gray-100 tw:px-6 tw:py-4 tw:dark:border-gray-800">
                <h4 class="tw:mb-0 tw:text-base tw:font-semibold tw:text-gray-800 tw:dark:text-white/90" id="generateModalLabel">Generate Stock Report</h4>
                <button type="button" class="tw:border-0 tw:bg-transparent tw:text-gray-400 tw:hover:text-gray-600 tw:dark:hover:text-gray-200" data-bs-dismiss="modal" aria-label="Close"><i class="bi bi-x-lg"></i></button>
            </div>
            <form id="generateForm" class="tw:space-y-4 tw:px-6 tw:py-4">
                @{
                    var radioGroups = new[]
                    {
                        new { Id = "queue", Name = "includeQueue", Label = "Include Job Orders in Queue:" },
                        new { Id = "emergency", Name = "includeEmergency", Label = "Include Emergency Jobs in Queue:" },
                        new { Id = "loader", Name = "includeLoader", Label = "Include AutoLoader Incoming Reel:" },
                    };
                }
                @foreach (var g in radioGroups)
                {
                    <div>
                        <span class="@labelClass">@g.Label</span>
                        <div class="tw:space-y-2">
                            <label class="tw:flex tw:cursor-pointer tw:items-center tw:gap-2 tw:text-sm tw:text-gray-700 tw:dark:text-gray-300" for="@(g.Id)Yes">
                                <input class="tw:h-4 tw:w-4 tw:accent-brand-500" type="radio" name="@g.Name" id="@(g.Id)Yes" value="true" checked> Yes
                            </label>
                            <label class="tw:flex tw:cursor-pointer tw:items-center tw:gap-2 tw:text-sm tw:text-gray-700 tw:dark:text-gray-300" for="@(g.Id)No">
                                <input class="tw:h-4 tw:w-4 tw:accent-brand-500" type="radio" name="@g.Name" id="@(g.Id)No" value="false"> No
                            </label>
                        </div>
                    </div>
                }
            </form>
            <div class="tw:flex tw:justify-end tw:gap-3 tw:border-t tw:border-gray-100 tw:px-6 tw:py-3 tw:dark:border-gray-800">
                <button type="button" class="save-btn tw:border-0 tw:rounded-lg tw:bg-brand-500 tw:py-2.5 tw:text-sm tw:font-medium tw:text-white tw:shadow-theme-xs tw:hover:bg-brand-600" onclick="confirmGenerateReport()">Generate</button>
                <button type="button" class="cancel-btn tw:bg-transparent tw:rounded-lg tw:border tw:border-gray-300 tw:px-4 tw:py-2.5 tw:text-sm tw:font-medium tw:text-gray-700 tw:hover:bg-gray-100
                    tw:dark:border-gray-700 tw:dark:text-gray-400 tw:dark:hover:bg-white/5" data-bs-dismiss="modal">Cancel</button>
            </div>
        </div>
    </div>
</div>

<!-- Applied Filters Modal :: shows the filter options used for the currently displayed report -->
<div class="modal fade" id="appliedFiltersModal" tabindex="-1" aria-labelledby="appliedFiltersModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content tw:overflow-hidden tw:rounded-2xl tw:border-0 tw:bg-white tw:text-gray-700 tw:shadow-theme-lg tw:dark:bg-gray-900 tw:dark:text-gray-300">
            <div class="tw:flex tw:items-center tw:justify-between tw:border-b tw:border-gray-100 tw:px-6 tw:py-4 tw:dark:border-gray-800">
                <h4 class="tw:mb-0 tw:text-base tw:font-semibold tw:text-gray-800 tw:dark:text-white/90" id="appliedFiltersModalLabel">Applied Filters</h4>
                <button type="button" class="tw:border-0 tw:bg-white tw:text-gray-400 tw:hover:text-gray-600 tw:dark:bg-gray-900 tw:dark:hover:text-gray-200" data-bs-dismiss="modal" aria-label="Close"><i class="bi bi-x-lg"></i></button>
            </div>
            <div class="tw:px-6 tw:py-4">
                <ul class="tw:m-0 tw:list-none tw:space-y-3 tw:p-0" id="appliedFiltersList"></ul>
            </div>
            <div class="tw:flex tw:justify-end tw:gap-3 tw:border-t tw:border-gray-100 tw:px-6 tw:py-3 tw:dark:border-gray-800">
                <button type="button" class="cancel-btn tw:bg-transparent tw:rounded-lg tw:border tw:border-gray-300 tw:px-4 tw:py-2.5 tw:text-sm tw:font-medium tw:text-gray-700 tw:hover:bg-gray-100
                    tw:dark:border-gray-700 tw:dark:text-gray-400 tw:dark:hover:bg-white/5" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

@section Scripts 
{
	<script src="~/js/xlsx.full.min.js"></script>
	<script src="~/js/exceljs.min.js"></script>

	<script>
		const jobOrderId = @ViewBag.id;

		function getJobOrderIdFromUrl() {
			const urlParams = new URLSearchParams(window.location.search);
			return urlParams.get('id');
		}

		$(document).ready(function () {
			if (jobOrderId) {
				loadRawMaterialStock();
			} else {
				$('#resultsContainer').html(errorAlertHtml('Job Order ID not found'));
				$('#loading').hide();
			}
		});

		// Store filter options for recalculation
		let generateOptions = {
			includeQueue: true,
			includeEmergency: true,
			includeLoader: true
		};

		function openGenerateModal() {
			// Set current values in modal
			document.getElementById('queueYes').checked = generateOptions.includeQueue;
			document.getElementById('queueNo').checked = !generateOptions.includeQueue;
			document.getElementById('emergencyYes').checked = generateOptions.includeEmergency;
			document.getElementById('emergencyNo').checked = !generateOptions.includeEmergency;
			document.getElementById('loaderYes').checked = generateOptions.includeLoader;
			document.getElementById('loaderNo').checked = !generateOptions.includeLoader;

			// Show modal
			const modal = new bootstrap.Modal(document.getElementById('generateModal'));
			modal.show();
		}

		function confirmGenerateReport() {
			// Get selected values from form
			generateOptions.includeQueue = document.querySelector('input[name="includeQueue"]:checked').value === 'true';
			generateOptions.includeEmergency = document.querySelector('input[name="includeEmergency"]:checked').value === 'true';
			generateOptions.includeLoader = document.querySelector('input[name="includeLoader"]:checked').value === 'true';

			// Hide modal
			const modal = bootstrap.Modal.getInstance(document.getElementById('generateModal'));
			modal.hide();

			// Show loading and recalculate
			$('#loading').show();
			$('#resultsContainer').html('');
			loadRawMaterialStockWithFilters();
		}

		// Shows the filter options that were used to generate the report currently on screen.
		function showAppliedFilters() {
			const rows = [
				{ label: 'Include Job Orders in Queue', value: generateOptions.includeQueue },
				{ label: 'Include Emergency Jobs in Queue', value: generateOptions.includeEmergency },
				{ label: 'Include AutoLoader Incoming Reel', value: generateOptions.includeLoader }
			];

			let html = '';
			rows.forEach(row => {
					const badgeClass = row.value ? BADGE_OK : BADGE_SHORT;
					const badgeText = row.value ? 'Yes' : 'No';
					html += `<li class="tw:flex tw:items-center tw:justify-between tw:text-sm tw:text-gray-700 tw:dark:text-gray-300">
								<span>${row.label}</span>
								<span class="${badgeClass}">${badgeText}</span>
							</li>`;
				});

				document.getElementById('appliedFiltersList').innerHTML = html;

			const modal = new bootstrap.Modal(document.getElementById('appliedFiltersModal'));
			modal.show();
		}

		function loadRawMaterialStockWithFilters() {
			$.ajax({
				url: '@Url.Action("CheckJOStock", "JO")',
				type: 'GET',
				data: {
					jobOrderId: jobOrderId,
					includeQueue: generateOptions.includeQueue,
					includeEmergency: generateOptions.includeEmergency,
					includeLoader: generateOptions.includeLoader
				},
				success: function (response) {
					if (response.success) {
						displayRawMaterialResults(response.data);
					} else {
						$('#resultsContainer').html(errorAlertHtml(`Error: ${response.errMessage}`));
					}
					$('#loading').hide();
					collapseAll('#resultsContainer');
					collapseAll('#resultsContainer2');
				},
				error: function (xhr, status, error) {
					$('#resultsContainer').html(errorAlertHtml(`Error loading data: ${error}`));
					$('#loading').hide();
				}
			});
		}

		function loadRawMaterialStock() {
			// Initial load with default options
			loadRawMaterialStockWithFilters();
		}

		// Data from the last successful load, kept around so tab 2 can be
		// re-filtered locally whenever a status card is clicked.
		let lastResultsData = [];
		let currentTab2Filter = 'all-details';

		const TAB2_LABELS = {
			'all-details': 'Total Details',
			'all-raw': 'Total Raw Materials',
			'details-can': 'Details Can Fulfill',
			'details-cannot': 'Details Cannot Fulfill',
			'raw-can': 'Raw Materials Can Fulfill',
			'raw-cannot': 'Raw Materials Cannot Fulfill'
		};

		// Tailwind class strings shared by the generated markup.
		const BADGE_OK = 'tw:status-badge tw:bg-success-50 tw:text-success-700 tw:dark:bg-success-500/15 tw:dark:text-success-500';
		const BADGE_SHORT = 'tw:status-badge tw:bg-error-50 tw:text-error-700 tw:dark:bg-error-500/15 tw:dark:text-error-500';
		const CARD_IDLE = 'tw:border-gray-200 tw:dark:border-gray-800';
		const CARD_ACTIVE = 'tw:border-brand-500 tw:ring-3 tw:ring-brand-500/20';

		function errorAlertHtml(message) {
			return `<div class="tw:rounded-lg tw:border tw:border-error-100 tw:bg-error-50 tw:px-4 tw:py-3 tw:text-sm tw:text-error-700 tw:dark:border-error-500/30 tw:dark:bg-error-500/15 tw:dark:text-error-500">${escapeHtml(message)}</div>`;
		}

		// Highlights the status card whose filter is showing in tab 2.
		function setActiveCard(filterKey) {
			$('.status-card').removeClass(CARD_ACTIVE).addClass(CARD_IDLE);
			$(`#card_${filterKey}`).removeClass(CARD_IDLE).addClass(CARD_ACTIVE);
		}

		// Builds the same nested (detail -> raw materials) table markup used by both tabs.
		// idPrefix keeps each tab's group-row/toggle ids unique so they don't clash.
		// (group-row, raw-material-group, raw-material-row, shortage and toggle-icon are hooks
		// used by the expand/collapse/export code below, so keep them on the elements.)
		function buildNestedTableHtml(data, idPrefix) {
			if (!data || data.length === 0) {
				return `
					<div class="tw:py-10 tw:text-center tw:text-gray-500 tw:dark:text-gray-400">
						<i class="bi bi-inbox tw:mb-3 tw:block tw:text-5xl tw:opacity-50"></i>
						<h5 class="tw:mb-1 tw:text-base tw:font-semibold tw:text-gray-700 tw:dark:text-gray-300">No Details Found</h5>
						<p class="tw:mb-0 tw:text-sm">No matching job order details.</p>
					</div>
				`;
			}

			const th = 'tw:px-4 tw:py-3 tw:text-left tw:text-sm tw:font-semibold tw:text-gray-700 tw:dark:text-gray-300';
			const thRight = th.replace('tw:text-left', 'tw:text-right');
			const innerTh = 'tw:px-3 tw:py-2 tw:text-xs tw:font-semibold tw:uppercase tw:tracking-wide tw:text-gray-600 tw:dark:text-gray-400';

			let html = '<div class="tw:overflow-x-auto tw:rounded-lg tw:border tw:border-gray-200 tw:dark:border-gray-800">';
			html += '<table class="results-table tw:w-full tw:border-collapse tw:text-sm">';
			html += `<thead><tr class="tw:border-b tw:border-gray-200 tw:bg-gray-50 tw:dark:border-gray-800 tw:dark:bg-white/[0.03]">
				<th class="${th} tw:w-[5%]">Status</th>
				<th class="${th} tw:w-[20%]">Finish Good Code</th>
				<th class="${th} tw:w-[20%]">Description</th>
				<th class="${thRight} tw:w-[10%] qty-cell">Qty Required</th>
				<th class="${th} tw:w-[45%]">Raw Materials</th>
			</tr></thead><tbody>`;

			data.forEach(function (detail, index) {
				const isFulfillable = detail.isFulfillable;
				const statusBadgeClass = isFulfillable ? BADGE_OK : BADGE_SHORT;
				const statusText = isFulfillable ? 'OK' : 'SHORT'; // ✓ ✗
				const groupRowId = idPrefix + index;

				// Main row for finish good
				html += `
					<tr class="group-row tw:group tw:cursor-pointer tw:border-b tw:border-gray-100 tw:bg-gray-50 tw:font-semibold tw:hover:bg-gray-100 tw:dark:border-gray-800 tw:dark:bg-white/[0.03] tw:dark:hover:bg-white/5" onclick="toggleDetails('${groupRowId}')">
						<td class="tw:px-4 tw:py-3"><span class="${statusBadgeClass}">${statusText}</span></td>
						<td class="tw:px-4 tw:py-3 tw:text-gray-800 tw:dark:text-white/90"><strong>${escapeHtml(detail.finishGoodItemCode)}</strong></td>
						<td class="tw:px-4 tw:py-3 tw:text-gray-700 tw:dark:text-gray-300">${escapeHtml(detail.finishGoodItemDescription)}</td>
						<td class="qty-cell tw:px-4 tw:py-3 tw:text-right tw:font-mono tw:text-gray-700 tw:dark:text-gray-300">${detail.finishGoodQty}</td>
						<td class="tw:px-4 tw:py-3 tw:text-gray-700 tw:dark:text-gray-300">
							<span class="toggle-icon tw:mr-2 tw:inline-block tw:transition-transform tw:duration-300 tw:group-[.collapsed]:-rotate-90">▼</span>
							<span id="count_${groupRowId}">${detail.rawMaterials ? detail.rawMaterials.length : 0} items</span>
						</td>
					</tr>
				`;

				// Raw material rows (grouped)
				if (detail.rawMaterials && detail.rawMaterials.length > 0) {
					html += `<tr class="raw-material-group" id="${groupRowId}" style="display: table-row;">`;
					html += '<td colspan="5" class="tw:p-0">';
					html += '<table class="raw-material-table tw:w-full tw:border-collapse">';
					html += `<thead class="tw:bg-amber-50 tw:dark:bg-amber-500/10"><tr>
						<th class="${innerTh} tw:w-[18%]">Item Code</th>
						<th class="${innerTh} tw:w-[27%]">Description</th>
						<th class="${innerTh} tw:w-[12%] tw:text-center qty-cell">Required</th>
						<th class="${innerTh} tw:w-[12%] tw:text-center qty-cell">Available</th>
						<th class="${innerTh} tw:w-[19%] tw:text-center">Reel Codes</th>
						<th class="${innerTh} tw:w-[12%] tw:text-center">Status</th>
					</tr></thead>`;
					html += '<tbody>';

					detail.rawMaterials.forEach(function (material) {
						const statusClass = material.hasSufficientStock ? BADGE_OK : BADGE_SHORT;
						const statusText = material.hasSufficientStock ? 'OK' : 'SHORT';
						const rowClass = material.hasSufficientStock
							? 'raw-material-row tw:border-b tw:border-gray-100 tw:dark:border-gray-800'
							: 'raw-material-row shortage tw:border-b tw:border-gray-100 tw:bg-error-50 tw:dark:border-gray-800 tw:dark:bg-error-500/10';

						// Display reel codes - show them or "No Reels" if none allocated
						const reelCodesDisplay = material.allocatedReelCodes && material.allocatedReelCodes.trim() !== ''
							? `<small>${escapeHtml(material.allocatedReelCodes)}</small>`
							: '<small class="tw:text-gray-400 tw:dark:text-white/30">No Reels</small>';

						html += `
							<tr class="${rowClass}">
								<td class="tw:px-3 tw:py-2.5 tw:text-gray-800 tw:dark:text-white/90"><strong>${escapeHtml(material.rawMaterialItemCode)}</strong></td>
								<td class="tw:px-3 tw:py-2.5 tw:text-gray-700 tw:dark:text-gray-300">${escapeHtml(material.rawMaterialItemDescription)}</td>
								<td class="qty-cell tw:px-3 tw:py-2.5 tw:text-center tw:font-mono tw:text-gray-700 tw:dark:text-gray-300">${material.requiredQty}</td>
								<td class="qty-cell tw:px-3 tw:py-2.5 tw:text-center tw:font-mono tw:text-gray-700 tw:dark:text-gray-300">${material.availableQty}</td>
								<td class="tw:px-3 tw:py-2.5 tw:text-center tw:text-gray-700 tw:dark:text-gray-300">${reelCodesDisplay}</td>
								<td class="tw:px-3 tw:py-2.5 tw:text-center"><span class="${statusClass}">${statusText}</span></td>
							</tr>
						`;
					});

					html += '</tbody>';
					html += '</table>';
					html += '</td>';
					html += '</tr>';
				}
			});

			html += '</tbody></table></div>';
			return html;
		}

		// Narrows the loaded data down to whatever category a status card represents.
		function filterDataForTab2(data, filterKey) {
			if (!data) { return []; }

			switch (filterKey) {
				case 'details-can':
					return data.filter(d => d.isFulfillable);
				case 'details-cannot':
					return data.filter(d => !d.isFulfillable);
				case 'raw-can':
					return data
						.map(d => ({ ...d, rawMaterials: (d.rawMaterials || []).filter(rm => rm.hasSufficientStock) }))
						.filter(d => d.rawMaterials.length > 0);
				case 'raw-cannot':
					return data
						.map(d => ({ ...d, rawMaterials: (d.rawMaterials || []).filter(rm => !rm.hasSufficientStock) }))
						.filter(d => d.rawMaterials.length > 0);
				case 'all-raw':
				case 'all-details':
				default:
					return data;
			}
		}

		// Re-renders tab 2 for the given filter, without switching tabs.
		function refreshTab2(filterKey) {
			currentTab2Filter = filterKey;
			const filtered = filterDataForTab2(lastResultsData, filterKey);

			$('#tab2Label').text(TAB2_LABELS[filterKey] || 'Filtered View');
			$('#resultsContainer2').html(buildNestedTableHtml(filtered, 'group2_'));

			setActiveCard(filterKey);
		}

		// Called when a status card is clicked :: refresh tab 2 and switch to it.
		function showTab2(filterKey) {
			refreshTab2(filterKey);

			Alpine.$data(document.getElementById('resultsTabs')).tab = 'filtered';
		}

		function displayRawMaterialResults(data) {
			lastResultsData = data || [];

			$('#resultsContainer').html(buildNestedTableHtml(lastResultsData, 'group_'));

			if (!lastResultsData || lastResultsData.length === 0) {
				refreshTab2(currentTab2Filter);
				return;
			}

			// Show action buttons
			$('#actionButtons').show();

			// Update summary cards
			let fulfillableCount = 0;
			let unfulfillableCount = 0;
			lastResultsData.forEach(detail => {
				if (detail.isFulfillable) fulfillableCount++;
				else unfulfillableCount++;
			});

			$('#txtTtlDtl').text(lastResultsData.length);
			let totalRawMaterials = 0;
				lastResultsData.forEach(detail => {
					if (detail.rawMaterials) {
						totalRawMaterials += detail.rawMaterials.length;
					}
				});
				$('#txtTtlRaw').text(totalRawMaterials);
				$('#txtTtlCanDtl').text(fulfillableCount);
				$('#txtTtlCannotDtl').text(unfulfillableCount);

				// Calculate raw materials can fulfill vs cannot fulfill
				let totalRawMaterialsCanFulfill = 0;
				lastResultsData.forEach(detail => {
					if (detail.rawMaterials) {
						totalRawMaterialsCanFulfill += detail.rawMaterials.filter(rm => rm.hasSufficientStock).length;
					}
				});
				const totalRawMaterialsCannotFulfill = totalRawMaterials - totalRawMaterialsCanFulfill;

					$('#txtTtlCanRaw').text(totalRawMaterialsCanFulfill);
					$('#txtTtlCannotRaw').text(totalRawMaterialsCannotFulfill);

					// Keep tab 2 in sync with whatever category is currently active
					refreshTab2(currentTab2Filter);
				}

		function toggleDetails(groupRowId) {
			const row = $(`#${groupRowId}`);
			const icon = row.prev().find('.toggle-icon');

			if (row.is(':visible')) {
				row.hide();
				row.prev().addClass('collapsed');
			} else {
				row.show();
				row.prev().removeClass('collapsed');
			}
		}

		function expandShortagesOnly(containerSelector) {
			// Get all group rows :: scoped to the calling tab's own table
			const groupRows = $(`${containerSelector} .results-table tbody`).find('tr.group-row');

			groupRows.each(function() {
				const groupRow = $(this);
				const groupRowId = groupRow.find('.toggle-icon').parent().parent().attr('onclick').match(/'([^']+)'/)[1];
				const detailRow = $(`#${groupRowId}`);

				// Check if this detail has shortages
				const hasShortages = detailRow.find('.raw-material-row.shortage').length > 0;

				if (hasShortages) {
					// Expand this row
					detailRow.show();
					groupRow.removeClass('collapsed');
				} else {
					// Collapse this row
					detailRow.hide();
					groupRow.addClass('collapsed');
				}
			});
		}

		function collapseAll(containerSelector) {
			// Collapse all detail rows :: scoped to the calling tab's own table
			const detailRows = $(`${containerSelector} .results-table tbody`).find('tr.raw-material-group');
			detailRows.each(function() {
				$(this).hide();
				$(this).prev().addClass('collapsed');
			});
		}

		function expandAll(containerSelector) {
			// Expand all detail rows :: scoped to the calling tab's own table
			const detailRows = $(`${containerSelector} .results-table tbody`).find('tr.raw-material-group');
			detailRows.each(function() {
				$(this).show();
				$(this).prev().removeClass('collapsed');
			});
		}

		function toggleShortOnly() {
			const isShortOnly = document.body.classList.toggle('short-only-mode');
			const btnText = $('#shortOnlyBtnText');
			const nestedView = $('#resultsContainer');

			if (isShortOnly) {
				btnText.text('Show All');

				// Hide rows without shortages in nested view
				nestedView.find('tr.group-row').each(function() {
					const groupRow = $(this);
					const onclickAttr = groupRow.attr('onclick');
					const groupRowId = onclickAttr ? onclickAttr.match(/'([^']+)'/)[1] : null;

					if (groupRowId) {
						const detailRow = $(`#${groupRowId}`);
						const hasShortages = detailRow.find('tr.shortage').length > 0;

						if (!hasShortages) {
							groupRow.hide();
							detailRow.hide();
						}
					}
				});
			} else {
				btnText.text('Show Short Only');

				// Show all rows in nested view
				nestedView.find('tr.group-row, tr.raw-material-group').show();
			}
		}

		function escapeHtml(text) {
			if (!text) return '';
			const div = document.createElement('div');
			div.textContent = text;
			return div.innerHTML;
		}

		function exportToExcel() {
			// Get the current results data
			const resultsTable = document.querySelector('#resultsContainer .results-table');
			if (!resultsTable) {
				alert('No data to export');
				return;
			}

			const workbook = new ExcelJS.Workbook();
			const worksheet = workbook.addWorksheet('Raw Material Stock Check');

			// Add title and summary rows
			let rowNumber = 1;
			const titleRow = worksheet.addRow(['JO Raw Material Stock Check Report']);
			titleRow.font = { bold: true, size: 14 };
			titleRow.alignment = { horizontal: 'left', vertical: 'center' };
			worksheet.mergeCells(`A${rowNumber}:F${rowNumber}`);
			rowNumber++;

			// Add generation timestamp
			worksheet.addRow(['Generated on:', new Date().toLocaleString()]);
			rowNumber++;

			// Add summary section
			worksheet.addRow(['SUMMARY']);
			worksheet.getRow(rowNumber).font = { bold: true, size: 11, color: { argb: 'FFFFFFFF' } };
			worksheet.getRow(rowNumber).fill = { type: 'pattern', pattern: 'solid', fgColor: { argb: 'FF366092' } };
			rowNumber++;

			const summaryData = [
				['Total Job Details', document.getElementById('txtTtlDtl').textContent],
				['Details Can Fulfill', document.getElementById('txtTtlCanDtl').textContent],
				['Details Cannot Fulfill', document.getElementById('txtTtlCannotDtl').textContent],
				['Total Raw Materials', document.getElementById('txtTtlRaw').textContent],
				['Raw Materials Can Fulfill', document.getElementById('txtTtlCanRaw').textContent],
				['Raw Materials Cannot Fulfill', document.getElementById('txtTtlCannotRaw').textContent]
			];

			summaryData.forEach(row => {
				const excelRow = worksheet.addRow(row);
				excelRow.getCell(1).font = { bold: true };
				rowNumber++;
			});

			rowNumber++; // Add blank row

			// Add main data table
			const headerRow = worksheet.addRow([
				'Status',
				'Finish Good Code',
				'Description',
				'Qty Required',
				'Item Code',
				'Raw Material Description',
				'Required Qty',
				'Available Qty',
				'Reel Codes',
				'Status'
			]);

			// Style header row
			headerRow.font = { bold: true, color: { argb: 'FFFFFFFF' } };
			headerRow.fill = { type: 'pattern', pattern: 'solid', fgColor: { argb: 'FF4472C4' } };
			headerRow.alignment = { horizontal: 'center', vertical: 'center' };

			// Highlight the repeated detail columns (Status, Finish Good Code, Description, Qty Required) in a light color
			[1, 2, 3, 4].forEach(colIdx => {
				const cell = headerRow.getCell(colIdx);
				cell.fill = { type: 'pattern', pattern: 'solid', fgColor: { argb: 'FFFFE699' } };
				cell.font = { bold: true, color: { argb: 'FF7F6000' } };
			});

			rowNumber++;

			// Parse and insert data from HTML table
			let currentDetailStatus = '';
			let currentFinishGood = '';
			let currentDescription = '';
			let currentQty = '';

			const groupRows = resultsTable.querySelectorAll('tr.group-row');
			groupRows.forEach((groupRow, index) => {
				const cells = groupRow.querySelectorAll('td');
				if (cells.length >= 5) {
					currentDetailStatus = cells[0].textContent.trim();
					currentFinishGood = cells[1].textContent.trim();
					currentDescription = cells[2].textContent.trim();
					currentQty = cells[3].textContent.trim();

					// Get the raw material group row
					const rawMaterialGroupRow = groupRow.nextElementSibling;
					if (rawMaterialGroupRow && rawMaterialGroupRow.classList.contains('raw-material-group')) {
						const innerTable = rawMaterialGroupRow.querySelector('.raw-material-table');
						if (innerTable) {
							const rawMaterialRows = innerTable.querySelectorAll('tbody tr');
							rawMaterialRows.forEach((rmRow, rmIndex) => {
								const rmCells = rmRow.querySelectorAll('td');
								if (rmCells.length >= 6) {
									const excelRow = worksheet.addRow([
										currentDetailStatus,
										currentFinishGood,
										currentDescription,
										currentQty,
										rmCells[0].textContent.trim(),
										rmCells[1].textContent.trim(),
										rmCells[2].textContent.trim(),
										rmCells[3].textContent.trim(),
										rmCells[4].textContent.trim(),
										rmCells[5].textContent.trim()
									]);

									// Color code the status
									const statusText = rmCells[5].textContent.trim();
									if (statusText === 'OK') {
										excelRow.getCell(10).fill = { type: 'pattern', pattern: 'solid', fgColor: { argb: 'FFC6EFCE' } };
										excelRow.getCell(10).font = { color: { argb: 'FF006100' } };
									} else if (statusText === 'SHORT') {
										excelRow.getCell(10).fill = { type: 'pattern', pattern: 'solid', fgColor: { argb: 'FFFFCCCB' } };
										excelRow.getCell(10).font = { color: { argb: 'FF9C0006' } };
									}
								}
							});
						}
					}
				}
			});

			// Set column widths
			worksheet.columns = [
				{ width: 12 },
				{ width: 15 },
				{ width: 20 },
				{ width: 12 },
				{ width: 15 },
				{ width: 25 },
				{ width: 12 },
				{ width: 12 },
				{ width: 15 },
				{ width: 12 }
			];

			// Set all cells alignment
			worksheet.eachRow((row) => {
				row.eachCell((cell) => {
					cell.alignment = { horizontal: 'left', vertical: 'center', wrapText: true };
				});
			});

			// Generate and download
			const fileName = `JO_RawMaterialStock_${new Date().getTime()}.xlsx`;
			workbook.xlsx.writeBuffer().then(buffer => {
				const blob = new Blob([buffer], { type: 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet' });
				const url = window.URL.createObjectURL(blob);
				const a = document.createElement('a');
				a.href = url;
				a.download = fileName;
				document.body.appendChild(a);
				a.click();
				document.body.removeChild(a);
				window.URL.revokeObjectURL(url);
			}).catch(err => {
				console.error('Error exporting to Excel:', err);
					alert('Error generating Excel file');
				});
			}
	</script>
}
