<style>
    .dt-layout-row:not(.dt-layout-table) {
        display: none !important;
    }
</style>

<div x-data="{ filtersOpen: true }">
    <div class="tw:flex tw:w-full tw:items-center tw:justify-between">
        <h2 class="tw:text-lg tw:mb-0 tw:ml-2 tw:font-semibold tw:text-gray-800 tw:dark:text-white/90">Reel List</h2>
        <div class="tw:flex tw:items-center tw:gap-2">
            <button type="button" class="tw:inline-flex tw:items-center tw:justify-center tw:rounded-lg tw:border-0 tw:px-3.5 tw:py-2"
                :class="filtersOpen ? 'tw:bg-brand-50 tw:text-brand-600 tw:dark:bg-brand-500/15 tw:dark:text-brand-400' : 'tw:bg-gray-100 tw:text-gray-500 tw:hover:bg-gray-200 tw:dark:bg-white/5 tw:dark:text-gray-400 tw:dark:hover:bg-white/10'"
                @@click="filtersOpen = !filtersOpen" title="Toggle Filters">
                <i class="bi bi-funnel"></i>
            </button>
            <button type="button" class="tw:border-0 tw:inline-flex tw:items-center tw:gap-2 tw:rounded-lg tw:bg-indigo-500 tw:px-4 tw:py-2.5 tw:text-sm tw:font-medium tw:text-white tw:transition
                tw:hover:bg-indigo-600" onclick="export()">
                Export
            </button>
        </div>
    </div>

    <div class="tw:mt-3 tw:space-y-4">
        <div x-show="filtersOpen" x-transition class="tw:rounded-xl tw:border tw:border-gray-200 tw:bg-white tw:p-4 tw:dark:border-gray-800 tw:dark:bg-white/[0.03]">
            @{
                string fieldClass = @"tw:w-full tw:rounded-lg tw:border tw:border-gray-300 tw:bg-transparent tw:px-4 tw:py-2.5 tw:text-sm tw:text-gray-800 tw:placeholder:text-gray-400
                    tw:focus:border-brand-300 tw:focus:ring-3 tw:focus:ring-brand-500/10 tw:focus:outline-hidden tw:dark:border-gray-700 tw:dark:bg-gray-900 tw:dark:text-white/90
                    tw:dark:placeholder:text-white/30 tw:dark:focus:border-brand-800";
                string labelClass = "tw:mb-1.5 tw:block tw:text-sm tw:font-medium tw:text-gray-700 tw:dark:text-gray-400";
            }
            <div class="tw:grid tw:grid-cols-3 tw:items-end tw:gap-3">
                <div>
                    <label class="@labelClass" for="txtReelCode">Reel Code</label>
                    <input id="txtReelCode" name="ReelCode" type="text" class="@fieldClass" placeholder="Reel Code" />
                </div>
                <div>
                    <label class="@labelClass" for="txtItemCode">Item Code</label>
                    <input id="txtItemCode" name="ItemCode" type="text" class="@fieldClass" placeholder="Item Code" />
                </div>
                <div>
                    <label class="@labelClass" for="selDateType">Date Type</label>
                    <select id="selDateType" name="DateType" class="@fieldClass">
                        <option value="C">Created Date</option>
                        <option value="U">Updated Date</option>
                    </select>
                </div>
                <div>
                    <label class="@labelClass" for="dtpDateFrom">Date From</label>
                    <input id="dtpDateFrom" name="DateFrom" type="date" class="@fieldClass" placeholder="Date From" />
                </div>
                <div>
                    <label class="@labelClass" for="dtpDateTo">Date To</label>
                    <input id="dtpDateTo" name="DateTo" type="date" class="@fieldClass" placeholder="Date To" />
                </div>
                <div>
                    <button type="button" class="tw:inline-flex tw:w-full tw:items-center tw:justify-center tw:rounded-lg tw:border-0 tw:bg-brand-500 tw:px-4 tw:py-2.5 tw:text-sm tw:font-medium tw:text-white tw:hover:bg-brand-600" onclick="loadList(1, 0)">
                        <i class="bi bi-search"></i>
                    </button>
                </div>
            </div>
        </div>

        <div class="tw:grid tw:grid-cols-4 tw:gap-4">
            @{
                var statusCards = new[]
                {
                    new { Filter = "W", Label = "Waiting Loader", ValueId = "txtW" },
                    new { Filter = "L", Label = "In Loader", ValueId = "txtL" },
                    new { Filter = "SRMS", Label = "In SRMS", ValueId = "txtSRMS" },
                    new { Filter = "T", Label = "In Trolley", ValueId = "txtT" },
                };
            }
            @foreach (var card in statusCards)
            {
                <div class="tw:cursor-pointer tw:rounded-xl tw:border tw:border-gray-200 tw:bg-white tw:p-4 tw:text-center tw:hover:-translate-y-0.5 tw:hover:shadow-theme-md tw:dark:border-gray-800 tw:dark:bg-white/[0.03]" onclick="loadList(1, '@card.Filter')">
                    <h3 class="tw:mb-1.5 tw:text-theme-xs tw:text-gray-500 tw:dark:text-gray-400">@card.Label</h3>
                    <div class="tw:text-xl tw:font-semibold tw:text-gray-800 tw:dark:text-white/90" id="@card.ValueId">-</div>
                </div>
            }
        </div>

        <div class="dt-tailadmin tw:overflow-hidden tw:rounded-xl tw:border tw:border-gray-200 tw:bg-white tw:text-gray-700 tw:dark:border-gray-800 tw:dark:bg-white/[0.03] tw:dark:text-gray-300">
            <div class="tw:flex tw:items-center tw:gap-2 tw:px-5 tw:pt-4 tw:text-sm tw:text-gray-700 tw:dark:text-gray-400">
                @* <label for="selpageSize">Show</label> *@
                <select id="selpageSize" name="pageSize" class="tw:rounded-lg tw:border tw:border-gray-300 tw:bg-transparent tw:px-2.5 tw:py-1.5 tw:text-[13px] tw:text-gray-800 tw:focus:border-brand-300 tw:focus:ring-3 tw:focus:ring-brand-500/10 tw:focus:outline-hidden tw:dark:border-gray-700 tw:dark:bg-gray-900 tw:dark:text-white/90">
                    <option value="25">25</option>
                    <option value="50">50</option>
                    <option value="100">100</option>
                    <option value="200">250</option>
                </select>
                <span>entries per page</span>
            </div>

            <table id="listTable" class="row-border dataTable hover order-column tw:w-full">
                <thead>
                    <tr class="tw:border-b tw:border-gray-200">
                        @{
                            string[] listHeaders = { "Reel Code", "Item Code", "Qty", "Status", "Actual Height", "Created Date", "Location" };
                        }
                        @foreach (var header in listHeaders)
                        {
                            <th class="tw:px-5 tw:py-3.5 tw:text-left sm:tw:px-6"><span class="tw:text-sm tw:font-semibold tw:text-gray-700 tw:dark:text-gray-300">@header</span></th>
                        }
                    </tr>
                </thead>
            </table>
            <div class="tw:flex tw:flex-wrap tw:text-sm tw:items-center tw:justify-between tw:gap-3 tw:px-5 tw:py-4 sm:tw:px-6">
                <div class="tw:text-gray-500 tw:dark:text-gray-400">Showing <span id="lblCurCount">0</span> of <span id="lblTotal">0</span> entries</div>
                <nav aria-label="pagination" id="ulPagination" class="tw:flex tw:items-center tw:gap-1"></nav>
            </div>
        </div>

        <input type="hidden" id="txtCurPage">
        <input type="hidden" id="txtTotalRecord">
        <input type="hidden" id="txtPageSize">
        <input type="hidden" id="txtTotalPage">

    </div>
</div>

@section Scripts
{
    <link rel="stylesheet" href="~/css/sweetalert2.min.css">
    <link rel="stylesheet" href="~/css/dataTables.dataTables.css">

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="../js/dataTables.js"></script>
    <script src="~/js/sweetalert2.all.min.js"></script>

    <script type="text/javascript">

        $(document).ready(function () {
            $('#txtTotalRecord').val(0);
            $('#txtTotalPage').val(1);

            var now = new Date();

            var day = ("0" + now.getDate()).slice(-2);
            var month = ("0" + (now.getMonth() + 1)).slice(-2);

            var today = now.getFullYear()+"-"+(month)+"-"+(day) ;
            var firstDate = (now.getFullYear() - 1)+"-01-01" ;

            $('#dtpDateFrom').val(firstDate);
            $('#dtpDateTo').val(today);

            loadList(1, 0);
        });

        function prevPage() {
            var curPage = $("#txtCurPage").val();
            if (curPage == 1) {
                return;
            }
            loadList(curPage - 1, 0);
        }

        function nextPage() {
            var curPage = Number($("#txtCurPage").val());
            var ttl = Number($("#txtTotalRecord").val());
            var pageSize = Number($("#txtPageSize").val());
            var ttlPage = Number($("#txtTotalPage").val());
            // var ttlPage = ttl / pageSize;
            // if ((ttl % pageSize) > 0) {
            //     ttlPage = ttlPage + 1;
            // }
            if ((curPage + 1) > ttlPage) {
                return;
            }
            loadList(curPage + 1, 0);
        }

        function loadList(page, stIdx) {
            var statusIdx = '1,2,3,4,5,6,7,8,9';
            if (stIdx == 'W') {
                 statusIdx = '1';
            }
            if (stIdx == 'L') {
                 statusIdx = '2';
            }
            if (stIdx == 'SRMS') {
                 statusIdx = '3,6';
            }
            if (stIdx == 'T') {
                 statusIdx = '7';
            }
            $('#txtCurPage').val(page);
            $('#txtPageSize').val($("#selpageSize").val());

            var data = {
                DateType: $("#selDateType").val(),
                DateFrom: $("#dtpDateFrom").val(),
                DateTo: $("#dtpDateTo").val(),
                ItemCode: $("#txtItemCode").val(),
                ReelCode: $("#txtReelCode").val(),
                StatusIdxList: statusIdx,
                ItemDesc: "",
                ItemDesc2: "",
                Remark: "",
                page: page,
                pageSize: $("#selpageSize").val(),
            }

            $.ajax({
                url: "/Reel/GetAvailableReelList/",
                type: "POST",
                data: JSON.stringify(data),
                dataType: 'JSON',
                contentType: 'application/json; charset=utf-8',
                beforeSend: function () {
                    Swal.fire({
                        text: 'Please Wait',
                        width: '300px',
                        allowEscapeKey: false,
                        allowOutsideClick: false,
                        showConfirmButton: false,
                    });
                    Swal.showLoading()
                },
                success: function (result) {
                    // console.log(result);
                    Swal.close()
                    if (result.success == true) {

                        if (page == 1) {
                            document.getElementById('txtW').innerHTML = result.data.totalWaiting;
                            document.getElementById('txtL').innerHTML = result.data.totalInLoader;
                            document.getElementById('txtSRMS').innerHTML = result.data.totalSRMS;
                            document.getElementById('txtT').innerHTML = result.data.totalInTrolley;
                        }

                        const cellClass = 'tw:px-5 tw:py-4 tw:whitespace-nowrap sm:tw:px-6 tw:text-theme-sm tw:text-gray-700 tw:dark:text-gray-300';

                        $('#listTable').DataTable( {
                            data: result.data.reelList,
                            paging: false,
                            searching: false,
                            "info": false,
                            pageLength: $("#selpageSize").val(),
                            // lengthMenu: [50, 100, 250, 500, 1000],
                            "bDestroy": true,
                            columns: [
                                { data: 'reelCode', className: cellClass },
                                {
                                    data: null,
                                    className: cellClass,
                                    render: function (data, type, row, meta) {
                                        return `<p class="tw:m-0">${row.itemCode}<br/>
                                            <span class="tw:text-theme-xs tw:text-gray-500 tw:dark:text-gray-400">${row.itemDesc}</span></p>`;
                                    }
                                },
                                { data: 'qty', className: cellClass },
                                { data: 'status', className: cellClass },
                                { data: 'actualHeight', className: cellClass },
                                {
                                    data: 'createdDate',
                                    className: cellClass,
                                    render: function (data, type, row) {
                                        const date = new Date(data.split('.')[0]);
                                        if (isNaN(date)) return 'Invalid Date';

                                        return date.toLocaleString('en-GB', {
                                            year: 'numeric',
                                            month: 'numeric',
                                            day: 'numeric',
                                            hour: 'numeric',
                                            minute: 'numeric',
                                            hour: 'numeric',
                                            hour12: true
                                        });
                                    }
                                },
                                {
                                    data: '',
                                    className: cellClass,
                                    render: function (data, type, row) {
                                        if (row.statusIdx == 2) {
                                            return `<p class="tw:m-0">Loader : ${row.loaderCode}</p><p class="tw:m-0">Column : ${row.loaderColumn}</p>`;
                                        }
                                        else if (row.statusIdx == 3 || row.statusIdx == 6) {
                                            return `<p class="tw:m-0">SRMS Slot : ${row.srmsSlotCode}</p>`;
                                        }
                                        else if (row.statusIdx == 7) {
                                            return `<p class="tw:m-0">Trolley : ${row.trolleyCode}</p><p class="tw:m-0">Code : ${row.trolleySlotCode}</p>`;
                                        }
                                        return ``;
                                    }
                                }
                            ],
                        });

                        var pageSize = parseInt($("#selpageSize").val());
                        var startEntry = ((page - 1) * pageSize) + 1;
                        var ttlRecords = result.totalRecords === -1 ? $('#lblTotal').text() : result.totalRecords;
                        var endEntry = Math.min(page * pageSize, ttlRecords);

                        if (ttlRecords === 0 || startEntry > ttlRecords) {
                            startEntry = 0;
                            endEntry = 0;
                        }
                        $('#lblCurCount').html(`${startEntry} to ${endEntry}`);

                        if (page == 1) {
                            $('#lblTotal').html(result.totalRecords);

                            var pageSizeVal = $('#selpageSize').val();
                            var ttlPage = parseInt(result.totalRecords / pageSizeVal);
                            if ((result.totalRecords % pageSizeVal) > 0) {
                                ttlPage = ttlPage + 1;
                            }
                            $('#txtTotalRecord').val(result.totalRecords);
                            $('#txtTotalPage').val(ttlPage);
                        }

                        var ttlPage = Number($("#txtTotalPage").val());
                        const myDiv = document.getElementById('ulPagination');
                        myDiv.innerHTML = "";
                        var pageItems = buildPaginationItems(ttlPage, page, 5);

                        const pageBtnBase = 'tw:inline-flex tw:h-8 tw:min-w-8 tw:items-center tw:justify-center tw:rounded-lg tw:border tw:border-gray-200 tw:px-2.5 tw:text-sm tw:dark:border-gray-800';
                        const pageBtnCurrent = pageBtnBase + ' tw:border-0 tw:bg-[rgba(43,127,255,0.08)] tw:font-medium tw:text-brand-500';
                        const pageBtnDisabled = pageBtnBase + ' tw:border-0 tw:cursor-not-allowed tw:text-gray-300 tw:dark:text-gray-600 tw:bg-transparent';
                        const pageBtnNormal = pageBtnBase + ' tw:text-gray-700 tw:dark:text-gray-300 tw:hover:border-0 tw:hover:bg-[rgba(43,127,255,0.08)] tw:hover:text-brand-500 tw:bg-transparent';

                        myDiv.innerHTML += '<button ' + (page <= 1 ? 'disabled' : '') + ' class="' + (page <= 1 ? pageBtnDisabled : pageBtnNormal) + '" onclick="loadList(1)" role="link" type="button" aria-controls="listTable">«</button>';
                        myDiv.innerHTML += '<button ' + (page <= 1 ? 'disabled' : '') + ' class="' + (page <= 1 ? pageBtnDisabled : pageBtnNormal) + '" onclick="prevPage()" role="link" type="button" aria-controls="listTable">‹</button>';

                        pageItems.forEach(function(item) {
                            if (item === '...') {
                                myDiv.innerHTML += '<span class="tw:px-1 tw:text-gray-400">...</span>';
                            }
                            else {
                                var isC = (page == item) ? pageBtnCurrent : pageBtnNormal;
                                myDiv.innerHTML += '<button class="' + isC + '" id="btnP' + item + '" onclick="loadList(' + item + ')" role="link" type="button" aria-controls="listTable">' + item + '</button>';
                            }
                        });

                        myDiv.innerHTML += '<button ' + (page >= ttlPage ? 'disabled' : '') + ' class="' + (page >= ttlPage ? pageBtnDisabled : pageBtnNormal) + '" onclick="nextPage()" role="link" type="button" aria-controls="listTable">›</button>';
                        myDiv.innerHTML += '<button ' + (page >= ttlPage ? 'disabled' : '') + ' class="' + (page >= ttlPage ? pageBtnDisabled : pageBtnNormal) + '" onclick="loadList(' + ttlPage + ')" role="link" type="button" aria-controls="listTable">»</button>';
                    }
                    else {
                        Swal.fire({
                            icon: 'error',
                            title: "Wait",
                            text: result.errMessage
                        });
                    }
                },
                error: function (error) {
                    Swal.fire({
                        icon: 'error',
                        title: "Wait",
                        text: error.val
                    });
                }
            });
        }

        function buildPaginationItems(totalPages, currentPage, windowSize = 5) {
            const items = [];

            if (totalPages <= windowSize) {
                for (let i = 1; i <= totalPages; i++) {
                    items.push(i);
                }
                return items;
            }

            if (currentPage <= windowSize - 1) {
                for (let i = 1; i <= windowSize; i++) {
                    items.push(i);
                }
                items.push('...');
                items.push(totalPages);
            }
            else if (currentPage >= totalPages - windowSize + 2) {
                items.push(1);
                items.push('...');
                for (let i = totalPages - windowSize + 1; i <= totalPages; i++) {
                    items.push(i);
                }
            }
            else {
                items.push(1);
                items.push('...');
                items.push(currentPage - 1, currentPage, currentPage + 1);
                items.push('...');
                items.push(totalPages);
            }

            return items;
        }
    </script>
}
