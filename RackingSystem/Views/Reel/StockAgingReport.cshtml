	<script src="../js/xlsx.full.min.js"></script>
	<script src="../js/exceljs.min.js"></script>

	<script>
		// let currentPage = 1;
		// let currentPageSize = 50;
		// let lastSearchData = null;

		$(document).ready(function() {
			$('#txtTotalRecord').val(0);
			$('#txtTotalPage').val(1);
			$('#txtCurFilter').val('A');

			loadList(1, 'A');
		});

		function prevPage() {
			var curPage = $("#txtCurPage").val();
			if (curPage == 1) {
				return;
			}
			var curFilter = $("#txtCurFilter").val();
			loadList(curPage - 1, curFilter);
		}

		function nextPage() {
			var curPage = Number($("#txtCurPage").val());
			var ttl = Number($("#txtTotalRecord").val());
			var pageSize = Number($("#txtPageSize").val());
			var ttlPage = Number($("#txtTotalPage").val());
			// var ttlPage = ttl / pageSize;
			// if ((ttl % pageSize) > 0) {
			//     ttlPage = ttlPage + 1;
			// }
			if ((curPage + 1) > ttlPage) {
				return;
			}
			var curFilter = $("#txtCurFilter").val();
			loadList(curPage + 1, curFilter);
		}

		function loadList(page, curFil) {
			// Remove active class from all status cards
			$('.status-card').removeClass('active');

			// Add active class to the clicked card
			if (curFil !== 'A') {
				$('.status-card').each(function() {
					const onclick = $(this).attr('onclick');
					if (onclick.includes("'" + curFil + "'")) {
						$(this).addClass('active');
					}
				});
			}

			$('#txtCurPage').val(page);
			$('#txtCurFilter').val(curFil);
			$('#txtPageSize').val($("#selpageSize").val());

			const itemCode = $('#txtItemCode').val().trim();
			const itemDesc = $('#txtItemDesc').val().trim();
			const itemGroup = $('#txtItemGroup').val().trim();
			const toDate = $('#toDate').val();
			const ex = curFil == 'A' ? null : (curFil.includes('NEx') ? false : true); // Default to 'A' if no filter is provided
			const srms = curFil == 'A' ? null : (curFil.includes('SRMS') ? true : false); // Default to 'A' if no filter is provided

			var data = {
				itemCode: itemCode,
				itemGroup: itemGroup,
				toExpiryDate: toDate ? new Date(toDate) : null,
				filterExpired: ex,
				filterInSRMS: srms,
				pageSize: $("#selpageSize").val(),
				page: page
			};

			$.ajax({
				url: "/Reel/GetStockAgingReport/",
				type: "POST",
				data: JSON.stringify(data),
				dataType: 'JSON',
				contentType: 'application/json; charset=utf-8',
				beforeSend: function() {
					Swal.fire({
						text: 'Please Wait',
						width: '300px',
						allowEscapeKey: false,
						allowOutsideClick: false,
						showConfirmButton: false,
					});
					Swal.showLoading();
				},
				success: function(result) {
					Swal.close()
					if (result.success == true) {

						if (page == 1) {
							document.getElementById('txtNEx').innerHTML = result.data.totalNonExpired;
							document.getElementById('txtEx').innerHTML = result.data.totalExpired;
							document.getElementById('txtNExSRMS').innerHTML = result.data.totalNonExpiredInSRMS;
							document.getElementById('txtExSRMS').innerHTML = result.data.totalExpiredInSRMS;
						}

						const cellClass = 'tw:px-5 tw:py-4 tw:whitespace-nowrap sm:tw:px-6 tw:text-theme-sm tw:text-gray-700 tw:dark:text-gray-300';

						$('#listTable').DataTable({
							data: result.data.items,
							paging: false,
							searching: false,
							"info": false,
							"bDestroy": true,
							columns: [
								{ data: 'itemCode', className: cellClass  },
								{ data: 'itemDescription', className: cellClass  },
								{ data: 'itemGroupName', className: cellClass  },
								{ data: 'reelCode', className: cellClass  },
								{ data: 'slotCode', className: cellClass  },
								{
									data: null,
									className: cellClass, 
									render: function(data, type, row, meta) {
										// const expiryDate = new Date(row.expiryDate).toLocaleDateString('en-US', {
										// 	year: 'numeric',
										// 	month: '2-digit',
										// 	day: '2-digit'
										// });
										const formattedDate = new Date(row.expiryDate).toLocaleDateString('en-GB');
										return formattedDate;
									}
								},
								{
									data: null,
									className: cellClass, 
									render: function(data, type, row, meta) {
										const daysClass = row.daysExpired > 30 ? 'tw:font-bold tw:text-error-600 tw:dark:text-error-500' : 'tw:text-error-500/70';
										return '<span class="' + daysClass + '">' + row.daysExpired + ' days</span>';
									}
								},
								{ data: 'qty', className: cellClass },
								{
									data: null,
									className: 'tw:px-5 tw:py-4 tw:whitespace-nowrap sm:tw:px-6',
									render: function(data, type, row, meta) {
										return row.isReady
										? '<span class="tw:status-badge tw:bg-warning-50 tw:text-warning-700 tw:dark:bg-warning-500/15 tw:dark:text-warning-500">Ready</span>'
										: '<span class="tw:status-badge tw:bg-error-50 tw:text-error-700 tw:dark:bg-error-500/15 tw:dark:text-error-500">Not Ready</span>';
									}
								},

							],
						});

						// if is page 1 then need regenerate pagination, else just show current entry
						var curCnt = 0;
						var pageSize = parseInt($("#selpageSize").val());
						var startEntry = ((page - 1) * pageSize) + 1;
						var ttlRecords = result.data.totalRecords === -1 ? $('#lblTotal').text() : result.data.totalRecords;
						var endEntry = Math.min(page * pageSize, ttlRecords);

						if (ttlRecords === 0 || startEntry > ttlRecords) {
							startEntry = 0;
							endEntry = 0;
						}
						$('#lblCurCount').html(`${startEntry} to ${endEntry}`);

						if (page == 1) {
							$('#lblTotal').html(result.data.totalRecords);

							var pageSizeVal = $("#selpageSize").val();
							var ttlPage = parseInt(result.data.totalRecords / pageSizeVal);

							if ((result.data.totalRecords % pageSizeVal) > 0) {
								ttlPage = ttlPage + 1;
							}
							$('#txtTotalRecord').val(result.data.totalRecords);
							$('#txtTotalPage').val(ttlPage);
						}

						var ttlPage = Number($("#txtTotalPage").val());
						const myDiv = document.getElementById('ulPagination');
						myDiv.innerHTML = "";
						var pageItems = buildPaginationItems(ttlPage, page, 5);

						const pageBtnBase = 'tw:inline-flex tw:h-8 tw:min-w-8 tw:items-center tw:justify-center tw:rounded-lg tw:border tw:border-gray-200 tw:px-2.5 tw:text-sm tw:dark:border-gray-800';
						const pageBtnCurrent = pageBtnBase + ' tw:border-0 tw:bg-[rgba(43,127,255,0.08)] tw:font-medium tw:text-brand-500';
						const pageBtnDisabled = pageBtnBase + ' tw:border-0 tw:cursor-not-allowed tw:text-gray-300 tw:dark:text-gray-600 tw:bg-transparent';
						const pageBtnNormal = pageBtnBase + ' tw:text-gray-700 tw:dark:text-gray-300 tw:hover:border-0 tw:hover:bg-[rgba(43,127,255,0.08)] tw:hover:text-brand-500 tw:bg-transparent';

						myDiv.innerHTML += '<button ' + (page == 1 ? 'disabled' : '') + ' class="' + (page == 1 ? pageBtnDisabled : pageBtnNormal) + '" onclick="loadList(1, \'' + curFil + '\')" role="link" type="button" aria-controls="listTable">«</button>';
						myDiv.innerHTML += '<button ' + (page == 1 ? 'disabled' : '') + ' class="' + (page == 1 ? pageBtnDisabled : pageBtnNormal) + '" onclick="prevPage()" role="link" type="button" aria-controls="listTable">‹</button>';

						pageItems.forEach(function(item) {
							if (item === '...') {
								myDiv.innerHTML += '<span class="tw:px-1 tw:text-gray-400">...</span>';
							}
							else {
								var isC = (page == item) ? pageBtnCurrent : pageBtnNormal;
								myDiv.innerHTML += '<button class="' + isC + '" id="btnP' + item + '" onclick="loadList(' + item + ', \'' + curFil + '\')" role="link" type="button" aria-controls="listTable">' + item + '</button>';
							}
						});

						myDiv.innerHTML += '<button ' + (page == ttlPage ? 'disabled' : '') + ' class="' + (page == ttlPage ? pageBtnDisabled : pageBtnNormal) + '" onclick="nextPage()" role="link" type="button" aria-controls="listTable">›</button>';
						myDiv.innerHTML += '<button ' + (page == ttlPage ? 'disabled' : '') + ' class="' + (page == ttlPage ? pageBtnDisabled : pageBtnNormal) + '" onclick="loadList(' + ttlPage + ', \'' + curFil + '\')" role="link" type="button" aria-controls="listTable">»</button>';

					}
					else {
						Swal.fire({
							icon: 'error',
							title: "Wait",
							text: result.errMessage
						});
					}
				},
				error: function(error) {
					Swal.fire({
						icon: 'error',
						title: "Wait",
						text: error.val
					});
				}
			});
		}

		function exportToExcel() {
			const itemCode = $('#txtItemCode').val().trim();
			const itemGroup = $('#txtItemGroup').val().trim();
			const fromDate = $('#fromDate').val();
			const toDate = $('#toDate').val();

			const filterData = {
				itemCode: itemCode,
				itemGroup: itemGroup,
				fromExpiryDate: fromDate ? new Date(fromDate) : null,
				toExpiryDate: toDate ? new Date(toDate) : null,
				pageSize: 10000,
				page: 1
			};

			// Show loading indicator
			showLoadingSpinner();

			$.ajax({
				url: '@Url.Action("ExportStockAgingReport", "Reel")',
				type: 'POST',
				contentType: 'application/json',
				data: JSON.stringify(filterData),
				xhrFields: {
					responseType: 'blob'
				},
				success: function (blob) {
					hideLoadingSpinner();

					// Create download link
					const url = window.URL.createObjectURL(blob);
					const link = document.createElement('a');
					link.href = url;
					link.download = 'StockAgingReport_' + new Date().toISOString().split('T')[0] + '.xlsx';

					// Trigger download
					document.body.appendChild(link);
					link.click();
					document.body.removeChild(link);
					window.URL.revokeObjectURL(url);

					// Show success message
					Swal.fire({
						icon: 'success',
						title: 'Success',
						text: 'Report exported successfully!'
					});
				},
				error: function (xhr, status, error) {
					hideLoadingSpinner();

					try {
						const response = JSON.parse(new TextDecoder().decode(xhr.response));
						Swal.fire({
							icon: 'error',
							title: 'Export Failed',
							text: response.errMessage || 'Failed to export report'
						});
					} catch (e) {
						Swal.fire({
							icon: 'error',
							title: 'Export Failed',
							text: 'An error occurred while exporting the report'
						});
					}
				}
			});
		}

		function showLoadingSpinner() {
			$('<div id="loadingOverlay" class="tw:fixed tw:inset-0 tw:z-[9999] tw:flex tw:items-center tw:justify-center tw:bg-black/50">' +
				'<div class="tw:h-10 tw:w-10 tw:animate-spin tw:rounded-full tw:border-4 tw:border-white/30 tw:border-t-white" role="status">' +
				'<span class="tw:sr-only">Loading...</span>' +
				'</div>' +
				'</div>').appendTo('body');
		}

		function hideLoadingSpinner() {
			$('#loadingOverlay').remove();
		}

		function buildPaginationItems(totalPages, currentPage, windowSize = 5) {
			const items = [];

			if (totalPages <= windowSize) {
				for (let i = 1; i <= totalPages; i++) {
					items.push(i);
				}
				return items;
			}

			if (currentPage <= windowSize - 1) {
				for (let i = 1; i <= windowSize; i++) {
					items.push(i);
				}
				items.push('...');
				items.push(totalPages);
			}
			else if (currentPage >= totalPages - windowSize + 2) {
				items.push(1);
				items.push('...');
				for (let i = totalPages - windowSize + 1; i <= totalPages; i++) {
					items.push(i);
				}
			}
			else {
				items.push(1);
				items.push('...');
				items.push(currentPage - 1, currentPage, currentPage + 1);
				items.push('...');
				items.push(totalPages);
			}

			return items;
		}


