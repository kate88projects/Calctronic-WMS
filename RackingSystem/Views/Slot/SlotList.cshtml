<style>
    #columnMatchingLabel {
        text-align: center;
        width: 100%;
        font-weight: bold;
    }
    
    .matching-btn {
        justify-content: center;
    }

    .bi-upload {
        padding-left: 10px;
    }

</style>

@{
    string menuItemClass = "tw:block tw:rounded-lg tw:px-3 tw:py-2 tw:text-sm tw:text-gray-700 tw:no-underline tw:hover:bg-gray-100 tw:dark:text-gray-300 tw:dark:hover:bg-white/5";
}

<div class="tw:flex tw:w-full tw:items-center tw:justify-between">
    <h2 class="tw:text-lg tw:mb-0 tw:ml-2 tw:font-semibold tw:text-gray-800 tw:dark:text-white/90">Slot Module List</h2>
    <div class="tw:flex tw:items-center tw:gap-2">
        <div class="tw:relative" x-data="{ importOpen: false }" @@click.outside="importOpen = false">
            <button type="button" class="tw:rounded-lg tw:border-0 tw:bg-yellow-400 tw:px-4 tw:py-2.5 tw:text-sm tw:font-medium tw:text-white tw:hover:bg-yellow-500" @@click="importOpen = !importOpen">
                Import
                <i class="bi bi-chevron-down tw:text-xs"></i>
            </button>
            <div x-show="importOpen" x-cloak class="tw:shadow-theme-lg tw:absolute tw:left-0 tw:z-10 tw:mt-2 tw:w-64 tw:rounded-xl tw:border tw:border-gray-200 tw:bg-white tw:p-2 tw:dark:border-gray-800 tw:dark:bg-gray-900">
                <a href="#" class="@menuItemClass" id="dTemp" onclick="downloadTemp('slots')" @@click="importOpen = false">Download Slot List Template</a>
                <a href="#" class="@menuItemClass" id="dTemp" onclick="downloadTemp('pulses')" @@click="importOpen = false">Download Update Pulses Template</a>
                <a href="#" class="@menuItemClass" onclick="triggerFileInput('importSlot')" @@click="importOpen = false">Import Slot from Excel</a>
            </div>
        </div>
        <input type="file" id="fileInput" accept=".xlsx, .xls, .csv" class="tw:hidden" onchange="handleFileUpload(event)">
        <button type="button" class="tw:rounded-lg tw:border-0 tw:bg-emerald-500 tw:px-4 tw:py-2.5 tw:text-sm tw:font-medium tw:text-white tw:hover:bg-emerald-600" onclick="triggerFileInput('updatePulses')">
            Update Pulses By Excel
        </button>
        <div class="tw:relative" x-data="{ addOpen: false }" @@click.outside="addOpen = false">
            <button type="button" class="tw:rounded-lg tw:border-0 tw:bg-brand-500 tw:px-4 tw:py-2.5 tw:text-sm tw:font-medium tw:text-white tw:hover:bg-brand-600" @@click="addOpen = !addOpen">
                Add
                <i class="bi bi-chevron-down tw:text-xs"></i>
            </button>
            <div x-show="addOpen" x-cloak class="tw:shadow-theme-lg tw:absolute tw:right-0 tw:z-10 tw:mt-2 tw:w-56 tw:rounded-xl tw:border tw:border-gray-200 tw:bg-white tw:p-2 tw:dark:border-gray-800 tw:dark:bg-gray-900">
                <a href="#" class="@menuItemClass" onclick="newSlotForm()" @@click="addOpen = false">Add Single Slot</a>
                <a href="#" class="@menuItemClass" onclick="newSlotColForm()" @@click="addOpen = false">Add Range of Slots</a>
            </div>
        </div>
    </div>
</div>

<div class="tw:mt-3">
    <div class="dt-tailadmin tw:overflow-hidden tw:rounded-xl tw:border tw:border-gray-200 tw:bg-white tw:text-gray-700 tw:dark:border-gray-800 tw:dark:bg-white/[0.03] tw:dark:text-gray-300">
        <table id="listTable" class="dataTable row-border hover order-column tw:w-full">
            <thead>
                <tr class="tw:border-b tw:border-gray-200">
                    @{
                        string[] listHeaders = { "Slot Code", "Column No", "Row No", "Active State", "Is Left", "X Pulse", "Z Pulse", "QR-X Pulse", "QR-ZPulse", "Action" };
                    }
                    @foreach (var header in listHeaders)
                    {
                        <th class="tw:px-5 tw:py-3.5 tw:text-left sm:tw:px-6"><span class="tw:text-sm tw:font-semibold tw:text-gray-700 tw:dark:text-gray-300">@header</span></th>
                    }
                </tr>
            </thead>
        </table>
    </div>
</div>

<div class="modal fade" id="columnMatchingModal" data-bs-backdrop="static" data-bs-focus="false">
    <div class="modal-dialog modal-dialog-centered tw:max-w-2xl">
       <div class="modal-content tw:overflow-hidden tw:rounded-2xl tw:border-0 tw:bg-white tw:text-gray-700 tw:shadow-theme-lg tw:dark:bg-gray-900 tw:dark:text-gray-300">
        <div class="tw:flex tw:items-center tw:justify-between tw:border-b tw:border-gray-100 tw:px-6 tw:py-4 tw:dark:border-gray-800">
        <h5 class="tw:text-base tw:font-medium tw:text-gray-800 tw:dark:text-white/90 tw:mb-0" id="columnMatchingLabel">Map CSV Columns to Data Table Columns</h5>
        <button type="button" class="tw:flex tw:h-8 tw:w-8 tw:appearance-none tw:items-center tw:justify-center tw:rounded-full tw:border-0 tw:bg-gray-100 tw:text-gray-400 tw:outline-none tw:hover:bg-gray-200 tw:hover:text-gray-600 tw:dark:bg-white/5 tw:dark:text-gray-400 tw:dark:hover:bg-white/[0.07] tw:dark:hover:text-gray-300" data-bs-dismiss="modal" aria-label="Close">
            <i class="bi bi-x-lg"></i>
        </button>
      </div>
      <div class="tw:space-y-4 tw:px-8 tw:pt-6 tw:py-3" id="csvColumns">
        <div id="csvColumnContent"></div> 
        <div id="dataTableColumns"></div> 
      </div>
      <div class="tw:flex tw:justify-center tw:border-t tw:border-gray-100 tw:px-6 tw:py-3 tw:dark:border-gray-800">
          <button type="button" class="tw:inline-flex tw:items-center tw:gap-2 tw:rounded-lg tw:border-0 tw:bg-brand-500 tw:px-4 tw:py-2.5 tw:text-sm tw:font-medium tw:text-white tw:hover:bg-brand-600" onclick="processAndSubmitData()">Submit<i class="bi bi-upload"></i></button>
      </div>
      <input type="hidden" id="updateType" />
    </div>
  </div>
</div>

@{
    string inputClass = "tw:w-full tw:rounded-lg tw:border tw:border-gray-300 tw:bg-transparent tw:px-4 tw:py-2.5 tw:text-sm tw:text-gray-800 tw:placeholder:text-gray-400 tw:focus:border-brand-300 tw:focus:ring-3 tw:focus:ring-brand-500/10 tw:focus:outline-hidden tw:dark:border-gray-700 tw:dark:bg-gray-900 tw:dark:text-white/90 tw:dark:placeholder:text-white/30 tw:dark:focus:border-brand-800";
    string labelClass = "tw:mb-1.5 tw:block tw:text-sm tw:font-medium tw:text-gray-700 tw:dark:text-gray-400";
}
<div class="modal fade" id="myModal" role="dialog" data-bs-focus="false" data-bs-backdrop="static">
    <div class="modal-dialog tw:max-w-xl">

        <div class="modal-content tw:overflow-hidden tw:rounded-2xl tw:border-0 tw:bg-white tw:text-gray-700 tw:shadow-theme-lg tw:dark:bg-gray-900 tw:dark:text-gray-300">
            <div class="tw:border-b tw:border-gray-100 tw:px-6 tw:py-4 tw:dark:border-gray-800 tw:mb-0">
                <h4 class="tw:text-base tw:font-semibold tw:text-gray-800 tw:mb-0 tw:dark:text-white/90">Update Slot</h4>
            </div>
            <div class="tw:space-y-4 tw:px-6 tw:py-4">

                <div class="tw:grid tw:grid-cols-2 tw:gap-4">
                    <div>
                        <label class="@labelClass" for="txtCode">Slot Code</label>
                        <input type="text" class="@inputClass" name="SlotCode" id="txtCode" aria-describedby="Slot Code" oninput="removeErrMsg(this.id)">
                        <div id="txtCodeError" class="error-message"></div>
                    </div>
                    <div>
                        <label class="@labelClass" for="txtPriority">Priority Level <span>(for Reel In)</span></label>
                        <input type="number" class="@inputClass" name="Priority" id="txtPriority" aria-describedby="Priority Level" min="0" oninput="removeErrMsg(this.id)">
                        <div id="txtPriorityError" class="error-message"></div>
                    </div>
                </div>
                <div class="tw:grid tw:grid-cols-2 tw:gap-4">
                    <div>
                        <label class="@labelClass" for="txtColNo">Column No</label>
                        <input type="number" class="@inputClass" name="ColNo" id="txtColNo" aria-describedby="Column No" min="1" oninput="removeErrMsg(this.id)">
                        <div id="txtColNoError" class="error-message"></div>
                    </div>
                    <div>
                        <label class="@labelClass" for="txtRowNo">Row No</label>
                        <input type="number" class="@inputClass" name="RowNo" id="txtRowNo" aria-describedby="Row No" min="1" oninput="removeErrMsg(this.id)">
                        <div id="txtRowNoError" class="error-message"></div>
                    </div>
                </div>
                <div class="tw:grid tw:grid-cols-2 tw:gap-4">
                    <div>
                        <label class="@labelClass" for="txtXPulse">X Pulse</label>
                        <input type="number" class="@inputClass" name="XPulse" id="txtXPulse" aria-describedby="X Pulse" min="0" oninput="removeErrMsg(this.id)">
                        <div id="txtXPulseError" class="error-message"></div>
                    </div>
                    <div>
                        <label class="@labelClass" for="txtYPulse">Z Pulse</label>
                        <input type="number" class="@inputClass" name="YPulse" id="txtYPulse" aria-describedby="Y Pulse" min="0" oninput="removeErrMsg(this.id)">
                        <div id="txtYPulseError" class="error-message"></div>
                    </div>
                </div>
                <div class="tw:grid tw:grid-cols-2 tw:gap-4">
                    <div>
                        <label class="@labelClass" for="txtQrXPulse">QR-X Pulse</label>
                        <input type="number" class="@inputClass" name="QrXPulse" id="txtQrXPulse" aria-describedby="Qr-X Pulse" min="0" oninput="removeErrMsg(this.id)">
                        <div id="txtQrXPulseError" class="error-message"></div>
                    </div>
                    <div>
                        <label class="@labelClass" for="txtQrYPulse">QR-Z Pulse</label>
                        <input type="number" class="@inputClass" name="QrYPulse" id="txtQrYPulse" aria-describedby="Qr-Z Pulse" min="0" oninput="removeErrMsg(this.id)">
                        <div id="txtQrYPulseError" class="error-message"></div>
                    </div>
                </div>

                <div id="additional" class="tw:hidden tw:space-y-4">
                    @foreach (var pair in new[] { new[] { 1, 2 }, new[] { 3, 4 }, new[] { 5, 6 } })
                    {
                        <div class="tw:grid tw:grid-cols-2 tw:gap-4">
                            @foreach (var n in pair)
                            {
                                <div>
                                    <label class="@labelClass" for="txtAddPulse@(n)">Additional Pulse @n</label>
                                    <input type="number" class="@inputClass" name="AddPulse@(n)" id="txtAddPulse@(n)" aria-describedby="Additional Pulse @n" min="0">
                                    <div id="txtAddPulse@(n)Error" class="error-message"></div>
                                </div>
                            }
                        </div>
                    }
                </div>

                <span id="textlink" class="tw:mb-2.5 tw:block tw:cursor-pointer tw:text-right tw:text-sm tw:font-medium tw:text-brand-500 tw:hover:text-brand-600 tw:dark:text-brand-400" tabIndex="0" onclick="customPulses('myModal', true)"><i class="fas fa-plus-circle"></i> Additional Pulses</span>

                <div class="tw:flex tw:items-center tw:gap-6 tw:mb-0">
                    <div class="tw:flex tw:items-center tw:gap-2">
                        <input type="checkbox" class="tw:h-4 tw:w-4 tw:accent-brand-500" id="chkIsActive">
                        <label class="tw:text-sm tw:text-gray-700 tw:dark:text-gray-400" for="chkIsActive">Is Active</label>
                    </div>
                    <div class="tw:flex tw:items-center tw:gap-2">
                        <input type="checkbox" class="tw:h-4 tw:w-4 tw:accent-brand-500" id="chkIsLeft">
                        <label class="tw:text-sm tw:text-gray-700 tw:dark:text-gray-400" for="chkIsLeft">Is Left</label>
                    </div>
                </div>

                <input type="hidden" id="txtId">
                </div>
                <div class="tw:flex tw:justify-end tw:gap-3 tw:border-t tw:border-gray-100 tw:px-6 tw:py-3 tw:dark:border-gray-800">
                    <button type="button" class="save-btn tw:border-0 tw:rounded-lg tw:bg-brand-500 tw:px-4 tw:py-2.5 tw:text-sm tw:font-medium tw:text-white tw:shadow-theme-xs tw:hover:bg-brand-600" onclick="saveSlot()">Save</button>
                    <button type="button" class="cancel-btn tw:bg-transparent tw:rounded-lg tw:border tw:border-gray-300 tw:px-4 tw:py-2.5 tw:text-sm tw:font-medium tw:text-gray-700 tw:hover:bg-gray-100 tw:dark:border-gray-700 tw:dark:text-gray-400 tw:dark:hover:bg-white/5" onclick="cancelForm('myModal')">Cancel</button>
                </div>
        </div>
    </div>
</div>

<div class="modal fade" id="colModal" role="dialog" data-bs-focus="false" data-bs-backdrop="static">
    <div class="modal-dialog tw:max-w-3xl">
        <div class="modal-content tw:overflow-hidden tw:rounded-2xl tw:border-0 tw:bg-white tw:text-gray-700 tw:shadow-theme-lg tw:dark:bg-gray-900 tw:dark:text-gray-300">
            <div class="tw:border-b tw:border-gray-100 tw:px-6 tw:py-5 tw:dark:border-gray-800">
                <h4 class="tw:text-base tw:font-semibold tw:mb-0 tw:text-gray-800 tw:dark:text-white/90">Add A Range of Slot</h4>
            </div>
            <div class="tw:max-h-[calc(100vh-200px)] tw:space-y-4 tw:overflow-y-auto tw:p-6">
                <div class="tw:grid tw:grid-cols-2 tw:gap-4">
                    <div>
                        <label class="@labelClass" for="txtCodeFormat">Slot Code Format</label>
                        <input type="text" class="@inputClass" name="SlotCodeFormat" id="txtCodeFormat" aria-describedby="Slot Code Format" oninput="removeErrMsg(this.id)">
                        <div id="txtCodeFormatError" class="error-message"></div>
                    </div>
                    <div>
                        <label class="@labelClass" for="txtPriority">Priority Level</label>
                        <input type="number" class="@inputClass tw:disabled:opacity-50" name="Priority" id="txtPriority" aria-describedby="Priority Level" value="0" disabled>
                        <div id="txtPriorityError" class="error-message"></div>
                    </div>
                </div>
                <div class="tw:grid tw:grid-cols-2 sm:tw:grid-cols-4 tw:gap-4">
                    <div>
                        <label class="@labelClass" for="txtColFrom">Column No From</label>
                        <input type="number" class="@inputClass" name="ColNo" id="txtColFrom" aria-describedby="Slot Code" oninput="removeErrMsg(this.id)">
                        <div id="txtColFromError" class="error-message"></div>
                    </div>
                    <div>
                        <label class="@labelClass" for="txtTotalCol">Total Column</label>
                        <input type="number" class="@inputClass" name="TotalCol" id="txtTotalCol" aria-describedby="Total Col" min="1" oninput="removeErrMsg(this.id)">
                        <div id="txtTotalColError" class="error-message"></div>
                    </div>
                    <div>
                        <label class="@labelClass" for="txtRowFrom">Row No From</label>
                        <input type="number" class="@inputClass" name="RowNo" id="txtRowFrom" aria-describedby="Row No" min="1" oninput="removeErrMsg(this.id)">
                        <div id="txtRowFromError" class="error-message"></div>
                    </div>
                    <div>
                        <label class="@labelClass" for="txtTotalRow">Total Row</label>
                        <input type="number" class="@inputClass" name="TotalRow" id="txtTotalRow" aria-describedby="Total Row" min="1" oninput="removeErrMsg(this.id)">
                        <div id="txtTotalRowError" class="error-message"></div>
                    </div>
                </div>

                @{
                    var colPulsePairs = new[]
                    {
                        new { Label = "X Pulse", StartId = "txtStartXPulse", StartName = "XPulse", StartAria = "X Pulse", IncId = "txtXPulseIncrement", IncName = "XPulseIncrement", IncAria = "X Pulse Increment" },
                        new { Label = "Z Pulse", StartId = "txtStartYPulse", StartName = "YPulse", StartAria = "Z Pulse", IncId = "txtYPulseIncrement", IncName = "YPulseIncrement", IncAria = "Z Pulse Increment" },
                        new { Label = "QR-X Pulse", StartId = "txtStartQrXPulse", StartName = "QrXPulse", StartAria = "Qr-X Pulse", IncId = "txtQrXPulseIncrement", IncName = "QrXPulseIncrement", IncAria = "Qr-X Pulse Increment" },
                        new { Label = "QR-Z Pulse", StartId = "txtStartQrYPulse", StartName = "QrYPulse", StartAria = "Qr-Z Pulse", IncId = "txtQrYPulseIncrement", IncName = "QrYPulseIncrement", IncAria = "Qr-Z Pulse Increment" },
                    };
                }
                @foreach (var p in colPulsePairs)
                {
                    <div class="tw:grid tw:grid-cols-2 tw:gap-4">
                        <div>
                            <label class="@labelClass" for="@p.StartId">@p.Label</label>
                            <input type="number" class="@inputClass" name="@p.StartName" id="@p.StartId" aria-describedby="@p.StartAria" min="0" oninput="removeErrMsg(this.id)">
                            <div id="@(p.StartId)Error" class="error-message"></div>
                        </div>
                        <div>
                            <label class="@labelClass" for="@p.IncId">@p.Label Increment</label>
                            <input type="number" class="@inputClass" name="@p.IncName" id="@p.IncId" aria-describedby="@p.IncAria" min="0" oninput="removeErrMsg(this.id)">
                            <div id="@(p.IncId)Error" class="error-message"></div>
                        </div>
                    </div>
                }

                <div id="additional2" class="tw:hidden tw:space-y-4">
                    @foreach (var n in new[] { 1, 2, 3, 4, 5, 6 })
                    {
                        <div class="tw:grid tw:grid-cols-2 tw:gap-4">
                            <div>
                                <label class="@labelClass" for="txtStartAddPulse@(n)">Additional Pulse @n</label>
                                <input type="number" class="@inputClass" name="AddPulse@(n)" id="txtStartAddPulse@(n)" aria-describedby="Additional Pulse @n" min="0">
                                <div id="txtStartAddPulse@(n)Error" class="error-message"></div>
                            </div>
                            <div>
                                <label class="@labelClass" for="txtAddPulse@(n)Inc">Additional Pulse @n Increment</label>
                                <input type="number" class="@inputClass" name="AddPulse@(n)Inc" id="txtAddPulse@(n)Inc" aria-describedby="Additional Pulse @n Increment" min="0">
                                <div id="txtAddPulse@(n)IncError" class="error-message"></div>
                            </div>
                        </div>
                    }
                </div>

                <span id="textlink2" class="tw:mb-2.5 tw:block tw:cursor-pointer tw:text-right tw:text-sm tw:font-medium tw:text-brand-500 tw:hover:text-brand-600 tw:dark:text-brand-400" tabindex="0" onclick="customPulses('colModal', true)"><i class="fas fa-plus-circle"></i> Additional Pulses</span>

                <div class="tw:flex tw:items-center tw:gap-6 tw:mb-0">
                    <div class="tw:flex tw:items-center tw:gap-2">
                        <input type="checkbox" class="tw:h-4 tw:w-4 tw:accent-brand-500" id="chkIsActiveRange">
                        <label class="tw:text-sm tw:text-gray-700 tw:dark:text-gray-400" for="chkIsActiveRange">Is Active</label>
                    </div>
                    <div class="tw:flex tw:items-center tw:gap-2">
                        <input type="checkbox" class="tw:h-4 tw:w-4 tw:accent-brand-500" id="chkIsLeftRange">
                        <label class="tw:text-sm tw:text-gray-700 tw:dark:text-gray-400" for="chkIsLeftRange">Is Left</label>
                    </div>
                </div>

                <input type="hidden" id="txtId">

            </div>
            <div class="tw:flex tw:justify-end tw:gap-3 tw:border-t tw:border-gray-100 tw:px-6 tw:py-5 tw:dark:border-gray-800">
                <button type="button" class="save-btn tw:border-0 tw:rounded-lg tw:bg-brand-500 tw:px-4 tw:py-2.5 tw:text-sm tw:font-medium tw:text-white tw:shadow-theme-xs tw:hover:bg-brand-600" onclick="saveRangeOfSlot()">Save</button>
                <button type="button" class="cancel-btn tw:bg-transparent tw:rounded-lg tw:border tw:border-gray-300 tw:px-4 tw:py-2.5 tw:text-sm tw:font-medium tw:text-gray-700 tw:hover:bg-gray-100 tw:dark:border-gray-700 tw:dark:text-gray-400 tw:dark:hover:bg-white/5" onclick="cancelForm('colModal')">Cancel</button>
            </div>
            @* </form> *@
        </div>
    </div>
</div>

@section Scripts
{
    <link rel="stylesheet" href="~/css/sweetalert2.min.css">
    <link rel="stylesheet" href="~/css/dataTables.dataTables.css">

    <script src="../lib/jquery/dist/jquery.min.js"></script>
    <script src="../js/dataTables.js"></script>
    <script src="~/js/sweetalert2.all.min.js"></script>
    <script src="../js/xlsx.full.min.js"></script>
    <script src="../js/exceljs.min.js"></script>

    <script type="text/javascript">
        let uploadedFileContent = null;
        let uploadedFileExtension = null;

        function customSelect(selectId) {
            return {
                open: false,
                dropUp: false,
                options: [],
                selectedValue: '',
                selectedLabel: '',
                hasError: false,
                init() {
                    this.syncOptions();
                    const sel = document.getElementById(selectId);
                    if (!sel) return;
                    this.hasError = sel.classList.contains('is-invalid');
                    new MutationObserver(() => {
                        this.hasError = sel.classList.contains('is-invalid');
                    }).observe(sel, { attributes: true, attributeFilter: ['class'] });
                },
                toggle() {
                    this.open = !this.open;
                    if (this.open) {
                        this.syncOptions();
                        const rect = this.$el.getBoundingClientRect();
                        const spaceBelow = window.innerHeight - rect.bottom;
                        this.dropUp = spaceBelow < 240 && rect.top > spaceBelow;
                    }
                },
                syncOptions() {
                    const sel = document.getElementById(selectId);
                    if (!sel) return;
                    this.options = Array.from(sel.options).map(o => ({ value: o.value, text: o.textContent.trim() }));
                    this.selectedValue = sel.value;
                    const selectedOpt = sel.options[sel.selectedIndex];
                    this.selectedLabel = selectedOpt ? selectedOpt.textContent.trim() : '';
                },
                select(opt) {
                    const sel = document.getElementById(selectId);
                    sel.value = opt.value;
                    this.selectedValue = opt.value;
                    this.selectedLabel = opt.text;
                    this.open = false;
                    sel.dispatchEvent(new Event('change'));
                }
            };
        }

        function refreshCustomSelect(selectId) {
            const sel = document.getElementById(selectId);
            const root = sel ? sel.closest('[x-data]') : null;
            if (root && window.Alpine) {
                Alpine.$data(root).syncOptions();
            }
        }

        $(document).ready(function () {
            loadList();
        });

        function loadList() {
            $.ajax({
                url: "/Slot/GetSlotList/",
                type: "GET",
                dataType: 'JSON',
                contentType: 'application/json; charset=utf-8',
                beforeSend: function () {
                    Swal.fire({
                        text: 'Please Wait',
                        width: '300px',
                        allowEscapeKey: false,
                        allowOutsideClick: false,
                        showConfirmButton: false,
                    });
                    Swal.showLoading()
                },
                success: function (result) {
                    Swal.close()
                    if (result.success == true) {
                        // dataArry = result.data;
                        const cellClass = 'tw:px-5 tw:py-4 tw:whitespace-nowrap sm:tw:px-6 tw:text-theme-sm tw:text-gray-700 tw:dark:text-gray-300';
                        const designClass = 'tw:px-5 tw:py-4 tw:whitespace-nowrap sm:tw:px-6';
                        $('#listTable').DataTable({
                            data: result.data,
                            paging: true,
                            scrollX: true,
                            pageLength: 50,
                            lengthMenu: [50, 100, 250, 500, 1000],
                            columns: [
                                { data: 'slotCode', className: cellClass },
                                { data: 'colNo', className: cellClass },
                                { data: 'rowNo', className: cellClass },
                                {
                                    data: null,
                                    className: designClass,
                                    render: function (row) {
                                        return row.isActive
                                            ? '<span class="tw:status-badge tw:bg-success-50 tw:text-success-700 tw:dark:bg-success-500/15 tw:dark:text-success-500">Active</span>'
