<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>@ViewData["Title"] - WMS</title>

    <!-- Theme Color -->
    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content="#007bff" />  @* media="(prefers-color-scheme: light)" *@
    <meta name="theme-color" content="#1a1a1a" />  @* media="(prefers-color-scheme: dark)" *@

    <!-- Apply the saved dark-mode choice before the first paint. It used to happen only when Alpine started (loaded last,
         after jQuery/DataTables/etc.), so every page change flashed white for a moment before turning dark. -->
    <script>
        try { document.documentElement.classList.toggle('dark', JSON.parse(localStorage.getItem('darkMode') || 'false')); } catch (e) { }
    </script>

    <!-- Fonts -->
    @* <link rel="stylesheet" href="https://fonts.googleapis.com/css?family=Roboto|Varela+Round"> *@
    <link href="~/css/roboto.css" rel="stylesheet" />

    @* <script defer src="https://use.fontawesome.com/releases/v5.0.8/js/all.js" integrity="sha384-SlE991lGASHoBfWbelyBPLsUlwY1GwNDJo3jSJO04KZ33K2bwfV9YBauFfnzvynJ" crossorigin="anonymous"></script> *@
    <script src="~/js/fontawesome-all.js"></script>

    <link rel="stylesheet"
    href="~/css/overlayscrollbars.min.css"
    crossorigin="anonymous" />

    <link rel="stylesheet"
    href="~/lib/bootstrap-font/bootstrap-icons.min.css"
    crossorigin="anonymous" />

    <!-- Bootstrap CSS (modals, buttons, forms, grid + the base reset the Tailwind pages rely on) -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" asp-append-version="true" />

    <link rel="stylesheet" href="~/css/general.css" asp-append-version="true" />

    <!-- TailAdmin styling preview: isolated Tailwind v4 build, scoped to this file + LoaderList.cshtml only -->
    <link rel="stylesheet" href="~/css/tailwind-admin.css" asp-append-version="true" />

    <style type="text/css">
        html * {
        /* font-size: 1em !important; */
        /* color: #000 !important; */
            font-family: Varela Round !important;
        }

        /* Belt-and-suspenders: guarantee no bullet markers in the TailAdmin
           sidebar nav regardless of stylesheet cache/load order. */
        #app-sidebar ul,
        #app-sidebar li {
            list-style: none !important;
        }

        @@media (max-width: 1000px) {
            .card-body {
                height: auto !important;
            }
        }
    </style>
</head>

@{
    var grpMMOpen = ViewData["ActiveGroup"]?.ToString() == "grpMM";
    var grpSTOCKOpen = ViewData["ActiveGroup"]?.ToString() == "grpSTOCK";
    var grpBOMOpen = ViewData["ActiveGroup"]?.ToString() == "grpBOM";
    var grpGRNOpen = ViewData["ActiveGroup"]?.ToString() == "grpGRN";
    var grpJOOpen = ViewData["ActiveGroup"]?.ToString() == "grpJO";
    var grpQOpen = ViewData["ActiveGroup"]?.ToString() == "grpQ";
    var grpRACKINGOpen = ViewData["ActiveGroup"]?.ToString() == "grpRACKING";
    var grpSETTINGSOpen = ViewData["ActiveGroup"]?.ToString() == "grpSETTINGS";
}

