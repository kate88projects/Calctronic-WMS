                                class="tw:z-[99999] tw:flex tw:h-10 tw:w-10 tw:flex-shrink-0 tw:appearance-none tw:items-center tw:justify-center tw:rounded-lg tw:border-0 tw:border-gray-200 tw:bg-transparent tw:text-gray-500 tw:outline-none tw:xl:h-9 tw:xl:w-9 tw:xl:border tw:dark:border-gray-800 tw:dark:text-gray-400"
                                @@click.stop="sidebarToggle = !sidebarToggle">
                            <svg class="tw:hidden tw:fill-current tw:xl:block" width="16" height="12" viewBox="0 0 16 12" fill="none" xmlns="http://www.w3.org/2000/svg">
                                <path fill-rule="evenodd" clip-rule="evenodd" d="M0.583252 1C0.583252 0.585788 0.919038 0.25 1.33325 0.25H14.6666C15.0808 0.25 15.4166 0.585786 15.4166 1C15.4166 1.41421 15.0808 1.75 14.6666 1.75L1.33325 1.75C0.919038 1.75 0.583252 1.41422 0.583252 1ZM0.583252 11C0.583252 10.5858 0.919038 10.25 1.33325 10.25L14.6666 10.25C15.0808 10.25 15.4166 10.5858 15.4166 11C15.4166 11.4142 15.0808 11.75 14.6666 11.75L1.33325 11.75C0.919038 11.75 0.583252 11.4142 0.583252 11ZM1.33325 5.25C0.919038 5.25 0.583252 5.58579 0.583252 6C0.583252 6.41421 0.919038 6.75 1.33325 6.75L7.99992 6.75C8.41413 6.75 8.74992 6.41421 8.74992 6C8.74992 5.58579 8.41413 5.25 7.99992 5.25L1.33325 5.25Z" fill="" />
                            </svg>

                            <svg :class="sidebarToggle ? 'tw:hidden' : 'tw:block tw:xl:hidden'" class="tw:fill-current tw:xl:hidden" width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                                <path fill-rule="evenodd" clip-rule="evenodd" d="M3.25 6C3.25 5.58579 3.58579 5.25 4 5.25L20 5.25C20.4142 5.25 20.75 5.58579 20.75 6C20.75 6.41421 20.4142 6.75 20 6.75L4 6.75C3.58579 6.75 3.25 6.41422 3.25 6ZM3.25 18C3.25 17.5858 3.58579 17.25 4 17.25L20 17.25C20.4142 17.25 20.75 17.5858 20.75 18C20.75 18.4142 20.4142 18.75 20 18.75L4 18.75C3.58579 18.75 3.25 18.4142 3.25 18ZM4 11.25C3.58579 11.25 3.25 11.5858 3.25 12C3.25 12.4142 3.58579 12.75 4 12.75L12 12.75C12.4142 12.75 12.75 12.4142 12.75 12C12.75 11.5858 12.4142 11.25 12 11.25L4 11.25Z" fill="" />
                            </svg>

                            <!-- cross icon -->
                            <svg :class="sidebarToggle ? 'tw:block tw:xl:hidden' : 'tw:hidden'" class="tw:fill-current" width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                                <path fill-rule="evenodd" clip-rule="evenodd" d="M6.21967 7.28131C5.92678 6.98841 5.92678 6.51354 6.21967 6.22065C6.51256 5.92775 6.98744 5.92775 7.28033 6.22065L11.999 10.9393L16.7176 6.22078C17.0105 5.92789 17.4854 5.92788 17.7782 6.22078C18.0711 6.51367 18.0711 6.98855 17.7782 7.28144L13.0597 12L17.7782 16.7186C18.0711 17.0115 18.0711 17.4863 17.7782 17.7792C17.4854 18.0721 17.0105 18.0721 16.7176 17.7792L11.999 13.0607L7.28033 17.7794C6.98744 18.0722 6.51256 18.0722 6.21967 17.7794C5.92678 17.4865 5.92678 17.0116 6.21967 16.7187L10.9384 12L6.21967 7.28131Z" fill="" />
                            </svg>
                        </button>

                        <!-- Mobile-only brand (hidden at xl, since the sidebar's own
                             brand is visible there instead) -->
                        <a asp-action="Dashboard" asp-controller="Dashboard"
                           class="tw:flex tw:items-center tw:gap-2 tw:text-lg tw:font-semibold tw:text-gray-800 tw:no-underline tw:xl:hidden tw:dark:text-white">
                            <i class="bi bi-hdd-rack tw:text-xl tw:text-brand-500"></i>
                            <span>WMS</span>
                        </a>

                        <!-- Application menu toggle: collapses the right-hand cluster
                             (search/dark-mode/user) below xl, matching the real template -->
                        <button type="button"
                                class="tw:z-[99999] tw:flex tw:h-10 tw:w-10 tw:flex-shrink-0 tw:appearance-none tw:items-center tw:justify-center tw:rounded-lg tw:border-0 tw:bg-transparent tw:text-gray-700 tw:outline-none tw:hover:bg-gray-100 tw:xl:hidden tw:dark:text-gray-400 tw:dark:hover:bg-gray-800"
                                :class="menuToggle ? 'tw:bg-gray-100 tw:dark:bg-gray-800' : ''"
                                @@click.stop="menuToggle = !menuToggle">
                            <i class="bi bi-three-dots-vertical tw:text-xl"></i>
                        </button>
                    </div>

                    <!-- Right cluster: dark mode + user profile - collapsible below xl -->
                    <div :class="menuToggle ? 'tw:flex' : 'tw:hidden'"
                         class="tw:w-full tw:items-center tw:justify-between tw:gap-4 tw:px-5 tw:py-4 tw:xl:flex tw:xl:w-auto tw:xl:justify-end tw:xl:px-0 tw:xl:py-0">
                        <div class="tw:flex tw:items-center tw:gap-3">
                            <!-- Dark Mode Toggler -->
                            <button type="button"
                                    class="tw:relative tw:flex tw:h-9 tw:w-9 tw:flex-shrink-0 tw:items-center tw:justify-center tw:rounded-full tw:border tw:border-gray-200 tw:bg-white tw:text-gray-500 tw:transition-colors tw:hover:bg-gray-100 tw:hover:text-gray-700 tw:dark:border-gray-800 tw:dark:bg-gray-900 tw:dark:text-gray-400 tw:dark:hover:bg-gray-800 tw:dark:hover:text-white"
                                    @@click.prevent="darkMode = !darkMode; document.documentElement.classList.toggle('dark', darkMode); localStorage.setItem('darkMode', JSON.stringify(darkMode))">
                                <i class="bi" :class="darkMode ? 'bi-sun' : 'bi-moon-stars'"></i>
                            </button>

                            <!-- User profile -->
                            <div class="tw:relative" x-data="{ dropdownOpen: false }" @@click.outside="dropdownOpen = false">
                                <button type="button"
                                        class="tw:flex tw:appearance-none tw:items-center tw:border-0 tw:bg-transparent tw:text-gray-700 tw:outline-none tw:dark:text-gray-400"
                                        @@click.prevent="dropdownOpen = !dropdownOpen">
                                    <span class="tw:me-3 tw:flex tw:h-9 tw:w-9 tw:items-center tw:justify-center tw:rounded-full tw:bg-brand-50 tw:text-brand-500 tw:dark:bg-brand-500/15">
                                        <i class="bi bi-person-fill"></i>
                                    </span>
                                    <span class="tw:text-theme-sm tw:me-1 tw:font-medium">@(User.Identity?.Name ?? "User")</span>
                                    <i class="bi bi-chevron-down tw:text-xs tw:transition-transform" :class="dropdownOpen ? 'tw:rotate-180' : ''"></i>
                                </button>

                                <div x-show="dropdownOpen" x-cloak
                                     class="tw:shadow-theme-lg tw:absolute tw:right-0 tw:mt-3 tw:flex tw:w-56 tw:flex-col tw:rounded-2xl tw:border tw:border-gray-200 tw:bg-white tw:p-3 tw:dark:border-gray-800 tw:dark:bg-gray-900">
                                    <span class="tw:text-theme-sm tw:block tw:px-2 tw:py-1 tw:font-medium tw:text-gray-700 tw:dark:text-gray-300">@(User.Identity?.Name ?? "User")</span>
                                    <form method="post" asp-action="Logout" asp-controller="Account" class="tw:mt-2 tw:border-t tw:border-gray-100 tw:pt-2 tw:dark:border-gray-800">
                                        <button type="submit"
                                                class="tw:group tw:text-theme-sm tw:flex tw:w-full tw:appearance-none tw:items-center tw:gap-2 tw:rounded-lg tw:border-0 tw:bg-transparent tw:px-2 tw:py-2 tw:text-left tw:font-medium tw:text-gray-700 tw:outline-none tw:hover:bg-gray-100 tw:dark:text-gray-400 tw:dark:hover:bg-white/5">
                                            <i class="bi bi-box-arrow-right"></i>
                                            Sign out
                                        </button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </header>
            <!--end::Header-->

            <!--begin::Page toolbar (per-view title/actions, varies per page) -->
            @* <div class="page-header-slot tw:border-b tw:border-gray-200 tw:bg-white tw:px-4 tw:py-4 md:tw:px-6 tw:dark:border-gray-800 tw:dark:bg-gray-900">
                @RenderSection("PageHeader", required: false)
            </div> *@
            <!--end::Page toolbar-->

            <!--begin::App Main-->
            <main class="tw:flex-1">
                <div class="tw:mx-auto tw:max-w-(--breakpoint-2xl) tw:px-4 tw:pb-4 tw:pt-2 tw:md:px-6 tw:md:pb-6 tw:md:pt-3">
                    @RenderBody()
                </div>
            </main>
            <!--end::App Main-->

            <!--begin::Footer-->
            <footer class="tw:border-t tw:border-gray-200 tw:bg-white tw:px-4 tw:py-3 tw:text-xs tw:text-gray-500 tw:dark:border-gray-800 tw:dark:bg-gray-900 tw:dark:text-gray-400">
                <strong>
                    Version 1.0.2.4 Copyright &copy; 2025&nbsp;
                </strong>
            </footer>
            <!--end::Footer-->
        </div>
        <!--end::Content column-->
    </div>
    <!--end::App Wrapper-->

    <!--begin::Required Plugin(popperjs for Bootstrap 5)-->
    <script src="~/lib/popper/popper.js"></script>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js" asp-append-version="true"></script>

    <!-- TailAdmin styling preview: powers the sidebar/dark-mode interactivity above -->
    <script src="~/lib/alpinejs/alpine.min.js" defer></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
