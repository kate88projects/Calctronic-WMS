        <!--begin::Content column-->
        <div id="content-scroll-area" class="tw:relative tw:flex tw:flex-1 tw:flex-col tw:overflow-y-auto tw:overflow-x-hidden">

            <!--begin::Header (persistent - identical on every page, matches
