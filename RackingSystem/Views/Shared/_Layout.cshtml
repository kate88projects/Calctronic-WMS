                    <div class="tw:flex tw:w-full tw:items-center tw:justify-between tw:gap-2 tw:border-b tw:border-gray-200 tw:px-3 tw:py-3 sm:tw:gap-4 lg:tw:py-4 tw:xl:justify-normal tw:xl:border-b-0 tw:xl:px-0 tw:dark:border-gray-800">
                        <!-- Hamburger Toggle BTN (sidebar) -->
