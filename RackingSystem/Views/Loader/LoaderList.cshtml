
@* @section PageHeader {
    <header class="d-flex align-items-center justify-content-between w-100">
    </header>
} *@

<div class="tw:flex tw:w-full tw:items-center tw:justify-between">
    <h2 class="tw:text-lg tw:mb-0 tw:ml-2 tw:font-semibold tw:text-gray-800 tw:dark:text-white/90">Auto Loader List</h2>
    <div class="tw:flex">
        <button type="button" class="tw:border-0 tw:inline-flex tw:items-center tw:gap-2 tw:rounded-lg tw:bg-brand-500 tw:px-4 tw:py-2.5 tw:text-sm tw:font-medium tw:text-white tw:transition 
            tw:hover:bg-brand-600" onclick="newItemForm()">
            <i class="bi bi-plus-lg"></i>
            Add New Auto Loader 
        </button>
    </div>
</div>

<div class="tw:mt-3">
    <div class="dt-tailadmin tw:overflow-hidden tw:rounded-xl tw:border tw:border-gray-200 tw:bg-white tw:text-gray-700 tw:dark:border-gray-800 tw:dark:bg-white/[0.03] tw:dark:text-gray-300">
        <table id="listTable" class="row-border dataTable hover order-column tw:w-full">
            <thead>
                <tr class="tw:border-b tw:border-gray-200">
                    @{
                        string[] listHeaders = { "Auto Loader Code", "Description", "Active State", "Status", "Total Column", "Column Height", "IP Address", "Balance", "Action" };
                    }
                    @foreach (var header in listHeaders)
                    {
                        <th class="tw:px-5 tw:py-3.5 tw:text-left sm:tw:px-6"><span class="tw:text-sm tw:font-semibold tw:text-gray-700 tw:dark:text-gray-300">@header</span></th>
                    }
                </tr>
            </thead>
        </table>
    </div>
</div>

<div class="modal fade" data-bs-backdrop="static" data-bs-focus="false" id="myModal" role="dialog">
    <div class="modal-dialog">

        <div class="modal-content tw:overflow-hidden tw:rounded-2xl tw:border-0 tw:bg-white tw:text-gray-700 tw:shadow-theme-lg tw:dark:bg-gray-900 tw:dark:text-gray-300">
            <div class="tw:border-b tw:border-gray-100 tw:px-6 tw:py-4 tw:dark:border-gray-800">
                <h4 class="tw:text-base tw:font-semibold tw:text-gray-800 tw:mb-0 tw:dark:text-white/90">Update Auto Loader</h4>
            </div>
            <div class="tw:space-y-4 tw:px-6 tw:py-4">
                @{
                    var loaderFields = new[]
                    {
                        new { Id = "txtCode", Name = "LoaderCode", Label = "Loader Code (ID)", AriaDesc = "Loader Code", Type = "text", MaxLength = (int?)50 },
                        new { Id = "txtDesc", Name = "Description", Label = "Description", AriaDesc = "Description", Type = "text", MaxLength = (int?)255 },
                        new { Id = "txtTotalCol", Name = "TotalCol", Label = "Total Column", AriaDesc = "TotalCol", Type = "number", MaxLength = (int?)null },
                        new { Id = "txtColHeight", Name = "ColHeight", Label = "Column Height (mm)", AriaDesc = "ColHeight", Type = "number", MaxLength = (int?)null },
                        new { Id = "txtIPAddr", Name = "IPAddr", Label = "IP Address", AriaDesc = "IP Address", Type = "text", MaxLength = (int?)15 },
                    };
                }
                @foreach (var f in loaderFields)
                {
                    <div>
                        <label class="tw:mb-1.5 tw:block tw:text-sm tw:font-medium tw:text-gray-700 tw:dark:text-gray-400" for="@f.Id">@f.Label</label>
                        <input type="@f.Type" class="tw:w-full tw:rounded-lg tw:border tw:border-gray-300 tw:bg-transparent tw:px-4 tw:py-2.5 tw:text-sm tw:text-gray-800 tw:placeholder:text-gray-400 
                           tw:focus:border-brand-300 tw:focus:ring-3 tw:focus:ring-brand-500/10 tw:focus:outline-hidden tw:dark:border-gray-700 tw:dark:bg-gray-900 tw:dark:text-white/90 
                           tw:dark:placeholder:text-white/30 tw:dark:focus:border-brand-800" name="@f.Name" id="@f.Id" aria-describedby="@f.AriaDesc" maxlength="@f.MaxLength" oninput="@(f.Id == "txtIPAddr" ? "formatIP(this)" : "removeErrMsg(this.id)")">
                        <div id="@(f.Id)Error" class="error-message"></div>
                    </div>
                }
                <div class="tw:flex tw:items-center tw:gap-2 tw:mb-0">
                    <input type="checkbox" class="tw:h-4 tw:w-4 tw:accent-brand-500" id="chkIsActive">
                    <label class="tw:text-sm tw:text-gray-700 tw:dark:text-gray-400" for="chkIsActive">Is Active</label>
                </div>

                <input type="hidden" id="txtId">

            </div>
            <div class="tw:flex tw:justify-end tw:gap-3 tw:border-t tw:border-gray-100 tw:px-6 tw:py-3 tw:dark:border-gray-800">
                <button type="button" class="save-btn tw:border-0 tw:rounded-lg tw:bg-brand-500 tw:px-4 tw:py-2.5 tw:text-sm tw:font-medium tw:text-white tw:shadow-theme-xs 
                    tw:hover:bg-brand-600" onclick="saveItem()">Save</button>
                <button type="button" class="cancel-btn tw:bg-transparent tw:rounded-lg tw:border tw:border-gray-300 tw:px-4 tw:py-2.5 tw:text-sm tw:font-medium tw:text-gray-700 tw:hover:bg-gray-100 
                    tw:dark:border-gray-700 tw:dark:text-gray-400 tw:dark:hover:bg-white/5" onclick="cancelForm()">Cancel</button>
            </div>
            @* </form> *@
        </div>
    </div>
</div>

@section Scripts
{
    <link rel="stylesheet" href="~/css/sweetalert2.min.css">
    <link rel="stylesheet" href="~/css/dataTables.dataTables.css">

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="../js/dataTables.js"></script>
    <script src="~/js/sweetalert2.all.min.js"></script>

    <script type="text/javascript">
        $(document).ready(function () {
            loadList();
        });
        
        function loadList() {
            $.ajax({
                url: "/Loader/GetLoaderList/",
                type: "POST",
                dataType: 'JSON',
                contentType: 'application/json; charset=utf-8',
                beforeSend: function () {
                    Swal.fire({
                        text: 'Please Wait',
                        width: '300px',
                        allowEscapeKey: false,
                        allowOutsideClick: false,
                        showConfirmButton: false,
                    });
                    Swal.showLoading();
                },
                success: function (result) {
                    Swal.close();
                    if (result.success == true) {
                        const cellClass = 'tw:px-5 tw:py-4 tw:whitespace-nowrap sm:tw:px-6 tw:text-theme-sm tw:text-gray-700 tw:dark:text-gray-300';
                        $('#listTable').DataTable( {
                            data: result.data,
                            paging: true,
                            scrollX: true,
                            pagingType: 'full_numbers',
                            pageLength: 50,
                            lengthMenu: [50, 100, 250, 500, 1000],
                            columns: [
                                { data: 'loaderCode', className: cellClass },
                                { data: 'description', className: cellClass },
                                {
                                    data: null,
                                    className: 'tw:px-5 tw:py-4 tw:whitespace-nowrap sm:tw:px-6',
                                    render: function (row) {
                                        return row.isActive
                                            ? '<span class="tw:status-badge tw:bg-success-50 tw:text-success-700 tw:dark:bg-success-500/15 tw:dark:text-success-500">Active</span>'
                                            : '<span class="tw:status-badge tw:bg-gray-100 tw:text-gray-700 tw:dark:bg-white/5 tw:dark:text-gray-400">Inactive</span>';
                                    }
                                },
                                { data: 'status', className: cellClass },
                                { data: 'totalCol', className: cellClass },
                                { data: 'colHeight', className: cellClass },
                                { data: 'ipAddr', className: cellClass },
                                {
                                    data: null,
                                    className: cellClass,
                                    render: function (row) {
                                        return `<span>${row.balancePercentage} %</span>`;
                                    }
                                },
                                {
                                    data: null,
                                    className: 'tw:px-5 tw:py-4 tw:whitespace-nowrap sm:tw:px-6',
                                    render: function (data, type, row, meta) {
                                        const rowData = JSON.stringify(row) .replace(/"/g, "&quot;");
                                        return `<div class="tw:flex tw:items-center tw:gap-2">
                                            <button class="edit-btn tw:inline-flex tw:items-center tw:gap-1.5 tw:rounded-lg tw:bg-amber-50 tw:font-medium tw:text-amber-600
                                                tw:transition-colors tw:hover:bg-amber-100 tw:dark:bg-amber-500/15 tw:dark:text-amber-400 tw:dark:hover:bg-amber-500/25" data-row="${rowData}" title="Edit">
                                                <i class="bi bi-pencil-square"></i>
                                                Edit
                                            </button>
                                            <button class="delete-btn tw:inline-flex tw:items-center tw:gap-1.5 tw:rounded-lg tw:bg-error-50 tw:font-medium tw:text-error-600 
                                                tw:transition-colors tw:hover:bg-error-100 tw:dark:bg-error-500/15 tw:dark:text-error-400 tw:dark:hover:bg-error-500/25" data-id="${row.loader_Id}" data-code="${row.loaderCode}" title="Delete">
                                                <i class="bi bi-trash"></i>
                                                Delete
                                            </button>
                                            <button class="empty-btn tw:inline-flex tw:items-center tw:gap-1.5 tw:rounded-lg tw:bg-violet-50 tw:font-medium tw:text-violet-600 tw:transition-colors
                                                tw:hover:bg-violet-100 tw:dark:bg-violet-500/15 tw:dark:text-violet-400 tw:dark:hover:bg-violet-500/25" data-id="${row.loader_Id}" data-code="${row.loaderCode}" title="Empty">
                                                <i class="bi bi-eraser"></i>
                                                Empty
                                            </button>
                                        </div>`;
                                    }
                                }
                            ],
                            language: {
                                searchPlaceholder: "🔍︎ Search",
                                search: ""
                            }
                            // columnControl: ['orderStatus'] // temporarily disabled for review - default DataTables sorting/header UI
                        });
                    }
                    else {
                        Swal.fire({
                            icon: 'error',
                            title: "Wait",
                            text: result.errMessage
                        });
                    }
                },
                error: function (error) {
                    Swal.fire({
                        icon: 'error',
                        title: "Wait",
                        text: error.val
                    });
                }
            });
        }

        function newItemForm() {
            removeErrMsg([]);
            $("#txtId").val("0");
            const fields = ['#txtCode', '#txtDesc', '#txtTotalCol', '#txtColHeight', '#txtIPAddr'];
            fields.forEach(i => $(i).val(''));

            document.getElementById("chkIsActive").checked = true;
            $("#myModal").modal("show");
        }

        $('#listTable').on('click', '.edit-btn', function () {
            const row = JSON.parse($(this).attr('data-row'));
            editItemForm(row);
        });

        function editItemForm(row) {
            removeErrMsg([]);
            $("#txtId").val(row.loader_Id);
            $("#txtCode").val(row.loaderCode);
            $("#txtDesc").val(row.description);
            $("#txtTotalCol").val(row.totalCol);
            $("#txtColHeight").val(row.colHeight);
            $("#txtIPAddr").val(row.ipAddr);
            if (row.isActive == true) {
                document.getElementById("chkIsActive").checked = true;
            }
            else {
                document.getElementById("chkIsActive").checked = false;
            }
            $("#myModal").modal("show");
        }

        function cancelForm() {
            $("#myModal").modal("toggle");
            fields = ['txtCode', 'txtDesc', 'txtTotalCol', 'txtColHeight', 'txtIPAddr' ];

            removeErrMsg(fields, true);
        }

        // Show error message and highlight invalid fields
        function showError(fieldId, message) {
            document.getElementById(fieldId).classList.add('is-invalid');
            document.getElementById(fieldId + 'Error').textContent = message;
        }

        function removeErrMsg(fields, clearValue = false) {
            // fields = ['txtCode', 'txtDesc', 'txtTotalCol', 'txtColHeight', 'txtIPAddr' ];
            if (fields != null) 
            {
                if (!Array.isArray(fields)) {
                    fields = [fields];
                }

                fields.forEach(function(field) {
                    document.getElementById(field).classList.remove('is-invalid');
                    document.getElementById(field).classList.remove('is-valid');
                    document.getElementById(field + 'Error').textContent = '';
                    if (clearValue) document.getElementById(field).value = '';
                });
            }
        }

        function checkInput() {
            let isValid = true;
            var txt = document.getElementById("txtCode");
            if (txt.value.trim() == "") {
                showError(txt.id, `Please enter Auto Loader Code.`);
                isValid = false;
            }
            txt = document.getElementById("txtTotalCol");
            if (txt.value == "") {
                showError(txt.id, `Please enter Total Column.`);
                isValid = false;
            }
            txt = document.getElementById("txtColHeight");
            if (txt.value == "") {
                showError(txt.id, `Please enter Column Height.`);
                isValid = false;
            }
            txt = document.getElementById("txtIPAddr");
            if (txt.value == "") {
                showError(txt.id, `Please enter IP Address.`);
                isValid = false;
            } else if (!isValidIP(txt.value.trim())) {
                showError(txt.id, `Please enter a valid IP Address (e.g. 192.168.1.10).`);
                isValid = false;
            }
            return isValid;
        }

        function formatIP(input) {
            removeErrMsg(input.id);
            // Only digits and dots, max 15 chars (255.255.255.255).
            input.value = input.value.replace(/[^\d.]/g, '').slice(0, 15);
        }

        // IPv4: four numbers 0-255 separated by dots, no leading zeros (e.g. 192.168.1.10).
        function isValidIP(value) {
            const octet = '(25[0-5]|2[0-4]\\d|1\\d\\d|[1-9]?\\d)';
            return new RegExp(`^${octet}(\\.${octet}){3}$`).test(value);
        }

        function saveItem() {
            removeErrMsg([]);
            if (checkInput() == false) {
                return;
            }

            const chkIsAct = document.querySelector('#chkIsActive');
            var data = {
                Loader_Id: $("#txtId").val(),
                LoaderCode: $("#txtCode").val(),
                Description: $("#txtDesc").val(),
                TotalCol: $("#txtTotalCol").val(),
                ColHeight: $("#txtColHeight").val(),
                IPAddr: $("#txtIPAddr").val(),
                IsActive: chkIsAct.checked ? true : false,
            }

            $.ajax({
                url: '/Loader/SaveLoader',
                type: 'POST',
                data: JSON.stringify(data),
                dataType: 'JSON',
                contentType: 'application/json; charset=utf-8',
                beforeSend: function () {
                    Swal.fire({
                        text: 'Please Wait',
                        width: '300px',
                        allowEscapeKey: false,
                        allowOutsideClick: false,
                        showConfirmButton: false,
                    });
                    Swal.showLoading();
                },
                success: function (result) {
                    if (result.success == true) {
                        $("#myModal").modal("toggle");
                        Swal.fire({
                            icon: 'success',
                            title: "Success Update",
                            text: "",
                            didClose: () => {
                              window.location.reload();
                            }
                        });
                    }
                    else {
                        Swal.fire({
                            icon: 'error',
                            title: "Wait",
                            text: result.errMessage
                        });
                    }
                },
                error: function (error) {
                    Swal.fire({
                        icon: 'error',
                        title: "Wait",
                        text: error.val
                    });
                }
            });
        }

        $('#listTable').on('click', '.delete-btn', function () {
            const id = $(this).attr('data-id');
            const code = $(this).attr('data-code');
            deleteItem(id, code);
        });

        function deleteItem(id, code) {
            Swal.fire({
                title: "Are you sure want to delete?",
                text: "You won't be able to recover this record!",
                icon: 'warning', 
                showCancelButton: true,
                confirmButtonText: 'Yes',
                cancelButtonText: 'Cancel',
                allowOutsideClick: false
            }).then(function(r) {
                if (r.isConfirmed == true) {

                    var data = {
                        Loader_Id: id,
                        LoaderCode: code
                    }

                    $.ajax({
                        url: '/Loader/DeleteLoader',
                        type: 'DELETE',
                        data: JSON.stringify(data),
                        dataType: 'json',
                        contentType: 'application/json; charset=utf-8',
                        beforeSend: function () {
                            Swal.fire({
                                text: 'Please Wait',
                                width: '300px',
                                allowEscapeKey: false,
                                allowOutsideClick: false,
                                showConfirmButton: false,
                            });
                            Swal.showLoading();
                        },
                        success: function (result) {
                            if (result.success == true) {
                                Swal.fire({
                                    icon: 'success',
                                    title: "Success Deleted",
                                    text: "",
                                    didClose: () => {
                                      window.location.reload();
                                    }
                                });
                            }
                            else {
                                Swal.fire({
                                    icon: 'error',
                                    title: "Wait",
                                    text: result.errMessage
                                });
                            }
                        },
                        error: function (error) {
                            Swal.fire({
                                icon: 'error',
                                title: "Wait",
                                text: error.val
                            });
                        }
                    });

                } else {
                    return;
                }
            });
        }

        $('#listTable').on('click', '.empty-btn', function () {
            const id = $(this).attr('data-id');
            const code = $(this).attr('data-code');
            emptyItem(id, code);
        });

        function emptyItem(id, code) {
            Swal.fire({
                title: "Are you sure want to empty this loader data?",
                text: "You won't be able to recover this record!",
				icon: 'warning',
                showCancelButton: true,
                confirmButtonText: 'Yes',
                cancelButtonText: 'Cancel',
                allowOutsideClick: false
            }).then(function(r) {
                if (r.isConfirmed == true) {

                    var data = {
                        Loader_Id: id,
                        LoaderCode: code
                    }

                    $.ajax({
                        url: '/Loader/EmptyLoader',
                        type: 'POST',
                        data: JSON.stringify(data),
                        dataType: 'json',
                        contentType: 'application/json; charset=utf-8',
                        beforeSend: function () {
                            Swal.fire({
                                text: 'Please Wait',
                                width: '300px',
                                allowEscapeKey: false,
                                allowOutsideClick: false,
                                showConfirmButton: false,
                            });
                            Swal.showLoading();
                        },
                        success: function (result) {
                            if (result.success == true) {
                                Swal.fire({
                                    icon: 'success',
                                    title: "Success Empty",
                                    text: "",
                                    didClose: () => {
                                      window.location.reload();
                                    }
                                });
                            }
                            else {
                                Swal.fire({
                                    icon: 'error',
                                    title: "Wait",
                                    text: result.errMessage
                                });
                            }
                        },
                        error: function (error) {
                            Swal.fire({
                                icon: 'error',
                                title: "Wait",
                                text: error.val
                            });
                        }
                    });

                } else {
                    return;
                }
            });
        }

    </script>
}
