
<div class="tw:flex tw:w-full tw:items-center tw:justify-between">
    <h2 class="tw:text-lg tw:mb-0 tw:ml-2 tw:font-semibold tw:text-gray-800 tw:dark:text-white/90">Loader Detail List</h2>
    <div class="tw:flex">
        <button type="button" class="tw:border-0 tw:inline-flex tw:items-center tw:gap-2 tw:rounded-lg tw:bg-indigo-500 tw:px-4 tw:py-2.5 tw:text-sm tw:font-medium tw:text-white tw:transition
            tw:hover:bg-indigo-600" onclick="export()">
            Export
        </button>
    </div>
</div>

<div class="tw:mt-3 tw:space-y-4">
    <input type="hidden" id="xToken" value="@ViewBag.xToken" autocomplete="off">

    <div class="tw:rounded-xl tw:border tw:border-gray-200 tw:bg-white tw:p-4 tw:dark:border-gray-800 tw:dark:bg-white/[0.03]">
        <div class="tw:flex tw:flex-wrap tw:items-center tw:gap-3">
            <label for="selLoader" class="tw:text-sm tw:font-medium tw:text-gray-700 tw:dark:text-gray-400">Loader</label>
            <div class="tw:relative tw:w-48" x-data="customSelect('selLoader')" x-init="init()">
                <select id="selLoader" class="tw:hidden"></select>
                <button type="button" @@click="toggle()" @@click.outside="open = false"
                    class="tw:flex tw:w-full tw:items-center tw:justify-between tw:gap-2 tw:rounded-lg tw:border tw:bg-transparent tw:px-4 tw:py-2.5 tw:text-left tw:text-sm tw:text-gray-800 tw:dark:bg-gray-900 tw:dark:text-white/90"
                    :class="hasError ? 'tw:border-error-500' : (open ? 'tw:border-brand-300 tw:ring-3 tw:ring-brand-500/10' : 'tw:border-gray-300 tw:dark:border-gray-700')">
                    <span x-text="selectedLabel || 'Select...'" :class="selectedLabel ? '' : 'tw:text-gray-400 tw:dark:text-white/30'"></span>
                    <i class="bi bi-chevron-down tw:text-xs tw:text-gray-500 tw:transition-transform tw:dark:text-gray-400" :class="open ? 'tw:rotate-180' : ''"></i>
                </button>
                <div x-show="open" x-transition
                    class="custom-select-scroll tw:absolute tw:z-50 tw:max-h-60 tw:w-full tw:overflow-y-auto tw:rounded-lg tw:border tw:border-gray-200 tw:bg-white tw:py-1 tw:shadow-theme-lg tw:dark:border-gray-700 tw:dark:bg-gray-900"
                    :class="dropUp ? 'tw:bottom-full tw:mb-1' : 'tw:top-full tw:mt-1'">
                    <template x-if="options.length === 0">
                        <div class="tw:px-4 tw:py-2 tw:text-sm tw:text-gray-400 tw:dark:text-white/30">No options</div>
                    </template>
                    <template x-for="opt in options" :key="opt.value">
                        <div @@click="select(opt)"
                            class="tw:cursor-pointer tw:px-4 tw:py-2 tw:text-sm tw:hover:bg-brand-50 tw:dark:hover:bg-brand-500/15"
                            :class="opt.value === selectedValue ? 'tw:bg-brand-50 tw:font-medium tw:text-brand-600 tw:dark:bg-brand-500/15 tw:dark:text-brand-400' : 'tw:text-gray-700 tw:dark:text-gray-300'"
                            x-text="opt.text"></div>
                    </template>
                </div>
            </div>
            <button type="button" class="tw:flex tw:h-10 tw:w-10 tw:items-center tw:justify-center tw:rounded-lg tw:border-0 tw:bg-brand-500 tw:text-white tw:hover:bg-brand-600" onclick="loadList()">
                <i class="bi bi-search"></i>
            </button>
        </div>
    </div>

    <div class="tw:grid tw:grid-cols-4 tw:gap-4">
        <div class="tw:rounded-2xl tw:border tw:border-gray-200 tw:bg-white tw:p-4 tw:text-center tw:dark:border-gray-800 tw:dark:bg-white/[0.03]">
            <h3 class="tw:mb-1.5 tw:text-xs tw:text-gray-500 tw:dark:text-gray-400">Status</h3>
            <div class="tw:text-xl tw:font-semibold tw:text-gray-800 tw:dark:text-white/90" id="txtStatus"> -</div>
        </div>
        <div class="tw:col-span-2 tw:rounded-2xl tw:border tw:border-gray-200 tw:bg-white tw:p-4 tw:text-center tw:dark:border-gray-800 tw:dark:bg-white/[0.03]">
            <h3 class="tw:mb-1.5 tw:text-xs tw:text-gray-500 tw:dark:text-gray-400">Column Capacity</h3>
            <div class="tw:grid tw:grid-cols-2 tw:gap-3">
                <div class="usage-card tw:dark:bg-white/[0.03] tw:dark:text-white/90" data-col="1">
                    <h3 class="tw:font-bold tw:text-sm">Column 1</h3>
                    <div class="tw:flex tw:justify-center tw:gap-2 tw:text-xs tw:mb-1">
                        <div class="usage-left">
                            <span class="label">Balanced:</span> 
                            <span data-type="balanced">-</span>
                        </div>
                        <div class="usage-used">
                            <span class="label">Used:</span> 
                            <span data-type="used">-</span>
                        </div>
                    </div>
                    <div class="tw:text-xs">
                        <span class="label">Total:</span>
                        <span data-type="total">-</span>
                    </div>
                </div>

                <div class="usage-card tw:dark:bg-white/[0.03] tw:dark:text-white/90" data-col="2">
                    <h4 class="tw:font-bold tw:text-sm">Column 2</h4>
                    <div class="tw:flex tw:justify-center tw:gap-2 tw:text-xs tw:mb-1">
                        <div class="usage-left">
                            <span class="label">Balanced:</span>
                            <span data-type="balanced">-</span>
                        </div>
                        <div class="usage-used">
                            <span class="label">Used:</span> 
                            <span data-type="used">-</span>
                        </div>
                    </div>
                    <div class="tw:text-xs">
                        <span class="label">Total:</span> 
                        <span data-type="total">-</span>
                    </div>
                </div>

                <div class="usage-card tw:dark:bg-white/[0.03] tw:dark:text-white/90" data-col="3">
                    <h4 class="tw:text-sm  tw:font-bold">Column 3</h4>
                    <div class="tw:flex tw:justify-center tw:gap-2 tw:text-xs tw:mb-1">
                        <div class="usage-left">
                            <span class="label">Balanced:</span> 
                            <span data-type="balanced">-</span>
                        </div>
                        <div class="usage-used">
                            <span class="label">Used:</span> 
                            <span data-type="used">-</span>
                        </div>
                    </div>
                    <div class="tw:text-xs">
                        <span class="label">Total:</span> 
                        <span data-type="total">-</span>
                    </div>
                </div>

                <div class="usage-card tw:dark:bg-white/[0.03] tw:dark:text-white/90" data-col="4">
                    <h4 class="tw:text-sm tw:font-bold">Column 4</h4>
                    <div class="tw:flex tw:justify-center tw:gap-2 tw:text-xs tw:mb-1">
                        <div class="usage-left">
                            <span class="label">Balanced:</span> 
                            <span data-type="balanced">-</span>
                        </div>
                        <div class="usage-used">
                            <span class="label">Used:</span>
                            <span data-type="used">-</span>
                        </div>
                    </div>
                    <div class="tw:text-xs">
                        <span class="label">Total:</span> 
                        <span data-type="total">-</span>
                    </div>
                </div>
            </div>
        </div>
        <div class="tw:rounded-2xl tw:border tw:border-gray-200 tw:bg-white tw:p-4 tw:text-center tw:dark:border-gray-800 tw:dark:bg-white/[0.03]">
            <h3 class="tw:mb-1.5 tw:text-xs tw:text-gray-500 tw:dark:text-gray-400">Total Reels</h3>
            <button class="col-reel-btn tw:dark:bg-white/[0.03] tw:dark:text-white/90 tw:text-sm" data-col="1" id="btnCol1">
                Column 1 <span id="txtTR1">3 reels</span>
            </button> 

            <button class="col-reel-btn tw:dark:bg-white/[0.03] tw:dark:text-white/90 tw:text-sm tw:bg-white" data-col="2" id="btnCol2">
                Column 2 <span id="txtTR2">-</span>
            </button>

            <button class="col-reel-btn tw:dark:bg-white/[0.03] tw:dark:text-white/90 tw:text-sm tw:bg-white" data-col="3" id="btnCol3">
                Column 3 <span id="txtTR3">-</span>
            </button>

            <button class="col-reel-btn tw:dark:bg-white/[0.03] tw:dark:text-white/90 tw:text-sm tw:bg-white" data-col="4" id="btnCol4">
                Column 4 <span id="txtTR4">-</span>
            </button>
        </div>
    </div>

    <div class="dt-tailadmin tw:overflow-hidden tw:rounded-xl tw:border tw:border-gray-200 tw:bg-white tw:text-gray-700 tw:dark:border-gray-800 tw:dark:bg-white/[0.03] tw:dark:text-gray-300">
        <table id="listTable" class="row-border dataTable hover order-column tw:w-full">
            <thead>
                <tr class="tw:border-b tw:border-gray-200">
                    @{
                        string[] listHeaders = { "Column", "Reel Code", "Item Code", "Qty" };
                    }
                    @foreach (var header in listHeaders)
                    {
                        <th class="tw:px-5 tw:py-3.5 tw:text-left sm:tw:px-6"><span class="tw:text-sm tw:font-semibold tw:text-gray-700 tw:dark:text-gray-300">@header</span></th>
                    }
                </tr>
            </thead>
        </table>
    </div>
</div>

@section Scripts
{
    <link rel="stylesheet" href="~/css/sweetalert2.min.css">
    <link rel="stylesheet" href="~/css/dataTables.dataTables.css">

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="../js/dataTables.js"></script>
    <script src="~/js/sweetalert2.all.min.js"></script>

    <script type="text/javascript">
        let globalData = [];
        let activeCol = null;

        function customSelect(selectId) {
            return {
                open: false,
                dropUp: false,
                options: [],
                selectedValue: '',
                selectedLabel: '',
                hasError: false,
                init() {
                    this.syncOptions();
                    const sel = document.getElementById(selectId);
                    if (!sel) return;
                    this.hasError = sel.classList.contains('is-invalid');
                    new MutationObserver(() => {
                        this.hasError = sel.classList.contains('is-invalid');
                    }).observe(sel, { attributes: true, attributeFilter: ['class'] });
                },
                toggle() {
                    this.open = !this.open;
                    if (this.open) {
                        this.syncOptions();
                        const rect = this.$el.getBoundingClientRect();
                        const spaceBelow = window.innerHeight - rect.bottom;
                        this.dropUp = spaceBelow < 240 && rect.top > spaceBelow;
                    }
                },
                syncOptions() {
                    const sel = document.getElementById(selectId);
                    if (!sel) return;
                    this.options = Array.from(sel.options).map(o => ({ value: o.value, text: o.textContent.trim() }));
                    this.selectedValue = sel.value;
                    const selectedOpt = sel.options[sel.selectedIndex];
                    this.selectedLabel = selectedOpt ? selectedOpt.textContent.trim() : '';
                },
                select(opt) {
                    const sel = document.getElementById(selectId);
                    sel.value = opt.value;
                    this.selectedValue = opt.value;
                    this.selectedLabel = opt.text;
                    this.open = false;
                    sel.dispatchEvent(new Event('change'));
                }
            };
        }

        function refreshCustomSelect(selectId) {
            const sel = document.getElementById(selectId);
            const root = sel ? sel.closest('[x-data]') : null;
            if (root && window.Alpine) {
                Alpine.$data(root).syncOptions();
            }
        }

        $(document).ready(function () {
            loadLoader();
        });

        function loadLoader() {
            $.ajax({
                url: "/Loader/GetLoaderList/",
                type: "POST",
                dataType: 'JSON',
                contentType: 'application/json; charset=utf-8',
                success: function (result) {
                    Swal.close();
                    if (result.success == true) {
                        const dropdown = document.getElementById('selLoader');
                        dropdown.innerHTML = "";

                        result.data.forEach((i, index) => {
                            const option = document.createElement("option");
                            option.value = i.loader_Id;
                            option.textContent = i.loaderCode;
                            if (index === 0) {
                                option.selected = true;
                            }
                            dropdown.appendChild(option);
                        });

                        refreshCustomSelect('selLoader');
                        loadList();
                    }
                },
                error: function (error) {
                    Swal.fire({
                        icon: 'error',
                        title: "Wait",
                        text: error.val
                    });
                }
            });
        }

        function loadList() {
            const id = document.getElementById("selLoader").value;

            $.ajax({
                url: "/Loader/GetLoaderDetailList?id=" + id,
                type: "GET",
                dataType: 'JSON',
                contentType: 'application/json; charset=utf-8',
                beforeSend: function () {
                    Swal.fire({
                        text: 'Please Wait',
                        width: '300px',
                        allowEscapeKey: false,
                        allowOutsideClick: false,
                        showConfirmButton: false,
                    });
                    Swal.showLoading();
                },
                success: function (result) {
                    Swal.close();
                    if (result.success == true) {
                        var spText = result.errStackTrace.split(',');
                        // document.getElementById('txtCol1').innerHTML = "Usage Col 1 : " + spText[0];
                        // document.getElementById('txtCol2').innerHTML = "Usage Col 2 : " + spText[1];
                        // document.getElementById('txtCol3').innerHTML = "Usage Col 3 : " + spText[2];
                        // document.getElementById('txtCol4').innerHTML = "Usage Col 4 : " + spText[3];

                        document.getElementById('txtTR1').innerHTML = spText[4] + (spText[4] > 1 ? " reels" : " reel");
                        document.getElementById('txtTR2').innerHTML = spText[5] + (spText[5] > 1 ? " reels" : " reel");
                        document.getElementById('txtTR3').innerHTML = spText[6] + (spText[6] > 1 ? " reels" : " reel");
                        document.getElementById('txtTR4').innerHTML = spText[7] + (spText[7] > 1 ? " reels" : " reel");

                        document.getElementById('txtStatus').innerHTML = spText[8];

                        //filter out the duplicate reel-id
                        const dup = new Set();
                        const filteredData = result.data.filter(row => {
                            if (dup.has(row.reelCode) || row.reel_Id == "00000000-0000-0000-0000-000000000000") {
                                return false;
                            }
                            dup.add(row.reelCode);
                            return true;
                        });

                        globalData = filteredData;
                        const cellClass = 'tw:px-5 tw:py-4 tw:whitespace-nowrap sm:tw:px-6 tw:text-theme-sm tw:text-gray-700 tw:dark:text-gray-300';

                        $('#listTable').DataTable( {
                            data: filteredData,
                            paging: true,
                            pageLength: 50,
                            lengthMenu: [50, 100, 250, 500, 1000],
                            "bDestroy": true,
                            columns: [
                                { data: 'colNo', className: cellClass },
                                { data: 'reelCode', className: cellClass },
                                {
                                    data: null,
                                    className: cellClass,
                                    render: function (data, type, row, meta) {
                                        // return '<p>' + row.itemCode + '</p><p>' + row.itemDesc + '</p>';
                                        return '<p style="margin:0;"><span>' + row.itemCode + '</span><br/>' +
                                        '<span style="font-size:13px;color:grey;">' + row.itemDesc + '</span></p>';
                                    }
                                },
                                { data: 'qty', className: cellClass },
                            ],
                            language: {
                                searchPlaceholder: "🔍︎ Search",
                                search: ""
                            }
                        });

                        
                        const usageData = filterColumnUsage(result.data);
                        $('.usage-card').each(function() {
                            const col = $(this).data('col');
                            const colData = usageData[col];

                            if (!colData) return;
                            $(this).find('[data-type="balanced"]').text(colData.balanced);
                            $(this).find('[data-type="used"]').text(colData.used);
                            $(this).find('[data-type="total"]').text(colData.total);
                        });
                    }
                    else {
                        Swal.fire({
                            icon: 'error',

                            title: "Wait",
                            text: result.errMessage
                        });
                    }
                },
                error: function (error) {
                    Swal.fire({
                        icon: 'error',
                        title: "Wait",
                        text: error.val
                    });
                }
            });
        }

        function filterColumnUsage(data) {
            const usage = {};

            data.forEach(row => {
                const col = row.colNo;
                if (!usage[col]) {
                    usage[col] = {
                        total: row.colHeight + " mm",
                        balanced: row.balanceHeight + " mm",
                        used: row.colHeight - row.balanceHeight + " mm"
                    };
                }
            });

            for (let col = 1; col <= 4; col++) {
                if (!usage[col]) {
                    usage[col] = {
                        total: "50 mm",
                        balanced: "50 mm",
                        used: "0 mm"
                    };
                }
            }
            return usage;
        }

        // function filterByColumn(colNumber) {
        //     const table = $('#listTable').DataTable();
        //     table.column(0).search('').draw();

        //     const filteredData = globalData.filter(row => row.colNo == colNumber);
        //     table.clear();
        //     table.rows.add(filteredData);
        //     table.draw();
        // }

        $('.col-reel-btn').on('click', function() {
            const col = $(this).data('col');
            const table = $('#listTable').DataTable();

            if (activeCol === col) {
                activeCol = null;

                $('.col-reel-btn').removeClass('active');
                table.clear();
                table.rows.add(globalData);
                table.draw();
                return;
            }

            activeCol = col;
            $('.col-reel-btn').removeClass('active');
            $(this).addClass('active');

            const filteredData = globalData.filter(x => x.colNo == col && x.qty != 0);
            table.clear();
            table.rows.add(filteredData);
            table.draw();
        });


    </script>
}