<style>
    .dt-layout-row:not(.dt-layout-table) {
        display: none !important;
    }
</style>

<div x-data="{ filtersOpen: true }">
    <div class="tw:flex tw:w-full tw:items-center tw:justify-between">
        <h2 class="tw:text-lg tw:mb-0 tw:ml-2 tw:font-semibold tw:text-gray-800 tw:dark:text-white/90">BOM List</h2>
        <div class="tw:flex tw:items-center tw:gap-2">
            <button type="button" class="tw:rounded-lg tw:border-0 tw:px-3.5 tw:py-2.5 tw:transition-colors"
                :class="filtersOpen ? 'tw:bg-brand-50 tw:text-brand-600 tw:dark:bg-brand-500/15 tw:dark:text-brand-400' : 'tw:bg-gray-100 tw:text-gray-500 tw:hover:bg-gray-200 tw:dark:bg-white/5 tw:dark:text-gray-400 tw:dark:hover:bg-white/10'"
                @@click="filtersOpen = !filtersOpen" title="Toggle Filters">
                <i class="bi bi-funnel"></i>
            </button>
            <button type="button" class="tw:gap-1.5 tw:rounded-lg tw:border-0 tw:bg-yellow-400 tw:px-4 tw:py-2.5 tw:text-sm tw:font-medium tw:text-white tw:hover:bg-yellow-500" onclick="downloadTemp()">
                Download BOM Template
            </button>
            <input type="file" id="fileInput" accept=".xlsx, .xls, .csv" class="tw:hidden" onchange="handleFileUpload(event)">
            <button type="button" class="tw:rounded-lg tw:border-0 tw:bg-emerald-500 tw:px-4 tw:py-2.5 tw:text-sm tw:font-medium
                tw:text-white tw:hover:bg-emerald-600" onclick="triggerFileInput()">
                Import BOM By Excel
            </button>
            <button type="button" class="tw:border-0 tw:gap-2 tw:rounded-lg tw:bg-brand-500 tw:px-4 tw:py-2.5 tw:text-sm tw:font-medium
                tw:text-white tw:transition tw:hover:bg-brand-600" onclick="navigateToNew('new')">
                Add New BOM
            </button>
        </div>
    </div>

    <div class="tw:mt-3 tw:space-y-4">
        <div x-show="filtersOpen" x-transition class="tw:rounded-xl tw:border tw:border-gray-200 tw:bg-white tw:p-4 tw:dark:border-gray-800 tw:dark:bg-white/[0.03]">
            @{
                string fieldClass = @"tw:w-full tw:rounded-lg tw:border tw:border-gray-300 tw:bg-transparent tw:px-4 tw:py-2.5 tw:text-sm tw:text-gray-800 tw:placeholder:text-gray-400
                    tw:focus:border-brand-300 tw:focus:ring-3 tw:focus:ring-brand-500/10 tw:focus:outline-hidden tw:dark:border-gray-700 tw:dark:bg-gray-900 tw:dark:text-white/90
                    tw:dark:placeholder:text-white/30 tw:dark:focus:border-brand-800";
                string labelClass = "tw:mb-1.5 tw:block tw:text-sm tw:font-medium tw:text-gray-700 tw:dark:text-gray-400";
            }
            <div class="tw:grid tw:grid-cols-3 tw:items-end tw:gap-3">
                <div>
                    <label class="@labelClass" for="txtItemCode">Item Code</label>
                    <input id="txtItemCode" name="ItemCode" type="text" class="@fieldClass" placeholder="Item Code" />
                </div>
                <div>
                    <label class="@labelClass" for="txtCreatedBySearch">Created By</label>
                    <input id="txtCreatedBySearch" name="CreatedBy" type="text" class="@fieldClass" placeholder="Created By" />
                </div>
                <div>
                    <button type="button" class="tw:inline-flex tw:w-full tw:items-center tw:justify-center tw:rounded-lg tw:border-0 tw:bg-brand-500 tw:px-4 tw:py-2.5 tw:text-sm tw:font-medium tw:text-white tw:hover:bg-brand-600" onclick="loadList(1)">
                        <i class="bi bi-search"></i>
                    </button>
                </div>
            </div>
        </div>

        <div class="dt-tailadmin tw:overflow-hidden tw:rounded-lg tw:border tw:border-gray-200 tw:bg-white tw:text-gray-700 tw:dark:border-gray-800 tw:dark:bg-white/[0.03] tw:dark:text-gray-300">
            <div class="tw:flex tw:items-center tw:gap-2 tw:px-5 tw:pt-4 tw:text-[13px] tw:text-gray-500 sm:tw:px-6 tw:dark:text-gray-400">
                <select id="selpageSize" name="pageSize" class="tw:rounded-lg tw:border tw:border-gray-300 tw:bg-white tw:px-4 tw:py-2 tw:text-[13px] tw:font-medium tw:text-gray-800 tw:shadow-theme-xs tw:focus:border-brand-300 tw:focus:ring-3 tw:focus:ring-brand-500/10 tw:focus:outline-hidden tw:dark:border-gray-700 tw:dark:bg-gray-900 tw:dark:text-white/90">
                    <option value="25">25</option>
                    <option value="50">50</option>
                    <option value="100">100</option>
                    <option value="200">250</option>
                </select>
                <span>entries per page</span>
            </div>

            <table id="listTable" class="row-border dataTable hover order-column tw:w-full">
                <thead>
                    <tr class="tw:border-b tw:border-gray-200">
                        @{
                            string[] listHeaders = { "BOM Id", "Item", "Description", "Is Active", "Created Date", "Action" };
                        }
                        @foreach (var header in listHeaders)
                        {
                            <th class="tw:px-5 tw:py-3.5 tw:text-left sm:tw:px-6"><span class="tw:text-sm tw:font-semibold tw:text-gray-700 tw:dark:text-gray-300">@header</span></th>
                        }
                    </tr>
                </thead>
            </table>

            <div class="tw:flex tw:flex-wrap tw:text-[13px] tw:items-center tw:justify-between tw:gap-3 tw:px-5 tw:py-4 sm:tw:px-6">
                <div class="tw:text-gray-500 tw:dark:text-gray-400">Showing <span id="lblCurCount">0</span> of <span id="lblTotal">0</span> entries</div>
                <nav aria-label="pagination" id="ulPagination" class="tw:flex tw:items-center tw:gap-1"></nav>
            </div>
        </div>
        <input type="hidden" id="txtCurPage">
        <input type="hidden" id="txtTotalRecord">
        <input type="hidden" id="txtPageSize">
        <input type="hidden" id="txtTotalPage">
    </div>
</div>

@section Scripts
{
    <link rel="stylesheet" href="~/css/sweetalert2.min.css">
    <link rel="stylesheet" href="~/css/dataTables.dataTables.css">

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="../js/dataTables.js"></script>
    <script src="~/js/sweetalert2.all.min.js"></script>
    <script src="../js/xlsx.full.min.js"></script>
    <script src="../js/exceljs.min.js"></script>

    <script type="text/javascript">
        let itemIndex = 1;
        var itemList = [];
        let originalFileContent = null;

        $(document).ready(async function () {
            $('#txtTotalRecord').val(0);
            $('#txtTotalPage').val(1);
            getFinishedItemList().then(function(resultGet) {
                if (resultGet) { loadList(1); }
            });
            // getRawItemList();
            // loadList(1);
        });

        function prevPage() {
            var curPage = $('#txtCurPage').val();
            if (curPage == 1) {
                return;
            }
            loadlList(curPage - 1);
        }

        function nextPage() {
            var curPage = $('#txtCurPage').val();
            var ttl = $('#txtTotalRecord').val();
            var paeSize = $('#txtPageSize').val();
            var ttlPage = $('#txtTotalPage').val();

            if ((curPage + 1) > ttlPage) {
                return;
            }
            loadList(curPage + 1);
        }

        function loadList(page) {

            $('#txtCurPage').val(page);
            $('#txtPageSize').val($('#selpageSize').val());

            var data = {
                ItemCode: $('#txtItemCode').val(),
                CreatedBy: $('#txtCreatedBySearch').val(),
                page: page,
                pageSize: $('#selpageSize').val(),
            };

            $.ajax({
                url: "/BOM/GetBOMList/",
                type: "POST",
                data: JSON.stringify(data),
                dataType: 'JSON',
                contentType: 'application/json; charset=utf-8',
                beforeSend: function () {
                    Swal.fire({
                        text: 'Please Wait',
                        width: '300px',

                        allowEscapeKey: false,
                        allowOutsideClick: false,
                        showConfirmButton: false,
                    });
                    Swal.showLoading()
                },
                success: function (result) {
                    Swal.close()
                    if (result.success == true) {
                        const cellClass = 'tw:px-5 tw:py-4 tw:whitespace-nowrap sm:tw:px-6 tw:text-theme-sm tw:text-gray-700 tw:dark:text-gray-300';

                        $('#listTable').DataTable({
                            data: result.data,
                            paging: false,
                            searching: false,
                            "info": false,
                            "bDestroy": true,
                            columns: [
                                { data: 'boM_Id', className: cellClass },
                                {   data: 'item_Id', 
                                    className: cellClass, 
                                    render: function(data, type, row) {
                                        var item = itemList.find(function(i) {
                                            return i.itemId === data;
                                        });
                                        return item ? item.itemCode: '';
                                    }
                                },
                                { 
                                    data: 'description',
                                    className: cellClass, 
                                    render: function (data, type, row, meta) {
                                        const maxLength = 50;
                                        const desc = row.description || "";
                                        const shortDesc = desc.length > maxLength
                                            ? desc.substring(0, maxLength) + "..."
                                            : desc;

                                        return `
                                            <p style="margin: 0;">
                                                <span title="${desc}">${shortDesc}</span><br/>
                                                <span style="font-size:13px;color:grey;">${row.desc2 || ""}</span>
                                            </p>
                                        `;
                                    }
                                },
                                {
                                    data: null,
                                    className: 'tw:px-5 tw:py-4 tw:whitespace-nowrap sm:tw:px-6',
                                    render: function (data, type, row, meta) {
                                        return row.isActive
                                            ? '<span class="tw:status-badge tw:bg-success-50 tw:text-success-700 tw:dark:bg-success-500/15 tw:dark:text-success-500">Active</span>'
                                            : '<span class="tw:status-badge tw:bg-gray-100 tw:text-gray-700 tw:dark:bg-white/5 tw:dark:text-gray-400">Inactive</span>';
                                    }
                                },
                                { 
                                    data: 'createdDate',
                                    className: cellClass, 
                                    render: function (data, type, row) {
                                        const date = new Date(data.split('.')[0]);
                                        if (isNaN(date)) return 'Invalid Date';

                                        return date.toLocaleString('en-GB', {
                                            year: 'numeric',
                                            month: 'numeric',
                                            day: 'numeric',
                                            hour: 'numeric',
                                            minute: 'numeric',
                                            hour: 'numeric',
                                            hour12: true
                                        });
                                    }
                                },
                                // { data: 'createdBy', className: cellClass },
                                {
                                    data: null,
                                    className: 'tw:px-5 tw:py-4 tw:whitespace-nowrap sm:tw:px-6',
                                    className: cellClass, 
                                    render: function (data, type, row, meta) {
                                        const rawData = JSON.stringify(row).replace(/"/g, "&quot;");
                                        return `<div class="tw:flex tw:items-center tw:gap-2">
                                            <button class="view-btn tw:inline-flex tw:items-center tw:gap-1.5 tw:rounded-lg tw:bg-brand-50 tw:font-medium tw:text-brand-600
                                                tw:transition-colors tw:hover:bg-brand-100 tw:dark:bg-brand-500/15 tw:dark:text-brand-400 tw:dark:hover:bg-brand-500/25" data-row='${rawData}' onclick="navigateToView(${row.boM_Id}, 'view')">
                                                <i class="bi bi-eye"></i> 
                                                View
                                            </button>
                                            <button class="edit-btn tw:inline-flex tw:items-center tw:gap-1.5 tw:rounded-lg tw:bg-amber-50 tw:font-medium tw:text-amber-600
                                                tw:transition-colors tw:hover:bg-amber-100 tw:dark:bg-amber-500/15 tw:dark:text-amber-400 tw:dark:hover:bg-amber-500/25" data-row='${rawData}' onclick="navigateToEdit(${row.boM_Id}, 'edit')">
                                                <i class="bi bi-pencil-square"></i> 
                                                Edit
                                            </button>
                                            <button class="delete-btn tw:inline-flex tw:items-center tw:gap-1.5 tw:rounded-lg tw:bg-error-50 tw:font-medium tw:text-error-600
                                                tw:transition-colors tw:hover:bg-error-100 tw:dark:bg-error-500/15 tw:dark:text-error-400 tw:dark:hover:bg-error-500/25" data-id="${row.boM_Id}">
                                                <i class="bi bi-trash"></i> 
                                                Delete
                                            </button>
                                        </div>`;
                                    }
                                }
                            ],
                        });

                        var curCnt = 0;
                        var pageSize = parseInt($("#selpageSize").val());
                        var startEntry = ((page - 1) * pageSize) + 1;
                        var ttlRecords = result.totalRecords === -1 ? $('#lblTotal').text() : result.totalRecords;
                        var endEntry = Math.min(page * pageSize, ttlRecords);

                        if (ttlRecords === 0 || startEntry > ttlRecords) {
                            startEntry = 0;
                            endEntry = 0;
                        }
                        $('#lblCurCount').html(`${startEntry} to ${endEntry}`);

                        if (page == 1) {
                            $('#lblTotal').html(result.totalRecords);

                            var pageSizeVal = $('#selpageSize').val();
                            var ttlPage = parseInt(result.totalRecords / pageSizeVal);
                            if ((result.totalRecords % pageSizeVal) > 0) {
                                ttlPage = ttlPage + 1;
                            }
                            $('#txtTotalRecord').val(result.totalRecords);
                            $('#txtTotalPage').val(ttlPage);
                        }

                        var ttlPage = Number($('#txtTotalPage').val());
                        const myDiv = document.getElementById('ulPagination');
                        myDiv.innerHTML = "";
                        var pageItems = buildPaginationItems(ttlPage, page, 5);

                        const pageBtnBase = 'tw:inline-flex tw:h-8 tw:min-w-8 tw:items-center tw:justify-center tw:rounded-lg tw:border tw:border-gray-200 tw:px-2.5 tw:text-sm tw:dark:border-gray-800';
                        const pageBtnCurrent = pageBtnBase + ' tw:border-0 tw:bg-[rgba(43,127,255,0.08)] tw:font-medium tw:text-brand-500';
                        const pageBtnDisabled = pageBtnBase + ' tw:border-0 tw:cursor-not-allowed tw:text-gray-300 tw:dark:text-gray-600 tw:bg-transparent' ;
                        const pageBtnNormal = pageBtnBase + ' tw:text-gray-700 tw:dark:text-gray-300 tw:hover:border-0 tw:hover:bg-[rgba(43,127,255,0.08)] tw:hover:text-brand-500 tw:bg-transparent';

                        myDiv.innerHTML += '<button ' + (page <= 1 ? 'disabled' : '') + ' class="' + (page <= 1 ? pageBtnDisabled : pageBtnNormal) + '" onclick="loadList(1)" role="link" type="button" aria-controls="listTable">«</button>';
                        myDiv.innerHTML += '<button ' + (page <= 1 ? 'disabled' : '') + ' class="' + (page <= 1 ? pageBtnDisabled : pageBtnNormal) + '" onclick="prevPage()" role="link" type="button" aria-controls="listTable">‹</button>';

                        pageItems.forEach(function(item) {
                            if (item === '...') {
                                myDiv.innerHTML += '<span class="tw:px-1 tw:text-gray-400">...</span>';
                            }
                            else {
                                var isC = (page == item) ? pageBtnCurrent : pageBtnNormal;
                                myDiv.innerHTML += '<button class="' + isC + '" id="btnP' + item + '" onclick="loadList(' + item + ')" role="link" type="button" aria-controls="listTable">' + item + '</button>';
                            }
                        });

                        myDiv.innerHTML += '<button ' + (page >= ttlPage ? 'disabled' : '') + ' class="' + (page >= ttlPage ? pageBtnDisabled : pageBtnNormal) + '" onclick="nextPage()" role="link" type="button" aria-controls="listTable">›</button>';
                        myDiv.innerHTML += '<button ' + (page >= ttlPage ? 'disabled' : '') + ' class="' + (page >= ttlPage ? pageBtnDisabled : pageBtnNormal) + '" onclick="loadList(' + ttlPage + ')" role="link" type="button" aria-controls="listTable">»</button>';
                    }
                    else {
                        Swal.fire({
                            icon: 'error',
                            title: "Wait",
                            text: result.errMessage
                        });
                    }
                },
                error: function (error) {
                    Swal.fire({
                        icon: 'error',
                        title: "Wait",
                        text: error.val
                    });
                }
            });
        }

        function buildPaginationItems(totalPages, currentPage, windowSize = 5) {
            const items = [];

            if (totalPages <= windowSize) {
                for (let i = 1; i <= totalPages; i++) {
                    items.push(i);
                }
                return items;
            }

            if (currentPage <= windowSize - 1) {
                for (let i = 1; i <= windowSize; i++) {
                    items.push(i);
                }
                items.push('...');
                items.push(totalPages);
            }
            else if (currentPage >= totalPages - windowSize + 2) {
                items.push(1);
                items.push('...');
                for (let i = totalPages - windowSize + 1; i <= totalPages; i++) {
                    items.push(i);
                }
            }
            else {
                items.push(1);
                items.push('...');
                items.push(currentPage - 1, currentPage, currentPage + 1);
                items.push('...');
                items.push(totalPages);
            }

            return items;
        }

        function navigateToNew(mode) {
            window.location.href = '@Url.Action("BOMDetails", "BOM", new { id = "_id_", mode = "_mode_" })'.replace('_id_', 0).replace('_mode_', mode);

        }

        function getFinishedItemList() {
            return new Promise((resolve, reject) => {
                $.ajax({
                    url: "/Item/GetFinishedItemList/",
                    type: "GET",
                    dataType: 'JSON',
                    contentType: 'application/json; charset=utf-8',
                    success: function (result) {
                        if (result.success == true) {
                            itemList = result.data.map(function (i) {
                                return {
                                    itemId : i.item_Id,
                                    itemCode: i.itemCode,
                                    itemDescription: i.description,
                                };
                            });
                            resolve(true);
                        } else {
                            Swal.fire({
                                icon: 'error',
                                title: 'Wait',
                                text: result.errMessage
                            });
                            resolve(false);
                        }
                    },
                    error: function (error) {
                        Swal.fire({
                            icon: 'error',
                            title: 'Wait',
                            text: error.val
                        });
                        resolve(false);
                    }
                });
            });
        }

        function navigateToView(id, mode) {
            window.location.href = '@Url.Action("BOMDetails", "BOM", new { id = "_id_", mode = "_mode_" })'.replace('_id_', id).replace('_mode_', mode);
        }

        function navigateToEdit(id, mode) {
            window.location.href = '@Url.Action("BOMDetails", "BOM", new { id = "_id_", mode = "_mode_" })'.replace('_id_', id).replace('_mode_', mode);
        }

        $('#listTable').on('click', '.delete-btn', function () {
            const id = $(this).attr('data-id');
            deleteBom(id);
        });

        function deleteBom(id) {
            Swal.fire({
                title: "Are you sure want to delete?",
                text: "You won't be able to recover this record!",
                icon: "warning",
                showCancelButton: true,
                confirmButtonText: 'Yes',
                cancelButtonText: 'Cancel',
                allowOutsideClick: false
            }).then(function(r) {
                if (r.isConfirmed == true) {
                    var data = {
                        BOM_Id: id,
                    };
                    $.ajax({
                        url: '/BOM/DeleteBOM',
                        type: 'DELETE',
                        data: JSON.stringify(data),
                        dataType: 'json',
                        contentType: 'application/json; charset=utf-8',
                        beforeSend: function () {
                            Swal.fire({
                                text: 'Please Wait',
                                width: '300px',

                                allowEscapeKey: false,
                                allowOutsideClick: false,
                                showConfirmButton: false,
                            });
                            Swal.showLoading()
                        },
                        success: function (result) {
                            if (result.success == true) {
                                Swal.fire({
                                    icon: 'success',
                                    title: "Success Deleted",
                                    text: "",
                                    didClose: () => {
                                      window.location.reload();
                                    }
                                });
                            }
                            else {
                                Swal.fire({
                                    icon: 'error',
                                    title: "Wait",
                                    text: result.errMessage
                                });
                            }
                        },
                        error: function (error) {
                            // console.log(error);
                            Swal.fire({
                                icon: 'error',
                                title: "Wait",
                                text: error.val
                            });
                        }
                    });

                } else {
                    return;
                }
              });
        }

        function downloadTemp() {
            var workbook = new ExcelJS.Workbook();
            workbook.creator = "Flex Software Consulting Sdn Bhd";
            workbook.created = new Date();
            workbook.properties.title = "Template";
            workbook.properties.subject = "Import BOM";

            var worksheet = workbook.addWorksheet("Sheet1");
            var book_header = [
                ["Finished Goods", "Description"],
                [],
                [],
                ["Sub Item", "Qty", "Remark"]
            ];

            book_header.forEach(function(row) {
                worksheet.addRow(row);
            });
            worksheet.columns = [
                { width: 15 },
                { width: 15 },
                { width: 15 }
            ];

            // worksheet.getRow(1).font = { bold: true };
            // worksheet.getRow(4).font = { bold: true };

            workbook.xlsx.writeBuffer().then(function(buffer) {
                var blob = new Blob([buffer], { type: "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" });

                var link = document.createElement("a");
                link.href = URL.createObjectURL(blob);
                link.download = "BOM_TEMPLATE.xlsx";
                link.click();
                URL.revokeObjectURL(link.href);
            }).catch(function(err) {
                console.error("Error creating Excel file:", err);
            });
        }

        function triggerFileInput() {
            const input = document.getElementById('fileInput');
            input.ariaValueMax = "";
            input.dataset.source
            input.click();
        }

        function handleFileUpload(event) {
            const file = event.target.files[0];
            const source = event.target.dataset.source;

            if (!file) return;
            
            const fileExtension = file.name.split('.').pop().toLowerCase();
            if (fileExtension !== 'xlsx' && fileExtension !== 'xls') {
                alert("Only XLSX and XLS files are supported.");
                return;
            }

            const reader = new FileReader();
            reader.onload = function(e) {
                const content = e.target.result;
                originalFileContent = content;
                processFileContent(content, source)
                    .then((excelData) => {
                        saveExcelBOM(excelData);
                    })
                    .catch((err) => {
                        console.error("Error processing the file:", err);
                    })
                    .finally(function() {
                        fileInput.value = '';
                    });
            };
            reader.readAsArrayBuffer(file);
        }

        function processFileContent(arraybuffer, source) {
            const workbook = new ExcelJS.Workbook();
            return workbook.xlsx.load(arraybuffer).then(function() {
                const worksheet = workbook.worksheets[0];

                if (!worksheet) {
                    alert("The upload file appears to be empty.");
                    return;
                }

                const finishedGood = worksheet.getRow(2).getCell(1).value || "";
                const description = worksheet.getRow(2).getCell(2).value || "";

                if (!finishedGood) {
                    alert("Finished Good is missing.");
                    return;
                }

                let headerRow = -1;
                for (let r = 1; r <= 50; r++) {
                    const cellVal = worksheet.getRow(r).getCell(1).value;
                    if (cellVal && String(cellVal).toLowerCase().trim() === "sub item") {
                        headerRow = r;
                        break;
                    }
                }

                if (headerRow === -1) {
                    alert("Invalid template: 'Sub Item' header not found.");
                    return;
                }

                const subItems = [];
                let rowNum = headerRow + 1;
                while (worksheet.getRow(rowNum).getCell(1).value) {
                    subItems.push({
                        ExcelRowNo: rowNum,
                        ItemCode: worksheet.getRow(rowNum).getCell(1).value || "",
                        Quantity: Number(worksheet.getRow(rowNum).getCell(2).value || 0),
                        Remark: String(worksheet.getRow(rowNum).getCell(3).value || "")
                    });
                    rowNum++;
                }

                if (subItems.length === 0) {
                    alert("No sub items found.");
                    return;
                }

                const excelData = {
                    FinishedGoods: finishedGood,
                    Description: description,
                    SubItems: subItems
                };

                // console.log("Parsed BOM:", excelData);
                return excelData;
            }).catch(function(err) {
                console.error("Error processing the file:", err);
                throw err;
            });
        }

        function saveExcelBOM(excelData) {
            $.ajax({
                url: '/BOM/SaveExcelBOM',
                type: 'POST',
                data: JSON.stringify(excelData),
                dataType: 'JSON',
                contentType: 'application/json; charset=utf-8',
                beforeSend: function () {
                    Swal.fire({
                        text: 'Please Wait',
                        width: '300px',
                        allowEscapeKey: false,
                        allowOutsideClick: false,
                        showConfirmButton: false,
                    });
                    Swal.showLoading()
                },
                success: function (result) {
                    // console.log(result);

                    if (result.success == true) {
                        Swal.fire({
                            icon: 'success',
                            title: "Success Update",
                            text: "",
                            didClose: () => {
                                window.location.reload();
                            }
                        });
                    }
                    else {
                        if (result.data && result.data.subItems.length > 0) {
                            generateErrorExcelFile(originalFileContent, result.data);
                            Swal.fire({
                                icon: 'warning',
                                title: "Validation Issues Found",
                                text: "Review on returned file and fix errors."
                            });

                        } else {
                            Swal.fire({
                                icon: 'error',
                                title: "Wait",
                                text: result.errMessage
                            });
                        }
                    }
                },
                error: function (error) {
                    // console.log(error);
                    Swal.fire({
                        icon: 'error',
                        title: "Wait",
                        text: error.val
                    });
                }
            });
        }

        function generateErrorExcelFile(buffer, errorData) {

            const workbook = new ExcelJS.Workbook();
            workbook.xlsx.load(buffer).then(() => {
                var worksheet = workbook.worksheets[0];
                var headerRowNumber = -1;
                for (let r = 1; r <= 50; r++) {
                    const cellValue = worksheet.getCell(`A${r}`).value;
                    if (cellValue && cellValue.toString().toLowerCase().trim() === "sub item") {
                        headerRowNumber = r;
                        break;
                    }
                }

                if (headerRowNumber === -1) {
                    alert("Header 'sub item' not found");
                    return;
                }

                const headerCell = worksheet.getCell(`D${headerRowNumber}`);
                headerCell.value = "Error Message";
                headerCell.font = { bold: true };

                const errorFill = {
                    type: "pattern",
                    pattern: "solid",
                    fgColor: { argb: "FFFFC7CE" }
                };
                const errorFont = { color: {argb: "FF9C0006" } };

                if (errorData.errorMsg) {
                    const fgErrorCell = worksheet.getCell("D2");
                    fgErrorCell.value = errorData.errorMsg;
                    fgErrorCell.fill = errorFill;
                    fgErrorCell.font = errorFont;
                }
                else 
                {
                    errorData.subItems.forEach(item => {
                        if (item.dtlErrorMsg) {
                            const rowNumber = item.excelRowNo;
                            const cell = worksheet.getCell(`D${rowNumber}`);
                            cell.value = item.dtlErrorMsg;
                            cell.fill = errorFill;
                            cell.font = errorFont;
                        }
                    });
                }

                worksheet.columns = [
                    { width: 20 },
                    { width: 12 },
                    { width: 18 }, 
                    { width: 50 }
                ];

                workbook.xlsx.writeBuffer().then(function(buffer) {
                    const blob = new Blob([buffer], { type: "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" });
                    const link = document.createElement("a");
                    link.href = URL.createObjectURL(blob);
                    link.download = `BOM_IMPORT_ERRORS_${new Date().toISOString().slice(0,10)}.xlsx`;
                    link.click();
                });

            }).catch(err => {
                console.error("Error loading workbook:", err);
            });
        }

        // function extendSheetRange(sheet, colIndex, rowIndex) {
