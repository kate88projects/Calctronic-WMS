@using RackingSystem.Models.BOM
@model BOMListDTO
@{
    string mode = ViewBag.Mode;
}

<div class="tw:space-y-4">
    <div class="tw:rounded-xl tw:border tw:border-gray-200 tw:bg-white tw:px-6 tw:py-4 tw:dark:border-gray-800 tw:dark:bg-white/[0.03]">
        <div class="tw:flex tw:items-center tw:justify-between tw:gap-4">
            <div>
                <h2 class="tw:text-lg tw:font-semibold tw:text-gray-800 tw:dark:text-white/90">BOM Details</h2>
                <p class="tw:mb-0 tw:text-sm tw:text-gray-500 tw:dark:text-gray-400">BOM details &middot; created @Model.CreatedDate.ToString("yyyy-MM-dd")</p>
            </div>
            <div class="tw:flex tw:gap-3">
                <button type="button" id="backButton" class="tw:inline-flex tw:shrink-0 tw:items-center tw:gap-2 tw:rounded-lg tw:border tw:border-gray-300 tw:bg-white tw:px-4 tw:py-2.5 tw:text-sm tw:font-medium tw:text-gray-700 tw:transition-colors
                        tw:hover:bg-gray-50 tw:dark:border-gray-700 tw:dark:bg-white/5 tw:dark:text-gray-300 tw:dark:hover:bg-white/10" onclick="returnToBOM()" @(mode == "view" ? "" : "hidden")>
                    <i class="bi bi-arrow-left"></i>
                    Back
                </button>
                <button type="button" id="editButton" class="tw:inline-flex tw:shrink-0 tw:items-center tw:gap-2 tw:rounded-lg tw:border tw:border-yellow-300 tw:bg-yellow-50 tw:px-4 tw:py-2.5 tw:text-sm tw:font-medium tw:text-yellow-700 tw:transition-colors
                        tw:hover:bg-yellow-100 tw:dark:border-yellow-800 tw:dark:bg-yellow-500/15 tw:dark:text-yellow-400 tw:dark:hover:bg-yellow-500/25" onclick="enabledEdit()" @(mode == "view" ? "" : "hidden")>
                    <i class="bi bi-pencil"></i>
                    Edit
                </button>
            </div>

        </div>
    </div>

 
    <form id="bomForm" method="post" data-bom-id="@Model.BOM_Id" class="tw:space-y-4">
        <div class="tw:rounded-xl tw:border tw:border-gray-200 tw:bg-white tw:px-6 tw:py-4 tw:dark:border-gray-800 tw:dark:bg-white/[0.03]">
            <div class="tw:mb-4 tw:flex tw:items-center tw:gap-2">
                <i class="bi bi-file-earmark tw:text-lg tw:text-black tw:dark:text-white/90"></i>
                <span class="tw:text-base tw:font-semibold tw:text-gray-800 tw:dark:text-white/90">Overview</span>
            </div>
            <div class="tw:grid tw:grid-cols-2 tw:gap-4">
                <div>
                    <label class="tw:mb-1.5 tw:block tw:text-sm tw:font-medium tw:text-gray-500 tw:dark:text-gray-400" for="bomName">Finished Goods</label>
                    <div class="tw:relative" x-data="customSelect('bomName')" @@click.outside="open = false">
                        <select class="tw:hidden" id="bomName" onchange="removeErrMsg(this.id)"></select>
                        <button type="button" id="bomNamePickerBtn" @@click="toggle()"
                            class="tw:box-border tw:flex tw:h-[40px] tw:w-full tw:items-center tw:justify-between tw:gap-2 tw:rounded-lg tw:border tw:bg-transparent tw:px-4 tw:text-left tw:text-sm tw:text-gray-800
                            tw:disabled:cursor-not-allowed tw:disabled:bg-gray-100 tw:disabled:text-gray-500 tw:dark:bg-gray-900 tw:dark:text-white/90 tw:dark:disabled:bg-white/5"
                            :class="hasError ? 'tw:border-error-500' : (open ? 'tw:border-brand-300 tw:ring-3 tw:ring-brand-500/10' : 'tw:border-gray-300 tw:dark:border-gray-700')"
                            @(mode == "view" ? "disabled" : "")>
                            <span class="tw:truncate" x-text="selectedLabel || 'Select an option'" :class="selectedLabel ? '' : 'tw:text-gray-400 tw:dark:text-white/30'"></span>
                            <i class="bi bi-chevron-down tw:shrink-0 tw:text-xs tw:text-gray-500 tw:transition-transform tw:dark:text-gray-400" :class="open ? 'tw:rotate-180' : ''"></i>
                        </button>
                        <div x-show="open" x-transition style="display: none;"
                            class="tw:absolute tw:z-50 tw:w-full tw:overflow-hidden tw:rounded-lg tw:border tw:border-gray-200 tw:bg-white tw:shadow-theme-lg tw:dark:border-gray-700 tw:dark:bg-gray-900"
                            :class="dropUp ? 'tw:bottom-full tw:mb-1' : 'tw:top-full tw:mt-1'">
                            <div class="tw:border-b tw:border-gray-100 tw:p-2 tw:dark:border-gray-800">
                                <input type="text" x-ref="search" x-model="search" class="tw:w-full tw:rounded-md tw:border tw:border-gray-300 tw:px-3 tw:py-1.5 tw:text-sm tw:text-gray-800 tw:outline-none
                                    tw:focus:border-brand-300 tw:dark:border-gray-700 tw:dark:bg-gray-800 tw:dark:text-white/90" placeholder="Search finished goods...">
                            </div>
                            <div class="custom-select-scroll tw:max-h-52 tw:overflow-y-auto tw:py-1">
                                <template x-if="filteredOptions.length === 0">
                                    <div class="tw:px-4 tw:py-2 tw:text-sm tw:text-gray-400 tw:dark:text-white/30">No matches</div>
                                </template>
                                <template x-for="opt in filteredOptions" :key="opt.value">
                                    <div @@click="select(opt)"
                                        class="tw:cursor-pointer tw:px-4 tw:py-2 tw:text-sm tw:hover:bg-brand-50 tw:dark:hover:bg-brand-500/15"
                                        :class="opt.value === selectedValue ? 'tw:bg-brand-50 tw:font-medium tw:text-brand-600 tw:dark:bg-brand-500/15 tw:dark:text-brand-400' : 'tw:text-gray-700 tw:dark:text-gray-300'"
                                        x-text="opt.text"></div>
                                </template>
                            </div>
                        </div>
                    </div>
                    <div id="bomNameError" class="error-message"></div>
                </div>
                <div>
                    <label class="tw:mb-1.5 tw:block tw:text-sm tw:font-medium tw:tracking-wide tw:text-gray-500 tw:dark:text-gray-400" for="txtdesc">Description</label>
                    <input type="text" class="tw:w-full tw:rounded-lg tw:border tw:border-gray-300 tw:bg-transparent tw:px-4 tw:py-2.5 tw:text-sm tw:text-gray-800 tw:placeholder:text-gray-400
                                tw:focus:border-brand-300 tw:focus:ring-3 tw:focus:ring-brand-500/10 tw:focus:outline-hidden tw:disabled:bg-gray-50 tw:disabled:text-gray-500 tw:h-[40px]
                                tw:dark:border-gray-700 tw:dark:bg-gray-900 tw:dark:text-white/90 tw:dark:placeholder:text-white/30 tw:dark:focus:border-brand-800 tw:dark:disabled:bg-white/5 tw:dark:disabled:text-gray-400"
                           id="txtdesc" placeholder="description" value="@Model.Description" @(mode == "view" ? "disabled" : "")>
                    <div id="txtdescError" class="error-message"></div>
                </div>
                @* <div class="col-3">
                    <label for="txtCreatedBy">Created By</label>
                    <input type="text" class="form-control" id="txtCreatedBy" placeholder="Please enter created person" value="@Model.CreatedBy" @(mode == "view" ? "disabled" : "")>
                    <div id="txtCreatedByError" class="error-message"></div>
                </div>*@
            </div>

            <div class="tw:mt-4 tw:flex tw:items-start tw:gap-3 tw:rounded-lg tw:border tw:border-gray-200 tw:p-4 tw:dark:border-gray-700">
                <input type="checkbox" class="tw:mt-0.5 tw:h-4 tw:w-4 tw:shrink-0 tw:accent-brand-500" id="chkIsActive" @(Model.IsActive ? "checked" : "") @(mode == "view" ? "disabled" : "")>
                <label for="chkIsActive" class="tw:cursor-pointer">
                    <span class="tw:block tw:text-sm tw:font-medium tw:text-gray-800 tw:dark:text-white/90">Enable BOM</span>
                    <span class="tw:mt-1 tw:block tw:text-sm tw:text-gray-500 tw:dark:text-gray-400">When enabled, this BOM is available for selection when creating job orders.</span>
                </label>
            </div>
        </div>

        <div class="tw:rounded-xl tw:border tw:border-gray-200 tw:bg-white tw:px-6 tw:py-4 tw:dark:border-gray-800 tw:dark:bg-white/[0.03]">
            <div class="tw:flex tw:items-center tw:justify-between">
                <div class="tw:flex tw:items-center tw:gap-2">
                    <i class="bi bi-list-ul tw:text-lg tw:text-black tw:dark:text-white/90"></i>
                    <span class="tw:text-base tw:font-semibold tw:text-black-800 tw:dark:text-white/90">Sub Items</span>
                </div>
                <span id="ttlItemsBadge" class="tw:status-badge tw:bg-gray-100 tw:text-gray-700 tw:dark:bg-white/5 tw:dark:text-gray-400">1 item</span>
            </div>

            <div class="tw:flex tw:items-center tw:gap-3 tw:py-2 tw:px-4 tw:border-b tw:border-gray-100 tw:dark:border-gray-800">
                <span class="tw:w-1/20 tw:text-sm tw:font-medium tw:tracking-wide tw:text-gray-400">#</span>
                <span class="tw:w-10/20 tw:text-sm tw:font-medium tw:tracking-wide tw:text-gray-400">Item</span>
                <span class="tw:w-2/20 tw:text-sm tw:font-medium tw:tracking-wide tw:text-gray-400">Quantity</span>
                <span class="tw:w-6/20 tw:text-sm tw:font-medium tw:tracking-wide tw:text-gray-400">Remark</span>
                <span class="tw:w-1/20"></span>
            </div>

            <div id="itemContainer">
                <div class="item tw:flex tw:gap-3 tw:border-b tw:border-gray-100 tw:px-4 tw:py-2 tw:dark:border-gray-800" data-index="1">
                    <div class="item-index tw:w-1/20 tw:flex tw:items-center tw:shrink-0 tw:text-sm tw:text-gray-400">1</div>
                    <div class="tw:w-10/20">
                        <div class="item-view tw:flex tw:items-center tw:gap-3" @(mode == "view" ? "" : "hidden")>
                            <div class="tw:flex tw:h-9 tw:w-9 tw:shrink-0 tw:items-center tw:justify-center tw:rounded-lg tw:bg-gray-100 tw:text-gray-500 tw:dark:bg-white/5 tw:dark:text-gray-400">
                                <i class="bi bi-box-seam"></i>
                            </div>
                            <span class="item-view-label tw:text-sm tw:font-medium tw:text-gray-800 tw:dark:text-white/90">-</span>
                        </div>
                        <div class="item-select-wrap tw:relative" x-data="customSelect('subItem1')" @@click.outside="open = false" @(mode == "view" ? "hidden" : "")>
                            <select class="tw:hidden" id="subItem1" onchange="removeErrMsg(this.id)"></select>
                            <button type="button" @@click="toggle()"
                                class="tw:box-border tw:flex tw:h-[40px] tw:w-full tw:items-center tw:justify-between tw:gap-2 tw:rounded-lg tw:border tw:bg-transparent tw:px-4 tw:text-left tw:text-sm tw:text-gray-800 tw:dark:bg-gray-900 tw:dark:text-white/90"
                                :class="hasError ? 'tw:border-error-500' : (open ? 'tw:border-brand-300 tw:ring-3 tw:ring-brand-500/10' : 'tw:border-gray-300 tw:dark:border-gray-700')">
                                <span class="tw:truncate" x-text="selectedLabel || 'Select an option'" :class="selectedLabel ? '' : 'tw:text-gray-400 tw:dark:text-white/30'"></span>
                                <i class="bi bi-chevron-down tw:shrink-0 tw:text-xs tw:text-gray-500 tw:transition-transform tw:dark:text-gray-400" :class="open ? 'tw:rotate-180' : ''"></i>
                            </button>
                            <div x-show="open" x-transition style="display: none;"
                                class="tw:absolute tw:z-50 tw:w-full tw:overflow-hidden tw:rounded-lg tw:border tw:border-gray-200 tw:bg-white tw:shadow-theme-lg tw:dark:border-gray-700 tw:dark:bg-gray-900"
                                :class="dropUp ? 'tw:bottom-full tw:mb-1' : 'tw:top-full tw:mt-1'">
                                <div class="tw:border-b tw:border-gray-100 tw:p-2 tw:dark:border-gray-800">
                                    <input type="text" x-ref="search" x-model="search" class="tw:w-full tw:rounded-md tw:border tw:border-gray-300 tw:px-3 tw:py-1.5 tw:text-sm tw:text-gray-800 tw:outline-none
                                        tw:focus:border-brand-300 tw:dark:border-gray-700 tw:dark:bg-gray-800 tw:dark:text-white/90" placeholder="Search product...">
                                </div>
                                <div class="custom-select-scroll tw:max-h-52 tw:overflow-y-auto tw:py-1">
                                    <template x-if="filteredOptions.length === 0">
                                        <div class="tw:px-4 tw:py-2 tw:text-sm tw:text-gray-400 tw:dark:text-white/30">No matches</div>
                                    </template>
                                    <template x-for="opt in filteredOptions" :key="opt.value">
                                        <div @@click="select(opt)"
                                            class="tw:cursor-pointer tw:px-4 tw:py-2 tw:text-sm tw:hover:bg-brand-50 tw:dark:hover:bg-brand-500/15"
                                            :class="opt.value === selectedValue ? 'tw:bg-brand-50 tw:font-medium tw:text-brand-600 tw:dark:bg-brand-500/15 tw:dark:text-brand-400' : 'tw:text-gray-700 tw:dark:text-gray-300'"
                                            x-text="opt.text"></div>
                                    </template>
                                </div>
                            </div>
                        </div>
                        <div id="subItem1Error" class="error-message"></div>
                    </div>

                    <div class="tw:w-2/20">
                        <input type="number" class="tw:box-border tw:h-[40px] tw:w-full tw:rounded-lg tw:border tw:border-gray-300 tw:bg-transparent tw:px-3 tw:text-center tw:text-sm tw:font-medium tw:text-gray-800
                            tw:focus:border-brand-300 tw:focus:ring-3 tw:focus:ring-brand-500/10 tw:focus:outline-hidden tw:disabled:border-transparent tw:disabled:bg-gray-100
                            tw:disabled:font-medium tw:disabled:text-gray-700 tw:dark:border-gray-700 tw:dark:bg-gray-900 tw:dark:text-white/90 tw:dark:disabled:bg-white/5 tw:dark:disabled:text-gray-300"
                               id="txtQty1" placeholder="0" @(mode == "view" ? "disabled" : "") required oninput="removeErrMsg(this.id)">
                        <div id="txtQty1Error" class="error-message"></div>
                    </div>

                    <div class="tw:w-6/20">
                        <input type="text" class="tw:box-border tw:h-[40px] tw:w-full tw:rounded-lg tw:border tw:border-gray-300 tw:bg-transparent tw:px-3 tw:text-sm tw:font-medium tw:text-gray-800
                            tw:focus:border-brand-300 tw:focus:ring-3 tw:focus:ring-brand-500/10 tw:focus:outline-hidden tw:disabled:border-transparent tw:disabled:bg-gray-100
                            tw:disabled:font-medium tw:disabled:text-gray-700 tw:dark:border-gray-700 tw:dark:bg-gray-900 tw:dark:text-white/90 tw:dark:disabled:bg-white/5 tw:dark:disabled:text-gray-300"
                               id="txtRemark1" @(mode == "view" ? "disabled" : "") required>
                        <div id="txtRemark1Error" class="error-message"></div>
                    </div>

                    <div class="tw:w-1/20">
                        <button class="remove-item-btn tw:box-border tw:inline-flex tw:h-[40px] tw:w-[40px] tw:items-center tw:justify-center tw:rounded-lg tw:border tw:border-gray-200 tw:bg-white tw:text-gray-400 tw:transition-colors
                            tw:hover:border-error-200 tw:hover:bg-error-50 tw:hover:text-error-600 tw:dark:border-gray-700 tw:dark:bg-white/[0.03]"
                                type="button" onclick="removeItem(this)" title="Remove" @(mode == "view" ? "hidden" : "")>
                            <i class="bi bi-trash"></i>
                        </button>
                    </div>
                    <input type="hidden" id="txtBomDtlId1">
                </div>
            </div>

            <button id="addSub" type="button" class="tw:mt-2 tw:flex tw:w-full tw:items-center tw:justify-center tw:gap-2 tw:rounded-lg tw:border tw:border-dashed tw:border-gray-300 tw:bg-gray-50 tw:px-4 tw:py-3 tw:text-sm tw:font-medium tw:text-gray-600 tw:transition-colors
                tw:hover:border-brand-300 tw:hover:bg-brand-50 tw:hover:text-brand-600 tw:dark:border-gray-700 tw:dark:bg-white/[0.02] tw:dark:text-gray-400 tw:dark:hover:border-brand-800 tw:dark:hover:bg-brand-500/10 tw:dark:hover:text-brand-400"
                tabindex="0" onclick="addSubItem()" @(mode == "view" ? "hidden" : "")>
                <i class="bi bi-plus-circle"></i>
                Add Item
            </button>

            <div class="tw:mt-4 tw:flex tw:justify-end tw:gap-3 tw:text-sm tw:dark:border-gray-800">
                <span class="tw:font-medium tw:text-brand-600 tw:dark:text-brand-400">Total Quantity</span>
                <span id="ttlQty" class="tw:rounded-lg tw:min-w-12 tw:bg-gray-100 tw:justify-center tw:status-badge tw:bg-gray-800 tw:text-white tw:dark:bg-white/10">0</span>
            </div>
        </div>

        <div class="tw:flex tw:justify-end tw:gap-3 tw:rounded-xl">
            <button class="save-btn tw:border-0 tw:rounded-lg tw:bg-brand-500 tw:px-4 tw:py-2.5 tw:text-sm tw:font-medium tw:text-white tw:shadow-theme-xs tw:hover:bg-brand-600" 
                id="saveButton" @(mode == "view" ? "hidden" : "")>Save</button>
            <button type="button" class="cancel-btn tw:bg-transparent tw:rounded-lg tw:border tw:border-gray-300 tw:px-4 tw:py-2.5 tw:text-sm tw:font-medium tw:text-gray-700 tw:hover:bg-gray-100
                tw:dark:border-gray-700 tw:dark:text-gray-400 tw:dark:hover:bg-white/5" onclick="returnToBOM()" @(mode == "view" ? "hidden" : "")>Cancel</button>
        </div>
    </form>     
</div>


@section Scripts {
    <link rel="stylesheet" href="~/css/sweetalert2.min.css">

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/js/sweetalert2.all.min.js"></script>

    <script type="text/javascript">
        let itemIndex = 1;
        let mode = "@mode";

        const itemPickerHtml = document.querySelector('#itemContainer .item-select-wrap').innerHTML;
        let itemList = [];
        let finishedItemList = [];

        $(document).ready(function() {

             loadItems().then(() => {
                loadDetails();
            }).catch((error) => {
                Swal.fire({
                    icon: 'error',
                    title: 'Error',
                    text: error
                });
            });

            $('#itemContainer').on('input', 'input[type="number"]', updateTotals);
        });

        function customSelect(selectId) {
            return {
                open: false,
                dropUp: false,
                options: [],
                selectedValue: '',
                selectedLabel: '',
                hasError: false,
                search: '',
                get filteredOptions() {
                    const term = this.search.trim().toLowerCase();
                    return this.options.filter(o => o.text.toLowerCase().includes(term));
                },
                init() {
                    this.syncOptions();
                    const sel = document.getElementById(selectId);
                    if (!sel) return;
                    this.hasError = sel.classList.contains('is-invalid');
                    new MutationObserver(() => {
                        this.hasError = sel.classList.contains('is-invalid');
                    }).observe(sel, { attributes: true, attributeFilter: ['class'] });
                },
                toggle() {
                    this.open = !this.open;
                    if (this.open) {
                        this.search = '';
                        this.syncOptions();
                        const rect = this.$el.getBoundingClientRect();
                        const spaceBelow = window.innerHeight - rect.bottom;
                        this.dropUp = spaceBelow < 280 && rect.top > spaceBelow;
                        this.$nextTick(() => this.$refs.search?.focus());
                    }
                },
                syncOptions() {
                    const sel = document.getElementById(selectId);
                    if (!sel) return;
                    this.options = Array.from(sel.options)
                        .filter(o => o.value !== '')
                        .map(o => ({ value: o.value, text: o.textContent.trim() }));
                    this.selectedValue = sel.value;
                    const selectedOpt = sel.options[sel.selectedIndex];
                    this.selectedLabel = selectedOpt && selectedOpt.value !== '' ? selectedOpt.textContent.trim() : '';
                },
                select(opt) {
                    const sel = document.getElementById(selectId);
                    sel.value = opt.value;
                    this.selectedValue = opt.value;
                    this.selectedLabel = opt.text;
                    this.open = false;
                    sel.dispatchEvent(new Event('change'));
                }
            };
        }

        function refreshCustomSelect(selectId) {
            const sel = document.getElementById(selectId);
            const root = sel ? sel.closest('[x-data]') : null;
            if (root && window.Alpine) {
                Alpine.$data(root).syncOptions();
            }
        }

        function fillItemOptions(select, list) {
            select.innerHTML = '<option value=""></option>' + list
                .map(item => `<option value="${item.item_Id}">${item.itemCode ?? ''}</option>`)
                .join('');
        }

        function loadItems() {
            return Promise.all([getFinishedItemList(), getRawItemList()]);
        }


        function loadDetails() {
            var bomForm = document.querySelector('#bomForm');
            var bomId = bomForm.getAttribute('data-bom-id');

            $.ajax({
                url: '/BOM/GetBOMDetail',
                type: 'POST',
                data: JSON.stringify(bomId),
                dataType: 'JSON',
                contentType: 'application/json; charset=utf-8',
                success: function (result) {
                    if (result.success == true) {
                        const bomDtls = result.data.map(function (i) {
                            return {
                                bomId: i.boM_Id,
                                bomDetailId: i.bomDetail_Id,
                                itemId: i.item_Id,
                                qty: i.qty,
                                remark: i.remark,
                            };
                        });

                        const container = document.getElementById("itemContainer");
                        const items = container.querySelectorAll(".item");
                        const itemCount = items.length;

                        bomDtls.forEach((dtl, index) => {
                            if (index === 0) {
                                const firstItem = container.querySelector(".item");
                                const select = firstItem.querySelector("select");
                                const qtyInput = firstItem.querySelector('input[type="number"]');
                                const remarkInput = firstItem.querySelector('input[id^="txtRemark"]');
                                const detailId = firstItem.querySelector('input[type="hidden"]');

                                select.value = dtl.itemId;
                                refreshCustomSelect(select.id);
                                qtyInput.value = dtl.qty;
                                remarkInput.value = dtl.remark;
                                detailId.value = dtl.bomDetailId;
                                setItemViewLabel(firstItem, dtl.itemId);

                            } else if (itemCount < bomDtls.length) {
                                createNewInputField(dtl, index+1, true);
                            }
                        });
                        itemIndex = bomDtls.length == 0 ? itemIndex : bomDtls.length;

                        renumberItems();
                        updateTotals();
                    }
                    else {
                        Swal.fire({
                            icon: 'error',
                            title: "Wait",
                            text: result.errMessage
                        });
                    }
                },
                error: function (error) {
                    Swal.fire({
                        icon: 'error',
                        title: "Wait",
                        text: error.val
                    });
                }
            });
        }

        function getFinishedItemList() {
            return new Promise((resolve, reject) => {
                $.ajax({
                    url: "/Item/GetFinishedItemList/",
                    type: "GET",
                    dataType: 'JSON',
                    contentType: 'application/json; charset=utf-8',
                    success: function (result) {
                        if (!result.success) {
                            reject(result.errMessage);
                            return;
                        }

                        finishedItemList = result.data;

                        const dropdown = document.getElementById('bomName');
                        fillItemOptions(dropdown, finishedItemList);

                        const itemId = @Model.Item_Id;
                        if (itemId) {
                            dropdown.value = itemId;
                        }
                        refreshCustomSelect('bomName');
                        resolve();
                    },
                    error: function (error) {
                        reject("Failed to load finished items.");
                    }
                });
            });
        }

        function getRawItemList () {
            return new Promise((resolve, reject) => {
                $.ajax({
                    url: "/Item/GetRawItemList/",
                    type: "GET",
                    dataType: 'JSON',
                    contentType: 'application/json; charset=utf-8',
                    success: function (result) {
                        if (!result.success) {
                            reject(result.errMessage);
                            return;
                        }

                        itemList = result.data;
                        fillItemOptions(document.getElementById('subItem1'), itemList);
                        refreshCustomSelect('subItem1');
                        resolve();
                    },
                    error: function () {
                        reject("Failed to load raw items.");
                    }
                });
            });
        }

        function getItemCodeById(id) {
            const found = itemList.find(i => i.item_Id == id);
            return found ? found.itemCode : '-';
        }

        function setItemViewLabel(itemEl, itemId) {
            const label = itemEl.querySelector('.item-view-label');
            if (label) label.textContent = getItemCodeById(itemId);
        }

        function addSubItem() {
           itemIndex++;
           createNewInputField(null, itemIndex, false);
           renumberItems();
           updateTotals();
        };

        function createNewInputField(dtl, index, isEditing = false) {
            const container = document.getElementById("itemContainer");
            const firstItem = container.querySelector(".item");

            const newItem = firstItem.cloneNode(true);

            const pickerWrap = newItem.querySelector('.item-select-wrap');
            pickerWrap.innerHTML = itemPickerHtml;
            pickerWrap.setAttribute('x-data', `customSelect('subItem${index}')`);
            pickerWrap.querySelector('select').innerHTML = firstItem.querySelector('select').innerHTML;

            const select = newItem.querySelector("select");
            const qtyInput = newItem.querySelector('input[type="number"]');
            const remarkInput = newItem.querySelector('input[id^="txtRemark"]');
            const detailId = newItem.querySelector('input[type="hidden"]');

            const newItemIndex = index;
            select.id = `subItem${newItemIndex}`;
            qtyInput.id = `txtQty${newItemIndex}`;
            remarkInput.id = `txtRemark${newItemIndex}`;
            detailId.id = `txtBomDtlId${newItemIndex}`;

            newItem.querySelector('.item-index').textContent = index;

            select.value = isEditing == true ? dtl.itemId : "";
            qtyInput.value = isEditing == true ? dtl.qty : "";
            remarkInput.value = isEditing == true ? dtl.remark : "";
            detailId.value = isEditing == true ? dtl.bomDetailId : "";

            updateErrorIds(newItem, index);
            container.appendChild(newItem);

            if (isEditing) {
                setItemViewLabel(newItem, dtl.itemId);
            }
            removeErrMsg([`subItem${newItemIndex}`, `txtQty${newItemIndex}`, `txtRemark${newItemIndex}`]);

        };

        function updateErrorIds(item, index) {
            const prefixes = ['subItem', 'txtQty', 'txtRemark'];
            item.querySelectorAll('.error-message').forEach((el, i) => {
                el.id = `${prefixes[i]}${index}Error`;
                el.textContent = '';
            });
        }

        function removeItem(icon) {
            const item = icon.closest('.item');
            const container = document.getElementById("itemContainer");
            const items = container.querySelectorAll(".item");
            const itemCount = items.length;

            if (itemCount > 1)
            {
                item.remove();
            } else {
                Swal.fire({
                    icon: 'info',
                    title: "Cannot Remove",
                    text: "At least one sub-item must remain."
                });
            }

            renumberItems();
            updateTotals();
        };

        function renumberItems() {
            document.querySelectorAll('#itemContainer .item .item-index').forEach((el, idx) => {
                el.textContent = idx + 1;
            });
        }

        function updateTotals() {
            const items = document.querySelectorAll('#itemContainer .item');
            let totalQty = 0;
            items.forEach(item => {
                const v = parseFloat(item.querySelector('input[type="number"]').value);
                if (!isNaN(v)) totalQty += v;
            });

            document.getElementById('ttlItemsBadge').textContent = items.length + (items.length === 1 ? ' item' : ' items');
            document.getElementById('ttlQty').textContent = totalQty;
        }

        function returnToBOM() {
            window.history.back();
        }

        document.getElementById("saveButton").addEventListener("click", function(event) {
            event.preventDefault();
            saveBOM();
        });

        function saveBOM() {
            const items = document.querySelectorAll('#itemContainer .item');
            const formData = [];
            let isValid = true;

            removeErrMsg('bomName');
            const finishedItemId = $('#bomName').val();
            if (!finishedItemId) {
                isValid = false;
                showError('bomName', 'Please choose a finished good.');
            }

            items.forEach(item => {
                const selectEl = item.querySelector("select");
                const qtyEl = item.querySelector('input[type="number"]');
                const remarkEl = item.querySelector('input[id^="txtRemark"]');
                const hiddenEl = item.querySelector('input[type="hidden"]');

                removeErrMsg([selectEl.id, qtyEl.id, remarkEl.id]);
                const subitem = selectEl.value;
                const qty = qtyEl.value;
                const remark = remarkEl.value;
                const bomDtlId = hiddenEl.value;

                if (!subitem) {
                    isValid = false;
                    showError(selectEl.id, "Please choose a raw item.");
                }
                if (!qty || isNaN(qty) || qty <=0) {
                    isValid = false;
                    showError(qtyEl.id, "Please enter a valid quantity (number >= 1)");
                }

                formData.push({
                    BOMDetail_Id: parseInt(bomDtlId) || 0,
                    BOM_Id: parseInt(@Model.BOM_Id) || 0,
                    Item_Id: parseInt(subitem),
                    Qty: parseInt(qty),
                    Remark: remark
                });
            });

            if (isValid) {
               var bomData = {
                    BOM_Id: parseInt(@Model.BOM_Id)  || 0,
                    Item_Id: parseInt(finishedItemId) || 0,
                    Description: $('#txtdesc').val(),
                    IsActive: $('#chkIsActive').prop('checked'),
                    SubItems: formData,
               };

                $.ajax({
                    url: '/BOM/SaveBOM',
                    type: 'POST',
                    data: JSON.stringify(bomData),
                    dataType: 'JSON',
                    contentType: 'application/json; charset=utf-8',
                    beforeSend: function () {
                        Swal.fire({
                            text: 'Please Wait',
                            width: '300px',

                            allowEscapeKey: false,
                            allowOutsideClick: false,
                            showConfirmButton: false,
                        });
                        Swal.showLoading()
                    },
                    success: function (result) {
                        if (result.success == true) {
                            Swal.fire({
                                icon: 'success',
                                title: "Success Save",
                                text: "",
                                didClose: () => {
                                  // window.location.reload();
                                  window.history.back();
                                }
                            });
                        }
                        else {
                            Swal.fire({
                                icon: 'error',
                                title: "Wait",
                                text: result.errMessage
                            });
                        }
                    },
                    error: function (error) {
                        Swal.fire({
                            icon: 'error',
                            title: "Wait",
                            text: error.val
                        });
                    }
                });
            }

            // console.log(bomData);
        }

        function showError(fieldId, message) {
            document.getElementById(fieldId).classList.add('is-invalid');
            document.getElementById(fieldId + 'Error').textContent = message;
        }

        function removeErrMsg(fields, clearValue = false) {
            if (fields != null)
            {
                if (!Array.isArray(fields)) {
                    fields = [fields];
                }
                fields.forEach(function(field) {
                    document.getElementById(field).classList.remove('is-invalid');
                    document.getElementById(field).classList.remove('is-valid');
                    document.getElementById(field + 'Error').textContent = '';
                    if (clearValue) document.getElementById(field).value = '';
                });
            }
        }

        function enabledEdit() {
            mode = 'edit';

            const form = document.getElementById('bomForm');
            const elements = form.querySelectorAll('input, select, button');

            elements.forEach(el => {
                if (el.type != 'hidden') {
                    el.disabled = false;
                    el.hidden = false;
                }
            });

            document.getElementById('saveButton')?.removeAttribute('hidden');
            document.getElementById('addSub')?.removeAttribute('hidden');

            document.querySelectorAll('.remove-item-btn').forEach(btn => {
                btn.removeAttribute('hidden');
            });

            document.querySelectorAll('.item-view').forEach(el => { el.hidden = true; });
            document.querySelectorAll('.item-select-wrap').forEach(el => { el.hidden = false; });

            document.getElementById('editButton')?.setAttribute('hidden', 'true');
            document.getElementById('backButton')?.setAttribute('hidden', 'true');

        }

    </script>
}
