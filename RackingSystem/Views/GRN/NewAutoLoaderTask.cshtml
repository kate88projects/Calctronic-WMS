        <div class="modal-content tw:rounded-2xl tw:border-0 tw:bg-white tw:p-8 tw:shadow-theme-lg tw:dark:bg-gray-900">
            <div class="tw:grid tw:grid-cols-2 tw:items-center tw:gap-6">
