@section Scripts
{
    <link rel="stylesheet" href="~/css/sweetalert2.min.css">

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/js/sweetalert2.all.min.js"></script>

    <script type="text/javascript">

        let taskLoad = false;
        let stopDecision = false;
        let stopTimer = null;
        let token = "@ViewBag.xToken";

        // -- get loader info --
        const scanLoaderEle = document.getElementById('txtScanLoader');
        scanLoaderEle.addEventListener('keyup', function(event) {
          // Check if the pressed key is "Enter" (key code 13 or key property "Enter")
          if (event.key === 'Enter') {
            $('#loadStatus1').text('');
            $('#err1').text('');
            const inputValue = this.value;
            var code = inputValue;
            $.ajax({
                url: "/Loader/GetLoaderInfo_ReadyToLoad?req=" + code,
                type: "GET",
                dataType: 'JSON',
                contentType: 'application/json; charset=utf-8',
                beforeSend: function () {
                    Swal.fire({
                        text: 'Please Wait',
                        width: '300px',
                        allowEscapeKey: false,
                        allowOutsideClick: false,
                        showConfirmButton: false,
                    });
                    Swal.showLoading()
                },
                success: function (result) {
                    Swal.close();
                    if (result.success == true) {
                        addLoader(0, result.data.loader_Id, result.data.loaderCode);
                    }
                    else {
                        $('#err1').text(result.errMessage);
                    }
                },
                error: function (error) {
                    $('#err1').text(error.val);
                }
            });
          }
        });

        // -- scan reel ID --
        const scanItemEle = document.getElementById('txtScanItem');
        scanItemEle.addEventListener('keyup', function(event) {
          // Check if the pressed key is "Enter" (key code 13 or key property "Enter")
          if (event.key === 'Enter') {
            const inputValue = this.value;

            $("#txtReelCode").val(inputValue);
            $("#itemModal").modal("toggle");
            loadPLC(3);
          }
        });

        $(document).ready(function () {
            resetColorPLCForm(1);
            newReel();
            loadLoaderList();

            $("#txtLoaderId").val('');
            $("#txtICol").val(1);
            document.getElementById("btnStop").setAttribute("disabled", "true");
            document.getElementById("btnEnd").setAttribute("disabled", "true");

            scanLoaderEle.focus();
            initialGaugeSetup(
                "svg-graph-meter-value",
                "svg-gauge-percentage-2",
                "rgb(228, 0, 0)",
                0,
                setGaugePathValue
            );
        });

        function clearLoaderScanCode() {
            const inputFields = ['#txtScanLoader', '#txtLoaderId', '#txtLoaderCode'];
            inputFields.forEach(i => $(i).val(''));

            scanLoaderEle.focus();
        }

        function clearItemScanCode() {
            const fields = ['#txtScanItem', '#txtReelCode', '#txtHReelID', '#txtHItem', '#txtHExtH', '#txtHActH'];
            fields.forEach(i => $(i).val(''));

            scanItemEle.focus();
        }

        function restartStep() {
            resetColorPLCForm(1);
            newReel();
            $('#loadStatus1').text('');
            $("#txtScanLoader").val('');
            $("#txtICol").val(1);
            // document.getElementById("btnChangeReel").setAttribute("disabled", "true");
            document.getElementById("btnStop").setAttribute("disabled", "true");
            document.getElementById("btnEnd").setAttribute("disabled", "true");
            taskLoad = false;

            const fields = ['#txtLoaderId', '#txtLoaderCode', '#txtScanLoader', '#loaderName'];
            fields.forEach(i => $(i).val(''));
            scanLoaderEle.focus();

            initialGaugeSetup(
                "svg-graph-meter-value",
                "svg-gauge-percentage-2",
                "rgb(228, 0, 0)",
                0,
                setGaugePathValue
            );

            for (let i = 1; i <= 4; i++)
            {
                if ($(`#icon-c${i}`).hasClass("bi bi-fire"))
                {
                    $(`#icon-c${i}`).removeClass("bi bi-fire");
                    $('#c' + i).removeClass("tw:bg-warning-500 tw:animate-pulse");
                    $('#c' + i).addClass("tw:bg-success-500");
                }
                else if ($(`#icon-c${i}`).hasClass("bi bi-exclamation-square"))
                {
                    $(`#icon-c${i}`).removeClass("bi bi-exclamation-square");
                }

                $(`#percent-c${i}`).text("0%");
                $(`#balance-c${i}`).text("10");
                $(`#colHeight-c${i}`).text("10");
                $(`#c${i}`).css('width', '0%');

                if ($(`#pg-c${i}`).hasClass("tw:grayscale"))
                {
                    $(`#pg-c${i}`).removeClass("tw:relative tw:grayscale tw:opacity-60 tw:pointer-events-none");
                }
                // if ($(`#icon-c${i}`).hasClass('bi bi-exclamation-square'))
                // {
                //     $(`#icon-c${i}`).removeClass("bi bi-exclamation-square");
                // }
            }
        }
        /*
        function restartItem() {
            var loaderId = $("#txtLoaderId").val();
            if (loaderId == "") {
                restartStep();
                return;
            }

            // document.getElementById("btnChangeReel").setAttribute("disabled", "true");
            resetColorPLCForm(3);
            document.getElementById("btnStop").setAttribute("disabled", "true");
            newReel();
            scanItemEle.focus();
        }
        */

        function newReel() {
            $('#pt2').html("STEP 2 :: Waiting Scan Reel ... ");
            $('#pt3').html("STEP 3 :: Checking column available ... ");
            $('#pt4').html("STEP 4 :: Reading Reel Info ... ");
            $('#pTextLast').text("STEP 5 :: Keep Record and Finalyzing ... ");
            // $('#pTextLast').text("Waiting finish loading reel ... ");

            const inputs = [
                { id: "#txtScanItem", value: '' },
                { id: "#txtEstHeight", value: 0 },
                { id: "#txtActHeight", value: 0 },
                { id: "#txtReelCode", value: '' },
            ];
            inputs.forEach(input => {
                $(input.id).val(input.value);
            });
            //#loadProcess4
            $('#reelIdentity, #reelHeight, #itemStatus, #heightStatus4, #loadCol4').text(''); //, #loadConfirm4
            $('#txtHReelID, #txtHItem, #txtHExtH, #txtHActH').text('-');
            $('#exclamIcon').addClass('tw:hidden');
            $("#waiting2, #waiting3, #waiting4, #waitingLast").removeClass("tw:hidden");
            $('#badgeTitle').text('N/A');
            $('#badgeTitle').removeClass('tw:bg-brand-50 tw:text-brand-600 tw:dark:bg-brand-500/15 tw:dark:text-brand-400');
            $('#badgeTitle').addClass('tw:bg-error-50 tw:text-error-700 tw:dark:bg-error-500/15 tw:dark:text-error-500');
        }

        function resetColorPLCForm(idx) {
            const sections = ['sec1', 'sec2', 'sec3', 'sec4', 'sec5', 'secLast'];
            const steps = ['step1', 'step2', 'step3', 'step4', 'step5', 'stepLast'];

            sections.forEach(id => $('#' + id).addClass("tw:hidden").removeClass("tw:my-6"));
            steps.forEach(id => $('#' + id).removeClass("next active"));

            if (idx >= 1 && idx <= 5) {
                $('#' + sections[idx - 1]).removeClass('tw:hidden').addClass('tw:my-6');

                for (let i = 0; i < idx; i++) {
                    $('#' + steps[i]).addClass('active');
                }

                for (let i = 0; i < idx - 1; i++) {
                    $('#' + steps[i]).addClass('next');
                }
            } else if (idx == 0) {
                return;
            } else {
                $('#' + sections[5]).removeClass('tw:hidden').addClass('tw:my-6');
                for (let i = 0; i < 5; i++) {
                    $('#' + steps[i]).addClass('next active');
                }
                $('#' + steps[5]).addClass('active');
            }
            //, #btnRetryTurn, #btnRetryStart
            $('#btnNext2, #btnNext3, #btnNext4, #btnRetryLast, #exclamIcon, #btnRetry4, #btnRetryTurn').addClass('tw:hidden');
            $('#err1, #errCol2, #errFork2, #errItem3, #errCol4, #startErr, #errActHeight, #colStatus2, #forkStatus2').text("");
        }

        function loadLoaderList() {
            $.ajax({
                url: "/Loader/GetLoaderList_ReadyToLoad/",
                type: "GET",
                dataType: 'JSON',
                contentType: 'application/json; charset=utf-8',
                beforeSend: function () {
                    Swal.fire({
                        text: 'Please Wait',
                        width: '300px',

                        allowEscapeKey: false,
                        allowOutsideClick: false,
                        showConfirmButton: false,
                    });
                    Swal.showLoading();
                },
                success: function (result) {
                    Swal.close();
                    if (result.success == true) {

                        // // Get the select element
                        // const selLoader = document.getElementById('selLoader');
                        // for (const opt of result.data)
                        // {
                        //     const el = document.createElement("option");
                        //     el.textContent = opt.loaderCode;
                        //     el.value = opt.loader_Id;
                        //     selLoader.appendChild(el);
                        // }

                    }
                    else {
                        Swal.fire({
                            icon: 'error',
                            title: "Wait",
                            text: result.errMessage
                        });
                    }
                },
                error: function (error) {
                    Swal.fire({
                        icon: 'error',
                        title: "Wait",
                        text: error.val
                    });
                }
            });
        }

        function addLoader(_type, id, code) {
            if (_type == 1) {
                const selLoader = document.getElementById('selLoader');
                const idx = selLoader.selectedIndex;
                const selectedOption = selLoader.options[idx];
                id = selectedOption.value;
                code = selectedOption.text;

                $.ajax({
                    url: "/Loader/GetLoaderInfo_ReadyToLoad?req=" + code,
                    type: "GET",
                    dataType: 'JSON',
                    contentType: 'application/json; charset=utf-8',
                    beforeSend: function () {
                        Swal.fire({
                            text: 'Please Wait',
                            width: '300px',

                            allowEscapeKey: false,
                            allowOutsideClick: false,
                            showConfirmButton: false,
                        });
                        Swal.showLoading()
                    },
                    success: function (result) {
                        Swal.close();
                        if (result.success == true) {
                        }
                        else {
                            Swal.fire({
                                icon: 'error',
                                title: "Wait",
                                text: result.errMessage
                            });
                            return;
                        }
                    },
                    error: function (error) {
                        Swal.fire({
                            icon: 'error',
                            title: "Wait",
                            text: error.val
                        });
                        return;
                    }
                });

            }

            // continue
            $("#txtLoaderId").val(id);
            $("#txtLoaderCode").val(code);
            loadPLC(1);

            $("#txtHLoader").val(code);
        }

        function delay(ms) {
            return new Promise(resolve => setTimeout(resolve, ms));
        }

        async function step1() {
            var loaderId = $("#txtLoaderId").val();
            if (loaderId == "") {
                $('#loadStatus1').text('');
                $('#err1').text('Must select Auto Loader');
                return;
            }

            var loaderCode = $("#txtLoaderCode").val();
            var scanCode = $("#txtScanLoader").val();
            if (loaderCode.toUpperCase() != scanCode.toUpperCase()) {
                $('#loadStatus1').text('');
                $('#err1').text('Please rescan the Loader');
                return;
            }

            //check loader mode
            var loaderMode = await loadPLCGetLoaderMode($("#txtLoaderId").val());
            if (loaderMode == false) {
                Swal.fire({
                    icon: 'error',
                    title: "Wait",
                    text: "Loader is not in Auto Mode.",
                });
            } else {
                if ($('#err1').text() == '')
                {
                    startBatteryMonitoring(loaderId);
                    getLoaderColumn(loaderId);  //get loader column usage and show status
                    retry2();
                }
            }
        }

        function retry2(type) {
            $('#btnRetry2').addClass('tw:hidden');
            $('#btnRetry2-1').addClass('tw:hidden');
            $('#errFork2').text('');
            $('#errCol2').text('');

            if (type != 'col') {
                $('#startStatus').text('');
                startLoad();
            }
            else 
            {
                loadPLC(2);
            }
            setTimeout(3000);
        }

        function step2() {
            resetColorPLCForm(3);
            scanItemEle.focus();

            // document.getElementById("btnStop").setAttribute("disabled", "true");
            // $('#itemStatus').text('');
            // $('#reelIdentity').text('');
            // $('#reelHeight').text('');

            // $("#txtEstHeight").val(0);
            // $("#txtActHeight").val(0);
            // const fields = ['#txtReelCode', '#txtHReelID', '#txtHItem', '#txtHExtH', '#txtHActH'];
            // fields.forEach(i => $(i).val(''));
            // $('#btnNext2').addClass('hidden');
        }

        function retry3() {
            $('#errItem3').text('');

            var reelCode = $("#txtReelCode").val();
            var scanCode = $("#txtScanItem").val();
            if (reelCode.toUpperCase() != scanCode.toUpperCase() || (reelCode == "" || scanCode == "")) {
                $('#errItem3').text('Please scan Reel');
                return;
            }

            setTimeout(3000);
            loadPLC(3);
        }

        async function step3() {

            if ($('#txtScanItem').val() != $('#txtReelCode').val()) {
                $('#itemStatus, #reelHeight, #reelIdentity').text('');
                $('#errItem3').text('Please rescan the Reel');
                $('#btnNext3').addClass("tw:hidden");
                return;
            }
            
            //ensure the col is enough space
            var chkHeight = await loadPLCCheckEstHeight($('#txtLoaderId').val(), $('#txtReelCode').val(), $('#txtICol').val(), 3);
            if (chkHeight == false) {
                Swal.fire({
                    icon: 'error',
                    title: "Wait",
                    text: "Reel height exceeds the column balance height. ",
                });
            } 
            else {
                resetColorPLCForm(4);
                document.getElementById("btnStop").setAttribute("disabled", "true");
                document.getElementById("btnEnd").setAttribute("disabled", "true");
                loadPLC(4);
                // document.getElementById("btnChangeReel").removeAttribute("disabled");
            }
        }

        async function step5() {
            if ($('#warnTurnModal').hasClass("show")) {
                $('#warnTurnModal').modal("toggle");
            }

            $('#loadingBlk').removeClass('tw:hidden');
            //end column before turn
            $('#btnRetryTurn').addClass('tw:hidden');
            $('#exclamIcon').addClass('tw:hidden');
            $('#errActHeight').text('');

            var iCol = $("#txtICol").val();
            var realCol = await loadPLCGetCurrentColumn($("#txtLoaderId").val());

            let isActive = false;
            let skipCol = iCol > 2 ? iCol - realCol : 1;
            // console.log("skipCol", skipCol);
            // console.log("iCol", iCol);

            while (!isActive && iCol <= 4) {
                const el = document.getElementById(`title-c${iCol}`);
                if (!el) break;

                isActive = el.dataset.active === "true";

                if (!isActive) {
                    skipCol++;
                    iCol++;
                }
            }

            $('#txtICol').val(iCol);
            // console.log("iCol", iCol);
            if (iCol <= 4) {
                const oldCol = iCol - skipCol; //oldCol suppose is same as realCol
                //set full for the skipped col before turn
                for (let col = oldCol; col < iCol; col++) {
                    var endstate = await loadPLCSetColumnState($("#txtLoaderId").val(), col);
                    if (!endstate)  {
                        $('#errActHeight').text('Failed to end the task. Check the connection and try again.');
                        success = false;
                        break;
                    }
                }

                // var colstate = await loadPLCSetColumnState($("#txtLoaderId").val(), iCol-1);
                // if (endstate == true) {
                var chkColTurn = await loadPLCCheckColTurn($("#txtLoaderId").val());
                if (chkColTurn == false) {
                    //if not column not ready to turn
                    $('#exclamIcon').removeClass("tw:hidden");

                    $('#errActHeight').text('Failed to Turn Column.');
                    $('#btnRetryTurn').removeClass('tw:hidden');
                    $('#btnRetryTurn').text('Retry on Turn Column');
                }
                else {
                    turnCol(5);
                }
            }
            else 
            {
                turnCol(5);
            }
        }

        function retry5(action) {
            if (action == 1) {
                loadPLC(5);
            }
            else {
                resetColorPLCForm(4);
                loadPLC(4);
            }
        }

        function warnBeforeTurnCol(action) {
            let warnText = document.getElementById('warnText');
            let turnBtn = document.getElementById('turnBtn');
            turnBtn.disabled = false;

            if (action == 2) {
                warnText.textContent = "Please make sure hands off and tap 'Start Turn Column' button.";
                turnBtn.onclick = async function() {
                    // turnBtn.disabled = true;
                    if ($('#warnTurnModal').hasClass("show")) {
                        $('#warnTurnModal').modal("toggle");
                    }
                    var chkColTurn = await loadPLCCheckColTurn($("#txtLoaderId").val());
                    if (chkColTurn == false) {
                        $('#colStatus2').text('');
                        $('#errCol2').text('Failed to Turn Column').css('color', 'red');
                        $('#btnRetry2').removeClass('tw:hidden');
                        $('#btnRetry2').text('Retry on Turn Column');
                    } else {
                        turnCol(2);
                    }
                };
                $('#turnImg').attr('src', '/assets/img/a-b.gif');
            } else {
                $('#btnRetryTurn').addClass('tw:hidden');
                warnText.textContent = "Please take out the Reel and only tap Start Turn Column button.";
                turnBtn.onclick = function() {
                    turnBtn.disabled = true;
                    step5();
                };
                $('#turnImg').attr('src', '/assets/img/take-out-reel.gif');
            }
            $('#warnTurnModal').modal("show");
        }

        async function startLoad() {
            var loaderId = $("#txtLoaderId").val();
            var callStart = await loadPLCStartLoad(loaderId);
            resetColorPLCForm(2);
            taskLoad = true;

            if (callStart == true) {
                loadPLC(2);
            }
        }

        async function turnCol(index) {
            if ($("#warnTurnModal").hasClass("show")) {
                $("#warnTurnModal").modal("toggle");
            }
            var loaderId = $("#txtLoaderId").val();
            var iCol = $("#txtICol").val();
            var realCol = await loadPLCGetCurrentColumn(loaderId);

            if (iCol > 4) {
                let countdown = 5;
                $('#loadingBlk').addClass('tw:hidden');
                $('#errActHeight').text(`All active columns are full. The task will end automatically in ${countdown} seconds.`);

                let timer = setInterval(async () => {
                    countdown--;
                    $('#errActHeight').text(`All active columns are full. The task will end automatically in ${countdown} seconds.`);

                    if (countdown <= 0) {
                        clearInterval(timer);
                        var success = false;

                        while (Number(realCol) <= 4) {
                            var endstate = await loadPLCSetColumnState(loaderId, realCol);
                            success = true;
                            realCol++;
                            if (endstate == false)  {
                                $('#errActHeight').text('Failed to end the task. Check the connection and try again.');
                                success = false;
                                break;
                            }
                        }

                        if (success) {
                            restartStep();
                        }
                    }
                }, 1000);
            }
            else 
            {
                if (Number(realCol) == 0) {
                    if (index == 2) {
                        $('#btnRetry2').removeClass("tw:hidden");
                    }
                    else {
                        $('#btnRetry4').removeClass("tw:hidden");
                    }
                } 
                else {
                    const oldCol = realCol;
                    if (realCol < iCol) {
                        var turnCol = await loadPLCTurnColumn(loaderId, Number(iCol));
                        if (turnCol == false) {
                            if (index == 2) {
                                $('#colStatus2').text('');
                                $('#btnRetry2').removeClass('tw:hidden');
                                $('#errCol2').text('Failed to Turn Column').css('color', 'red');
                            }
                            else {
                                $('#errActHeight').text('Failed to Turn Column').css('color', 'red');
                                $('#btnRetry4').removeClass('tw:hidden');
                            }
                            return;
                        }
                        else {
                            $('#loadProcess4').addClass("error-message");
                            $('#loadProcess4').text('');
                        }
                        realCol = iCol; // (realCol) + 1;
                    }

                    $(`#c${oldCol}`).removeClass("tw:bg-warning-500 tw:animate-pulse");
                    $(`#icon-c${oldCol}`).removeClass("bi-fire");
                    $(`#c${oldCol}`).addClass("tw:bg-success-500");

                    $(`#c${iCol}`).addClass("tw:bg-warning-500 tw:animate-pulse");
                    $(`#icon-c${iCol}`).addClass("bi bi-fire");

                    // wait for fork is ready
                    // await delay(3000);
                    var chkColFork = await loadPLCCheckColFork(loaderId, iCol);
                    if (chkColFork == false) {
                        if (index == 2) {
                            $('#btnRetry2').removeClass("tw:hidden");
                            $('#errFork2').text('Fork Not Ready.').css('color', 'red');
                        }
                        else {

                        }
                    }
                    else {
                        if (index == 2) {
                            // $('#btnNext2').removeClass("hidden");
                            $('#btnRetry2').addClass("tw:hidden");
                            // //disabled stop & end task button
                            document.getElementById("btnStop").removeAttribute("disabled");
                            document.getElementById("btnEnd").removeAttribute("disabled");

                            //auto proceed to step3
                            step2();
                        }
                        else {
                            $('#btnRetryTurn').addClass("tw:hidden");
                            $('#exclamIcon').removeClass("bi-exclamation-triangle-fill");
                            $('#exclamIcon').addClass("bi-info-circle-fill");
                            $('#exclamIcon').css('color', 'green');
