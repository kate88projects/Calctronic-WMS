        async function loadPLC(idx) {
            var loaderId = $("#txtLoaderId").val();

            // step 1 : check loader
            if (idx == 1) {
                resetColorPLCForm(1);
                if (loaderId == "") {
                    $('#err1').text("No loader is selected.");
                    return;
                }

                var chkLoader = await loadPLCCheckLoader(loaderId);
                // console.log('R1::' + chkLoader);
                return;
            }

            var reelCode = $("#txtReelCode").val();
            var iCol = $("#txtICol").val();

            if (idx == 2) {
                $('#startStatus').css('color', '#344054');
                $('#colStatus2').text('Checking on Column ' + iCol);

                await delay(3000);

                let attempt = 1;
                let maxAttempts = 4;
                let chkCol = false;

                while (chkCol === false && iCol <= maxAttempts) {
                    chkCol = await loadPLCCheckEstHeight(loaderId, reelCode, iCol, idx);
                    // console.log(`R3.${attempt}::` + chkCol);

                    if (chkCol == false) {
                        iCol = Number(iCol) + 1;
                        if (iCol < 5) $('#colStatus2').text('Checking on Column ' + iCol);
                        await delay(1000);
                    }
                    attempt;
                }

                // console.log('R3.10::' + iCol);

                if (chkCol == false) {
                    if (iCol < 5) $('#btnRetry2').removeClass('tw:hidden');
                } else {
                    $("#txtICol").val(iCol);
                    $("#txtHCol").val(iCol);

                    // check is column correct, else need call turn
                    var realCol = await loadPLCGetCurrentColumn(loaderId);

                    if (realCol == 0) {
                        $('#btnRetry2').removeClass('tw:hidden');
                        if (realCol !== false)
                        {
                            $('#colStatus2').text('');
                            $('#errCol2').text('Invalid Column Number');
                        }
                    }
                    else {
                        if (realCol < iCol) {
                            //set full for those unavailable column
                            var currentCol = realCol;
                            var setState = false;
                            while (currentCol < iCol) {
                                var colstate = await loadPLCSetColumnState(loaderId, currentCol);
                                if (colstate == true) {
                                    setState = true;
                                    currentCol++;
                                }
                            }

                            if (setState) {
                                warnBeforeTurnCol(2);
                            }
                        }
                        else {
                            
                            var chkColFork = await loadPLCCheckColFork(loaderId, iCol);
                            if (chkColFork == false) {
                                $('#btnRetry2').removeClass('tw:hidden');
                                $('#errFork2').text('Failed to retrieve fork status').css('color', 'red');
                            }
                            else {
                                // if success then only show next button
                                // $('#btnNext2').removeClass('hidden');
                                $('#btnRetry2').addClass('tw:hidden');
                                const oldCol = iCol-1;
                                $('#c' + (oldCol)).addClass("tw:bg-success-500");
                                $('#c' + (oldCol)).removeClass("tw:bg-warning-500 tw:animate-pulse");
                                $(`#icon-c${oldCol}`).removeClass("bi bi-fire");

                                $('#c' + iCol).addClass("tw:bg-warning-500 tw:animate-pulse");
                                $(`#icon-c${iCol}`).addClass("bi bi-fire");

                                //disabled stop & end task button
                                document.getElementById("btnStop").removeAttribute("disabled");
                                document.getElementById("btnEnd").removeAttribute("disabled");

                                //auto proceed to step3
                                step2();
                            }
                        }
                    }
                }
                return;
                // await delay(3000);
            }

            if (idx == 3) {
                if (reelCode == "") {
                    $('#errItem3').text('Please scan Reel.');
                    return;
                }
                // await delay(3000);
                var chkItem = await loadPLCCheckItem(loaderId, reelCode);
                // console.log('R2::' + chkItem);
                if (chkItem == false) {
                    $('#btnNext3').addClass('tw:hidden');
                    $('#itemStatus, #reelIdentity, #reelHeight').text('');
                } else {
                    // $('#btnNext3').removeClass('tw:hidden');
                    $('#errItem3').text('');
                    step3();
                }
                return;
            }

            // ID = 4
            iCol = $("#txtICol").val();
            if (idx == 4) {
                $('#btnRetryStart').addClass('tw:hidden');
                var loaderId = $("#txtLoaderId").val();
                var callStart = await loadPLCStartPutReel(loaderId);
                if (callStart == true) {
                    $('#btnRetryStart').addClass("tw:hidden");
                    $("#putModal").modal("show"); 
                }
                return; 
            }

            if (idx == 5) {
                if (loaderId == "" || reelCode == "") {
                    Swal.fire({
                        icon: 'error',
                        title: "Wait",
                        text: "Please start from Step 1."
                    });
                    return;
                }
                $('#loadCol4').text('');
                $('#heightStatus4').text('');
                $('#loadingBlk').addClass('tw:hidden');
                resetColorPLCForm(5);
                if ($('#putModal').hasClass('show')) {
                    $('#putModal').modal('toggle');
                }
                
                await delay(3000);
                var chkAct = await loadPLCActHeight(loaderId, reelCode, iCol);
                // console.log('R4::' + chkAct);
                
                if (chkAct == "99") {
                    // is success
                    $('#btnNext4').removeClass("tw:hidden");
                    $('#btnRetry4').addClass("tw:hidden");
                }
                return;
            }

            if (idx == 6) {
                var h = $("#txtActHeight").val();
                if (loaderId == "" || reelCode == "" || h =="" || h =="0") {
                    Swal.fire({
                        icon: 'error',
                        title: "Wait",
                        text: "Please start from Step 1."
                    });
                    return;
                }

                $('#exclamIcon').removeClass("bi-info-circle-fill");
                $('#exclamIcon').css('color', 'red');
                $('#exclamIcon').addClass("bi-exclamation-triangle-fill");
                // document.getElementById("btnChangeReel").setAttribute("disabled", "true");

                resetColorPLCForm(6);
                var chkLast = await loadPLCUpdateDB(loaderId, reelCode, iCol);
                // console.log('R5::' + chkLast);
                if (chkLast == false) {
                    $('#pTextLast').text('Failed to update info. Please try again.').css('color', 'red');
                    $('#btnRetryLast').removeClass("tw:hidden");
                    return;
                } else {
                    document.getElementById("btnStop").removeAttribute("disabled");
                    document.getElementById("btnEnd").removeAttribute("disabled");
                    $('#pTextLast').text("STEP 5 :: DONE Finalized ").css('color', 'black');

                    const userStopped = await waitForDecision();
                    if (!userStopped) {
                      // console.log('Continue automatically.');
                      return continueNextStep2('');
                    }

                    // If user stopped, wait for cancel/confirm
                    const userCancelled = await waitForDecision();
                    if (userCancelled === false) {
                      // console.log('User canceled stop — continue.');
                      continueNextStep2('');
                    // } else {
                      // console.log('User confirmed stop — half.');
                    }

                }
            }
        }

        function continueNextStep2(process) {
            // document.getElementById("btnChangeReel").setAttribute("disabled", "true");
            document.getElementById("btnStop").setAttribute("disabled", "true");
            document.getElementById("btnEnd").setAttribute("disabled", "true");
            resetColorPLCForm(2);
            getLoaderColumn($("#txtLoaderId").val());
            (process == "start") ? retry2("start") : retry2("col");
            newReel();
            isUserStopped = false;
        }

