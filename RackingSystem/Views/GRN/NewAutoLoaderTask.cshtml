        async function loadPLCCheckEstHeight(loaderId, reelCode, iCol, stepid) {
            // step 3 : check column height balance and change column
            var thickness = $("#txtEstHeight").val();
            var fResult = false;

            try {
                const result = await $.ajax({
                    url: "/api/PLCLoader/CheckColumnHeight/" + loaderId + "/" + iCol + "/" + thickness,
                    type: "GET",
                    headers: {
                        'Authorization': 'Bearer ' + token
                    },
                    dataType: 'JSON',
                    contentType: 'application/json; charset=utf-8'
                });

                // console.log('3::' + JSON.stringify(result));
                if (result.success == true) {
                    if (stepid == 2) {
                        $('#errCol2').text('');
                        $('#colStatus2').text(iCol);
                        $('#txtHColBal').val(result.data);
                    }
                    fResult = true;
                } else {
                    if (stepid == 2) {
                        // $('#errCol2').text(result.errMessage);
                        if (iCol >= 4) {
                            var realCol = await loadPLCGetCurrentColumn(loaderId);
                            let countdown = 5;
                            // $('#btnRetry2').addClass('tw:hidden');
                            $('#colStatus2').text('');
                            $('#errCol2').text(`All active columns are full. The task will end automatically in ${countdown} seconds.`);
                            let timer = setInterval(async () => {
                                countdown--;
                                $('#errCol2').text(`All active columns are full. The task will end automatically in ${countdown} seconds.`);

                                if (countdown <= 0) {
                                    clearInterval(timer);
                                    var success = false;

                                    while (Number(realCol) <= 4) {
                                        //set full for all unavailable col, auto loader will perform perfect end task
                                        var endstate = await loadPLCSetColumnState(loaderId, realCol);
                                        success = true;
                                        realCol++;
                                        // console.log('end state', endstate);
                                        if (endstate == false)  {
                                            $('#errCol2').text('Failed to end the task. Check the connection and try again.');
                                            success = false;
                                            break;
                                        }
                                    }

                                    if (success) {
                                        restartStep();
                                    }
                                }
                            }, 1000);
                        }
                    }
                }
            } catch (error) {
                if (iCol < 4) {
                    $('#errCol2').text(error.val);
                }
                else {
                    $('#errCol2').text('All column is full. Please change loader.');
                }
            }

            // console.log('3::' + fResult);
            return fResult;
        }

