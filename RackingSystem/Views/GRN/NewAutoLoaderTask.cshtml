        async function waitForDecision() {
            return new Promise((resolve) => {
               stopDecision = (value) => resolve(value);

               let countdown = 3;
               function tick() {
                  if (countdown > 0) {
                     $('#pTextLast').text(`Continue to Next Reel..${countdown}...`);
                     countdown--;
                     stopTimer = setTimeout(tick, 1000);
                  } else {
                     resolve(false);
                  }
               }
               tick();
            });
        }
