        function buildPaginationItems(totalPages, currentPage, windowSize = 5) {
            const items = [];

            if (totalPages <= windowSize) {
                for (let i = 1; i <= totalPages; i++) {
                    items.push(i);
                }
                return items;
            }

            if (currentPage <= windowSize - 1) {
                for (let i = 1; i <= windowSize; i++) {
                    items.push(i);
                }
                items.push('...');
                items.push(totalPages);
            }
            else if (currentPage >= totalPages - windowSize + 2) {
                items.push(1);
                items.push('...');
                for (let i = totalPages - windowSize + 1; i <= totalPages; i++) {
                    items.push(i);
                }
            }
            else {
                items.push(1);
                items.push('...');
                items.push(currentPage - 1, currentPage, currentPage + 1);
                items.push('...');
                items.push(totalPages);
            }

            return items;
        }

