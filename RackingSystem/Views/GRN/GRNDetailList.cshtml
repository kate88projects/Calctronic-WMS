        function createGRNTemplateWorkbook(items) {
            const workbook = new ExcelJS.Workbook();
            workbook.creator = "Flex Software Consulting Sdn Bhd";
            workbook.title = "Import GRN Template";
            workbook.subject = "GRN";
            workbook.created = new Date();

            const sheet = workbook.addWorksheet("Sheet1");
            sheet.columns = [
                { header: 'Reel Code', width: 16 },
                { header: 'Item Code', width: 22 },
                { header: 'Quantity', width: 10 },
                { header: 'Expiry Date', width: 16 },
                { header: 'Supplier Name', width: 20 },
                { header: 'Supplier Ref No', width: 20 }
            ];
            sheet.getRow(1).font = { name: 'Arial', size: 11, bold: true };
            sheet.columns.forEach((column, i) => {
                sheet.getCell(1, i + 1).value = { richText: [
                    { text: column.header, font: { name: 'Arial', size: 11, bold: true } },
                    { text: ' *', font: { name: 'Arial', size: 11, bold: true, color: { argb: 'FFFF0000' } } }
                ] };
            });

            const itemSheet = workbook.addWorksheet("Items", { state: 'hidden' });
            itemSheet.columns = [{ header: 'Item Code', width: 22 }, { header: 'Description', width: 40 }];
            items.forEach(i => itemSheet.addRow([i.itemCode, i.description]));

            if (items.length > 0) {
                const itemRange = `Items!$A$2:$A$${items.length + 1}`;
                sheet.dataValidations.add(`B2:B${TEMPLATE_MAX_ROWS + 1}`, {
                    type: 'list',
                    allowBlank: true,
                    formulae: [itemRange],
                    showErrorMessage: true,
                    errorStyle: 'stop',
                    errorTitle: 'Invalid Item Code',
                    error: 'Please select an Item Code from the list.'
                });
            }

            return workbook;
        }

        // ---- Import GRN by Excel ----
        const GRN_IMPORT_FIELDS = ['Reel Code', 'Item Code', 'Quantity', 'Expiry Date', 'Supplier Name', 'Supplier Ref No'];
        let uploadedFileContent = null;
        let uploadedFileExtension = '';
        let activeItems = [];  // active Item Code from db

        function customSelect(selectId) {
            return {
                open: false,
                dropUp: false,
                options: [],
                selectedValue: '',
                selectedLabel: '',
                hasError: false,
                init() {
                    this.syncOptions();
                    const sel = document.getElementById(selectId);
                    if (!sel) return;
                    this.hasError = sel.classList.contains('is-invalid');
                    new MutationObserver(() => {
                        this.hasError = sel.classList.contains('is-invalid');
                    }).observe(sel, { attributes: true, attributeFilter: ['class'] });
                },
                toggle() {
                    this.open = !this.open;
                    if (this.open) {
                        this.syncOptions();
                        const rect = this.$el.getBoundingClientRect();
                        const spaceBelow = window.innerHeight - rect.bottom;
                        this.dropUp = spaceBelow < 240 && rect.top > spaceBelow;
                    }
                },
                syncOptions() {
                    const sel = document.getElementById(selectId);
                    if (!sel) return;
                    this.options = Array.from(sel.options).map(o => ({ value: o.value, text: o.textContent.trim() }));
                    this.selectedValue = sel.value;
                    const selectedOpt = sel.options[sel.selectedIndex];
                    this.selectedLabel = selectedOpt ? selectedOpt.textContent.trim() : '';
                },
                select(opt) {
                    const sel = document.getElementById(selectId);
                    sel.value = opt.value;
                    this.selectedValue = opt.value;
                    this.selectedLabel = opt.text;
                    this.open = false;
                    sel.dispatchEvent(new Event('change'));
                }
            };
        }

        function triggerFileInput() {
