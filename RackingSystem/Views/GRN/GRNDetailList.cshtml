        function handleFileUpload(event) {
            const file = event.target.files[0];
            if (!file) return;

            const fileExtension = file.name.split('.').pop().toLowerCase();
            if (fileExtension !== 'csv' && fileExtension !== 'xlsx' && fileExtension !== 'xls') {
                Swal.fire({
                    icon: 'error',
                    title: "Wait",
                    text: "Only CSV, XLSX, and XLS files are supported."
                });
                return;
            }

            const reader = new FileReader();
            reader.onload = function (e) {
                processFileContent(e.target.result, fileExtension);
            };

            if (fileExtension === 'csv') {
                reader.readAsText(file);
            } else {
                reader.readAsArrayBuffer(file);
            }
        }

        //Row 0 is the header row.
        function readSheetRows(content, fileExtension) {
            const workbook = fileExtension === 'csv'
                ? XLSX.read(content, { type: 'string', codepage: 65001 })
                : XLSX.read(content, { type: 'array' });
            return XLSX.utils.sheet_to_json(workbook.Sheets[workbook.SheetNames[0]], { header: 1 });
        }

        function processFileContent(content, fileExtension) {
            try {
                const data = readSheetRows(content, fileExtension);

                if (!data || data.length === 0) {
                    Swal.fire({ icon: 'error', title: "Wait", text: "The uploaded file appears to be empty or malformed." });
                    return;
                }

                const columns = data[0];
                if (!columns || columns.length === 0) {
                    Swal.fire({ icon: 'error', title: "Wait", text: "No headers found in the file." });
                    return;
                }

                if (data.length < 2) {
                    Swal.fire({ icon: 'error', title: "Wait", text: "The file has no data rows." });
                    return;
                }

                uploadedFileContent = content;
                uploadedFileExtension = fileExtension;
                showColumnMapping(columns);

            } catch (error) {
                console.error("Error processing the file:", error);
                Swal.fire({ icon: 'error', title: "Wait", text: "Failed to process the uploaded file." });
            }
        }

        function escapeHtml(value) {
            return String(value).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;').replace(/'/g, '&#39;');
        }

        function defaultGRNBatchNo() {
            const d = new Date();
            const pad = n => n.toString().padStart(2, '0');
            return `${d.getFullYear()}${pad(d.getMonth() + 1)}${pad(d.getDate())}${pad(d.getHours())}${pad(d.getMinutes())}`;
        }

        function showColumnMapping(columns) {
            let columnDropdowns = '';

            const isMatch = (col1, col2) => {
                const col1Str = String(col1).toLowerCase().replace(/[\s*]+/g, '');
                const col2Str = String(col2).toLowerCase().replace(/[\s*]+/g, '');
                return col1Str === col2Str;
            };

            columns.forEach((column, index) => {
                const matchedField = GRN_IMPORT_FIELDS.find(field => isMatch(field, column));

                columnDropdowns += `
                <div class="tw:mb-3 tw:grid tw:grid-cols-2 tw:items-center">
                    <label class="tw:text-sm tw:font-medium tw:text-gray-700 tw:dark:text-gray-400">File Column: ${escapeHtml(column)}</label>
                    <div class="tw:relative" x-data="customSelect('column${index}')" x-init="init()">
                        <select class="column-mapping tw:hidden" data-index="${index}" id="column${index}">
                            <option value="">Select Matching Column</option>
                            ${GRN_IMPORT_FIELDS.map(field => `
                                <option value="${field}" ${matchedField === field ? 'selected' : ''}>${field}</option>
                            `).join('')}
                        </select>
                        <button type="button" @@click="toggle()" @@click.outside="open = false"
                            class="tw:flex tw:w-full tw:items-center tw:justify-between tw:gap-2 tw:rounded-lg tw:border tw:bg-transparent tw:px-4 tw:py-2.5 tw:text-left tw:text-sm tw:text-gray-800 tw:dark:bg-gray-900 tw:dark:text-white/90"
                            :class="hasError ? 'tw:border-error-500' : (open ? 'tw:border-brand-300 tw:ring-3 tw:ring-brand-500/10' : 'tw:border-gray-300 tw:dark:border-gray-700')">
                            <span x-text="selectedLabel || 'Select...'" :class="selectedLabel ? '' : 'tw:text-gray-400 tw:dark:text-white/30'"></span>
                            <i class="bi bi-chevron-down tw:text-xs tw:text-gray-500 tw:transition-transform tw:dark:text-gray-400" :class="open ? 'tw:rotate-180' : ''"></i>
                        </button>
                        <div x-show="open" x-transition
                            class="custom-select-scroll tw:absolute tw:z-50 tw:max-h-60 tw:w-full tw:overflow-y-auto tw:rounded-lg tw:border tw:border-gray-200 tw:bg-white tw:py-1 tw:shadow-theme-lg tw:dark:border-gray-700 tw:dark:bg-gray-900"
                            :class="dropUp ? 'tw:bottom-full tw:mb-1' : 'tw:top-full tw:mt-1'">
                            <template x-if="options.length === 0">
                                <div class="tw:px-4 tw:py-2 tw:text-sm tw:text-gray-400 tw:dark:text-white/30">No options</div>
                            </template>
                            <template x-for="opt in options" :key="opt.value">
                                <div @@click="select(opt)"
                                    class="tw:cursor-pointer tw:px-4 tw:py-2 tw:text-sm tw:hover:bg-brand-50 tw:dark:hover:bg-brand-500/15"
                                    :class="opt.value === selectedValue ? 'tw:bg-brand-50 tw:font-medium tw:text-brand-600 tw:dark:bg-brand-500/15 tw:dark:text-brand-400' : 'tw:text-gray-700 tw:dark:text-gray-300'"
                                    x-text="opt.text"></div>
                            </template>
                        </div>
                    </div>
                </div>`;
            });

            $('#txtImportGRN').val(defaultGRNBatchNo());
            removeErrMsg('txtImportGRN');

            document.getElementById('csvColumnContent').innerHTML = columnDropdowns;
            if (window.Alpine) {
                Alpine.initTree(document.getElementById('csvColumnContent'));
            }
            $('#columnMatchingModal').modal("show");
        }

        function captureUserMappings() {
            const fieldToIndex = {};
            const duplicates = [];
            document.querySelectorAll('.column-mapping').forEach(selectElement => {
                const field = selectElement.value;
                if (!field) return;

                if (fieldToIndex[field] !== undefined) {
                    if (!duplicates.includes(field)) duplicates.push(field);
                } else {
                    fieldToIndex[field] = Number(selectElement.dataset.index);
                }
            });
            return { fieldToIndex, duplicates };
        }

        function cleanText(value) {
            return value === undefined || value === null ? '' : String(value).trim();
        }

        function parseImportQty(value) {
            const n = Number(cleanText(value).replace(/,/g, ''));
            return Number.isInteger(n) && n > 0 ? n : 0;
        }

        function parseImportDate(value) {
            if (value === undefined || value === null || value === '') return null;

            let y, m, d, parts;
            if (value instanceof Date) {
                y = value.getFullYear(); m = value.getMonth() + 1; d = value.getDate();
            } else if (typeof value === 'number') {
                const p = XLSX.SSF.parse_date_code(value);
                if (!p) return null;
                y = p.y; m = p.m; d = p.d;
            } else {
                const s = String(value).trim();
                if ((parts = s.match(/^(\d{4})[-\/.](\d{1,2})[-\/.](\d{1,2})/))) {
                    y = +parts[1]; m = +parts[2]; d = +parts[3];
                } else if ((parts = s.match(/^(\d{1,2})[-\/.](\d{1,2})[-\/.](\d{4})$/))) {
                    d = +parts[1]; m = +parts[2]; y = +parts[3];
                } else {
                    return null;
                }
            }

            const check = new Date(y, m - 1, d);
            if (check.getFullYear() !== y || check.getMonth() !== m - 1 || check.getDate() !== d) return null;
            return `${y}-${String(m).padStart(2, '0')}-${String(d).padStart(2, '0')}`;
        }

        function processAndSubmitData() {
            const grnBatchNo = cleanText($('#txtImportGRN').val());
            if (grnBatchNo === '') {
                showError('txtImportGRN', 'Please enter GRN Batch No.');
                return;
            }

            const { fieldToIndex, duplicates } = captureUserMappings();
            const missing = GRN_IMPORT_FIELDS.filter(field => fieldToIndex[field] === undefined);
            if (missing.length > 0) {
                Swal.fire({ icon: 'error', title: "Wait", text: `Please select a column for: ${missing.join(', ')}.` });
                return;
            }
            if (duplicates.length > 0) {
                Swal.fire({ icon: 'error', title: "Wait", text: `More than one file column is mapped to: ${duplicates.join(', ')}.` });
                return;
            }

            let headers, rows;
            try {
                const data = readSheetRows(uploadedFileContent, uploadedFileExtension);
                headers = data[0];
                rows = data.slice(1);
            } catch (error) {
                console.error("Error processing the file:", error);
                Swal.fire({ icon: 'error', title: "Wait", text: "Failed to process the uploaded file." });
                return;
            }

            const cell = (row, field) => fieldToIndex[field] === undefined ? '' : cleanText(row[fieldToIndex[field]]);
            const isBlankRow = row => GRN_IMPORT_FIELDS.every(field => cell(row, field) === '');
            while (rows.length > 0 && isBlankRow(rows[rows.length - 1])) {
                rows.pop();
            }
            if (rows.length === 0) {
                Swal.fire({ icon: 'error', title: "Wait", text: "The file has no data rows." });
                return;
            }

            if (activeItems.length === 0) {
                Swal.fire({ icon: 'error', title: "Wait", text: "The item list is not available, please refresh the page and try again." });
                return;
            }

            const itemByCode = new Map(activeItems.map(item => [item.itemCode.toLowerCase(), item]));

            const grnData = rows.map(row => {
                const itemCode = cell(row, 'Item Code');
                const item = itemByCode.get(itemCode.toLowerCase());

                return {
                    GRNBatchNo: grnBatchNo,
                    ReelCode: cell(row, 'Reel Code'),
                    ItemCode: itemCode,
                    Item_Id: item ? item.item_Id : 0,
                    Qty: parseImportQty(row[fieldToIndex['Quantity']]),
                    ExpiryDate: parseImportDate(row[fieldToIndex['Expiry Date']]),
                    SupplierName: cell(row, 'Supplier Name'),
                    SupplierRefNo: cell(row, 'Supplier Ref No')
                };
            });

            saveExcelGRN(grnData, { headers, rows, fieldToIndex });
        }

        function saveExcelGRN(grnData, importContext) {
            $.ajax({
                url: '/GRN/SaveExcelGRN',
                type: 'POST',
                data: JSON.stringify(grnData),
                dataType: 'JSON',
                contentType: 'application/json; charset=utf-8',
                beforeSend: function () {
                    Swal.fire({
                        text: 'Please Wait',
                        width: '300px',
                        allowEscapeKey: false,
                        allowOutsideClick: false,
                        showConfirmButton: false,
                    });
                    Swal.showLoading()
                },
                success: async function (response) {
                    $('#columnMatchingModal').modal("hide");

                    if (response.success == true) {
                        Swal.fire({
                            icon: 'success',
                            title: "Success Import",
                            text: `${grnData.length} reel(s) imported.`,
                            didClose: () => {
                                window.location.reload();
                            }
                        });
                    } else if (Array.isArray(response.data) && response.data.some(r => r.errorMsg)) {
                        try {
                            await downloadImportErrorFile(response.data, importContext);
                            Swal.fire({
                                icon: 'warning',
                                title: "Validation Issues Found",
                                text: "Review on returned file and fix errors."
                            });
                        } catch (error) {
                            console.error("Error creating the error file:", error);
                            Swal.fire({
                                icon: 'warning',
                                title: "Validation Issues Found",
                                text: `${response.errMessage} The error file could not be created.`
                            });
                        }
                    } else {
                        Swal.fire({
                            icon: 'error',
                            title: "Wait",
                            text: response.errMessage
                        });
                    }
                },
                error: function () {
                    Swal.fire({
                        icon: 'error',
                        title: "Wait",
                        text: "Failed to import the file."
                    });
                }
            });
        }

        const IMPORT_ERROR_FILE_NAME = 'GRNImport_Errors.xlsx';
        const IMPORT_ERROR_FIELD_COLUMNS = { ReelCode: 'Reel Code', ItemCode: 'Item Code', Qty: 'Quantity', ExpiryDate: 'Expiry Date', SupplierName: 'Supplier Name', SupplierRefNo: 'Supplier Ref No' };

        async function downloadImportErrorFile(errorRows, importContext) {
            const { headers, rows, fieldToIndex } = importContext;
            const colCount = rows.reduce((max, row) => Math.max(max, row.length), headers.length);
            const errorCol = colCount + 1;
            const expiryIndex = fieldToIndex['Expiry Date'];

            const workbook = new ExcelJS.Workbook();
            const sheet = workbook.addWorksheet("Sheet1");

            const headerValues = [];
            for (let c = 0; c < colCount; c++) {
                headerValues.push(cleanText(headers[c]));
            }
            headerValues.push('Error');
            const titleRow = sheet.addRow(headerValues);
            titleRow.font = { name: 'Arial', size: 11, bold: true };
            titleRow.eachCell(cell => {
                const parts = /^(.*?)\s*\*$/.exec(String(cell.value));
                if (parts) {
                    cell.value = { richText: [
                        { text: parts[1], font: { name: 'Arial', size: 11, bold: true } },
                        { text: ' *', font: { name: 'Arial', size: 11, bold: true, color: { argb: 'FFFF0000' } } }
                    ] };
                }
            });

            const markWrong = (excelCell) => {
                excelCell.fill = { type: 'pattern', pattern: 'solid', fgColor: { argb: 'FFFFC7CE' } };
            };

            rows.forEach((row, i) => {
                const values = [];
                for (let c = 0; c < colCount; c++) {
                    let value = row[c];
                    if (c === expiryIndex) {
                        const isoDate = parseImportDate(value);
                        if (isoDate) value = isoDate;
                    }
                    values.push(cleanText(value) === '' ? null : value);
                }

                const errorRow = errorRows[i];
                values.push(errorRow ? errorRow.errorMsg : '');
                const excelRow = sheet.addRow(values);

                if (errorRow && errorRow.errorMsg) {
                    (errorRow.errorFields || []).forEach(field => {
                        const index = fieldToIndex[IMPORT_ERROR_FIELD_COLUMNS[field]];
                        if (index !== undefined) markWrong(excelRow.getCell(index + 1));
                    });
                    const errorCell = excelRow.getCell(errorCol);
                    markWrong(errorCell);
                    errorCell.font = { color: { argb: 'FF9C0006' } };
                    errorCell.alignment = { wrapText: true, vertical: 'top' };
                }
            });

            for (let c = 1; c <= colCount; c++) {
                sheet.getColumn(c).width = 18;
            }
            sheet.getColumn(errorCol).width = 70;

            const buffer = await workbook.xlsx.writeBuffer();
            const blob = new Blob([buffer], { type: 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet' });
            const url = URL.createObjectURL(blob);
            const link = document.createElement('a');
            link.href = url;
            link.download = IMPORT_ERROR_FILE_NAME;
            document.body.appendChild(link);
            link.click();
            link.remove();
            URL.revokeObjectURL(url);
        }

        function printQR(source) {
            const reelCode = (typeof source === 'string') ? source : $(source).data('reelcode');
            if (!reelCode) {
                return;
            }

            let qrSvg;
            try {
                const qr = qrcode(0, 'M');
                qr.addData(String(reelCode));
                qr.make();
                qrSvg = qr.createSvgTag({ cellSize: 1, margin: 1, scalable: true });
            }
            catch (e) {
                console.error('Print QR failed:', e);
                reportClientError('Print QR', e);
                Swal.fire({
                    icon: 'error',
                    title: 'Print Failed',
                    text: 'Unable to generate QR code' + (e && e.message ? ': ' + e.message : '.')
                });
                return;
            }

            // Big enough for the browser's print preview (it is shown inside this window), and centered on the screen.
            const winWidth = 900, winHeight = 700;
            const winLeft = Math.max(0, Math.round((window.screen.width - winWidth) / 2));
            const winTop = Math.max(0, Math.round((window.screen.height - winHeight) / 2));
            const printWindow = window.open('', '_blank', `width=${winWidth},height=${winHeight},left=${winLeft},top=${winTop}`);
            if (!printWindow) {
                Swal.fire({
                    icon: 'error',
                    title: 'Print Failed',
                    text: 'Please allow pop-ups for this site to print labels.'
                });
                return;
            }

            // sticker and QR size in mm
            const labelWidth = 15, labelHeight = 20, qrSize = 10;
            printWindow.document.write(
                '<html><head><title>Reel Label</title><style>'
                + '@@page { size: ' + labelWidth + 'mm ' + labelHeight + 'mm; margin: 0; }'
                + 'html, body { margin:0; padding:0; width:' + labelWidth + 'mm; height:' + (labelHeight - 0.1) + 'mm; overflow:hidden; }'
                + 'body { display:flex; flex-direction:column; align-items:center; justify-content:center; font-family:Arial, sans-serif; }'
                + 'svg { width:' + qrSize + 'mm; height:' + qrSize + 'mm; display:block; }'
                + '.code { font-size:7pt; font-weight:bold; line-height:1; margin-top:1mm; white-space:nowrap; }'
                + '<\/style></head><body>'
                + qrSvg
                + '<div class="code">' + reelCode + '<\/div>'
                + '<\/body><\/html>'
            );
            printWindow.document.close();

            printWindow.onload = function () {
                printWindow.focus();
                printWindow.print();
            };
            printWindow.onafterprint = function () {
                printWindow.close();
            };
        }

        $('#listTable').on('click', '.delete-btn', function() {
            const id = $(this).attr('data-id');
            const reelCode = $(this).attr('data-code');
            deleteItem(id, reelCode);
        });

        function deleteItem(id, reelCode) {
            Swal.fire({
                title: "Are you sure want to delete?",
                text: "You won't be able to recover this record!",
                icon: 'warning', 
                showCancelButton: true,
                confirmButtonText: 'Yes',
                cancelButtonText: 'Cancel',
                allowOutsideClick: false
            }).then(function(r) {
                if (r.isConfirmed == true) {

                    var data = {
                        GRNDetail_Id: id,
                        ReelCode: reelCode,
                    };

                    $.ajax({
                        url: '/GRN/DeleteGRNDtl',
                        type: 'DELETE',
                        data: JSON.stringify(data),
                        dataType: 'json',
                        contentType: 'application/json; charset=utf-8',
                        beforeSend: function () {
                            Swal.fire({
                                text: 'Please Wait',
                                width: '300px',
                                allowEscapeKey: false,
                                allowOutsideClick: false,
                                showConfirmButton: false,
                            });
                            Swal.showLoading()
                        },
                        success: function (result) {
                            if (result.success == true) {
                                Swal.fire({
                                    icon: 'success',
                                    title: "Success Deleted",
                                    text: "",
                                    didClose: () => {
                                      window.location.reload();
                                    }
                                });
                            }
                            else {
                                Swal.fire({
                                    icon: 'error',
                                    title: "Wait",
                                    text: result.errMessage
                                });
                            }
                        },
                        error: function (error) {
                            Swal.fire({
                                icon: 'error',
                                title: "Wait",
                                text: error.val
                            });
                        }
                    });
                }
                else {
                    return;
                }
            });
        }

    </script>
}
