                </div>

                <input type="hidden" id="txtId2">
                <input type="hidden" id="txtItemId2">
                <input type="hidden" id="txtLoaderId2">
                <input type="hidden" id="txtReelCode2">

            </div>
            <div class="tw:flex tw:justify-end tw:gap-3 tw:border-t tw:border-gray-100 tw:px-6 tw:py-3 tw:dark:border-gray-800">
                <button type="button" class="tw:rounded-lg tw:border-0 tw:bg-brand-500 tw:px-4 tw:py-2.5 tw:text-sm tw:font-medium tw:text-white tw:shadow-theme-xs tw:hover:bg-brand-600" onclick="updateReceive()">Save</button>
                <button type="button" class="tw:bg-transparent tw:rounded-lg tw:border tw:border-gray-300 tw:px-4 tw:py-2.5 tw:text-sm tw:font-medium tw:text-gray-700 tw:hover:bg-gray-100 tw:dark:border-gray-700 tw:dark:text-gray-400 tw:dark:hover:bg-white/5" onclick="cancelEditForm()">Cancel</button>
            </div>
        </div>
    </div>
</div>


@section Scripts
{
    <link rel="stylesheet" href="~/css/sweetalert2.min.css">
    <link rel="stylesheet" href="~/css/dataTables.dataTables.css">

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/js/sweetalert2.all.min.js"></script>
    <script src="../js/dataTables.js"></script>
    <script src="../js/qrcode.js"></script>
    <script src="../js/qz-tray.js"></script>
    <script src="../js/xlsx.full.min.js"></script>

    <script type="text/javascript">
        let loaderList = [];
        const scanLoaderEle = document.getElementById('txtScanLoader');

        scanLoaderEle.addEventListener('keyup', function(event) {
          if (event.key === 'Enter') {

            const inputValue = this.value;
            var code = inputValue;
            $.ajax({
                url: "/Loader/GetLoaderInfo_ReadyToLoad?req=" + code,
                type: "GET",
                dataType: 'JSON',
                contentType: 'application/json; charset=utf-8',
                beforeSend: function () {
                    Swal.fire({
                        text: 'Please Wait',
                        width: '300px',
                        allowEscapeKey: false,
                        allowOutsideClick: false,
                        showConfirmButton: false,
                        hideClass: { popup: '' },
                    });
                    Swal.showLoading()
                },
                success: function (result) {
                    Swal.close();
                    if (result.success == true) {
                        addLoader(0, result.data.loader_Id, result.data.loaderCode);
                    }
                    else {
                        Swal.fire({
                            icon: 'error',
                            title: "Wait",
                            text: result.errMessage
                        });
                    }
                },
                error: function (error) {
                    Swal.fire({
                        icon: 'error',
                        title: "Wait",
                        text: error.val
                    });
                }
            });
          }
        });

        $(document).ready(function() {
            $('#txtGRN').val('-');
            const cellClass = 'tw:px-5 tw:py-4 tw:whitespace-nowrap sm:tw:px-6 tw:text-theme-sm tw:text-gray-700 tw:dark:text-gray-300';

            $('#listTable').DataTable({
                searching: true,
                responsive: true,
                "order": [[ 4, 'desc' ]],
                 paging: true,
                 scrollX: true,
                 pagingType: 'full_numbers',
                 pageLength: 50,
                 lengthMenu: [50, 100, 250, 500, 1000],
                 columnDefs: [
                     // { targets: '_all', className: 'text-start' }
                     { targets: 0, width: '160px', className: cellClass },
                     { targets: 2, width: '80px', className: cellClass },
                     { targets: 3, width: '160px', className: cellClass },
                     { targets: 4, width: '200px', className: cellClass },
                 ],
                 language: {
                     searchPlaceholder: "🔍︎ Search",
                     search: ""
                 }
            });

            initLoaderPicker();

            loadLoaderList();
            loadItemList();
        });

        function showLoaderForm() {
            $("#loaderModal").modal("show");
        }

        function cancelLoaderForm() {
            $("#loaderModal").modal("toggle");
        }

        function initLoaderPicker() {
            const wrap = document.getElementById('selLoader').closest('.tw\\:relative');
            const select = document.getElementById('selLoader');
            const btn = document.getElementById('selLoaderPickerBtn');
            const chevron = wrap.querySelector('.product-picker-chevron');
            const panel = wrap.querySelector('.product-picker-panel');
            const search = wrap.querySelector('.product-picker-search');
            const optionsBox = wrap.querySelector('.product-picker-options');

            function renderOptions(filter) {
                const term = (filter || '').toLowerCase();
                optionsBox.innerHTML = '';
                const filtered = loaderList.filter(i => i.loaderCode.toLowerCase().includes(term));
                if (filtered.length === 0) {
                    optionsBox.innerHTML = '<div class="tw:px-4 tw:py-2 tw:text-sm tw:text-gray-400 tw:dark:text-white/30">No matches</div>';
                    return;
                }
                filtered.forEach(i => {
                    const opt = document.createElement('div');
                    opt.className = 'tw:cursor-pointer tw:px-4 tw:py-2 tw:text-sm tw:text-gray-700 tw:hover:bg-brand-50 tw:dark:text-gray-300 tw:dark:hover:bg-brand-500/15';
                    opt.textContent = i.loaderCode;
                    opt.addEventListener('click', () => {
                        select.value = i.loader_Id;
                        syncLoaderLabel();
                        select.dispatchEvent(new Event('change'));
                        closePanel();
                    });
                    optionsBox.appendChild(opt);
                });
            }

            function openPanel() {
                if (btn.disabled) return;
                panel.classList.remove('tw:hidden');
                chevron.classList.add('tw:rotate-180');
                search.value = '';
                renderOptions('');
                search.focus();
            }

            function closePanel() {
                panel.classList.add('tw:hidden');
                chevron.classList.remove('tw:rotate-180');
            }

            btn.addEventListener('click', (e) => {
                e.stopPropagation();
                if (panel.classList.contains('tw:hidden')) {
                    openPanel();
                } else {
                    closePanel();
                }
            });
            search.addEventListener('click', (e) => e.stopPropagation());
            search.addEventListener('input', () => renderOptions(search.value));
            document.addEventListener('click', (e) => {
                if (!wrap.contains(e.target)) closePanel();
            });
        }

        function syncLoaderLabel() {
            const select = document.getElementById('selLoader');
            const label = document.getElementById('selLoaderPickerBtn').querySelector('.product-picker-label');
            const found = loaderList.find(i => i.loader_Id == select.value);
            if (found) {
                label.textContent = found.loaderCode;
                label.classList.remove('tw:text-gray-400', 'tw:dark:text-white/30');
                label.classList.add('tw:text-gray-800', 'tw:dark:text-white/90');
            } else {
                label.textContent = 'Select an option';
                label.classList.add('tw:text-gray-400', 'tw:dark:text-white/30');
                label.classList.remove('tw:text-gray-800', 'tw:dark:text-white/90');
            }
        }

        function loadLoaderList() {
            $.ajax({
                url: "/Loader/GetLoaderList_ReadyToLoad/",
                type: "GET",
                dataType: 'JSON',
                contentType: 'application/json; charset=utf-8',
                beforeSend: function () {
                    Swal.fire({
                        text: 'Please Wait',
                        width: '300px',
                        allowEscapeKey: false,
                        allowOutsideClick: false,
                        showConfirmButton: false,
                        hideClass: { popup: '' },
                    });
                    Swal.showLoading();
                },
                success: function (result) {
                    Swal.close();
                    if (result.success == true) {
                        loaderList = result.data;
                        const dropdown = document.getElementById('selLoader');
                        dropdown.innerHTML = "";

                        loaderList.forEach((i, index) => {
                            const option = document.createElement("option");
                            option.value = i.loader_Id;
                            option.textContent = i.loaderCode;
                            if (index === 0) {
                                option.selected = true;
                            }
                            dropdown.appendChild(option);
                        });

                        syncLoaderLabel();
                    }
                    else {
                        Swal.fire({
                            icon: 'error',
                            title: "Wait",
                            text: result.errMessage
                        });
                    }
                },
                error: function (error) {
                    Swal.fire({
                        icon: 'error',
                        title: "Wait",
                        text: error.val
                    });
                }
            });
        }

        function loadItemList() {
            $.ajax({
                url: "/Item/GetActiveItemList/",
                type: "GET",
                dataType: 'JSON',
                contentType: 'application/json; charset=utf-8',
                beforeSend: function () {
                    Swal.fire({
                        text: 'Please Wait',
                        width: '300px',

                        allowEscapeKey: false,
                        allowOutsideClick: false,
                        showConfirmButton: false,
                        hideClass: { popup: '' },
                    });
                    Swal.showLoading();
                },
                success: function (result) {
                    Swal.close();
                    if (result.success == true) {
                        const cellClass = 'tw:px-5 tw:py-4 tw:whitespace-nowrap sm:tw:px-6 tw:text-theme-sm tw:text-gray-700 tw:dark:text-gray-300';

                        $('#itemTable').DataTable( {
                            ordering: false,
                            data: result.data,
                            paging: true,
                            pagingType: 'full_numbers',
                            pageLength: 50,
                            lengthMenu: [50, 100, 250, 500, 1000],
                            columns: [
                                { data: 'itemCode', className: cellClass },
                                { data: 'uom', className: cellClass },
                                {
                                    data: null,
                                    className: cellClass,
                                    render: function (data, type, row, meta) {
                                        const desc = row.description || '';
                                        const descShort = desc.length > 30 ? desc.substring(0, 30) + '...' : desc;
                                        return '<p class="tw:m-0" title="' + desc.replace(/"/g, '&quot;') + '"><span>' + descShort + '</span><br/>' +
                                        '<span class="tw:text-[13px] tw:text-gray-500 tw:dark:text-gray-400">' + row.desc2 + '</span></p>';
                                    }
                                },
                                {
                                    data: null,
                                    render: function (data, type, row, meta) {
                                        const rowData = JSON.stringify(row).replace(/"/g, "&quot;");
                                        return `<div class="tw:flex">
                                                    <button class="addItem-btn tw:inline-flex tw:items-center tw:gap-1.5 tw:rounded-lg tw:border-0 tw:bg-brand-500 tw:px-3 tw:py-1.5 tw:text-sm tw:font-medium tw:text-white tw:hover:bg-brand-600" data-row="${rowData}">
                                                        <i class="bi bi-plus-lg"></i> Add
                                                    </button>
                                                </div>`;
                                    }
                                }
                            ],
                            language: {
                                searchPlaceholder: "🔍︎ Search",
                                search: ""
                            },
                            columnDefs: [
                                { width: '15%', targets: 0 }, 
                                { width: '10%', targets: 1 }, 
                                { width: '15%', targets: 2 }, 
                                { width: '15%', targets: 3 }  
                            ]
                        });

                    }
                    else {
                        Swal.fire({
                            icon: 'error',
                            title: "Wait",
                            text: result.errMessage
                        });
                    }
                },
                error: function (error) {
                    Swal.fire({
                        icon: 'error',
