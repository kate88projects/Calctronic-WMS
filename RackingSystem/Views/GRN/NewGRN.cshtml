            $("#itemModal").modal("toggle");

            $.ajax({
                url: "/Item/GetSingleItemGroup",
                type: "GET",
                dataType: 'JSON',
                data: { id: row.itemGroup_Id },
                contentType: 'application/json; charset=utf-8',
                success: function (result) {
                    if (result.success) {
                        const today = new Date();
                        const years = result.data.expiredYears;
                        const months = result.data.expiredMonths;

                        const expiredDate = new Date(today);
                        expiredDate.setFullYear(expiredDate.getFullYear() + years);
                        expiredDate.setMonth(expiredDate.getMonth() + months);
                        const formattedDate = expiredDate.toISOString().split('T')[0];

                        document.getElementById("dtpExDate").value = formattedDate;
                        removeErrMsg('dtpExDate');
                    }
                },
                error: function (error) {
                    Swal.fire({
                        icon: 'error',
                        title: "Wait",
                        text: error.val
                    });
                }
            });
        }

        function validateInput(inputChecks) {
            let isValid = true;

            inputChecks.forEach(input => {
                const el = document.getElementById(input.id);
                if (el && el.value.trim() === "") {
                    showError(input.id, `Please enter ${input.label}.`);
                    isValid = false;
                }
            });

            return isValid;
        }

        function showError(fieldId, message) {
            document.getElementById(fieldId).classList.add('is-invalid');
            document.getElementById(fieldId + 'Error').textContent = message;
        }

        function removeErrMsg(fields, clearValue = false) {
            if (!Array.isArray(fields)) {
                fields = [fields];
            }

            fields.forEach(function(field) {
                document.getElementById(field).classList.remove('is-invalid');
                document.getElementById(field).classList.remove('is-valid');
                document.getElementById(field + 'Error').textContent = '';
                if (clearValue) document.getElementById(field).value = '';
            });
        }

