        function printQR(source) {
            const reelCode = (typeof source === 'string') ? source : $(source).data('reelcode');
            if (!reelCode) {
                return;
            }

            let qrDataUrl;
            try {
                const qr = qrcode(0, 'M');
                qr.addData(String(reelCode));
                qr.make();
                qrDataUrl = qr.createDataURL(6, 8);
            }
            catch (e) {
                // console.log(e);
                Swal.fire({
                    icon: 'error',
                    title: 'Print Failed',
                    text: 'Unable to generate QR code.'
                });
                return;
            }

            const printWindow = window.open('', '_blank', 'width=300,height=300');
            if (!printWindow) {
                Swal.fire({
                    icon: 'error',
                    title: 'Print Failed',
                    text: 'Please allow pop-ups for this site to print labels.'
                });
                return;
            }

            printWindow.document.write(
                '<html><head><title>Reel Label</title><style>'
                + 'body { text-align:center; font-family:Arial, sans-serif; margin:0; padding:10px; }'
                + 'img { width:150px; height:150px; }'
                + '.code { font-size:14px; margin-top:5px; }'
                + '<\/style></head><body>'
                + '<img src="' + qrDataUrl + '" />'
                + '<div class="code">' + reelCode + '<\/div>'
                + '<\/body><\/html>'
            );
            printWindow.document.close();

            printWindow.onload = function () {
                printWindow.focus();
                printWindow.print();
            };
            printWindow.onafterprint = function () {
                printWindow.close();
            };
        }

