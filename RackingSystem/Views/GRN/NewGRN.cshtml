            <div class="tw:border-b tw:border-gray-100 tw:px-6 tw:py-4 tw:dark:border-gray-800">
                <h4 class="tw:mb-0 tw:text-base tw:font-semibold tw:text-gray-800 tw:dark:text-white/90">Update GRN</h4>
            </div>
            <div class="tw:space-y-4 tw:px-6 tw:py-4">
                <div>
                    <label class="@labelClass">Supplier Name</label>
                    <input id="txtSupplierName2" type="text" class="@inputClass" maxlength="255" oninput="removeErrMsg(this.id)" />
                    <div id="txtSupplierName2Error" class="error-message"></div>
                </div>
                <div>
                    <label class="@labelClass">Supplier Ref No</label>
                    <input id="txtSupplierRefNo2" type="text" class="@inputClass" maxlength="50" oninput="removeErrMsg(this.id)" />
                    <div id="txtSupplierRefNo2Error" class="error-message"></div>
                </div>
                <div>
                    <label class="@labelClass">Item</label>
                    <input id="txtItem2" type="button" class="@inputClass tw:cursor-pointer tw:text-left" onclick="showItemForm('Edit')" />
                    <div id="txtItem2Error" class="error-message"></div>
                </div>
                <div>
                    <label class="@labelClass">Qty</label>
                    <input id="txtQty2" type="number" class="@inputClass" oninput="removeErrMsg(this.id)" />
                    <div id="txtQty2Error" class="error-message"></div>
                </div>
                <div>
                    <label class="@labelClass">Expiry Date</label>
                    <input id="dtpExDate2" name="DateFrom" type="date" class="@inputClass" placeholder="Expiry Date" oninput="removeErrMsg(this.id)" />
                    <div id="dtpExDate2Error" class="error-message"></div>
                </div>
                <div>
                    <label class="@labelClass">Remark</label>
                    <input id="txtRemark2" type="text" class="@inputClass" maxlength="255" />
