        function exportGRNExcel() {
            var table = $('#listTable').DataTable();
            var rows = table.rows().data().toArray();

            if (rows.length === 0) {
                Swal.fire({
                    icon: 'info',
                    title: "Nothing to Export",
                    text: "No GRN records have been added yet."
                });
                return;
            }

            var aoa = [['GRN No', 'Item', 'Qty', 'Reel Code', 'Created']];
            rows.forEach(function (r) {
                aoa.push([r[0], r[1], r[2], r[3], r[4]]);
            });

            var wb = XLSX.utils.book_new();
            wb.Props = {
                Title: "New GRN",
                Subject: "GRN Receive List",
                Author: "Flex Software Consulting Sdn Bhd",
                CreatedDate: new Date()
            };
            var ws = XLSX.utils.aoa_to_sheet(aoa);
            XLSX.utils.book_append_sheet(wb, ws, "Sheet1");
            XLSX.writeFile(wb, "NewGRN.xlsx");
        }

