
<div class="tw:flex tw:w-full tw:items-center tw:justify-between">
    <h2 class="tw:text-lg tw:mb-0 tw:ml-2 tw:font-semibold tw:text-gray-800 tw:dark:text-white/90">New GRN</h2>
    <button type="button" class="tw:inline-flex tw:items-center tw:gap-2 tw:rounded-lg tw:border-0 tw:bg-indigo-500 tw:px-4 tw:py-2.5 tw:text-sm tw:font-medium tw:text-white tw:hover:bg-indigo-600" onclick="exportGRNExcel()">
        <i class="bi bi-file-earmark-excel"></i> Export Excel
    </button>
</div>


@{
    string inputClass = "tw:w-full tw:rounded-lg tw:border tw:border-gray-300 tw:bg-transparent tw:px-4 tw:py-2.5 tw:text-sm tw:text-gray-800 tw:placeholder:text-gray-400 tw:focus:border-brand-300 tw:focus:ring-3 tw:focus:ring-brand-500/10 tw:focus:outline-hidden tw:dark:border-gray-700 tw:dark:bg-gray-900 tw:dark:text-white/90 tw:dark:placeholder:text-white/30 tw:dark:focus:border-brand-800";
    string labelClass = "tw:mb-1.5 tw:block tw:text-sm tw:font-medium tw:text-gray-700 tw:dark:text-gray-400";
}
<div class="tw:mt-3 tw:rounded-xl tw:border tw:border-gray-200 tw:bg-white tw:px-5 tw:py-3.5 tw:dark:border-gray-800 tw:dark:bg-white/[0.03]">
    <div id="grnForm">
        <div class="tw:mb-4 tw:flex tw:items-center tw:gap-2">
            <i class="bi bi-info-circle tw:text-lg tw:text-brand-500"></i>
            <span class="tw:text-base tw:font-semibold tw:text-gray-800 tw:dark:text-white/90">Receive Info</span>
        </div>
        <div class="tw:space-y-4">
            <div class="tw:grid tw:grid-cols-3 tw:gap-4">
                <div>
                    <label class="@labelClass" for="txtLoader">Loader</label>
                    <input id="txtLoader" type="button" class="@inputClass tw:cursor-pointer tw:text-left" placeholder="Loader" onclick="showLoaderForm()">
                    <div id="txtLoaderError" class="error-message"></div>
                </div>
                <div>
                    <label class="@labelClass" for="txtGRN">GRN Batch No</label>
                    <input id="txtGRN" type="text" class="@inputClass" maxlength="50" oninput="removeErrMsg(this.id)">
                    <div id="txtGRNError" class="error-message"></div>
                </div>
                <div>
                    <label class="@labelClass" for="txtRemark">Remark</label>
                    <input id="txtRemark" type="text" class="@inputClass" maxlength="255">
                    <div id="txtRemarkError" class="error-message"></div>
                </div>
            </div>
            <div class="tw:grid tw:grid-cols-3 tw:gap-4">
                <div>
                    <label class="@labelClass" for="txtItem">Item</label>
                    <input id="txtItem" type="button" class="@inputClass tw:cursor-pointer tw:text-left" onclick="showItemForm('New')">
                    <div id="txtItemError" class="error-message"></div>
                </div>
                <div>
                    <label class="@labelClass" for="txtQty">Qty</label>
                    <input id="txtQty" type="number" class="@inputClass" oninput="removeErrMsg(this.id)">
                    <div id="txtQtyError" class="error-message"></div>
                </div>
                <div>
                    <label class="@labelClass" for="dtpExDate">Expiry Date</label>
                    <input id="dtpExDate" name="DateFrom" type="date" class="@inputClass" placeholder="Expiry Date" oninput="removeErrMsg(this.id)">
                    <div id="dtpExDateError" class="error-message"></div>
                </div>
            </div>
            <div class="tw:grid tw:grid-cols-2 tw:gap-4">
                <div>
                    <label class="@labelClass" for="txtSupplierName">Supplier Name</label>
                    <input id="txtSupplierName" type="text" class="@inputClass" maxlength="255" oninput="removeErrMsg(this.id)">
                    <div id="txtSupplierNameError" class="error-message"></div>
                </div>
                <div>
                    <label class="@labelClass" for="txtSupplierRefNo">Supplier Ref No</label>
                    <input id="txtSupplierRefNo" type="text" class="@inputClass" maxlength="50" oninput="removeErrMsg(this.id)">
                    <div id="txtSupplierRefNoError" class="error-message"></div>
                </div>
            </div>
            <div class="tw:flex tw:items-center tw:gap-2">
                <input type="checkbox" class="tw:h-4 tw:w-4 tw:accent-brand-500" id="chkPrint" checked>
                <label class="tw:text-sm tw:text-gray-700 tw:dark:text-gray-400" for="chkPrint">Print QR</label>
            </div>
            @* <div class="col-sm-6 col-md-2">
                <div class="custom-control custom-checkbox">
                    <input class="custom-control-input" type="checkbox" id="chkPrintItem">
                    <label for="chkPrintItem" class="custom-control-label">Print Item</label>
                </div>
            </div> *@
            @* <div class="col-sm-6 col-md-3">
                <div class="custom-control custom-checkbox">
                    <input class="custom-control-input" type="checkbox" id="chkLoadToLoader">
                    <label for="chkLoadToLoader" class="custom-control-label">Start Loader</label>
                </div>
            </div> *@
        </div>

        <div class="tw:flex tw:justify-end">
            <button type="button" class="tw:inline-flex tw:items-center tw:gap-1.5 tw:rounded-lg tw:border-0 tw:bg-brand-500 tw:px-4 tw:py-2.5 tw:text-sm tw:font-medium tw:text-white tw:hover:bg-brand-600" id="addButton" onclick="addReceive()">
                <i class="bi bi-plus-lg"></i> Add
            </button>
        </div>
        <input type="hidden" id="txtItemId">
        <input type="hidden" id="txtLoaderId">
        <input type="hidden" id="txtReelCode1">
    </div>
</div>

<div class="tw:mt-4 tw:rounded-xl tw:border tw:border-gray-200 tw:bg-white tw:dark:border-gray-800 tw:dark:bg-white/[0.03]">
    <div class="dt-tailadmin tw:overflow-hidden tw:text-gray-700 tw:dark:text-gray-300">
        <table id="listTable" class="row-border dataTable hover order-column tw:w-full">
            <thead>
                <tr class="tw:border-b tw:border-gray-200">
                    @{
                        string[] listHeaders = { "GRN No", "Item", "Qty", "Reel Code", "Created", "Action" };
                    }
                    @foreach (var header in listHeaders)
                    {
                        <th class="tw:px-5 tw:py-3.5 tw:text-left sm:tw:px-6"><span class="tw:text-sm tw:font-semibold tw:text-gray-700 tw:dark:text-gray-300">@header</span></th>
                    }
                </tr>
            </thead>
        </table>
    </div>
</div>

<div class="modal fade" id="loaderModal" role="dialog">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content tw:rounded-2xl tw:border-0 tw:bg-white tw:text-gray-700 tw:shadow-theme-lg tw:dark:bg-gray-900 tw:dark:text-gray-300">
            <div class="tw:border-b tw:border-gray-100 tw:px-6 tw:py-4 tw:dark:border-gray-800">
                <h3 class="tw:mb-0 tw:text-base tw:font-semibold tw:text-gray-800 tw:dark:text-white/90">Scan Loader Code</h3>
            </div>
            <div class="tw:space-y-4 tw:px-6 tw:py-4">
                <input id="txtScanLoader" class="@inputClass" type="text" placeholder="Scan Loader ... ">
                <hr class="tw:border-gray-200 tw:dark:border-gray-800">
                <div>
                    <label class="@labelClass" for="selLoader">Or select loader from list :</label>
                    <div class="tw:relative">
                        <select class="tw:hidden" id="selLoader"></select>
                        <button type="button" id="selLoaderPickerBtn" class="product-picker-btn tw:box-border tw:flex tw:h-[40px] tw:w-full tw:items-center tw:justify-between tw:gap-2 tw:rounded-lg tw:border tw:border-gray-300 tw:bg-transparent tw:px-4 tw:text-left tw:text-sm tw:dark:border-gray-700 tw:dark:bg-gray-900">
                            <span class="product-picker-label tw:truncate tw:text-gray-400 tw:dark:text-white/30">Select an option</span>
                            <i class="bi bi-chevron-down product-picker-chevron tw:shrink-0 tw:text-xs tw:text-gray-500 tw:transition-transform tw:dark:text-gray-400"></i>
                        </button>
                        <div class="product-picker-panel tw:absolute tw:z-50 tw:mt-1 tw:hidden tw:w-full tw:overflow-hidden tw:rounded-lg tw:border tw:border-gray-200 tw:bg-white tw:shadow-theme-lg tw:dark:border-gray-700 tw:dark:bg-gray-900">
                            <div class="tw:border-b tw:border-gray-100 tw:p-2 tw:dark:border-gray-800">
                                <input type="text" class="product-picker-search tw:w-full tw:rounded-md tw:border tw:border-gray-300 tw:px-3 tw:py-1.5 tw:text-sm tw:text-gray-800 tw:outline-none
                                    tw:focus:border-brand-300 tw:dark:border-gray-700 tw:dark:bg-gray-800 tw:dark:text-white/90" placeholder="Search loaders...">
                            </div>
                            <div class="product-picker-options tw:max-h-52 tw:overflow-y-auto tw:py-1"></div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="tw:flex tw:justify-end tw:gap-3 tw:border-t tw:border-gray-100 tw:px-6 tw:py-3 tw:dark:border-gray-800">
                <button type="button" class="tw:rounded-lg tw:border-0 tw:bg-brand-500 tw:px-4 tw:py-2.5 tw:text-sm tw:font-medium tw:text-white tw:shadow-theme-xs tw:hover:bg-brand-600" onclick="addLoader(1, '','')">Done</button>
                <button type="button" class="tw:bg-transparent tw:rounded-lg tw:border tw:border-gray-300 tw:px-4 tw:py-2.5 tw:text-sm tw:font-medium tw:text-gray-700 tw:hover:bg-gray-100 tw:dark:border-gray-700 tw:dark:text-gray-400 tw:dark:hover:bg-white/5" onclick="cancelLoaderForm()">Cancel</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="itemModal" role="dialog" data-bs-focus="false">
    <div class="modal-dialog modal-lg">
        <div class="modal-content tw:overflow-hidden tw:rounded-2xl tw:border-0 tw:bg-white tw:text-gray-700 tw:shadow-theme-lg tw:dark:bg-gray-900 tw:dark:text-gray-300">
            <div class="tw:border-b tw:border-gray-100 tw:bg-brand-500 tw:px-6 tw:py-4">
                <h4 class="tw:mb-0 tw:text-base tw:font-semibold tw:text-white">Select Item</h4>
            </div>

            <div class="dt-tailadmin tw:overflow-hidden tw:rounded-xl tw:border tw:border-gray-200 tw:bg-white tw:text-gray-700 tw:dark:border-gray-800 tw:dark:bg-white/[0.03] tw:dark:text-gray-300">
                <table id="itemTable" class="row-border dataTable hover order-column tw:w-full">
                    <thead>
                        <tr class="tw:border-b tw:border-gray-200">
                            @{
                                string[] ItemHeaders = { "Item Code", "UOM", "Description", "Action" };
                            }
                            @foreach (var header in ItemHeaders)
                            {
                                <th class="tw:px-5 tw:py-3.5 tw:text-left sm:tw:px-6"><span class="tw:text-sm tw:font-semibold tw:text-gray-700 tw:dark:text-gray-300">@header</span></th>
                            }
                        </tr>
                    </thead>
                </table>
                <input type="hidden" id="txtItemStatus">
            </div>

        </div>
    </div>
</div>

<div class="modal fade" data-bs-backdrop="static" id="myEditModal" role="dialog">
