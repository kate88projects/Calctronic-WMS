            });

            document.getElementById('csvColumnContent').innerHTML = columnDropdowns;
            if (window.Alpine) {
                Alpine.initTree(document.getElementById('csvColumnContent'));
            }
            $('#columnMatchingModal').modal("show");
        }

        function captureUserMappings() {
            const mappings = {};
            document.querySelectorAll('.column-mapping').forEach((selectElement, index) => {
                const selectedValue = selectElement.value; 
                const columnName = selectElement.getAttribute('data-col');
                if (selectedValue) {
                    mappings[columnName] = selectedValue;
                } else {
                    console.log(`No selection for column: ${columnName}`);
                }
            });
            return mappings;
        }

        function cleanText(val) {
            return val === undefined || val === null ? '' : String(val).trim();
        }

        function processAndSubmitData() {
            let workbook;
            let slotsData;
            userMappings = captureUserMappings();
            content = uploadedFileContent;
            fileExtension = uploadedFileExtension;
            const updateType = $('#updateType').val();

            try {
                if (fileExtension === 'csv') {
                    workbook = XLSX.read(content, { type: 'string', codepage: 65001 });
                } else {
                    workbook = XLSX.read(content, { type: 'array' });
                }

                const sheet = workbook.Sheets[workbook.SheetNames[0]];
                const data = XLSX.utils.sheet_to_json(sheet, { header: 1 });

                const columns = data[0];
                const colIndex = {};

                const fieldNames = updateType === "slots"
                    ? ['Trolley Code', 'Trolley Slot Code', 'Column No', 'Row No', 'X Pulse', 'Z Pulse', 'QR-X Pulse', 'QR-Z Pulse',
                       'Additional Pulse 1', 'Additional Pulse 2', 'Additional Pulse 3', 'Additional Pulse 4', 'Additional Pulse 5', 'Additional Pulse 6',
                       'Is Active', 'Is Left']
                    : ['Trolley Slot Code', 'X Pulse', 'Z Pulse', 'QR-X Pulse', 'QR-Z Pulse',
                       'Additional Pulse 1', 'Additional Pulse 2', 'Additional Pulse 3', 'Additional Pulse 4', 'Additional Pulse 5', 'Additional Pulse 6',
                       'Is Active', 'Is Left'];

                fieldNames.forEach(field => {
                    const fileColumn = Object.keys(userMappings).find(name => userMappings[name] === field);
                    colIndex[field] = fileColumn === undefined ? -1 : columns.findIndex(c => String(c) === fileColumn);
                });

                const dataRows = data.slice(1).map((row, i) => ({ row, excelRow: i + 2 }));
                while (dataRows.length > 0 && fieldNames.every(field => cleanText(dataRows[dataRows.length - 1].row[colIndex[field]]) === '')) {
                    dataRows.pop();
                }
                if (dataRows.length === 0) {
                    alert("The file has no data rows.");
                    return;
                }

                if (updateType === "slots" && trolleyCodeList.length === 0) {
                    Swal.fire({ icon: 'error', title: "Wait", text: "The trolley list is not available, please refresh the page and try again." });
                    return;
                }

                const errors = [];
                const numberOf = (row, excelRow, field) => {
                    const text = cleanText(row[colIndex[field]]).replace(/,/g, '');
                    if (text === '') return undefined;
                    const n = Number(text);
                    if (!Number.isInteger(n)) {
                        errors.push(`Row ${excelRow}: ${field} [${text}] must be a whole number`);
                        return undefined;
                    }
                    return n;
                };
                const textOf = (row, field) => cleanText(row[colIndex[field]]) || undefined;

                if (updateType === "slots")
                {
                    const parseBool = val =>
                        val === true || val === 1 || val === '1' || val === 'true' || val === 'TRUE';

                    slotsData = dataRows.map(({ row, excelRow }) => {
                        const trolleyCode = cleanText(row[colIndex['Trolley Code']]);
                        const trolley = trolleyCodeList.find(x => x.trolleyCode === trolleyCode);
                        if (!trolley) {
                            errors.push(trolleyCode === '' ? `Row ${excelRow}: trolley code is empty` : `Row ${excelRow}: trolley [${trolleyCode}] not found or not active`);
                        }

                        return {
                            Trolley_Id: trolley ? trolley.trolleyId : 0,
                            ExcelRow: excelRow,
                            TrolleySlotCode: textOf(row, 'Trolley Slot Code'),
                            ColNo: numberOf(row, excelRow, 'Column No'),
                            RowNo: numberOf(row, excelRow, 'Row No'),
                            XPulse: numberOf(row, excelRow, 'X Pulse'),
                            YPulse: numberOf(row, excelRow, 'Z Pulse'),
                            QRXPulse: numberOf(row, excelRow, 'QR-X Pulse'),
                            QRYPulse: numberOf(row, excelRow, 'QR-Z Pulse'),
                            Add1Pulse: numberOf(row, excelRow, 'Additional Pulse 1'),
                            Add2Pulse: numberOf(row, excelRow, 'Additional Pulse 2'),
                            Add3Pulse: numberOf(row, excelRow, 'Additional Pulse 3'),
                            Add4Pulse: numberOf(row, excelRow, 'Additional Pulse 4'),
                            Add5Pulse: numberOf(row, excelRow, 'Additional Pulse 5'),
                            Add6Pulse: numberOf(row, excelRow, 'Additional Pulse 6'),
                            IsActive: parseBool(row[colIndex['Is Active']]),
                            IsLeft: parseBool(row[colIndex['Is Left']]),
                        };
                    });
                }
                else {
                    slotsData = dataRows.map(({ row, excelRow }) => {
                        return {
                            ExcelRow: excelRow,
                            TrolleySlotCode: textOf(row, 'Trolley Slot Code'),
                            XPulse: numberOf(row, excelRow, 'X Pulse'),
                            YPulse: numberOf(row, excelRow, 'Z Pulse'),
                            QRXPulse: numberOf(row, excelRow, 'QR-X Pulse'),
                            QRYPulse: numberOf(row, excelRow, 'QR-Z Pulse'),
                            Add1Pulse: numberOf(row, excelRow, 'Additional Pulse 1'),
                            Add2Pulse: numberOf(row, excelRow, 'Additional Pulse 2'),
                            Add3Pulse: numberOf(row, excelRow, 'Additional Pulse 3'),
                            Add4Pulse: numberOf(row, excelRow, 'Additional Pulse 4'),
                            Add5Pulse: numberOf(row, excelRow, 'Additional Pulse 5'),
                            Add6Pulse: numberOf(row, excelRow, 'Additional Pulse 6'),
                        };
                    });
                }

                if (errors.length > 0) {
                    Swal.fire({
                        icon: 'error',
                        title: "Wait",
                        text: errors.slice(0, 10).join('; ') + (errors.length > 10 ? ` ... and ${errors.length - 10} more` : '')
                    });
                    return;
                }

                saveExcelSlots(slotsData, { headers: columns, dataRows, fieldToIndex: colIndex }, updateType);

            } catch (error) {
                console.error("Error processing the file:", error);
                alert("Failed to process the uploaded file.");
            }
        }

        function saveExcelSlots(slotsData, importContext, source) {
            const url = source == "slots" ? '/Trolley/SaveExcelTrolleySlot' : '/Trolley/UpdateExcelTSPulses';
            if (slotsData != null)
            {
                $.ajax({
                    url: url, 
                    type: 'POST',
                    data: JSON.stringify(slotsData),
                    dataType: 'JSON',
                    contentType: 'application/json; charset=utf-8',
                    beforeSend: function () {
                        Swal.fire({
                            text: 'Please Wait',
                            width: '300px',
                            allowEscapeKey: false,
                            allowOutsideClick: false,
                            showConfirmButton: false,
                        });
                        Swal.showLoading()
                    },
                    success: function(response) {
                        if (response.success == true) {
                            Swal.fire({
                                icon: 'success',
                                title: "Success Update",
                                text: "",
                                didClose: () => {
                                    window.location.reload();
                                }
                            });
                        } else {
                           if (response.data && response.data.length > 0) {
                               markErrorsInSheet(importContext, response.data, source);
                               Swal.fire({
                                  icon: 'warning',
                                  title: "Validation Issues Found",
                                  text: "Review on returned file and fix errors."
                               });
                               $('#columnMatchingModal').modal("toggle");

                           } else {
                               Swal.fire({
                                  icon: 'error',
                                  title: "Wait",
                                  text: response.errMessage
                               });
                           }
                        }
                    },
                    error: function(xhr) {
                        const detail = xhr && xhr.responseJSON && xhr.responseJSON.errors ? Object.values(xhr.responseJSON.errors).flat()[0] : '';
                        Swal.fire({
                            icon: 'error',
                            title: "Wait",
                            text: detail ? `The server could not read the file: ${detail}` : 'Failed to import the file.'
                        });
                    }
                });
            }
        }

        const IMPORT_ERROR_FIELD_COLUMNS = {
            TrolleySlotCode: 'Trolley Slot Code', ColNo: 'Column No', RowNo: 'Row No', IsLeft: 'Is Left',
            XPulse: 'X Pulse', YPulse: 'Z Pulse', QRXPulse: 'QR-X Pulse', QRYPulse: 'QR-Z Pulse',
            Add1Pulse: 'Additional Pulse 1', Add2Pulse: 'Additional Pulse 2', Add3Pulse: 'Additional Pulse 3',
            Add4Pulse: 'Additional Pulse 4', Add5Pulse: 'Additional Pulse 5', Add6Pulse: 'Additional Pulse 6'
        };

        async function markErrorsInSheet(importContext, errorRows, updateType) {
            const { headers, dataRows, fieldToIndex } = importContext;
            const colCount = dataRows.reduce((max, r) => Math.max(max, r.row.length), headers.length);
            const errorCol = colCount + 1;

            const workbook = new ExcelJS.Workbook();
            const worksheet = workbook.addWorksheet("Sheet1");

            const headerValues = [];
            for (let c = 0; c < colCount; c++) {
                headerValues.push(cleanText(headers[c]));
            }
            headerValues.push('Error');
            const titleRow = worksheet.addRow(headerValues);
            titleRow.font = { name: 'Arial', size: 11, bold: true };
            // the asterisk of a compulsory column stays red, like in the template
            titleRow.eachCell(cell => {
                const parts = /^(.*?)\s*\*$/.exec(String(cell.value));
                if (parts) {
                    cell.value = { richText: [
                        { text: parts[1], font: { name: 'Arial', size: 11, bold: true } },
                        { text: ' *', font: { name: 'Arial', size: 11, bold: true, color: { argb: 'FFFF0000' } } }
                    ] };
                }
            });

            const errorByRow = new Map();
            errorRows.forEach(e => {
                if (e.errorMsg) errorByRow.set(e.excelRow, e);
            });

            const markWrong = cell => {
                cell.fill = { type: 'pattern', pattern: 'solid', fgColor: { argb: 'FFFFC7CE' } };
            };

            dataRows.forEach(({ row, excelRow }) => {
                const values = [];
                for (let c = 0; c < colCount; c++) {
                    values.push(cleanText(row[c]) === '' ? null : row[c]);
                }

                const errorRow = errorByRow.get(excelRow);
                values.push(errorRow ? errorRow.errorMsg : null);
                const sheetRow = worksheet.addRow(values);

                if (errorRow) {
                    (errorRow.errorFields || []).forEach(field => {
                        const index = fieldToIndex[IMPORT_ERROR_FIELD_COLUMNS[field]];
                        if (index !== undefined && index >= 0) markWrong(sheetRow.getCell(index + 1));
                    });
                    const errorCell = sheetRow.getCell(errorCol);
                    markWrong(errorCell);
                    errorCell.font = { color: { argb: 'FF9C0006' } };
                }
            });

            for (let c = 1; c <= colCount; c++) {
                worksheet.getColumn(c).width = 18;
            }
            worksheet.getColumn(errorCol).width = 60;

            const updatedBuffer = await workbook.xlsx.writeBuffer();
            const blob = new Blob([updatedBuffer], {
                type: "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
            });

            const link = document.createElement("a");
            link.href = URL.createObjectURL(blob);
            link.download = updateType === "slots" ? "TrolleySlotList_Errors.xlsx" : "TrolleySlotPulses_Errors.xlsx";
            link.click();

            Swal.fire({
                icon: 'warning',
                title: "Validation Issues Found",
                text: "Review on returned file and fix errors."
            });
        }
	</script>
}

