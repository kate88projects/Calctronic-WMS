        function downloadTemplateFile(fileName, subject, headers, widthsPx, requiredHeaders = []) {
            const workbook = new ExcelJS.Workbook();
            workbook.creator = "Flex Software Consulting Sdn Bhd";
            workbook.created = new Date();
            workbook.properties.title = "Template";
            workbook.properties.subject = subject;

            const sheet = workbook.addWorksheet("Sheet1");
            const headerRow = sheet.addRow(headers);
            headerRow.font = { name: 'Arial', size: 11, bold: true };
            headers.forEach((header, i) => {
                if (requiredHeaders.includes(header)) {
                    headerRow.getCell(i + 1).value = { richText: [
                        { text: header, font: { name: 'Arial', size: 11, bold: true } },
                        { text: ' *', font: { name: 'Arial', size: 11, bold: true, color: { argb: 'FFFF0000' } } }
                    ] };
                }
                sheet.getColumn(i + 1).width = Math.max(Math.round((widthsPx[i] || 0) / 7), header.length + 3);
            });

            workbook.xlsx.writeBuffer().then(function (buffer) {
                const blob = new Blob([buffer], { type: "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" });
                const link = document.createElement("a");
                link.href = URL.createObjectURL(blob);
                link.download = fileName;
                link.click();
                URL.revokeObjectURL(link.href);
            }).catch(function (err) {
                console.error("Error creating the template:", err);
            });
        }

