
<style>
    #system-log {
        color: #7f8c8d;
        height: 350px;
        overflow-y: auto;
        padding: 10px;
        font-family: monospace;
        font-size: 0.9em;
        border-radius: 4px;
    }

    .log-entry {
        margin-bottom: 3px;
        white-space: nowrap;
    }

    .log-info {
        color: var(--text-color);
    }

    .log-alert {
        color: var(--status-alarm);
    }

    .log-success {
        color: var(--status-ok);
    }

    .yellow {
        background: #ffc107;
    }

    .circle {
        width: 10px;
        height: 10px;
        border-radius: 50%;
        box-shadow: 0px 0px 1px 1px #0000001a;
    }

    .pulse {
        animation: pulse-animation 2s infinite;
    }

    @@keyframes pulse-animation {
        0% {
            box-shadow: 0 0 0 0px rgba(0, 0, 0, 0.2);
        }

        100% {
            box-shadow: 0 0 0 10px rgba(0, 0, 0, 0);
        }
    }

    .diff-up {
        color: #28a745;
        font-size: 14px;
    }

    .diff-down {
        color: #dc3545;
        font-size: 14px;
    }

    .diff-same {
        color: #6c757d;
        font-size: 14px;
    }

    .diff-up::before {
        content: "▲ ";
    }

    .diff-down::before {
        content: "▼ ";
    }

</style>

<div class="tw:flex tw:w-full tw:items-center tw:justify-between">
    <h2 class="tw:text-lg tw:mb-0 tw:ml-2 tw:font-semibold tw:text-gray-800 tw:dark:text-white/90">Update Trolley Slot QR Pulse</h2>
    <div class="tw:flex">
        <button type="button" class="tw:border-0 tw:inline-flex tw:items-center tw:gap-2 tw:rounded-lg tw:bg-indigo-500 tw:px-4 tw:py-2.5 tw:text-sm tw:font-medium tw:text-white tw:transition
                tw:hover:bg-indigo-600" onclick="exportLogFile()">
            Export Pulses
        </button>
    </div>
</div>

<div class="tw:mt-3">
    <input type="hidden" id="xToken" value="@ViewBag.xToken" autocomplete="off">
    <input id="chkCont" type="checkbox" class="" style="display:none;" />

    @{
        string inputClass = "tw:w-28 tw:rounded-lg tw:border tw:border-gray-300 tw:bg-transparent tw:px-3 tw:py-2 tw:text-sm tw:text-gray-800 tw:focus:border-brand-300 tw:focus:ring-3 tw:focus:ring-brand-500/10 tw:focus:outline-hidden tw:dark:border-gray-700 tw:dark:bg-gray-900 tw:dark:text-white/90";
        string labelClass = "tw:whitespace-nowrap tw:text-sm tw:font-medium tw:text-gray-700 tw:dark:text-gray-400";
        string btnBase = "tw:inline-flex tw:items-center tw:justify-center tw:gap-1.5 tw:rounded-lg tw:border-0 tw:px-4 tw:py-2.5 tw:text-sm tw:font-medium tw:text-white tw:disabled:cursor-not-allowed tw:disabled:opacity-50";
    }

    <div class="tw:rounded-xl tw:border tw:border-gray-200 tw:bg-white tw:p-4 tw:dark:border-gray-800 tw:dark:bg-white/[0.03]">
        <div class="tw:flex tw:flex-wrap tw:items-center tw:gap-4">
            <div class="tw:flex tw:items-center tw:gap-2">
                <label class="@labelClass" for="txtCol">Column: </label>
                <div class="tw:relative tw:w-20" x-data="customSelect('txtSide')" x-init="init()">
                <select class="tw:hidden" id="txtSide">
                    <option value="A">A</option>
                    <option value="B">B</option>
                </select>
                <button type="button" @@click="toggle()" @@click.outside="open = false"
                        class="tw:flex tw:w-full tw:items-center tw:justify-between tw:gap-2 tw:rounded-lg tw:border tw:bg-transparent tw:px-3 tw:py-2 tw:text-left tw:text-sm tw:text-gray-800 tw:dark:bg-gray-900 tw:dark:text-white/90"
                        :class="hasError ? 'tw:border-error-500' : (open ? 'tw:border-brand-300 tw:ring-3 tw:ring-brand-500/10' : 'tw:border-gray-300 tw:dark:border-gray-700')">
                    <span x-text="selectedLabel || 'Select...'" :class="selectedLabel ? '' : 'tw:text-gray-400 tw:dark:text-white/30'"></span>
                    <i class="bi bi-chevron-down tw:text-xs tw:text-gray-500 tw:transition-transform tw:dark:text-gray-400" :class="open ? 'tw:rotate-180' : ''"></i>
                </button>
                <div x-show="open" x-transition
                     class="custom-select-scroll tw:absolute tw:z-50 tw:max-h-60 tw:w-full tw:overflow-y-auto tw:rounded-lg tw:border tw:border-gray-200 tw:bg-white tw:py-1 tw:shadow-theme-lg tw:dark:border-gray-700 tw:dark:bg-gray-900"
                     :class="dropUp ? 'tw:bottom-full tw:mb-1' : 'tw:top-full tw:mt-1'">
                    <template x-if="options.length === 0">
                        <div class="tw:px-4 tw:py-2 tw:text-sm tw:text-gray-400 tw:dark:text-white/30">No options</div>
                    </template>
                    <template x-for="opt in options" :key="opt.value">
                        <div @@click="select(opt)"
                             class="tw:cursor-pointer tw:px-4 tw:py-2 tw:text-sm tw:hover:bg-brand-50 tw:dark:hover:bg-brand-500/15"
                             :class="opt.value === selectedValue ? 'tw:bg-brand-50 tw:font-medium tw:text-brand-600 tw:dark:bg-brand-500/15 tw:dark:text-brand-400' : 'tw:text-gray-700 tw:dark:text-gray-300'"
                             x-text="opt.text"></div>
                    </template>
                </div>
            </div>
                <input type="number" class="@inputClass" value="1" id="txtCol" name="txtCol" placeholder="Column No" />
            </div>
            <div class="tw:flex tw:items-center tw:gap-2">
                <label class="@labelClass" for="txtRow">From Row:</label>
                <input type="number" class="@inputClass" value="1" id="txtRow" name="txtRow" placeholder="Row No" />
            </div>
            <div class="tw:ml-auto tw:flex tw:flex-wrap tw:gap-2">
                <button type="button" class="@btnBase tw:bg-brand-500 tw:hover:bg-brand-600" onclick="loadList()">
                    <i class="bi bi-search"></i> Generate
                </button>
                <button type="button" class="@btnBase tw:bg-emerald-500 tw:hover:bg-emerald-600" onclick="getQRPulses()" id="start-btn">Start Scan</button>
                <button type="button" class="@btnBase tw:bg-emerald-500 tw:hover:bg-emerald-600" onclick="getContQRPulses()" id="start-btn">Start Cont. Scan</button>
                <button type="button" class="@btnBase tw:bg-error-500 tw:hover:bg-error-600" onclick="stopGet()" id="stop-btn">Stop Scan</button>
            </div>
        </div>
    </div>

    <!-- Status -->
    <div class="tw:my-4 tw:grid tw:grid-cols-4 tw:gap-4">
        <div class="tw:rounded-2xl tw:border tw:border-gray-200 tw:bg-gray-50 tw:p-4 tw:text-center tw:dark:border-gray-800 tw:dark:bg-white/[0.03] tw:bg-white">
            <h3 class="tw:mb-1.5 tw:text-[13px] tw:text-gray-500 tw:dark:text-gray-400">Status</h3>
            <div class="tw:text-xl tw:font-semibold tw:text-gray-800 tw:dark:text-white/90" id="txtIdle">Stop</div>
        </div>
        <div class="tw:rounded-2xl tw:border tw:border-gray-200 tw:bg-gray-50 tw:p-4 tw:text-center tw:dark:border-gray-800 tw:dark:bg-white/[0.03] tw:bg-white">
            <h3 class="tw:mb-1.5 tw:text-[13px] tw:text-gray-500 tw:dark:text-gray-400">Current Row</h3>
            <div class="tw:text-xl tw:font-semibold tw:text-gray-800 tw:dark:text-white/90" id="txtCurRow">–</div>
        </div>
        <div class="tw:rounded-2xl tw:border tw:border-gray-200 tw:bg-gray-50 tw:p-4 tw:text-center tw:dark:border-gray-800 tw:dark:bg-white/[0.03] tw:bg-white">
            <h3 class="tw:mb-1.5 tw:text-[13px] tw:text-gray-500 tw:dark:text-gray-400">Pulses Read</h3>
            <div class="tw:flex tw:items-center tw:justify-center tw:gap-1.5 tw:text-base">
                <span class="tw:font-semibold tw:text-gray-600 tw:dark:text-gray-400">QR-X:</span>
                <span class="tw:font-bold tw:text-gray-800 tw:dark:text-white/90" id="pulseXValue">0</span>
                <span class="pulse-diff tw:ml-1" id="pulseXDiff"></span>
            </div>
            <div class="tw:mt-1 tw:flex tw:items-center tw:justify-center tw:gap-1.5 tw:text-base">
                <span class="tw:font-semibold tw:text-gray-600 tw:dark:text-gray-400">QR-Z:</span>
                <span class="tw:font-bold tw:text-gray-800 tw:dark:text-white/90" id="pulseZValue">0</span>
                <span class="pulse-diff tw:ml-1" id="pulseZDiff"></span>
            </div>
        </div>
        <div class="tw:rounded-2xl tw:border tw:border-gray-200 tw:bg-gray-50 tw:p-4 tw:text-center tw:dark:border-gray-800 tw:dark:bg-white/[0.03] tw:bg-white">
            <h3 class="tw:mb-1.5 tw:text-[13px] tw:text-gray-500 tw:dark:text-gray-400">Errors</h3>
            <div class="tw:text-xl tw:font-semibold tw:text-error-600 tw:dark:text-error-500" id="txtErr">-</div>
        </div>
    </div>

    <div class="tw:grid tw:grid-cols-[1fr_1fr_1fr_2fr] tw:gap-3">
        <div class="tw:overflow-hidden tw:rounded-lg tw:border tw:border-gray-200 tw:bg-white tw:dark:border-gray-800 tw:dark:bg-white/[0.03] tw:p-3">
            <table class="tw:w-full tw:text-xs" id="list1Table">
                <tbody id="list1TableBody" class="tw:[&>tr]:border-b tw:[&>tr]:border-gray-100 tw:[&>tr:last-child]:border-0 tw:[&>tr:nth-child(even)]:bg-gray-50 tw:[&>tr:hover]:bg-gray-100 tw:dark:[&>tr]:border-gray-800 tw:dark:[&>tr:nth-child(even)]:bg-white/[0.03] tw:dark:[&>tr:hover]:bg-white/10"></tbody>
            </table>
        </div>
        <div class="tw:overflow-hidden tw:rounded-lg tw:border tw:border-gray-200 tw:bg-white tw:dark:border-gray-800 tw:dark:bg-white/[0.03] tw:p-3">
            <table class="tw:w-full tw:text-xs" id="list2Table">
                <tbody id="list2TableBody" class="tw:[&>tr]:border-b tw:[&>tr]:border-gray-100 tw:[&>tr:last-child]:border-0 tw:[&>tr:nth-child(even)]:bg-gray-50 tw:[&>tr:hover]:bg-gray-100 tw:dark:[&>tr]:border-gray-800 tw:dark:[&>tr:nth-child(even)]:bg-white/[0.03] tw:dark:[&>tr:hover]:bg-white/10"></tbody>
            </table>
        </div>
        <div class="tw:overflow-hidden tw:rounded-lg tw:border tw:border-gray-200 tw:bg-white tw:dark:border-gray-800 tw:dark:bg-white/[0.03] tw:p-3">
            <table class="tw:w-full tw:text-xs" id="list3Table">
                <tbody id="list3TableBody" class="tw:[&>tr]:border-b tw:[&>tr]:border-gray-100 tw:[&>tr:last-child]:border-0 tw:[&>tr:nth-child(even)]:bg-gray-50 tw:[&>tr:hover]:bg-gray-100 tw:dark:[&>tr]:border-gray-800 tw:dark:[&>tr:nth-child(even)]:bg-white/[0.03] tw:dark:[&>tr:hover]:bg-white/10"></tbody>
            </table>
        </div>
        <div class="tw:overflow-hidden tw:rounded-lg tw:border tw:border-gray-200 tw:bg-white tw:dark:border-gray-800 tw:dark:bg-white/[0.03] tw:p-3">
            <h3 class="tw:mb-2 tw:text-sm tw:font-semibold tw:text-gray-700 tw:dark:text-gray-300">Activity Log</h3>
            <div id="system-log"></div>
        </div>
    </div>

</div>

@section Scripts
{
    <link href="~/css/datatables.min.css" rel="stylesheet">
    <link rel="stylesheet" href="~/css/sweetalert2.min.css">

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/js/datatables.min.js"></script>
    <script src="~/js/sweetalert2.all.min.js"></script>

    <script src="~/js/xlsx.full.min.js"></script>
    <script src="~/js/exceljs.min.js"></script>

    <script type="text/javascript">

        var autoTimer;
        var runningTask = false;
        var endTask = true;
        let token = '';

        function delay(ms) {
            return new Promise(resolve => setTimeout(resolve, ms));
        }

        function customSelect(selectId) {
            return {
                open: false,
                dropUp: false,
                options: [],
                selectedValue: '',
                selectedLabel: '',
                hasError: false,
                init() {
                    this.syncOptions();
                    const sel = document.getElementById(selectId);
                    if (!sel) return;
                    this.hasError = sel.classList.contains('is-invalid');
                    new MutationObserver(() => {
                        this.hasError = sel.classList.contains('is-invalid');
                    }).observe(sel, { attributes: true, attributeFilter: ['class'] });
                },
                toggle() {
                    this.open = !this.open;
                    if (this.open) {
                        this.syncOptions();
                        const rect = this.$el.getBoundingClientRect();
                        const spaceBelow = window.innerHeight - rect.bottom;
                        this.dropUp = spaceBelow < 240 && rect.top > spaceBelow;
                    }
                },
                syncOptions() {
                    const sel = document.getElementById(selectId);
                    if (!sel) return;
                    this.options = Array.from(sel.options).map(o => ({ value: o.value, text: o.textContent.trim() }));
                    this.selectedValue = sel.value;
                    const selectedOpt = sel.options[sel.selectedIndex];
                    this.selectedLabel = selectedOpt ? selectedOpt.textContent.trim() : '';
                },
                select(opt) {
                    const sel = document.getElementById(selectId);
                    sel.value = opt.value;
                    this.selectedValue = opt.value;
                    this.selectedLabel = opt.text;
                    this.open = false;
                    sel.dispatchEvent(new Event('change'));
                }
            };
        }

        function refreshCustomSelect(selectId) {
            const sel = document.getElementById(selectId);
            const root = sel ? sel.closest('[x-data]') : null;
            if (root && window.Alpine) {
                Alpine.$data(root).syncOptions();
            }
        }

        $(document).ready(function () {
            // document.getElementById('mySelect').value = 'a'; // 'a' corresponds to the value
            const startBtn = document.getElementById('start-btn');
            const stopBtn = document.getElementById('stop-btn');
            startBtn.disabled = false;
            stopBtn.disabled = true;

            token = $('#xToken').val();

            $('#txtSide').val('A');
            $('#txtCol').val(1);
            $('#txtRow').val(1);
            loadList();
        });

        function loadList() {
            var s = $('#txtSide').val();
            $.ajax({
                url: "/Trolley/GetTrolleySlotStatus_BySide?side=" + s,
                type: "GET",
                dataType: 'JSON',
                contentType: 'application/json; charset=utf-8',
                beforeSend: function () {
                    Swal.fire({
                        text: 'Please Wait',
                        width: '300px',
                        allowEscapeKey: false,
                        allowOutsideClick: false,
                        showConfirmButton: false,
                    });
                    Swal.showLoading()
                },
                success: function (result) {
                    //console.log(result);
                    Swal.close();
                    if (result.success == true) {

                        var idx = 1;
                        for (let iC = 1; iC <= 3; iC++) {
                            const tbl = document.getElementById('list' + iC + 'Table');
                            const tableBody = document.getElementById('list' + iC + 'TableBody');
                            tableBody.innerHTML = '';
                            idx = 1;

                            for (let i = 0; i < 150; i++) { // Example: Add 5 rows
                                var colNo = iC;
                                if (result.data[idx - 1].colNo != iC) {
                                    idx = idx + 1;
                                    continue;
                                }
                                // if (s == "A") {
                                // }
                                // else {
                                //     if (result.data[idx - 1].colNo != (iC + 100)) {
                                //         idx = idx + 1;
                                //         continue;
                                //     }
                                //     colNo = iC + 100;
                                // }

                                const rawData = JSON.stringify(result.data[idx - 1]);
                                const newRow = tbl.insertRow(); // or document.createElement('tr');
                                const cell1 = newRow.insertCell(); // or document.createElement('td');
                                cell1.innerHTML = `<a class="tw:text-[10px] tw:text-gray-500 tw:dark:text-gray-400"
                                href='javascript:void(0);' id='btnUpdate' data-row='${rawData}' > ` + result.data[idx - 1].rowNo + '</a>';
                                $(cell1).addClass("tw:w-[30%] tw:px-2 tw:py-1.5");
                                const cell2 = newRow.insertCell();
                                cell2.id = colNo + "R" + result.data[idx - 1].rowNo;
                                cell2.dataset.trolleySlotId = result.data[idx - 1].trolleySlot_Id;
                                cell2.innerHTML = '<span class="xVal">' + result.data[idx - 1].qrxPulse + '</span> <span class="tw:text-gray-300 tw:dark:text-gray-600">,</span>  <span class="yVal">' + result.data[idx - 1].qryPulse + '</span>';
                                $(cell2).addClass("tw:w-[60%] tw:px-2 tw:py-1.5 tw:text-gray-700 tw:dark:text-gray-300");
                                const cell3 = newRow.insertCell(); // or document.createElement('td');
                                if (result.data[idx - 1].needCheck) {
                                    cell3.innerHTML = '<div class="circle pulse yellow"></div>';
                                }
                                else {
                                    if (result.data[idx - 1].isActive) {
                                        cell3.innerHTML = '<span class="tw:text-[10px] tw:text-success-500"><i class="bi-circle-fill"></i></span>';
                                    }
                                    else {
                                        cell3.innerHTML = '<span class="tw:text-[10px] tw:text-error-500"><i class="bi-exclamation-circle-fill"></i></span>';
                                    }
                                }
                                $(cell3).addClass("tw:w-[10%] tw:px-2 tw:py-1.5 tw:text-center");

                                idx = idx + 1;
                            }
                        }
                    }
                    else {
                        Swal.fire({
                            icon: 'error',
                            title: "Wait",
                            text: result.errMessage
                        });
                    }
                },
                error: function (error) {
                    Swal.fire({
                        icon: 'error',
                        title: "Wait",
                        text: error.val
                    });
                }
            });

        }

        function logMessage(message, type = 'info') {
            const logContainer = document.getElementById('system-log');
            if (!logContainer) return;

            const timestamp = new Date().toLocaleTimeString();
            const logEntry = document.createElement('div');
            logEntry.classList.add('log-entry', `log-${type}`);
            logEntry.textContent = `[${timestamp}] ${message}`;

            logContainer.appendChild(logEntry);

            logContainer.scrollTop = logContainer.scrollHeight;
        }

        function clearLog() {
            const logContainer = document.getElementById('system-log');
            if (logContainer) {
                logContainer.innerHTML = '';
                logMessage("Log cleared by operator.", 'alert');
            }
        }

        function getQRPulses() {
            const startBtn = document.getElementById('start-btn');
            const stopBtn = document.getElementById('stop-btn');
            startBtn.disabled = true;
            stopBtn.disabled = false;

            endTask = false;
            runningTask = false;
            autoTimer = setInterval(getPulsesAuto, 2000);
        }

        function getContQRPulses() {
            document.getElementById('chkCont').checked = true;

            const startBtn = document.getElementById('start-btn');
            const stopBtn = document.getElementById('stop-btn');
            startBtn.disabled = true;
            stopBtn.disabled = false;

            endTask = false;
            runningTask = false;
            autoTimer = setInterval(getPulsesAuto, 2000);

            document.getElementById('txtIdle').innerHTML = "Running Continuosly";
        }

        function stopGet() {
            document.getElementById('chkCont').checked = false;
            const startBtn = document.getElementById('start-btn');
            const stopBtn = document.getElementById('stop-btn');
            startBtn.disabled = false;
            stopBtn.disabled = true;

            endTask = true;
            clearInterval(autoTimer);
            document.getElementById('txtIdle').innerHTML = "Stop";
            return;
        }

        function stop() {
            document.getElementById('chkCont').checked = false;
            const startBtn = document.getElementById('start-btn');
            const stopBtn = document.getElementById('stop-btn');
            startBtn.disabled = false;
            stopBtn.disabled = true;

            runningTask = false;
            endTask = true;
            clearInterval(autoTimer);
            document.getElementById('txtIdle').innerHTML = "Stop";
            return;
        }

        async function getPulsesAuto() {
            if (endTask == true) { return; }
            if (runningTask == true) { return; }

            var iCol = Number($('#txtCol').val());
            var rowFrom = Number($('#txtRow').val());


            if (rowFrom >= 51) {
                //console.log('RF:51');
                $('#txtRow').val(51);
                stop();
                return;
            }

            runningTask = true;
            var r = await startScanPulses(iCol, rowFrom);
            if (r == false) {
                r = await startScanPulses(iCol, rowFrom);
                if (r == false) {
                    stop();
                    return;
                }
            }

            // await delay(1000);

            if (r == true) {
                var r2 = await readPulses(iCol, rowFrom);
                if (r2 == false) {
                    r2 = await readPulses(iCol, rowFrom);
                    if (r2 == false) {
                        stop();
                        return;
                    }
                }
            }
            runningTask = false;

            const chkCont = document.getElementById('chkCont');
            if (chkCont.checked == false) {
                //console.log('chkCont');
                stop();
                return;
            }
        }

        async function startScanPulses(iCol, rowFrom) {
            var fResult = false;
            var s = $('#txtSide').val();

            if (rowFrom >= 51) {
                return false;
            }

            document.getElementById('txtCurRow').innerHTML = rowFrom;
            document.getElementById('txtErr').innerHTML = "-";

            await $.ajax({
                url: "/api/PLCSlot/SetScanTrolleyPulseStart/" + s + "/" + iCol + "/" + rowFrom,
                type: "GET",
                headers: {
                    'Authorization': 'Bearer ' + token
                },
                dataType: 'JSON',
                contentType: 'application/json; charset=utf-8',
                beforeSend: function () {
                },
                success: function (result) {

                    if (result.success == true) {
                        fResult = true;
                        logMessage('Start Scan :: Done ' + rowFrom, 'info');
                    }
                    else {
                        logMessage('Start Scan :: ' + result.errMessage, 'alert');
                    }
                },
                error: function (error) {
                    logMessage('Start Scan :: ' + error.val, 'alert');
                }
            });

            return fResult;
        }

        async function readPulses(iCol, rowFrom) {
            var fResult = false;
            var s = $('#txtSide').val();

            document.getElementById('txtErr').innerHTML = "-";

            await $.ajax({
                url: "/api/PLCSlot/ReadTrolleyPulse/" + s + "/" + iCol + "/" + rowFrom,
                type: "GET",
                headers: {
                    'Authorization': 'Bearer ' + token
                },
                dataType: 'JSON',
                contentType: 'application/json; charset=utf-8',
                beforeSend: function () {
                },
                success: function (result) {

                    if (result.success == true) {
                        fResult = true;
                        const cell = document.getElementById(iCol + 'R' + rowFrom);

                        cell.textContent = result.data;
                        const [qrx, qry] = result.data.split(',').map(v => v.trim());
                        document.getElementById("pulseXValue").textContent = qrx;
                        document.getElementById("pulseZValue").textContent = qry;
                        logMessage('Read :: Done ' + result.data, 'info');

                        rowFrom = Number(rowFrom) + 1;
                        $('#txtRow').val(rowFrom); 
                        getPulsesIncrement(cell.dataset.trolleySlotId);
                    }
                    else {
                        logMessage('Read :: ' + result.errMessage, 'alert');
                    }
                },
                error: function (error) {
                    logMessage('Read :: ' + error.val, 'alert');
                }
            });

            return fResult;
        }

        function getPulsesIncrement(id) {
            $.ajax({
                url: "/Trolley/GetTrolleySlot",
                type: "GET",
                dataType: 'JSON',
                data: { id: id },
                contentType: 'application/json; charset=utf-8',
                success: function (result) {
                    //console.log(result);

                    if (result.success == true) {
                        const preQRX = result.data.lastQRXPulse;
                        const preQRZ = result.data.lastQRYPulse;
                        const curQRX = result.data.qrxPulse;
                        const curQRZ = result.data.qryPulse;

                        const xDiff = calculateDiff(preQRX, curQRX);
                        const zDiff = calculateDiff(preQRZ, curQRZ);

                        const pulseXDiff = document.getElementById("pulseXDiff");
                        pulseXDiff.textContent = xDiff.text;
                        pulseXDiff.className = `pulse-diff ms-2 ${xDiff.className}`;

                        const pulseZDiff = document.getElementById("pulseZDiff");
                        pulseZDiff.textContent = zDiff.text;
                        pulseZDiff.className = `pulse-diff ms-2 ${zDiff.className}`;
                    }
                },
                error: function (error) {
                    //console.log(error);
                    Swal.fire({
                        icon: 'error',
                        title: "Wait",
                        text: error.val
                    });
                }
            });
        }

        function calculateDiff(previous, current) {
            if (previous === 0) {
                return { text: "(0)", className: "diff-same" };
            }

            const diff = current - previous;
            if (diff > 0) {
                return {
                    text: `(+${diff})`,
                    className: "diff-up"
                };
            }

            if (diff < 0) {
                return {
                    text: `(${diff})`,
                    className: "diff-down"
                };
            }
            return { text: "(0)", className: "diff-same" };
        }

