            <div class="usage-card tw:dark:bg-white/[0.03] tw:dark:text-white/90" data-collapsed="2">
                <div class="tw:flex tw:justify-center tw:items-center tw:gap-2">
                    <h3 class="tw:text-sm tw:font-bold tw:mb-0">Column 2</h3>
                    <div class="tw:ms-4 tw:text-sm">
