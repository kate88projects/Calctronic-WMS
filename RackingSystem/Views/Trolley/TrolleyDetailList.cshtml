        <div class="tw:rounded-2xl tw:border tw:border-gray-200 tw:bg-white tw:p-4 tw:text-center tw:dark:border-gray-800 tw:dark:bg-white/[0.03] tw:space-y-2">
            <h3 class="tw:mb-1.5 tw:text-xs tw:text-gray-500 tw:dark:text-gray-400">Side B</h3>
            <div class="usage-card tw:dark:bg-white/[0.03] tw:dark:text-white/90" data-collapsed="1">
                <div class="tw:flex tw:justify-center tw:items-center tw:gap-2">
                    <h3 class="tw:text-sm tw:font-bold tw:mb-0">Column 1</h3>
                    <div class="tw:ms-4 tw:text-sm">
                        <span id="totalReelsB1" class="usage-reel">5 reels</span>
                    </div>
                </div>
                <hr class="tw:m-0 tw:pt-1" />
                <div class="tw:flex tw:justify-center tw:gap-2 tw:text-xs tw:mb-1">
