@section Scripts
{
    <link rel="stylesheet" href="~/css/sweetalert2.min.css">
    <link rel="stylesheet" href="~/css/dataTables.dataTables.css">

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="../js/dataTables.js"></script>
    <script src="~/js/sweetalert2.all.min.js"></script>

    <script type="text/javascript">
        let itemGroupList = {};
        let activeGrp = null;
        let globalData = null;

        function customSelect(selectId) {
            return {
                open: false,
                dropUp: false,
                options: [],
                selectedValue: '',
                selectedLabel: '',
                hasError: false,
                init() {
                    this.syncOptions();
                    const sel = document.getElementById(selectId);
                    if (!sel) return;
                    this.hasError = sel.classList.contains('is-invalid');
                    new MutationObserver(() => {
                        this.hasError = sel.classList.contains('is-invalid');
                    }).observe(sel, { attributes: true, attributeFilter: ['class'] });
                },
                toggle() {
                    this.open = !this.open;
                    if (this.open) {
                        this.syncOptions();
                        const rect = this.$el.getBoundingClientRect();
                        const spaceBelow = window.innerHeight - rect.bottom;
                        this.dropUp = spaceBelow < 240 && rect.top > spaceBelow;
                    }
                },
                syncOptions() {
                    const sel = document.getElementById(selectId);
                    if (!sel) return;
                    this.options = Array.from(sel.options).map(o => ({ value: o.value, text: o.textContent.trim() }));
                    this.selectedValue = sel.value;
                    const selectedOpt = sel.options[sel.selectedIndex];
                    this.selectedLabel = selectedOpt ? selectedOpt.textContent.trim() : '';
                },
                select(opt) {
                    const sel = document.getElementById(selectId);
                    sel.value = opt.value;
                    this.selectedValue = opt.value;
                    this.selectedLabel = opt.text;
                    this.open = false;
                    sel.dispatchEvent(new Event('change'));
                }
            };
        }

        function refreshCustomSelect(selectId) {
            const sel = document.getElementById(selectId);
            const root = sel ? sel.closest('[x-data]') : null;
            if (root && window.Alpine) {
                Alpine.$data(root).syncOptions();
            }
        }

        $(document).ready(function () {
            loadTrolley();
            // loadList();
        });

        function loadTrolley() {
            $.ajax({
                url: "/Trolley/GetTrolleyList/",
                type: "GET",
                dataType: 'JSON',
                contentType: 'application/json; charset=utf-8',
                success: function (result) {
                    Swal.close()
                    if (result.success == true) {
                        const dropdown = document.getElementById('selTrolley');
                        dropdown.innerHTML = "";

                        result.data.forEach((i, index) => {
                            const option = document.createElement("option");
                            option.value = i.trolley_Id;
                            option.textContent = i.trolleyCode;
                            if (index === 0) {
                                option.selected = true;
                            }
                            dropdown.appendChild(option);
                        });

                        refreshCustomSelect('selTrolley');
                        loadList();
                    }
                },
                error: function (error) {
                    Swal.fire({
                        icon: 'error',
                        title: "Wait",
                        text: error.val
                    });
                }
            });
        }

        function loadList() {
            const id = document.getElementById('selTrolley').value;

            $.ajax({
                url: "/Trolley/GetTrolleyDetailList?id=" + id,
                type: "GET",
                dataType: 'JSON',
                contentType: 'application/json; charset=utf-8',
                beforeSend: function () {
                    Swal.fire({
                        text: 'Please Wait',
                        width: '300px',
                        allowEscapeKey: false,
                        allowOutsideClick: false,
                        showConfirmButton: false,
                    });
                    Swal.showLoading();
                },
                success: function (result) {
                    Swal.close();
                    if (result.success == true) {
                        globalData = result.data;
                        //console.log(result);
                        itemGroupList = {};

                        result.data.forEach(item => {
                            if (!itemGroupList[item.itemGroupCode]) {
                                itemGroupList[item.itemGroupCode] = 0;
                            }
                            
                            itemGroupList[item.itemGroupCode] += 1;
                        });
                        renderGroupButton();
                        
                        document.getElementById('txtCheck').innerHTML = result.errStackTrace;
                        result.errList.forEach(item => {
                            const parts = item.split(',');
                            const side = parts[0];
                            const col = parts[1];
                            const sidePrefix = side === 'A' ? 'A' : 'B';
                            const reelId = `totalReels${sidePrefix}${col}`;
                            const balancedId = `balanced${sidePrefix}${col}`;
                            const usedId = `used${sidePrefix}${col}`;
                            const totalId = `total${sidePrefix}${col}`;

                            document.getElementById(reelId).textContent = parts[2] + " reels";
                            document.getElementById(balancedId).textContent = parts[3] + " slots";;
                            document.getElementById(usedId).textContent = (parseInt(parts[5]) - parseInt(parts[3])) + " slots";
                            document.getElementById(totalId).textContent = parts[3] + " slots";
                        });

                        const cellClass = 'tw:px-5 tw:py-4 tw:whitespace-nowrap sm:tw:px-6 tw:text-theme-sm tw:text-gray-700 tw:dark:text-gray-300';

                        $('#listTable').DataTable( {
                            data: result.data,
                            paging: true,
                            pageLength: 50,
                            lengthMenu: [50, 100, 250, 500, 1000],
                            "bDestroy": true,
                            columns: [
                                { data: 'trolleySlotCode', className: cellClass },
                                { data: 'reelCode', className: cellClass },
                                {
                                    data: null,
                                    className: cellClass, 
                                    render: function (data, type, row, meta) {
                                        // return '<p>' + row.itemCode + '</p><p>' + row.itemDesc + '</p>';
                                        return '<p style="margin:0;"><span>' + row.itemCode + '</span><br/>' +
                                        '<span style="font-size:13px;color:grey;">' + row.itemDesc + '</span></p>';
                                    }
                                },
                                { data: 'qty', className: cellClass },
                                // {
                                //     data: null,
                                //     render: function (data, type, row, meta) {
                                //         if (row.needCheck == true) {
                                //             return '<span class="badge rounded-pill bg-warning" style="font-size:13px;">Need Check</span>'
                                //         }
                                //         else {
                                //             return ''
                                //         }
                                //     }
                                // },
                                { data: 'itemGroupCode', visible: false },
                                // {
                                //     data: null,
                                //     render: function (data, type, row, meta) {
                                //         const rowData = JSON.stringify(row).replace(/"/g, "&quot;");
                                //         return `<div style="display:flex;">
                                //             <button class="btn btn-warning d-grid edit-btn" style="margin-right:10px;" data-row="${rowData}">
                                //                 <span><i class="bi bi-pencil-square"></i> </span></button>`;
                                //     }
                                // }
                            ],
                            language: {
                                searchPlaceholder: "🔍︎ Search",
                                search: ""
                            }
                        });

                    }
                    else {
                        Swal.fire({
                            icon: 'error',
                            title: "Wait",
                            text: result.errMessage
                        });
                    }
                },
                error: function (error) {
                    Swal.fire({
                        icon: 'error',
                        title: "Wait",
                        text: error.val
                    });
                }
            });
        }
        
        function renderGroupButton() {
            const container = document.getElementById('itemGroupContainer');
            container.innerHTML = "";

            Object.keys(itemGroupList).forEach((ig, index) => {
                const btn = document.createElement("button");
                btn.className = "group-reel-btn tw:bg-white tw:dark:bg-white/[0.03] tw:dark:text-white/90";
                btn.dataset.group = ig;
                btn.id= `btnGroup${index}`;

                const qty = itemGroupList[ig];

                btn.innerHTML = `
                    ${ig}
                    <span class="tw:text-sm tw:dark:text-white/90" id="txtGroup{index +1}">${qty} reels</span
                `;

                container.appendChild(btn);
            });
        }

        $(document).on('click', '.group-reel-btn', function() {
            const group = $(this).data('group');
            //console.log("group", group);

            const table = $('#listTable').DataTable();

            if (activeGrp === group) {
                activeGrp = null;
                $('.group-reel-btn').removeClass('active');
                table.clear();
                table.rows.add(globalData);
                table.draw();
                return;
            }

            activeGrp = group;
            $('.group-reel-btn').removeClass('active');
            $(this).addClass('active');

            const filteredData = globalData.filter(x => x.itemGroupCode == group);
            //console.log("filteredData", filteredData);
            table.clear();
            table.rows.add(filteredData);
            table.draw();
        });

    </script>
}