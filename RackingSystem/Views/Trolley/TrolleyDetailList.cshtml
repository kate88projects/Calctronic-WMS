            <div class="value tw:text-lg tw:font-semibold tw:text-gray-800 tw:dark:text-white/90" id="txtCheck">–</div>
        </div>
        <div class="tw:rounded-2xl tw:border tw:border-gray-200 tw:bg-white tw:p-4 tw:text-center tw:dark:border-gray-800 tw:dark:bg-white/[0.03] tw:space-y-2">
