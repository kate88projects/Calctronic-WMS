
<style>
    .yellow {
        background: #ffc107;
    }

    .circle {
        width: 10px;
        height: 10px;
        border-radius: 50%;
        box-shadow: 0px 0px 1px 1px #0000001a;
    }

    .pulse {
        animation: pulse-animation 2s infinite;
    }

    @@keyframes pulse-animation {
        0% {
            box-shadow: 0 0 0 0px rgba(0, 0, 0, 0.2);
        }

        100% {
            box-shadow: 0 0 0 10px rgba(0, 0, 0, 0);
        }
    }
</style>

<div class="tw:flex tw:w-full tw:items-center tw:justify-between">
    <h2 class="tw:text-lg tw:mb-0 tw:ml-2 tw:font-semibold tw:text-gray-800 tw:dark:text-white/90">Trolley Column Status</h2>
    <div class="tw:flex">
        <button type="button" class="tw:border-0 tw:inline-flex tw:items-center tw:gap-2 tw:rounded-lg tw:bg-brand-500 tw:px-4 tw:py-2.5 tw:text-sm tw:font-medium tw:text-white tw:transition
            tw:hover:bg-brand-600" onclick="export()">
            Export
        </button>
    </div>
</div>


<div class="tw:mt-3 tw:space-y-4">
    <input type="hidden" id="xToken" value="@ViewBag.xToken" autocomplete="off">

    <div class="tw:rounded-xl tw:border tw:border-gray-200 tw:bg-white tw:p-4 tw:dark:border-gray-800 tw:dark:bg-white/[0.03]">
        <div class="tw:flex tw:flex-wrap tw:items-center tw:gap-3">
            <div class="tw:flex tw:items-center tw:gap-2">
                <label class="tw:whitespace-nowrap tw:text-sm tw:font-medium tw:text-gray-700 tw:dark:text-gray-400" for="txtTrolley">Trolley:</label>
                <input type="text" class="tw:w-full tw:h-10 tw:rounded-lg tw:border tw:border-gray-300 tw:bg-transparent tw:px-3 tw:py-2 tw:text-sm tw:text-gray-800 tw:focus:border-brand-300
                    tw:focus:ring-3 tw:focus:ring-brand-500/10 tw:focus:outline-hidden tw:dark:border-gray-700 tw:dark:bg-gray-900 tw:dark:text-white/90" id="txtTrolley" name="txtTrolley" placeholder="Trolley" />
            </div>
            <button type="button" class="tw:flex tw:h-10 tw:w-10 tw:items-center tw:justify-center tw:rounded-lg tw:border-0 tw:bg-brand-500 tw:text-white tw:hover:bg-brand-600" onclick="generate()">
                <i class="bi bi-search"></i>
            </button>
            <div class="tw:h-10 tw:w-px tw:bg-gray-200 tw:dark:bg-gray-700"></div>
            <div class="tw:flex tw:items-center tw:gap-2 tw:mb-0">
                <input type="checkbox" id="chkAutoRun" class="tw:h-4 tw:w-4 tw:accent-brand-500" onclick="autoChanged()" />
                <label for="chkAutoRun" class="tw:text-sm tw:text-gray-700 tw:dark:text-gray-400">Auto Refresh</label>
            </div>
        </div>
    </div>

    <!-- Status -->
    <div class="tw:grid tw:grid-cols-4 tw:gap-4">
        <div class="tw:cursor-pointer tw:rounded-xl tw:border tw:border-gray-200 tw:bg-white tw:p-4 tw:text-center tw:dark:border-gray-800 tw:dark:bg-white/[0.03]">
            <h3 class="tw:mb-1.5 tw:text-theme-xs tw:text-gray-500 tw:dark:text-gray-400">Inactive Slot</h3>
            <div class="value tw:text-xl tw:font-semibold tw:text-gray-800 tw:dark:text-white/90" id="txtInactive">-</div>
        </div>
        <div class="tw:cursor-pointer tw:rounded-xl tw:border tw:border-gray-200 tw:bg-white tw:p-4 tw:text-center tw:dark:border-gray-800 tw:dark:bg-white/[0.03]">
            <h3 class="tw:mb-1.5 tw:text-theme-xs tw:text-gray-500 tw:dark:text-gray-400">Need Checking Slot</h3>
            <div class="value tw:text-xl tw:font-semibold tw:text-gray-800 tw:dark:text-white/90" id="txtCheck">–</div>
        </div>
        <div class="tw:cursor-pointer tw:rounded-xl tw:border tw:border-gray-200 tw:bg-white tw:p-4 tw:text-center tw:dark:border-gray-800 tw:dark:bg-white/[0.03]">
            <h3 class="tw:mb-1.5 tw:text-theme-xs tw:text-gray-500 tw:dark:text-gray-400">Occupied Slot</h3>
            <div class="usage-card tw:mt-1">
                <div class="d-flex justify-content-center gap-2 tw:text-xs tw:mb-1">
                    <div class="usage-left">
                        <span>Total Reel : </span>
                        <span data-type="balanced" id="txtOTR">-</span>
                    </div>
                    <div class="usage-used">
                        <span>Slot w Reel : </span>
                        <span data-type="used" id="txtOTRN">-</span>
                    </div>
                </div>
                <div class="tw:text-xs">
                    <span>Empty Tray : </span>
                    <span data-type="total" id="txtOT">-</span>
                </div>
            </div>
        </div>
        <div class="tw:cursor-pointer tw:rounded-xl tw:border tw:border-gray-200 tw:bg-white tw:p-4 tw:text-center tw:dark:border-gray-800 tw:dark:bg-white/[0.03]">
            <h3 class="tw:mb-1.5 tw:text-theme-xs tw:text-gray-500 tw:dark:text-gray-400">Available Slot</h3>
            <div class="value" id="txtA">-</div>
        </div>
    </div>

    <div class="tw:grid tw:grid-cols-6 tw:gap-3">
        <div class="tw:col-span-3 tw:text-center tw:text-sm tw:font-semibold tw:text-gray-700 tw:dark:text-gray-300">Side A</div>
        <div class="tw:col-span-3 tw:text-center tw:text-sm tw:font-semibold tw:text-gray-700 tw:dark:text-gray-300">Side B</div>
        <div class="tw:overflow-hidden tw:rounded-lg tw:border tw:border-gray-200 tw:bg-white tw:p-3 tw:dark:border-gray-800 tw:dark:bg-white/[0.03]">
            <table class="tw:w-full tw:text-xs" id="list1Table">
                <tbody id="list1TableBody" class="tw:[&>tr]:border-b tw:[&>tr]:border-gray-100 tw:[&>tr:last-child]:border-0 tw:[&>tr:nth-child(even)]:bg-gray-50 tw:[&>tr:hover]:bg-gray-100 tw:dark:[&>tr]:border-gray-800 tw:dark:[&>tr:nth-child(even)]:bg-white/[0.03] tw:dark:[&>tr:hover]:bg-white/10"></tbody>
            </table>
        </div>
        <div class="tw:overflow-hidden tw:rounded-lg tw:border tw:border-gray-200 tw:bg-white tw:p-3 tw:dark:border-gray-800 tw:dark:bg-white/[0.03]">
            <table class="tw:w-full tw:text-xs" id="list2Table">
                <tbody id="list2TableBody" class="tw:[&>tr]:border-b tw:[&>tr]:border-gray-100 tw:[&>tr:last-child]:border-0 tw:[&>tr:nth-child(even)]:bg-gray-50 tw:[&>tr:hover]:bg-gray-100 tw:dark:[&>tr]:border-gray-800 tw:dark:[&>tr:nth-child(even)]:bg-white/[0.03] tw:dark:[&>tr:hover]:bg-white/10"></tbody>
            </table>
        </div>
        <div class="tw:overflow-hidden tw:rounded-lg tw:border tw:border-gray-200 tw:bg-white tw:p-3 tw:dark:border-gray-800 tw:dark:bg-white/[0.03]">
            <table class="tw:w-full tw:text-xs" id="list3Table">
                <tbody id="list3TableBody" class="tw:[&>tr]:border-b tw:[&>tr]:border-gray-100 tw:[&>tr:last-child]:border-0 tw:[&>tr:nth-child(even)]:bg-gray-50 tw:[&>tr:hover]:bg-gray-100 tw:dark:[&>tr]:border-gray-800 tw:dark:[&>tr:nth-child(even)]:bg-white/[0.03] tw:dark:[&>tr:hover]:bg-white/10"></tbody>
            </table>
        </div>
        <div class="tw:overflow-hidden tw:rounded-lg tw:border tw:border-gray-200 tw:bg-white tw:p-3 tw:dark:border-gray-800 tw:dark:bg-white/[0.03]">
            <table class="tw:w-full tw:text-xs" id="list4Table">
                <tbody id="list4TableBody" class="tw:[&>tr]:border-b tw:[&>tr]:border-gray-100 tw:[&>tr:last-child]:border-0 tw:[&>tr:nth-child(even)]:bg-gray-50 tw:[&>tr:hover]:bg-gray-100 tw:dark:[&>tr]:border-gray-800 tw:dark:[&>tr:nth-child(even)]:bg-white/[0.03] tw:dark:[&>tr:hover]:bg-white/10"></tbody>
            </table>
        </div>
        <div class="tw:overflow-hidden tw:rounded-lg tw:border tw:border-gray-200 tw:bg-white tw:p-3 tw:dark:border-gray-800 tw:dark:bg-white/[0.03]">
            <table class="tw:w-full tw:text-xs" id="list5Table">
                <tbody id="list5TableBody" class="tw:[&>tr]:border-b tw:[&>tr]:border-gray-100 tw:[&>tr:last-child]:border-0 tw:[&>tr:nth-child(even)]:bg-gray-50 tw:[&>tr:hover]:bg-gray-100 tw:dark:[&>tr]:border-gray-800 tw:dark:[&>tr:nth-child(even)]:bg-white/[0.03] tw:dark:[&>tr:hover]:bg-white/10"></tbody>
            </table>
        </div>
        <div class="tw:overflow-hidden tw:rounded-lg tw:border tw:border-gray-200 tw:bg-white tw:p-3 tw:dark:border-gray-800 tw:dark:bg-white/[0.03]">
            <table class="tw:w-full tw:text-xs" id="list6Table">
                <tbody id="list6TableBody" class="tw:[&>tr]:border-b tw:[&>tr]:border-gray-100 tw:[&>tr:last-child]:border-0 tw:[&>tr:nth-child(even)]:bg-gray-50 tw:[&>tr:hover]:bg-gray-100 tw:dark:[&>tr]:border-gray-800 tw:dark:[&>tr:nth-child(even)]:bg-white/[0.03] tw:dark:[&>tr:hover]:bg-white/10"></tbody>
            </table>
        </div>
    </div>

</div>

<div class="modal fade" id="myModal" role="dialog">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title">Update Slot</h4>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label class="form-label" for="txtSide">Side</label>
                    <input type="text" class="form-control" name="txtSide" id="txtSide" aria-describedby="Side" disabled>
                </div>
                <div class="mb-3">
                    <label class="form-label" for="txtRowNo">Row No</label>
                    <input type="text" class="form-control" name="RowNo" id="txtRowNo" aria-describedby="Row No" disabled>
                </div>
                <div class="mb-3">
                    <label class="form-label" for="txtPriority">Priority</label>
                    <input type="number" class="form-control" name="Priority" id="txtPriority" aria-describedby="Priority">
                </div>
                <div class="mb-3 form-check">
                    <input type="checkbox" class="form-check-input" id="chkIsActive">
                    <label class="form-check-label" for="chkIsActive">Is Active</label>
                </div>
                <div class="mb-3 form-check">
                    <input type="checkbox" class="form-check-input" id="chkHasReel">
                    <label class="form-check-label" for="chkHasReel">Has Reel</label>
                </div>
                <div class="mb-3 form-check">
                    <input type="checkbox" class="form-check-input" id="chkNeedChk">
                    <label class="form-check-label" for="chkNeedChk">Need Check</label>
                </div>
                <div class="mb-3">
                    <label class="form-label" for="txtReelNo">Reel No</label>
                    <input type="number" class="form-control" name="ReelNo" id="txtReelNo" aria-describedby="Reel No">
                </div>
                <div class="mb-3">
                    <label class="form-label" for="txtReelCode">Reel Code</label>
                    <input type="text" class="form-control" name="txtReelCode" id="txtReelCode" aria-describedby="Reel Code">
                </div>

                <input type="hidden" id="txtId">

            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary" onclick="updateSlotStatus()">Update</button>
                <button type="button" class="btn btn-outline-secondary" onclick="cancelForm()">Cancel</button>
            </div>
        </div>
    </div>
</div>

@section Scripts
{
    <link href="~/css/datatables.min.css" rel="stylesheet">
    <link rel="stylesheet" href="~/css/sweetalert2.min.css">

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/js/datatables.min.js"></script>
    <script src="~/js/sweetalert2.all.min.js"></script>

    <script type="text/javascript">

        var autoTimer1;
        var autoTimer2;

        $(document).ready(function () {
            // var savedValue = localStorage.getItem('savedTrolley');
            // if (savedValue) {
            //     document.getElementById('txtTrolley').value = savedValue;
            // }
            // else {
                $('#txtTrolley').val(''); // Trolley1A
            // }

            loadListA();
            loadListB();
        });

        function autoChanged() {
            const chkAutoRun = document.getElementById('chkAutoRun')
            if (chkAutoRun.checked) {
                if (autoTimer1 == undefined) {
                    autoTimer1 = setInterval(loadListA, 5000);
                    autoTimer2 = setInterval(loadListB, 5000);
                }
            }
            else {
                if (autoTimer1 != undefined) {
                    clearInterval(autoTimer1);
                    clearInterval(autoTimer2);
                }
            }
        }

        function generate() {
            const chkAutoRun = document.getElementById('chkAutoRun');
            if (chkAutoRun.checked) {
                if (autoTimer1 == undefined) {
                    autoTimer1 = setInterval(loadListA, 5000);
                    autoTimer2 = setInterval(loadListB, 5000);
                }
            }
            else {
                loadListA();
                loadListB();
                if (autoTimer1 != undefined) {
                    clearInterval(autoTimer1);
                    clearInterval(autoTimer2);
                }
            }
        }

        function loadList() {
            loadListA();
            loadListB();
        }

        function loadListA() {
            // localStorage.setItem('savedTrolley', col);

            $.ajax({
                url: "/Trolley/GetTrolleySlotStatus?side=A",
                type: "GET",
                dataType: 'JSON',
                // data: JSON.stringify(jsonInput),
                contentType: 'application/json; charset=utf-8',
                beforeSend: function () {
                    Swal.fire({
                        text: 'Please Wait',
                        width: '300px',

                        allowEscapeKey: false,
                        allowOutsideClick: false,
                        showConfirmButton: false,
                    });
                    Swal.showLoading()
                },
                success: function (result) {
                    // console.log(result);
                    Swal.close();
                    if (result.success == true) {

                        var idx = 1;
                        for (let iC = 1; iC <= 3; iC++) {
                            const tbl = document.getElementById('list' + iC + 'Table');
                            const tableBody = document.getElementById('list' + iC + 'TableBody');
                            tableBody.innerHTML = '';
                            idx = 1;

                            for (let i = 0; i < 150; i++) { // Example: Add 5 rows
                                var colNo = iC;
                                if (result.data[idx - 1].colNo != iC) {
                                    idx = idx + 1;
                                    continue;
                                }
                                // if (s == "A") {
                                // }
                                // else {
                                //     if (result.data[idx - 1].colNo != (iC + 100)) {
                                //         idx = idx + 1;
                                //         continue;
                                //     }
                                //     colNo = iC + 100;
                                // }

                                const rawData = JSON.stringify(result.data[idx - 1]);
                                const newRow = tbl.insertRow(); // or document.createElement('tr');
                                const cell1 = newRow.insertCell(); // or document.createElement('td');
                                cell1.innerHTML = `<a class="toggle-btn tw:text-[10px] tw:text-gray-500 tw:dark:text-gray-400"
                                href='javascript:void(0);' id='btnUpdate' data-row='${rawData}' > `+ result.data[idx - 1].colNo + '-' + result.data[idx - 1].rowNo + '</a>';
                                $(cell1).addClass("tw:w-[30%] tw:px-2 tw:py-1.5");
                                const cell2 = newRow.insertCell();
                                    if (result.data[idx - 1].hasReel) {
                                        if (result.data[idx - 1].reelNo == 0) {
                                            cell2.innerHTML = '<img src="../assets/img/tray_full_icon_138077.png" class="tw:mx-auto tw:h-[20px]" />';
                                        }
                                        else {
                                            cell2.innerHTML = '<span class="tw:mx-auto tw:block tw:text-center tw:text-[15px] tw:text-gray-700 tw:dark:text-gray-300">2</span>';
                                        }
                                    }
                                    else {
                                        if (result.data[idx - 1].hasEmptyTray) {
                                            cell2.innerHTML = '<img src="../assets/img/tray_icon_136086.png" class="tw:mx-auto tw:h-[20px] tw:w-[20px]" />';
                                        }
                                        else {
                                            cell2.innerHTML = '';
                                        }
                                    }
                                $(cell2).addClass("tw:w-[60%] tw:px-2 tw:py-1.5 tw:text-center");
                                const cell3 = newRow.insertCell(); // or document.createElement('td');
                                if (result.data[idx - 1].needCheck) {
                                    cell3.innerHTML = '<div class="circle pulse yellow"></div>';
                                }
                                else {
                                    if (result.data[idx - 1].isActive) {
                                        cell3.innerHTML = '<span class="tw:text-[10px] tw:text-success-500"><i class="bi-circle-fill"></i></span>';
                                    }
                                    else {
                                        cell3.innerHTML = '<span class="tw:text-[10px] tw:text-error-500"><i class="bi-exclamation-circle-fill"></i></span>';
                                    }
                                }
                                $(cell3).addClass("tw:w-[10%] tw:px-2 tw:py-1.5 tw:text-center");

                                idx = idx + 1;
                            }
                        }

                    }
                    else {
                        Swal.fire({
                            icon: 'error',
                            title: "Wait",
                            text: result.errMessage
                        });
                    }
                },
                error: function (error) {
                    Swal.fire({
                        icon: 'error',
                        title: "Wait",
                        text: error.val
                    });
                }
            });

        }

        function loadListB() {
            $.ajax({
                url: "/Trolley/GetTrolleySlotStatus?side=B",
                type: "GET",
                dataType: 'JSON',
                // data: JSON.stringify(jsonInput),
                contentType: 'application/json; charset=utf-8',
                beforeSend: function () {
                    Swal.fire({
                        text: 'Please Wait',
                        width: '300px',

                        allowEscapeKey: false,
                        allowOutsideClick: false,
                        showConfirmButton: false,
                    });
                    Swal.showLoading()
                },
                success: function (result) {
                    // console.log(result);
                    Swal.close();
                    if (result.success == true) {
                        var spText = result.errMessage.split(',');
                        document.getElementById('txtInactive').innerHTML = spText[0];
                        document.getElementById('txtCheck').innerHTML = spText[1];
                        document.getElementById('txtOT').innerHTML = spText[2];
                        document.getElementById('txtOTR').innerHTML = spText[3];
                        document.getElementById('txtOTRN').innerHTML = (Number(spText[3]) + Number(spText[4]));
                        document.getElementById('txtA').innerHTML = spText[5];


                        var idx = 1;
                        for (let iC = 1; iC <= 3; iC++) {
                            const tbl = document.getElementById('list' + (iC + 3) + 'Table');
                            const tableBody = document.getElementById('list' + (iC + 3) + 'TableBody');
                            tableBody.innerHTML = '';
                            idx = 1;

                            for (let i = 0; i < 150; i++) { // Example: Add 5 rows
                                var colNo = iC;
                                if (result.data[idx - 1].colNo != iC) {
                                    idx = idx + 1;
                                    continue;
                                }
                                // if (s == "A") {
                                // }
                                // else {
                                //     if (result.data[idx - 1].colNo != (iC + 100)) {
                                //         idx = idx + 1;
                                //         continue;
                                //     }
                                //     colNo = iC + 100;
                                // }

                                const rawData = JSON.stringify(result.data[idx - 1]);
                                const newRow = tbl.insertRow(); // or document.createElement('tr');
                                const cell1 = newRow.insertCell(); // or document.createElement('td');
                                cell1.innerHTML = `<a class="toggle-btn tw:text-[10px] tw:text-gray-500 tw:dark:text-gray-400"
                                href='javascript:void(0);' id='btnUpdate' data-row='${rawData}' > ` + result.data[idx - 1].colNo + '-' + result.data[idx - 1].rowNo + '</a>';
                                $(cell1).addClass("tw:w-[30%] tw:px-2 tw:py-1.5");
                                const cell2 = newRow.insertCell();
                                    if (result.data[idx - 1].hasReel) {
                                        if (result.data[idx - 1].reelNo == 0) {
                                            cell2.innerHTML = '<img src="../assets/img/tray_full_icon_138077.png" class="tw:mx-auto tw:h-[20px]" />';
                                        }
                                        else {
                                            cell2.innerHTML = '<span class="tw:mx-auto tw:block tw:text-center tw:text-[15px] tw:text-gray-700 tw:dark:text-gray-300">2</span>';
                                        }
                                    }
                                    else {
                                        if (result.data[idx - 1].hasEmptyTray) {
                                            cell2.innerHTML = '<img src="../assets/img/tray_icon_136086.png" class="tw:mx-auto tw:h-[20px] tw:w-[20px]" />';
                                        }
                                        else {
                                            cell2.innerHTML = '';
                                        }
                                    }
                                $(cell2).addClass("tw:w-[60%] tw:px-2 tw:py-1.5 tw:text-center");
                                const cell3 = newRow.insertCell(); // or document.createElement('td');
                                if (result.data[idx - 1].needCheck) {
                                    cell3.innerHTML = '<div class="circle pulse yellow"></div>';
                                }
                                else {
                                    if (result.data[idx - 1].isActive) {
                                        cell3.innerHTML = '<span class="tw:text-[10px] tw:text-success-500"><i class="bi-circle-fill"></i></span>';
                                    }
                                    else {
                                        cell3.innerHTML = '<span class="tw:text-[10px] tw:text-error-500"><i class="bi-exclamation-circle-fill"></i></span>';
                                    }
                                }
                                $(cell3).addClass("tw:w-[10%] tw:px-2 tw:py-1.5 tw:text-center");

                                idx = idx + 1;
                            }
                        }

                    }
                    else {
                        Swal.fire({
                            icon: 'error',
                            title: "Wait",
                            text: result.errMessage
                        });
                    }
                },
                error: function (error) {
                    Swal.fire({
                        icon: 'error',
                        title: "Wait",
                        text: error.val
                    });
                }
            });

        }

        $('#list1Table').on('click', '.toggle-btn', function () {
            const row = JSON.parse($(this).attr('data-row'));
            updateForm(row, 'A');
        });

        $('#list2Table').on('click', '.toggle-btn', function () {
            const row = JSON.parse($(this).attr('data-row'));
            updateForm(row, 'A');
        });

        $('#list3Table').on('click', '.toggle-btn', function () {
            const row = JSON.parse($(this).attr('data-row'));
            updateForm(row, 'A');
        });

        $('#list4Table').on('click', '.toggle-btn', function () {
            const row = JSON.parse($(this).attr('data-row'));
            updateForm(row, 'B');
        });

        $('#list5Table').on('click', '.toggle-btn', function () {
            const row = JSON.parse($(this).attr('data-row'));
            updateForm(row, 'B');
        });

        $('#list6Table').on('click', '.toggle-btn', function () {
            const row = JSON.parse($(this).attr('data-row'));
            updateForm(row, 'B');
        });

        function updateForm(row, side) {
            $("#txtId").val(row.trolleySlot_Id);
            $("#txtSide").val(side);
            $("#txtRowNo").val(row.rowNo);
            if (row.isActive == true) {
                document.getElementById("chkIsActive").checked = true;
            }
            else {
                document.getElementById("chkIsActive").checked = false;
            }
            if (row.hasReel == true) {
                document.getElementById("chkHasReel").checked = true;
            }
            else {
                document.getElementById("chkHasReel").checked = false;
            }
            $("#txtReelNo").val(row.reelNo);
            $("#txtPriority").val(row.priority);
            $("#txtReelCode").val(row.reelCode);
            if (row.needCheck == true) {
                document.getElementById("chkNeedChk").checked = true;
            }
            else {
                document.getElementById("chkNeedChk").checked = false;
            }
            $("#myModal").modal("show");
        }

        function updateSlotStatus() {
            const chkIsAct = document.querySelector('#chkIsActive');
            const chkHasEmptyTray = document.querySelector('#chkHasEmptyTray');
            const chkHasReel = document.querySelector('#chkHasReel');
            const chkNeedChk = document.querySelector('#chkNeedChk');

            var data = {
                Slot_Id: $("#txtId").val(),
                RowNo: Number($("#txtRowNo").val()),
                Priority: Number($("#txtPriority").val()),
                IsActive: chkIsAct.checked ? true : false,
                HasReel: chkHasReel.checked ? true : false,
                ReelNo: $("#txtReelNo").val(),
                ReelCode: $("#txtReelCode").val(),
                NeedCheck: chkNeedChk.checked ? true : false,
            }

            //console.log(JSON.stringify(data));

            $.ajax({
                url: '/Trolley/UpdateTrolleySlotStatus',
                type: 'POST',
                data: JSON.stringify(data),
                dataType: 'JSON',
                contentType: 'application/json; charset=utf-8',
                beforeSend: function () {
                    Swal.fire({
                        text: 'Please Wait',
                        width: '300px',

                        allowEscapeKey: false,
                        allowOutsideClick: false,
                        showConfirmButton: false,
                    });
                    Swal.showLoading()
                },
                success: function (result) {
                    // console.log(result);
                    if (result.success == true) {
                        $("#myModal").modal("toggle");
                        Swal.fire({
                            icon: 'success',
                            title: "Success Update",
                            text: "",
                            didClose: () => {
                              window.location.reload();
                            }
                        });
                    }
                    else {
                        Swal.fire({
                            icon: 'error',
                            title: "Wait",
                            text: result.errMessage
                        });
                    }
                },
                error: function (error) {
                    // console.log(error);
                    Swal.fire({
                        icon: 'error',
                        title: "Wait",
                        text: error.val
                    });
                }
            });

            // console.log(id);
        }

        function cancelForm() {
            $("#myModal").modal("toggle");
        }

    </script>
}
