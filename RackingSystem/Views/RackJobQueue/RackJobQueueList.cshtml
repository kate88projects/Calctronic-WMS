<div class="modal fade" id="qModal" role="dialog">
    <div class="modal-dialog">

        <div class="modal-content tw:overflow-hidden tw:rounded-2xl tw:border-0 tw:bg-white tw:text-gray-700 tw:shadow-theme-lg tw:dark:bg-gray-900 tw:dark:text-gray-300">
            <div class="tw:border-b tw:border-gray-100 tw:px-6 tw:py-4 tw:dark:border-gray-800">
                <h4 class="tw:text-base tw:font-semibold tw:text-gray-800 tw:mb-0 tw:dark:text-white/90">Change Queue Number</h4>
            </div>
            <div class="tw:space-y-4 tw:px-6 tw:py-4">
                <div>
                    <label class="tw:mb-1.5 tw:block tw:text-sm tw:font-medium tw:text-gray-700 tw:dark:text-gray-400" for="txtDocNo">Loader / Doc No</label>
                    <input type="text" class="tw:w-full tw:rounded-lg tw:border tw:border-gray-300 tw:bg-zinc-100 tw:px-4 tw:py-2.5 tw:text-sm tw:text-gray-500 tw:placeholder:text-gray-400
                        tw:dark:border-gray-700 tw:dark:bg-gray-900 tw:dark:text-gray-400" name="Doc No" id="txtDocNo" aria-describedby="Doc No" disabled>
                </div>
                <div>
                    <label class="tw:mb-1.5 tw:block tw:text-sm tw:font-medium tw:text-gray-700 tw:dark:text-gray-400" for="txtQ">Queue No</label>
                    <input type="number" class="tw:w-full tw:rounded-lg tw:border tw:border-gray-300 tw:bg-transparent tw:px-4 tw:py-2.5 tw:text-sm tw:text-gray-800 tw:placeholder:text-gray-400
                        tw:focus:border-brand-300 tw:focus:ring-3 tw:focus:ring-brand-500/10 tw:focus:outline-hidden tw:dark:border-gray-700 tw:dark:bg-gray-900 tw:dark:text-white/90
                        tw:dark:placeholder:text-white/30 tw:dark:focus:border-brand-800" name="Q No" id="txtQ" aria-describedby="Q No" min="1">
                    <div id="txtQError" class="error-message"></div>
                </div>
                <input type="hidden" id="txtDocId">
                <input type="hidden" id="txtDocType">
            </div>
            <div class="tw:flex tw:justify-end tw:gap-3 tw:border-t tw:border-gray-100 tw:px-6 tw:py-3 tw:dark:border-gray-800">
                <button type="button" class="save-btn tw:border-0 tw:rounded-lg tw:bg-brand-500 tw:px-4 tw:py-2.5 tw:text-sm tw:font-medium tw:text-white tw:shadow-theme-xs 
                    tw:hover:bg-brand-600" onclick="saveQ()">Save</button>
                <button type="button" class="cancel-btn tw:bg-transparent tw:rounded-lg tw:border tw:border-gray-300 tw:px-4 tw:py-2.5 tw:text-sm tw:font-medium tw:text-gray-700 tw:hover:bg-gray-100
                    tw:dark:border-gray-700 tw:dark:text-gray-400 tw:dark:hover:bg-white/5" onclick="cancelQForm()">Cancel</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="resetQueueModal" data-bs-backdrop="static" data-bs-keyboard="false" role="dialog">
    <div class="modal-dialog modal-dialog-centered tw:max-w-sm">
        <div class="modal-content tw:overflow-hidden tw:rounded-2xl tw:border-0 tw:bg-white tw:text-gray-700 tw:shadow-theme-lg tw:dark:bg-gray-900 tw:dark:text-gray-300">
            <div class="tw:p-6 tw:text-center">
                <div class="tw:mx-auto tw:mb-4 tw:flex tw:h-14 tw:w-14 tw:items-center tw:justify-center tw:rounded-full tw:bg-warning-50 tw:text-warning-500 tw:dark:bg-warning-500/15">
                    <i class="bi bi-exclamation-triangle tw:text-2xl"></i>
                </div>
                <h4 class="tw:mb-2 tw:text-base tw:font-semibold tw:text-gray-800 tw:dark:text-white/90">Are you sure want to reset the queue?</h4>
                <p class="tw:text-sm tw:text-gray-500 tw:dark:text-gray-400">You will not be able to recover this record!</p>
            </div>
            <div class="tw:flex tw:justify-center tw:gap-3 tw:border-t tw:border-gray-100 tw:px-6 tw:py-3 tw:dark:border-gray-800">
                <button type="button" class="save-btn tw:border-0 tw:rounded-lg tw:bg-error-500 tw:px-4 tw:py-2.5 tw:text-sm tw:font-medium tw:text-white tw:shadow-theme-xs tw:hover:bg-error-600" onclick="confirmResetQueue()">Yes</button>
                <button type="button" class="cancel-btn tw:bg-transparent tw:rounded-lg tw:border tw:border-gray-300 tw:px-4 tw:py-2.5 tw:text-sm tw:font-medium tw:text-gray-700 tw:hover:bg-gray-100
