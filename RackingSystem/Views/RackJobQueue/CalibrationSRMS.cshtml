@{
    Layout = "~/Views/Shared/_LayoutEmpty.cshtml";
}


<style>
    * {
        box-sizing: border-box;
    }

    body {
        font-family: 'Outfit', sans-serif;
        margin: 0;
    }

    .tray {
        width: 56px;
        height: 18px;
        border-radius: 3px;
        border: 1.5px solid rgba(0,0,0,0.15);
        transition: all 0.6s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .arm {
      transition: all 0.8s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .gripper {
      transition: all 0.3s ease;
    }

    @@keyframes pulse-glow {
      0%, 100% { box-shadow: 0 0 8px rgba(34,197,94,0.3); }
      50% { box-shadow: 0 0 20px rgba(34,197,94,0.6); }
    }

    .status-active {
      animation: pulse-glow 1.5s ease-in-out infinite;
    }

    @@keyframes slideIn {
      from { opacity: 0; transform: translateY(8px); }
      to { opacity: 1; transform: translateY(0); }
    }

    .log-entry {
        animation: slideIn 0.3s ease;
    }

    .mono {
        font-family: 'JetBrains Mono', monospace;
    }

    /*.rack-slot {
        width: 62px;
        height: 22px;
        border: 1.5px dashed rgba(0,0,0,0.1);
        border-radius: 4px;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        transition: all 0.3s ease;
    }

    .rack-slot:hover {
        border-color: #3b82f6;
        box-shadow: 0 0 8px rgba(59, 130, 246, 0.2);
    }

    .rack-slot.rack-selected {
        border-color: #10b981;
        box-shadow: 0 0 12px rgba(16, 185, 129, 0.3);
        background: rgba(16, 185, 129, 0.08);
    } */

    .rack-selected {
        border-color: #10b981;
        box-shadow: 0 0 12px rgba(16, 185, 129, 0.3);
        background: rgba(16, 185, 129, 0.08);
    }

    .trolley-slot {
        width: 62px;
        height: 22px;
        border: 1.5px dashed rgba(0,0,0,0.1);
        border-radius: 4px;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        transition: all 0.3s ease;
    }

        .trolley-slot:hover {
            border-color: #3b82f6;
            box-shadow: 0 0 8px rgba(59, 130, 246, 0.2);
        }

        .trolley-slot.empty-selected {
            border-color: #10b981;
            box-shadow: 0 0 12px rgba(16, 185, 129, 0.3);
            background: rgba(16, 185, 129, 0.08);
        }

    .tray.empty-selected {
        background-color: #10b981;
    }

    .scene-container {
        position: relative;
        width: 100%;
        height: 280px;
        border-radius: 12px;
        overflow: hidden;
    }

    .rack-section, .trolley-column {
        display: flex;
        flex-direction: column;
        gap: 1.5px;
        align-items: center;
    }

    .trolley-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 1.5px;
        padding: 8px;
        background: rgba(243, 244, 246, 0.6);
        border-radius: 8px;
        width: fit-content;
    }

    .rack-selector, .trolley-target {
        cursor: pointer;
        border: 2px solid transparent;
        border-radius: 6px;
        transition: all 0.3s ease;
        padding: 8px;
    }

        .rack-selector:hover {
            border-color: #d1d5db;
            background: rgba(209, 213, 219, 0.15);
        }

        .rack-selector.selected {
            border-color: #10b981;
            background: rgba(16, 185, 129, 0.1);
            box-shadow: 0 0 12px rgba(16, 185, 129, 0.2);
        }

    .trolley-target {
        position: relative;
    }

        .trolley-target::after {
            content: '';
            position: absolute;
            inset: 0;
            border: 2px solid transparent;
            border-radius: 4px;
            pointer-events: none;
            transition: all 0.3s ease;
        }

        .trolley-target:hover::after {
            border-color: #3b82f6;
            box-shadow: 0 0 8px rgba(59, 130, 246, 0.2);
        }

        .trolley-target.target-selected::after {
            border-color: #10b981;
            box-shadow: 0 0 12px rgba(16, 185, 129, 0.3);
            background: rgba(16, 185, 129, 0.08);
        }

    .step-line::before {
        content: '';
        position: absolute;
        left: 15px;
        top: 32px;
        bottom: -8px;
        width: 2px;
        background: lightgrey; /* #1e293b; */
    }

    .step-line:last-child::before {
        display: none;
    }

    .step-dot {
        width: 12px;
        height: 12px;
        border-radius: 50%;
        border: 2px solid lightgrey; /* #334155; */
        background: lightgrey; /* #0f172a; */
        flex-shrink: 0;
        transition: all 0.3s;
        position: relative;
        z-index: 2;
    }

        .step-dot.active {
            border-color: #22c55e;
            background: #22c55e;
            box-shadow: 0 0 10px rgba(34,197,94,0.5);
        }

        .step-dot.done {
            border-color: #22c55e;
            background: #22c55e;
        }

        .step-dot.waiting {
            border-color: lightgrey; /* #475569; */
            background: lightgrey; /* #1e293b; */
        }

    .status-badge {
        font-size: 10px;
        padding: 2px 8px;
        border-radius: 9999px;
        font-weight: 600;
        letter-spacing: 0.5px;
        text-transform: uppercase;
    }

    .badge-idle {
        background: #1e293b;
        color: #64748b;
    }

    .badge-running {
        background: #052e16;
        color: #4ade80;
    }

    .badge-done {
        background: #022c22;
        color: #34d399;
    }

    .hidden {
        display: none;
    }

    .fade-out {
        opacity: 0;
        /* This transition duration should match the delay in the JavaScript setTimeout */
        transition: opacity 0.5s ease-out;
    }

    .trolley-selected {
        border-color: #10b981;
        box-shadow: 0 0 12px rgba(16, 185, 129, 0.3);
        background: rgba(16, 185, 129, 0.08);
    }

    .selected {
        border-color: #10b981;
        box-shadow: 0 0 12px rgba(16, 185, 129, 0.3);
        background: rgba(16, 185, 129, 0.08);
    }

    .ctl-btn:disabled {
        background-color: darkgray !important;
        color: #fff !important;
        border-color: darkgray !important;
        cursor: not-allowed;
    }

    .phase-btn:disabled {
        color: darkgray !important;
        border-color: #e5e7eb !important;
        cursor: not-allowed;
    }
</style>

<input type="hidden" id="xToken" value="@ViewBag.xToken" autocomplete="off">
<input type="hidden" id="xDeviceId" value="@ViewBag.DeviceId" autocomplete="off">

<div id="app" class="h-full w-full overflow-auto" style="background: #f8f9fa;">
    <!-- Title -->
    <header class="px-6 py-4 flex items-center justify-between border-b" style="border-color: #e5e7eb;">
        <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-lg flex items-center justify-center" style="background: #6366f1;">
                <i class="bi-rulers" style="width:20px;height:20px;color:#fff;"></i>
            </div>
            <div>
                <h1 id="pageTitle" class="text-lg font-bold" style="color:#1f2937;">Calibration SRMS</h1>
                <p id="statusLabel" class="text-xs mono" style="color:#6b7280;">Take a drawer from the trolley, put away and retrieve it at each row of one SRMS column, return it to the trolley</p>
            </div>
        </div>
        <div class="flex items-center gap-3">
            <a href="@Url.Action("RackJobQueueList", "RackJobQueue")" class="flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-semibold transition-all" style="background:#f3f4f6;color:#374151;border:1px solid #e5e7eb;text-decoration:none;">
                <i class="bi-arrow-left" style="width:12px;height:12px;"></i> Queue
            </a>
            <button id="addressLogBtn" class="flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-semibold transition-all" style="background:#f3f4f6;color:#374151;border:1px solid #e5e7eb;" onclick="showAddressResponseLog()">
                <i class="bi-cpu" style="width:12px;height:12px;"></i> PLC Address Log
            </button>
            <button id="btnCurrentPulses" class="flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-semibold transition-all" style="background:#f3f4f6;color:#374151;border:1px solid #e5e7eb;" onclick="showCurrentPulses()">
                <i class="bi-crosshair" style="width:12px;height:12px;"></i> Current Pulses
            </button>
            <div id="statusBadge" class="flex items-center gap-2 px-3 py-1.5 rounded-full text-xs font-semibold mono" style="background:#f3f4f6;color:#6b7280;">
                <span id="statusDot" class="w-2 h-2 rounded-full" style="background:#6b7280;"></span> <span id="statusText">IDLE</span>
            </div>
        </div>
    </header>

    <!-- Body -->
    <div class="p-6">
        <div class="grid gap-4" style="grid-template-columns: minmax(320px, 2fr) 3fr;">

            <!-- Left: Setup + Control -->
            <div class="flex flex-col gap-4" style="min-width:0;">

                <!-- Drawer location -->
                <div class="rounded-xl px-6 py-3 flex items-center justify-between" style="background:#fff;border:1px solid #e5e7eb;">
                    <span class="text-xs font-semibold" style="color:#4b5563;">Drawer is at</span>
                    <span id="drawerAtText" class="text-sm font-bold mono" style="color:#6b7280;">Trolley</span>
                </div>

                <!-- Setup -->
                <div class="rounded-xl p-6" style="background:#fff;border:1px solid #e5e7eb;">
                    <h2 class="text-xs font-semibold mb-3 flex items-center gap-2" style="color:#4b5563;">
                        <i class="bi-gear" style="width:14px;height:14px;"></i> Setup
                    </h2>
                    <div class="grid gap-2" style="grid-template-columns: auto 1fr;">
                        <label for="selTrolley" class="text-xs font-semibold" style="color:#4b5563;align-self:center;">Trolley</label>
                        <select id="selTrolley" class="px-2.5 py-1.5 rounded-lg text-xs border" style="border-color:#e5e7eb;"></select>

                        <label for="selSide" class="text-xs font-semibold" style="color:#4b5563;align-self:center;">Side</label>
                        <select id="selSide" class="px-2.5 py-1.5 rounded-lg text-xs border" style="border-color:#e5e7eb;">
                            <option value="A">A</option>
                            <option value="B">B</option>
                        </select>

                        <label for="selTrolleyCol" class="text-xs font-semibold" style="color:#4b5563;align-self:center;">Trolley Col</label>
                        <select id="selTrolleyCol" class="px-2.5 py-1.5 rounded-lg text-xs border" style="border-color:#e5e7eb;">
                            <option value="1">1 - Left</option>
                            <option value="2">2 - Center</option>
                            <option value="3">3 - Right</option>
                        </select>

                        <label for="txtTrolleyRow" class="text-xs font-semibold" style="color:#4b5563;align-self:center;">Trolley Row</label>
                        <input type="number" id="txtTrolleyRow" min="1" value="1" autocomplete="off" class="px-2.5 py-1.5 rounded-lg text-xs border" style="border-color:#e5e7eb;">

                        <div style="grid-column: 1 / -1;border-top:1px solid #e2e8f0;margin:4px 0;"></div>

                        <label for="selColumn" class="text-xs font-semibold" style="color:#4b5563;align-self:center;">SRMS Column</label>
                        <select id="selColumn" class="px-2.5 py-1.5 rounded-lg text-xs border" style="border-color:#e5e7eb;" onchange="loadColumn()"></select>

                        <label for="txtStartRow" class="text-xs font-semibold" style="color:#4b5563;align-self:center;">Start Row</label>
                        <input type="number" id="txtStartRow" min="1" placeholder="Row" autocomplete="off" class="px-2.5 py-1.5 rounded-lg text-xs border" style="border-color:#e5e7eb;" onchange="setStartRow()">

                        <label for="txtEndRow" class="text-xs font-semibold" style="color:#4b5563;align-self:center;">End Row</label>
                        <input type="number" id="txtEndRow" min="1" placeholder="Last row" autocomplete="off" class="px-2.5 py-1.5 rounded-lg text-xs border" style="border-color:#e5e7eb;" onchange="setEndRow()">

                        <label for="txtDiffLimit" class="text-xs font-semibold" style="color:#4b5563;align-self:center;">Highlight diff ≥</label>
                        <input type="number" id="txtDiffLimit" min="0" value="10" autocomplete="off" class="px-2.5 py-1.5 rounded-lg text-xs border" style="border-color:#e5e7eb;" onchange="renderResults()">
                    </div>
                    <p class="text-xs mt-2" style="color:#6b7280;">The drawer comes from this trolley slot for every row. Slots that are inactive or already have a reel or tray are skipped.</p>
                </div>

                <!-- Control -->
                <div class="rounded-xl p-6" style="background:#fff;border:1px solid #e5e7eb;">
                    <div class="flex items-center justify-between mb-3">
                        <h2 class="text-xs font-semibold flex items-center gap-2" style="color:#4b5563;">
                            <i class="bi-joystick" style="width:14px;height:14px;"></i> Control
                        </h2>
                        <span id="txtCurSlot" class="text-xs font-bold mono" style="color:#1f2937;">-</span>
                    </div>
                    <div class="grid gap-2" style="grid-template-columns: 1fr 1fr;">
                        <button id="btnReadOne" onclick="startRead('one')" class="ctl-btn px-3 py-2 rounded-lg text-xs font-semibold" style="background:#16a34a;color:#fff;">
                            <i class="bi-play-fill" style="width:12px;height:12px;"></i> Read One
                        </button>
                        <button id="btnContinue" onclick="startRead('continue')" class="ctl-btn px-3 py-2 rounded-lg text-xs font-semibold" style="background:#f59e0b;color:#fff;">
                            <i class="bi-fast-forward-fill" style="width:12px;height:12px;"></i> Continue Read
                        </button>
                        <button id="btnStopNow" onclick="requestStopNow()" class="ctl-btn px-3 py-2 rounded-lg text-xs font-semibold" style="background:#e74c3c;color:#fff;" disabled>
                            <i class="bi-stop-fill" style="width:12px;height:12px;"></i> Stop Now
                        </button>
                        <button id="btnStopAfter" onclick="requestStopAfter()" class="ctl-btn px-3 py-2 rounded-lg text-xs font-semibold" style="background:#fff;color:#e74c3c;border:1px solid #fecaca;" disabled>
                            <i class="bi-skip-end-fill" style="width:12px;height:12px;"></i> Stop After Cycle
                        </button>
                    </div>
                    <p id="txtHint" class="text-xs mt-2" style="color:#6b7280;"></p>

                    <!-- cycle progress -->
                    <div class="mt-3 pt-3" style="border-top:1px solid #e2e8f0;">
                        <div id="stepList" class="flex flex-col gap-1.5"></div>
                        <button id="btnReset" onclick="resetCycle()" class="mt-3 px-3 py-1 rounded text-xs font-semibold hidden" style="background:#f3f4f6;color:#374151;border:1px solid #e5e7eb;">
                            <i class="bi-arrow-counterclockwise" style="width:12px;height:12px;"></i> Reset cycle
                        </button>
                    </div>
                </div>
            </div>

            <!-- Right: Results + Log -->
            <div class="flex flex-col gap-4" style="min-width:0;">
                <div class="rounded-xl p-6" style="background:#fff;border:1px solid #e5e7eb;">
                    <div class="flex items-center justify-between mb-2">
                        <h2 class="text-xs font-semibold flex items-center gap-2" style="color:#4b5563;">
                            <i class="bi-table" style="width:14px;height:14px;"></i> Results <span id="txtSummary" class="mono" style="color:#9ca3af;font-weight:400;"></span>
                        </h2>
                        <button onclick="exportResults()" class="px-2 py-1 rounded text-xs font-semibold" style="background:#f3f4f6;color:#374151;">
                            <i class="bi-download" style="width:12px;height:12px;"></i> Export
                        </button>
                    </div>
                    <div style="overflow:auto;max-height:28rem;">
                        <table class="w-full text-xs mono" style="border-collapse:collapse;">
                            <thead style="position:sticky;top:0;background:#fff;">
                                <tr style="color:#6b7280;border-bottom:1px solid #e5e7eb;">
                                    <th class="text-left py-1 pr-2">Row</th>
                                    <th class="text-left py-1 pr-2">Slot</th>
                                    <th class="text-left py-1 pr-2">Result</th>
                                    <th class="text-right py-1 pr-2">PLC X</th>
                                    <th class="text-right py-1 pr-2">PLC Z</th>
                                    <th class="text-right py-1 pr-2">DB X</th>
                                    <th class="text-right py-1 pr-2">DB Z</th>
                                    <th class="text-right py-1 pr-2">Diff X</th>
                                    <th class="text-right py-1">Diff Z</th>
                                </tr>
                            </thead>
                            <tbody id="resultBody">
                                <tr><td colspan="9" class="py-2" style="color:#9ca3af;">Select a column.</td></tr>
                            </tbody>
                        </table>
                    </div>
                </div>

                <div class="rounded-xl p-6 flex flex-col" style="background:#fff;border:1px solid #e5e7eb;">
                    <h2 class="text-xs font-semibold mb-2 flex items-center gap-2" style="color:#4b5563;"><i class="bi-terminal" style="width:14px;height:14px;"></i> Activity Log</h2>
                    <div id="logList" class="space-y-1 overflow-y-auto text-xs mono" style="max-height: 18rem;">
                        <div class="log-entry text-xs" style="color:#64748b;">[System ready]</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="pulsesModal" role="dialog">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Current Pulses</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="flex items-center gap-2 mb-3">
                    <input type="text" id="txtPulseSlot" placeholder="Slot Code" autocomplete="off" class="px-2.5 py-1.5 rounded-lg text-xs border" style="width: 40%;">
                    <button class="px-2 py-1 rounded text-xs font-semibold" style="background:#3b82f6;color:#fff;" onclick="loadCurrentPulses()">
                        <i class="bi-arrow-clockwise" style="width:12px;height:12px;"></i> Read
                    </button>
                </div>
                <table class="w-full text-xs mono">
                    <thead>
                        <tr style="color:#6b7280;border-bottom:1px solid #e5e7eb;">
                            <th class="text-left py-1"></th>
                            <th class="text-right py-1">PLC (Current)</th>
                            <th class="text-right py-1">Slot (DB)</th>
                            <th class="text-right py-1">Difference</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td class="py-1 font-semibold">X</td>
                            <td class="text-right py-1" id="pulsePlcX">-</td>
                            <td class="text-right py-1" id="pulseSlotX">-</td>
                            <td class="text-right py-1 font-semibold" id="pulseDiffX">-</td>
                        </tr>
                        <tr>
                            <td class="py-1 font-semibold">Y</td>
                            <td class="text-right py-1" id="pulsePlcY">-</td>
                            <td class="text-right py-1" id="pulseSlotY">-</td>
                            <td class="text-right py-1 font-semibold" id="pulseDiffY">-</td>
                        </tr>
                    </tbody>
                </table>
                <p class="text-xs mt-2" id="pulseMsg" style="color:#ef4444;"></p>
            </div>
        </div>
    </div>
</div>

<!-- PLC Address Response Log Side Panel -->
<div id="addressLogOverlay" class="hidden" style="position:fixed;inset:0;background:rgba(15,23,42,0.35);z-index:1040;" onclick="hideAddressResponseLog()"></div>
<div id="addressLogPanel" style="position:fixed;top:0;right:-420px;width:420px;height:100vh;background:#fff;box-shadow:-8px 0 24px rgba(0,0,0,0.12);z-index:1050;transition:right 0.3s ease;display:flex;flex-direction:column;">
    <div class="px-4 py-3 flex items-center justify-between border-b" style="border-color:#e5e7eb;">
        <h2 class="text-sm font-bold flex items-center gap-2" style="color:#1f2937;">
            <i class="bi-cpu" style="width:14px;height:14px;"></i> PLC Address Response Log
        </h2>
        <div class="flex items-center gap-2">
            <button class="px-2 py-1 rounded text-xs font-semibold" style="background:#f3f4f6;color:#374151;" onclick="loadAddressResponseLog()">
                <i class="bi-arrow-clockwise" style="width:12px;height:12px;"></i> Refresh
            </button>
            <button class="btn-close" aria-label="Close" onclick="hideAddressResponseLog()"></button>
        </div>
    </div>
    <div class="px-4 py-2 text-xs mono" style="color:#9ca3af;border-bottom:1px solid #e5e7eb;">
        Sorted by most recent reading. Rows updated in the last 5s are highlighted.
    </div>
    <div id="addressLogList" class="flex-1" style="overflow-y:auto;padding:8px 12px;">
        <div class="text-xs" style="color:#9ca3af;">Loading...</div>
    </div>
</div>

@section Scripts
{
    <script src="../js/lucide.min.js"></script>
    <link href="../css/jetbrains.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/sweetalert2.min.css">

    <script src="../lib/jquery/dist/jquery.min.js"></script>
    <script src="../js/sweetalert2.all.min.js"></script>
    <script src="~/js/xlsx.full.min.js"></script>

    <script type="text/javascript">

        let token = '';

        // one cycle = one SRMS slot, drawer goes trolley -> slot -> trolley
        const STEPS = [
            'Retrieve drawer from trolley',
            '* Retrieve Status *',
            'Put away to SRMS slot',
            '* Put Away Status *',
            'Read QR X, Z',
            'Retrieve from SRMS slot',
            '* Retrieve Status *',
            'Put away back to trolley',
            '* Put Away Status *'
        ];
        // wait for the robot to move before reading its status
        const MOVE_DELAY = { 0: 2000, 2: 5000, 5: 5000, 7: 5000 };
        // manual buttons :: move = send command again, status = read status again, read = read QR again
        const STEP_KIND = ['move', 'status', 'move', 'status', 'read', 'move', 'status', 'move', 'status'];
        // where the drawer must be before a move can be sent
        const MOVE_FROM = { 0: 'trolley', 2: 'robot', 5: 'rack', 7: 'robot' };
        // one cycle :: take from trolley, read at SRMS slot, return to trolley. finished only after step 9.
        const STEP_GROUP = { 0: 'TAKE FROM TROLLEY', 2: 'SRMS SLOT', 7: 'RETURN TO TROLLEY' };

        // where the drawer is :: 'trolley', 'robot', 'rack' (inside slot)
        let drawerAt = 'trolley';
        let drawerSlot = '';

        let slots = [];         // column slots with result
        let curIdx = -1;        // next slot to read
        let cycle = null;       // { idx, t: { trolleyId, trolleyCode, side, col, row }, phase } while a cycle is not finished
        let mode = '';          // 'one' or 'continue'
        let running = false;
        let stopNow = false;
        let stopAfter = false;
        let lastError = false;

        $(document).ready(async function () {
            token = $('#xToken').val();
            await loadTrolleys();
            await loadColumns();
            renderSteps();
            updateUI();
        });

        window.addEventListener('beforeunload', function (e) {
            if (drawerAt != 'trolley' || running || cycle != null) {
                e.preventDefault();
                e.returnValue = '';
            }
        });

        function delay(ms) {
            return new Promise(resolve => setTimeout(resolve, ms));
        }

        // delay that ends early when Stop Now is pressed
        async function wait(ms) {
            const end = Date.now() + ms;
            while (Date.now() < end && !stopNow) { await delay(200); }
        }

        async function api(url) {
            try {
                return await $.ajax({
                    url: url,
                    type: 'GET',
                    headers: { 'Authorization': 'Bearer ' + token },
                    dataType: 'JSON',
                    contentType: 'application/json; charset=utf-8'
                });
            }
            catch (error) {
                return { success: false, errMessage: 'Request failed (' + (error.status || 'network') + ').', data: null };
            }
        }

        function log(msg, typ) {
            const list = document.getElementById('logList');
            const d = document.createElement('div');
            d.className = 'log-entry';
            const ts = new Date().toLocaleTimeString('en', { hour12: false });
            const color = typ == 'alert' ? '#e74c3c' : (typ == 'ok' ? '#059669' : '#374151');
            d.innerHTML = `<span style="color:#475569">[${ts}]</span> <span style="color:${color}">${$('<div>').text(msg).html()}</span>`;
            list.prepend(d);
            if (list.children.length > 200) list.lastChild.remove();
        }

        function setStatus(text, color) {
            document.getElementById('statusText').textContent = text;
            document.getElementById('statusDot').style.background = color;
        }

        // ----------- Load lists
        async function loadTrolleys() {
            const r = await api('/api/PLCCalibration/GetTrolleys');
            const sel = $('#selTrolley').empty();
            if (r.success) {
                r.data.forEach(t => sel.append(`<option value="${t.trolley_Id}">${$('<div>').text(t.trolleyCode).html()}</option>`));
            }
        }

        async function loadColumns() {
            const r = await api('/api/PLCCalibration/GetColumns');
            const sel = $('#selColumn').empty();
            sel.append('<option value="">-- Select --</option>');
            if (r.success) {
                r.data.forEach(c => sel.append(`<option value="${c.colNo}">Col ${c.colNo} (${c.isLeft ? 'Left' : 'Right'}, ${c.totalSlot} slots)</option>`));
            }
        }

        async function loadColumn() {
            if (running || cycle != null) { return; }
            const col = $('#selColumn').val();
            slots = [];
            curIdx = -1;
            $('#txtStartRow, #txtEndRow').val('');
            if (!col) { renderResults(); updateUI(); return; }

            const r = await api('/api/PLCCalibration/GetColumnSlots/' + col);
            if (!r.success) { log('Load column :: ' + r.errMessage, 'alert'); return; }

            slots = r.data.map(s => {
                let skip = '';
                if (!s.isActive) skip = 'Skipped: inactive';
                else if (s.hasReel) skip = 'Skipped: has reel';
                else if (s.hasEmptyTray) skip = 'Skipped: has tray';
                return { ...s, result: skip || 'Pending', state: skip ? 'skip' : 'pending', plcX: null, plcZ: null, dbX: s.qrxPulse, dbZ: s.qryPulse, diffX: null, diffZ: null };
            });
            if (slots.length > 0) { $('#txtEndRow').val(slots[slots.length - 1].rowNo); }
            setPointer(nextReadable(0));
            renderResults();
            updateUI();
        }

        // last row to read, empty = end of column
        function endRow() {
            const v = Number($('#txtEndRow').val() || 0);
            return v > 0 ? v : Infinity;
        }

        // next readable slot from index, not past End Row. -1 when none.
        function nextReadable(from) {
            if (from < 0) return -1;
            const end = endRow();
            for (let i = from; i < slots.length; i++) {
                if (slots[i].rowNo > end) return -1;
                if (slots[i].state != 'skip') return i;
            }
            return -1;
        }

        function setPointer(idx) {
            curIdx = idx;
            $('#txtStartRow').val(idx >= 0 ? slots[idx].rowNo : '');
        }

        // user typed a start row :: next read starts from that row (or the first readable row after it)
        function setStartRow(quiet) {
            if (running || cycle != null) { return; }
            const row = Number($('#txtStartRow').val() || 0);
            if (row > endRow() && !quiet) {
                log(`Start Row :: row ${row} is after End Row ${endRow()}.`, 'alert');
            }
            const idx = slots.findIndex(s => s.rowNo >= row);
            const next = nextReadable(idx);
            if (idx >= 0 && next >= 0 && next != idx) {
                log(`Start Row :: row ${row} is skipped (${slots[idx].result}), next readable row is used`, 'info');
            }
            setPointer(next);
            if (next < 0) { $('#txtStartRow').val(row || ''); }
            renderResults();
            updateUI();
        }

        // End Row can change any time, also during Continue Read (takes effect when the current cycle finishes)
        function setEndRow() {
            const end = endRow();
            const start = Number($('#txtStartRow').val() || 0);
            if (end != Infinity && start > end) {
                log(`End Row :: row ${end} is before Start Row ${start}.`, 'alert');
            } else {
                log(end == Infinity ? 'End Row :: end of column' : `End Row :: ${end}`, 'info');
            }
            if (!running && cycle == null) {
                // re-pick the next slot from the Start Row with the new end
                setStartRow(true);
                return;
            }
            updateUI();
        }

        // ----------- Results
        function renderResults() {
            const body = document.getElementById('resultBody');
            if (slots.length == 0) {
                body.innerHTML = '<tr><td colspan="9" class="py-2" style="color:#9ca3af;">Select a column.</td></tr>';
                $('#txtSummary').text('');
                return;
            }
            const limit = Number($('#txtDiffLimit').val() || 0);
            const hiIdx = cycle != null ? cycle.idx : curIdx;
            let html = '';
            slots.forEach((s, i) => {
                const colors = { pending: '#9ca3af', skip: '#9ca3af', ok: '#059669', warn: '#b45309', fail: '#e74c3c', busy: '#2563eb' };
                const bg = i == hiIdx ? '#eff6ff' : 'transparent';
                const big = v => v != null && limit > 0 && Math.abs(v) >= limit;
                const cell = v => v == null ? '-' : v;
                html += `<tr id="res${i}" style="border-bottom:1px solid #f1f5f9;background:${bg};">
                    <td class="py-1 pr-2">${s.rowNo}</td>
                    <td class="py-1 pr-2">${$('<div>').text(s.slotCode).html()}</td>
                    <td class="py-1 pr-2" style="color:${colors[s.state]};">${$('<div>').text(s.result).html()}</td>
                    <td class="py-1 pr-2 text-right">${cell(s.plcX)}</td>
                    <td class="py-1 pr-2 text-right">${cell(s.plcZ)}</td>
                    <td class="py-1 pr-2 text-right">${cell(s.dbX)}</td>
                    <td class="py-1 pr-2 text-right">${cell(s.dbZ)}</td>
                    <td class="py-1 pr-2 text-right" style="${big(s.diffX) ? 'color:#b45309;font-weight:700;' : ''}">${cell(s.diffX)}</td>
                    <td class="py-1 text-right" style="${big(s.diffZ) ? 'color:#b45309;font-weight:700;' : ''}">${cell(s.diffZ)}</td>
                </tr>`;
            });
            body.innerHTML = html;

            const done = slots.filter(s => s.state == 'ok' || s.state == 'warn').length;
            const fail = slots.filter(s => s.state == 'fail').length;
            const skip = slots.filter(s => s.state == 'skip').length;
            $('#txtSummary').text(`${done} checked · ${fail} failed · ${skip} skipped · ${slots.length} slots`);

            if (hiIdx >= 0) {
                const row = document.getElementById('res' + hiIdx);
                if (row) row.scrollIntoView({ block: 'nearest' });
            }
        }

        function setSlot(i, state, result) {
            slots[i].state = state;
            slots[i].result = result;
            renderResults();
        }

        // manual step button allowed? moves only when the drawer is where that move expects it
        function canManual(i) {
            if (running) return false;
            if (cycle == null) return i == 0 && curIdx >= 0;
            if (STEP_KIND[i] != 'move') return true;
            return drawerAt == MOVE_FROM[i];
        }

        function renderSteps() {
            const p = cycle != null ? cycle.phase : -1;
            let html = '';
            STEPS.forEach((label, i) => {
                let cls = 'waiting';
                let style = '';
                if (p >= 0 && i < p) cls = 'done';
                else if (i == p) {
                    if (lastError) style = 'background:#e74c3c;border-color:#e74c3c;';
                    else cls = running ? 'active' : 'done';
                    if (!running && !lastError) style = 'background:#f59e0b;border-color:#f59e0b;';
                }
                const color = i == p ? '#1f2937' : '#64748b';
                const btnText = { move: 'Send again', status: 'Check again', read: 'Read again' }[STEP_KIND[i]];
                if (STEP_GROUP[i]) {
                    html += `<div class="text-xs font-semibold mono ${i > 0 ? 'mt-1.5' : ''}" style="color:#9ca3af;">${STEP_GROUP[i]}</div>`;
                }
                html += `<div class="flex items-center gap-2">
                    <div class="step-dot ${cls}" style="${style}"></div>
                    <span class="text-xs flex-1" style="color:${color};${i == p ? 'font-weight:600;' : ''}">${i + 1}. ${label}</span>
                    <button onclick="manualStep(${i})" class="phase-btn px-3 py-1 rounded text-xs font-semibold" style="background:#fff;color:#ef4444;border:1px solid #fecaca;" ${canManual(i) ? '' : 'disabled'}>${btnText}</button>
                </div>`;
            });
            document.getElementById('stepList').innerHTML = html;
        }

        // ----------- UI state
        function updateUI() {
            const atText = { trolley: 'Trolley', robot: 'Robot (holding)', rack: 'Rack slot ' + drawerSlot }[drawerAt];
            const atColor = { trolley: '#6b7280', robot: '#2563eb', rack: '#b45309' }[drawerAt];
            $('#drawerAtText').text(atText).css('color', atColor);

            // setup is locked while a cycle is not finished, the drawer must go back to the same trolley slot
            const locked = running || cycle != null;
            $('#selTrolley, #selSide, #selTrolleyCol, #txtTrolleyRow, #selColumn, #txtStartRow').prop('disabled', locked);

            const canRead = !running && (cycle != null || curIdx >= 0);
            $('#btnReadOne, #btnContinue').prop('disabled', !canRead);
            $('#btnStopNow').prop('disabled', !running || stopNow);
            $('#btnStopAfter').prop('disabled', !running || stopNow || stopAfter);
            $('#btnReset').toggleClass('hidden', running || cycle == null);

            const idx = cycle != null ? cycle.idx : curIdx;
            $('#txtCurSlot').text(idx >= 0 ? `${slots[idx].slotCode} (row ${slots[idx].rowNo})` : '-');

            let hint = '';
            if (running && stopNow) hint = 'Stopping after the current robot step...';
            else if (running && stopAfter) hint = 'Will stop when the drawer is back in the trolley.';
            else if (running) hint = { one: 'Reading one slot.', continue: 'Reading every row down the column.', manual: 'Running one step.' }[mode];
            else if (cycle != null) hint = `Stopped at step ${cycle.phase + 1}. Read One / Continue Read carries on from this step, or use a step button to retry one action.`;
            else if (slots.length == 0) hint = 'Select a SRMS column.';
            else if (curIdx < 0) hint = 'No more slot to read up to End Row. Change Start Row / End Row to read again.';
            else hint = `Next: ${slots[curIdx].slotCode} (row ${slots[curIdx].rowNo}).`;
            $('#txtHint').text(hint);

            renderSteps();
        }

        function readTrolley() {
            const t = {
                trolleyId: $('#selTrolley').val(),
                trolleyCode: $('#selTrolley option:selected').text(),
                side: $('#selSide').val(),
                col: Number($('#selTrolleyCol').val()),
                row: Number($('#txtTrolleyRow').val())
            };
            if (!t.trolleyId || !t.row) { log('Select trolley and trolley row.', 'alert'); return null; }
            return t;
        }

        function newCycle(t) {
            const s = slots[curIdx];
            s.plcX = s.plcZ = s.diffX = s.diffZ = null;
            setSlot(curIdx, 'busy', 'Taking from trolley');
            cycle = { idx: curIdx, t: t, phase: 0, result: null };
            log(`Cycle :: ${s.slotCode} (row ${s.rowNo}) with ${t.trolleyCode} side ${t.side} col ${t.col} row ${t.row}`, 'info');
        }

        // ----------- Read One / Continue Read
        async function startRead(m) {
            if (running) { return; }
            if (cycle == null) {
                if (curIdx < 0) { log('No more slot to read up to End Row. Change Start Row / End Row.', 'alert'); return; }
                const t = readTrolley();
                if (!t) { return; }
                newCycle(t);
            } else {
                log(`Resume :: ${slots[cycle.idx].slotCode} from step ${cycle.phase + 1} (${STEPS[cycle.phase]})`, 'info');
            }

            mode = m;
            running = true;
            stopNow = false;
            stopAfter = false;
            lastError = false;
            setStatus(m == 'one' ? 'READ ONE' : 'CONTINUE READ', '#22c55e');
            updateUI();

            while (true) {
                const t = cycle.t;
                const done = await runCycle();
                if (!done) { return; } // stopped now or error, already handled

                if (curIdx < 0) { log(endRow() == Infinity ? 'Column finished' : `Finished :: reached End Row ${endRow()}`, 'ok'); break; }
                if (mode == 'one') { break; }
                if (stopAfter) { log('Stopped after cycle. Drawer is back in the trolley.', 'info'); break; }
                if (stopNow) { log('Stopped. Drawer is back in the trolley.', 'info'); break; }
                newCycle(t);
                updateUI();
            }
            finishRun('IDLE', '#6b7280');
        }

        // runs the current cycle from its phase to the end. true when the drawer is back in the trolley.
        async function runCycle() {
            const s = slots[cycle.idx];
            while (cycle.phase < STEPS.length) {
                if (stopNow) {
                    log(`Stop Now :: stopped at step ${cycle.phase + 1} (${STEPS[cycle.phase]}) of ${s.slotCode}. Drawer is at ${drawerAt == 'rack' ? 'slot ' + drawerSlot : drawerAt}.`, 'alert');
                    finishRun('STOPPED', '#e74c3c');
                    return false;
                }
                const p = cycle.phase;
                updateUI();
                const res = await runStep(p);
                if (res == 'fail') { stopOnError(); return false; }
                if (MOVE_DELAY[p] && cycle.phase == p + 1) { await wait(MOVE_DELAY[p]); }
            }

            completeCycle();
            return true;
        }

        // drawer is back in the trolley :: move pointer to the next readable row
        function completeCycle() {
            log(`Cycle :: ${slots[cycle.idx].slotCode} done, drawer is back in the trolley`, 'ok');
            const next = nextReadable(cycle.idx + 1);
            const doneRow = slots[cycle.idx].rowNo;
            cycle = null;
            setPointer(next);
            // reached End Row :: keep Start Row after the last read row, so a larger End Row carries on from here
            if (next < 0) { $('#txtStartRow').val(doneRow + 1); }
            renderResults();
            updateUI();
        }

        // manual :: run one step of the current cycle, then stop
        async function manualStep(p) {
            if (!canManual(p)) { return; }
            const label = `step ${p + 1} (${STEPS[p]})`;

            // sending a move again is only safe when the PLC really did not get the first one
            if (STEP_KIND[p] == 'move') {
                const c = await Swal.fire({
                    icon: 'warning',
                    title: 'Send command again?',
                    html: `This tells the robot to do <b>${STEPS[p]}</b>.<br>Only do this if the robot is <b>not moving</b> and did not start the first command.`,
                    showCancelButton: true,
                    confirmButtonText: 'Send',
                    cancelButtonText: 'Cancel',
                    confirmButtonColor: '#e74c3c'
                });
                if (!c.isConfirmed || !canManual(p)) { return; }
            }

            if (cycle == null) {
                const t = readTrolley();
                if (!t) { return; }
                newCycle(t);
            }

            mode = 'manual';
            running = true;
            stopNow = false;
            stopAfter = false;
            lastError = false;
            setStatus('MANUAL STEP', '#f59e0b');
            log(`Manual :: ${slots[cycle.idx].slotCode} :: ${label}`, 'info');
            updateUI();

            const res = await runStep(p);
            if (res == 'fail') { return stopOnError(); }
            if (cycle.phase >= STEPS.length) {
                completeCycle();
                return finishRun('IDLE', '#6b7280');
            }
            log(`Manual :: done. Next is step ${cycle.phase + 1} (${STEPS[cycle.phase]}).`, 'info');
            finishRun('MANUAL', '#f59e0b');
        }

        // run one step of the current cycle. 'ok' moves cycle.phase on, 'fail' keeps it so it can be retried.
        async function runStep(p) {
            const i = cycle.idx;
            const s = slots[i];
            const t = cycle.t;
            const tUrl = `${t.trolleyId}/${t.side}/${t.col}/${t.row}`;
            let r;

            switch (p) {
                // 1 :: trolley -> robot
                case 0:
                    r = await api('/api/PLCCalibration/RetrieveTrolley/' + tUrl);
                    if (!r.success) { log('Retrieve Trolley :: ' + r.errMessage, 'alert'); return 'fail'; }
                    log('Retrieve Trolley :: command sent', 'info');
                    break;

                // 2 :: retrieve trolley status
                case 1:
                    r = await api('/api/PLCCalibration/GetRetrieveTrolleyStatus');
                    if (!r.success) {
                        if (r.data == '3') {
                            // no drawer, robot did not take anything, next try sends retrieve again
                            cycle.phase = 0;
                            log(`Retrieve Trolley Status :: ${r.errMessage} Put a drawer at ${t.trolleyCode} side ${t.side} col ${t.col} row ${t.row}.`, 'alert');
                        } else {
                            log(`Retrieve Trolley Status :: ${r.errMessage} (register ${r.data}). Check the robot.`, 'alert');
                        }
                        return 'fail';
                    }
                    drawerAt = 'robot';
                    log('Retrieve Trolley Status :: OK, robot is holding the drawer', 'ok');
                    break;

                // 3 :: robot -> slot
                case 2:
                    setSlot(i, 'busy', 'Putting away');
                    r = await api('/api/PLCCalibration/PutAwayRack/' + encodeURIComponent(s.slotCode));
                    if (!r.success) { log(`Put Away :: ${s.slotCode} :: ${r.errMessage}`, 'alert'); return 'fail'; }
                    log(`Put Away :: ${s.slotCode} :: command sent`, 'info');
                    break;

                // 4 :: put away status
                case 3:
                    r = await api('/api/PLCCalibration/GetPutAwayStatus');
                    if (!r.success) {
                        if (r.data == '3') {
                            // slot occupied, robot still holding the drawer :: skip reading, bring drawer back to trolley
                            cycle.result = { state: 'fail', text: 'Has tray (PLC)' };
                            setSlot(i, 'busy', 'Has tray, returning to trolley');
                            log(`Put Away Status :: ${s.slotCode} :: ${r.errMessage} Drawer goes back to the trolley.`, 'alert');
                            cycle.phase = 7;
                            return 'ok';
                        }
                        log(`Put Away Status :: ${s.slotCode} :: ${r.errMessage} (register ${r.data}). Check the robot.`, 'alert');
                        return 'fail';
                    }
                    drawerAt = 'rack';
                    drawerSlot = s.slotCode;
                    log(`Put Away Status :: ${s.slotCode} :: OK`, 'ok');
                    break;

                // 5 :: read QR pulses (not fatal)
                case 4:
                    r = await api('/api/PLCTrolley/GetQRPulses/' + encodeURIComponent(s.slotCode));
                    if (r.success && r.data) {
                        const d = r.data;
                        s.plcX = d[0]; s.plcZ = d[1]; s.diffX = d[2]; s.diffZ = d[3]; s.dbX = d[4]; s.dbZ = d[5];
                        if (d[0] == 0 && d[1] == 0) {
                            log(`Read QR :: ${s.slotCode} :: PLC returned 0, read may have failed`, 'alert');
                        } else {
                            log(`Read QR :: ${s.slotCode} :: X ${d[0]} Z ${d[1]} (diff ${d[2]} / ${d[3]})`, 'info');
                        }
                    } else {
                        log(`Read QR :: ${s.slotCode} :: ${r.errMessage}`, 'alert');
                    }
                    setSlot(i, 'busy', 'Taking back');
                    break;

                // 6 :: slot -> robot
                case 5:
                    r = await api('/api/PLCCalibration/RetrieveRack/' + encodeURIComponent(s.slotCode));
                    if (!r.success) { log(`Retrieve :: ${s.slotCode} :: ${r.errMessage}. Drawer is still in the slot.`, 'alert'); return 'fail'; }
                    log(`Retrieve :: ${s.slotCode} :: command sent`, 'info');
                    break;

                // 7 :: retrieve status
                case 6: {
                    r = await api('/api/PLCCalibration/GetRetrieveRackStatus');
                    if (!r.success) {
                        log(`Retrieve Status :: ${s.slotCode} :: ${r.errMessage} (register ${r.data}). Check whether the drawer is still in the slot.`, 'alert');
                        return 'fail';
                    }
                    drawerAt = 'robot';
                    drawerSlot = '';
                    const limit = Number($('#txtDiffLimit').val() || 0);
                    const big = limit > 0 && s.diffX != null && (Math.abs(s.diffX) >= limit || Math.abs(s.diffZ) >= limit);
                    // result is final only when the drawer is back in the trolley (step 9)
                    cycle.result = big ? { state: 'warn', text: 'OK, check diff' } : { state: 'ok', text: 'OK' };
                    setSlot(i, 'busy', 'Returning to trolley');
                    log(`Retrieve Status :: ${s.slotCode} :: OK`, 'ok');
                    break;
                }

                // 8 :: robot -> trolley
                case 7:
                    r = await api('/api/PLCCalibration/PutAwayTrolley/' + tUrl);
                    if (!r.success) { log('Put Away Trolley :: ' + r.errMessage, 'alert'); return 'fail'; }
                    log('Put Away Trolley :: command sent', 'info');
                    break;

                // 9 :: put away trolley status
                case 8: {
                    r = await api('/api/PLCCalibration/GetPutAwayStatus');
                    if (!r.success) {
                        if (r.data == '3') {
                            // trolley slot occupied, robot still holding the drawer, next try sends put away again
                            cycle.phase = 7;
                            log(`Put Away Trolley Status :: ${r.errMessage} Clear ${t.trolleyCode} side ${t.side} col ${t.col} row ${t.row}.`, 'alert');
                        } else {
                            log(`Put Away Trolley Status :: ${r.errMessage} (register ${r.data}). Check the robot.`, 'alert');
                        }
                        return 'fail';
                    }
                    drawerAt = 'trolley';
                    const res = cycle.result || { state: 'fail', text: 'No reading' };
                    setSlot(i, res.state, res.text);
                    log('Put Away Trolley Status :: OK', 'ok');
                    break;
                }
            }

            cycle.phase = p + 1;
            return 'ok';
        }

        function requestStopNow() {
            if (!running) { return; }
            stopNow = true;
            log('Stop Now :: no more command will be sent after the current robot step', 'alert');
            updateUI();
        }

        function requestStopAfter() {
            if (!running) { return; }
            stopAfter = true;
            log('Stop After Cycle :: will stop when the drawer is back in the trolley', 'info');
            updateUI();
        }

        function stopOnError() {
            lastError = true;
            log(`Stopped on error at step ${cycle.phase + 1} (${STEPS[cycle.phase]}). Fix the cause, then press Read One or Continue Read to retry this step.`, 'alert');
            finishRun('ERROR', '#e74c3c');
        }

        function finishRun(text, color) {
            running = false;
            stopNow = false;
            stopAfter = false;
            setStatus(text, color);
            renderResults();
            updateUI();
        }

        // drop an unfinished cycle after the drawer has been put back by hand
        async function resetCycle() {
            if (running || cycle == null) { return; }
            const t = cycle.t;
            const c = await Swal.fire({
                icon: 'warning',
                title: 'Reset cycle?',
                html: `Only do this when the drawer is back in <b>${$('<div>').text(t.trolleyCode).html()} side ${t.side} col ${t.col} row ${t.row}</b> and the robot is not holding anything.`,
                showCancelButton: true,
                confirmButtonText: 'Reset',
                cancelButtonText: 'Cancel',
                confirmButtonColor: '#e74c3c'
            });
            if (!c.isConfirmed) { return; }

            const s = slots[cycle.idx];
            if (s.state == 'busy') { setSlot(cycle.idx, 'pending', 'Pending'); }
            log(`Reset cycle :: ${s.slotCode} cleared at step ${cycle.phase + 1}`, 'info');
            setPointer(cycle.idx);
            cycle = null;
            lastError = false;
            drawerAt = 'trolley';
            drawerSlot = '';
            finishRun('IDLE', '#6b7280');
        }

        // ----------- Export
        function exportResults() {
            if (slots.length == 0) { return; }
            const rows = slots.map(s => ({
                'Row': s.rowNo,
                'Slot': s.slotCode,
                'Result': s.result,
                'PLC X': s.plcX,
                'PLC Z': s.plcZ,
                'DB X': s.dbX,
                'DB Z': s.dbZ,
                'Diff X': s.diffX,
                'Diff Z': s.diffZ,
            }));
            const wb = XLSX.utils.book_new();
            wb.Props = { Title: "Calibration SRMS", Subject: "Calibration SRMS", Author: "Flex Software Consulting Sdn Bhd", CreatedDate: new Date() };
            XLSX.utils.book_append_sheet(wb, XLSX.utils.json_to_sheet(rows), "Sheet1");
            XLSX.writeFile(wb, "Calibration SRMS Col " + $('#selColumn').val() + ".xlsx");
        }

        // ----------- Current Pulses
        function showCurrentPulses() {
            const idx = cycle != null ? cycle.idx : curIdx;
            $("#txtPulseSlot").val(drawerSlot || (idx >= 0 ? slots[idx].slotCode : ''));
            $('#pulsesModal').modal("show");
            loadCurrentPulses();
        }

        async function loadCurrentPulses() {
            const slot = ($("#txtPulseSlot").val() || "").trim();
            $("#pulsePlcX, #pulsePlcY, #pulseSlotX, #pulseSlotY, #pulseDiffX, #pulseDiffY").text("-");
            if (slot == "") {
                $("#pulseMsg").css("color", "#ef4444").text("Please enter Slot Code.");
                return;
            }
            $("#pulseMsg").css("color", "#6b7280").text("Reading...");
            const r = await api('/api/PLCTrolley/GetQRPulses/' + encodeURIComponent(slot) + '/' + (cycle != null ? cycle.t.trolleyId : 0));
            if (!r.success) {
                $("#pulseMsg").css("color", "#ef4444").text(r.errMessage || "Failed to get pulses.");
                return;
            }
            const d = r.data;
            $("#pulsePlcX").text(d[0]);
            $("#pulsePlcY").text(d[1]);
            $("#pulseSlotX").text(d[4]);
            $("#pulseSlotY").text(d[5]);
            $("#pulseDiffX").text(d[2]);
            $("#pulseDiffY").text(d[3]);
            if (d[0] == 0 && d[1] == 0) {
                $("#pulseMsg").css("color", "#ef4444").text("PLC returned 0. Read may have failed, check PLC connection.");
            } else {
                $("#pulseMsg").css("color", "#6b7280").text("Read at " + new Date().toLocaleTimeString());
            }
        }

        // ----------- PLC Address Response Log
        function showAddressResponseLog() {
            document.getElementById('addressLogOverlay').classList.remove('hidden');
            document.getElementById('addressLogPanel').style.right = '0px';
            loadAddressResponseLog();
        }

        function hideAddressResponseLog() {
            document.getElementById('addressLogOverlay').classList.add('hidden');
            document.getElementById('addressLogPanel').style.right = '-420px';
        }

        async function loadAddressResponseLog() {
            const r = await api('/api/PLCTrolley/GetAddressResponseLog');
            if (r.success == true) {
                renderAddressResponseLog(r.data);
            }
        }

        function renderAddressResponseLog(list) {
            const container = document.getElementById('addressLogList');
            if (!list || list.length === 0) {
                container.innerHTML = '<div class="text-xs" style="color:#9ca3af;">No address response yet.</div>';
                return;
            }

            // sort by last reading datetime, most recent first
            list.sort((a, b) => new Date(b.createdDate) - new Date(a.createdDate));

            const now = new Date();
            let html = '';
            list.forEach(item => {
                const dt = new Date(item.createdDate);
                const ageSec = (now - dt) / 1000;
                const isFresh = ageSec <= 5;
                const isErr = item.isErr === true;

                let bg = '#fff';
                let border = '#e5e7eb';
                if (isErr) { bg = '#fef2f2'; border = '#fecaca'; }
                else if (isFresh) { bg = '#ecfdf5'; border = '#6ee7b7'; }

                html += `
                    <div class="log-entry rounded-lg mb-1.5 px-3 py-2" style="background:${bg};border:1px solid ${border};">
                        <div class="flex items-center justify-between">
                            <span class="text-xs font-bold mono" style="color:#1f2937;">Addr ${item.address}</span>
                            <span class="text-xs font-semibold mono" style="color:${isErr ? '#b91c1c' : '#059669'};">
                                ${isFresh ? '<i class="bi-broadcast" style="width:10px;height:10px;"></i> ' : ''}${item.action}
                            </span>
                        </div>
                        <div class="flex items-center justify-between mt-0.5">
                            <span class="text-xs mono" style="color:#4b5563;">Value: <b>${item.value}</b></span>
                            <span class="text-xs mono" style="color:#9ca3af;">${dt.toLocaleTimeString()}</span>
                        </div>
                        <div class="text-xs mono" style="color:#9ca3af;">${item.methodName}</div>
                    </div>`;
            });

            container.innerHTML = html;
        }
    </script>
}
