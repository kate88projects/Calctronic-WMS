            </div><div class="tw:flex tw:justify-center tw:border-t tw:border-gray-100 tw:px-6 tw:py-5 tw:dark:border-gray-800">
                <button type="button" class="tw:inline-flex tw:items-center tw:gap-2 tw:rounded-lg tw:border-0 tw:bg-brand-500 tw:px-4 tw:py-2.5 tw:text-sm tw:font-medium tw:text-white tw:hover:bg-brand-600" onclick="processAndSubmitData()">Submit<i class="bi bi-upload"></i></button>
            </div>
        </div>
    </div>
</div>

@section Scripts
{
    <link rel="stylesheet" href="~/css/sweetalert2.min.css">
    <link rel="stylesheet" href="~/css/dataTables.dataTables.css">

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="../js/dataTables.js"></script>

    <script src="~/js/sweetalert2.all.min.js"></script>
    <script src="~/js/xlsx.full.min.js"></script>
    <script src="~/js/exceljs.min.js"></script>

    <script type="text/javascript">
        let uploadedFileContent = null;
        let uploadedFileExtension = null;

        function customSelect(selectId) {
            return {
                open: false,
                dropUp: false,
                options: [],
                selectedValue: '',
                selectedLabel: '',
                hasError: false,
                init() {
                    this.syncOptions();
                    const sel = document.getElementById(selectId);
                    if (!sel) return;
                    this.hasError = sel.classList.contains('is-invalid');
                    new MutationObserver(() => {
                        this.hasError = sel.classList.contains('is-invalid');
                    }).observe(sel, { attributes: true, attributeFilter: ['class'] });
                },
                toggle() {
                    this.open = !this.open;
                    if (this.open) {
                        this.syncOptions();
                        const rect = this.$el.getBoundingClientRect();
                        const spaceBelow = window.innerHeight - rect.bottom;
                        this.dropUp = spaceBelow < 240 && rect.top > spaceBelow;
                    }
                },
                syncOptions() {
                    const sel = document.getElementById(selectId);
                    if (!sel) return;
                    this.options = Array.from(sel.options).map(o => ({ value: o.value, text: o.textContent.trim() }));
                    this.selectedValue = sel.value;
                    const selectedOpt = sel.options[sel.selectedIndex];
                    this.selectedLabel = selectedOpt ? selectedOpt.textContent.trim() : '';
                },
                select(opt) {
                    const sel = document.getElementById(selectId);
                    sel.value = opt.value;
                    this.selectedValue = opt.value;
                    this.selectedLabel = opt.text;
                    this.open = false;
                    sel.dispatchEvent(new Event('change'));
                }
            };
        }

        function refreshCustomSelect(selectId) {
            const sel = document.getElementById(selectId);
            const root = sel ? sel.closest('[x-data]') : null;
            if (root && window.Alpine) {
                Alpine.$data(root).syncOptions();
            }
        }

        $(document).ready(function() {
            $('#txtTotalRecord').val(0);
            $('#txtTotalPage').val(1);
            loadList(1);
            loadItemGroupList();
            loadReelDList();
        });

        function prevPage() {
            var curPage = $("#txtCurPage").val();
            if (curPage == 1) {
                return;
            }
            loadList(curPage - 1);
        }

        function nextPage() {
            var curPage = Number($("#txtCurPage").val());
            var ttl = Number($("#txtTotalRecord").val());
            var pageSize = Number($("#txtPageSize").val());
            var ttlPage = Number($("#txtTotalPage").val());
            // var ttlPage = ttl / pageSize;
            // if ((ttl % pageSize) > 0) {
            //     ttlPage = ttlPage + 1;
            // }
            if ((curPage + 1) > ttlPage) {
                return;
            }
            loadList(curPage + 1);
        }

        function loadList(page) {
            $('#txtCurPage').val(page);
            $('#txtPageSize').val($("#selpageSize").val());

            var data = {
                ItemCode: $("#txtItemCode").val(),
                ItemDesc: $("#txtItemDesc").val(),
                ItemGroup: $("#txtItemGroup").val(),
                Thickness: $("#txtThickness").val(),
                page: page,
                pageSize: $("#selpageSize").val(),
            };

            $.ajax({
                url: "/Item/GetItemList/",
                type: "POST",
                data: JSON.stringify(data),
                dataType: 'JSON',
                contentType: 'application/json; charset=utf-8',
                beforeSend: function () {
                    Swal.fire({
                        text: 'Please Wait',
                        width: '300px',
                        allowEscapeKey: false,
                        allowOutsideClick: false,
                        showConfirmButton: false,
                    });
                    Swal.showLoading();
                },
                success: function (result) {
                    Swal.close()
                    if (result.success == true) {
                        const cellClass = 'tw:px-5 tw:py-4 tw:whitespace-nowrap sm:tw:px-6 tw:text-theme-sm tw:text-gray-700 tw:dark:text-gray-300';
                        const designClass = 'tw:px-5 tw:py-4 tw:whitespace-nowrap sm:tw:px-6';

                        $('#listTable').DataTable({
                            data: result.data,
                            paging: false,
                            scrollX: true,
                            searching: false,
                            "info": false,
                            // pageLength: $("#selpageSize").val(),
                            // lengthMenu: [50, 100, 250, 500, 1000],
                            "bDestroy": true,
                            columns: [
                                { data: 'itemCode', className: cellClass },
                                { data: 'uom', className: cellClass },
                                {
                                    data: null,
                                    className: cellClass, 
                                    render: function (data, type, row, meta) {
                                        const maxLength = 50;
                                        const desc = row.description || "";
                                        const shortDesc = desc.length > maxLength
                                            ? desc.substring(0, maxLength) + "..."
                                            : desc;

                                        return `
                                            <p style="margin: 0;">
                                                <span title="${desc}">${shortDesc}</span><br/>
                                                <span style="font-size:13px;color:grey;">${row.desc2 || ""}</span>
                                            </p>
                                        `;
                                    }
                                },
                                { data: 'itemGroupCode', className: cellClass },
                                {
                                    data: null,
                                    className: designClass,
                                    render: function (data, type, row, meta) {
                                        return row.isActive
                                            ? '<span class="tw:status-badge tw:bg-success-50 tw:text-success-700 tw:dark:bg-success-500/15 tw:dark:text-success-500">Active</span>'
                                            : '<span class="tw:status-badge tw:bg-gray-100 tw:text-gray-700 tw:dark:bg-white/5 tw:dark:text-gray-400">Inactive</span>';
                                    }
                                },
                                {
                                    data: null,
