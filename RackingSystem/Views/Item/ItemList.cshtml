<style>
    #columnMatchingLabel {
        text-align: center;
        width: 100%;
        font-weight: bold;
    }

    .matching-btn {
        justify-content: center;
    }

    .bi-upload {
        padding-left: 10px;
    }

    .dt-layout-row:not(.dt-layout-table) {
        display: none !important;
    }
</style>

@{
    string menuItemClass = "tw:block tw:rounded-lg tw:px-3 tw:py-2 tw:text-sm tw:text-gray-700 tw:no-underline tw:hover:bg-gray-100 tw:dark:text-gray-300 tw:dark:hover:bg-white/5";
}

<div x-data="{ filtersOpen: true }">
    <div class="tw:flex tw:w-full tw:items-center tw:justify-between">
        <h2 class="tw:text-lg tw:mb-0 tw:ml-2 tw:font-semibold tw:text-gray-800 tw:dark:text-white/90">Item List</h2>
        <div class="tw:flex tw:items-center tw:gap-2">
            <button type="button" class="tw:rounded-lg tw:border-0 tw:px-3.5 tw:py-2.5 tw:transition-colors"
                    :class="filtersOpen ? 'tw:bg-brand-50 tw:text-brand-600 tw:dark:bg-brand-500/15 tw:dark:text-brand-400' : 'tw:bg-gray-100 tw:text-gray-500 tw:hover:bg-gray-200 tw:dark:bg-white/5 tw:dark:text-gray-400 tw:dark:hover:bg-white/10'"
                    @@click="filtersOpen = !filtersOpen" title="Toggle Filters">
                <i class="bi bi-funnel"></i>
            </button>
            <div class="tw:relative" x-data="{ importOpen: false }" @@click.outside="importOpen = false">
                <button type="button" class="tw:rounded-lg tw:border-0 tw:bg-yellow-400 tw:px-4 tw:py-2.5 tw:text-sm tw:font-medium tw:text-white tw:hover:bg-yellow-500" @@click="importOpen = !importOpen">
                    Import
                    <i class="bi bi-chevron-down tw:text-xs"></i>
                </button>
                <div x-show="importOpen" x-cloak class="tw:shadow-theme-lg tw:absolute tw:left-0 tw:z-10 tw:mt-2 tw:w-64 tw:rounded-xl tw:border tw:border-gray-200 tw:bg-white tw:p-2 tw:dark:border-gray-800 tw:dark:bg-gray-900">
                    <a href="#" class="@menuItemClass" id="dTemp" onclick="downloadTemp()" @@click="importOpen = false">Download Template</a>
                    <a href="#" class="@menuItemClass" onclick="triggerFileInput()" @@click="importOpen = false">Import Item by Excel</a>
                </div>
            </div>
            <input type="file" id="fileInput" accept=".xlsx, .xls, .csv" class="tw:hidden" onchange="handleFileUpload(event)">
            <button type="button" class="tw:rounded-lg tw:border-0 tw:bg-brand-500 tw:px-4 tw:py-2.5 tw:text-sm tw:font-medium tw:text-white tw:hover:bg-brand-600" onclick="newItemForm()">
                Add New Item
            </button>
        </div>
    </div>

    <div class="tw:mt-3 tw:space-y-4">
        <div x-show="filtersOpen" x-transition class="tw:rounded-xl tw:border tw:border-gray-200 tw:bg-white tw:p-4 tw:dark:border-gray-800 tw:dark:bg-white/[0.03]">
            @{
                string fieldClass = @"tw:w-full tw:rounded-lg tw:border tw:border-gray-300 tw:bg-transparent tw:px-4 tw:py-2.5 tw:text-sm tw:text-gray-800 tw:placeholder:text-gray-400
                                        tw:focus:border-brand-300 tw:focus:ring-3 tw:focus:ring-brand-500/10 tw:focus:outline-hidden tw:dark:border-gray-700 tw:dark:bg-gray-900 tw:dark:text-white/90
                                        tw:dark:placeholder:text-white/30 tw:dark:focus:border-brand-800";
                string labelClass = "tw:mb-1.5 tw:block tw:text-sm tw:font-medium tw:text-gray-700 tw:dark:text-gray-400";
            }
            <div class="tw:grid tw:grid-cols-3 tw:items-end tw:gap-3">
                <div>
                    <label class="@labelClass" for="txtItemCode">Item Code</label>
                    <input id="txtItemCode" name="ItemCode" type="text" class="@fieldClass" placeholder="Item Code" />
                </div>
                <div>
                    <label class="@labelClass" for="txtItemDesc">Created By</label>
                    <input id="txtItemDesc" name="ItemDesc" type="text" class="@fieldClass" placeholder="Item Desc / Desc2" />
                </div>
                <div>
                    <label class="@labelClass" for="txtItemGroup">Item Group</label>
                    <input id="txtItemGroup" name="ItemGroup" type="text" class="@fieldClass" placeholder="Item Group" />
                </div>
                <div>
                    <label class="@labelClass" for="txtThickness">Item Code</label>
                    <input id="txtThickness" name="Thickness" type="text" class="@fieldClass" placeholder="Thickness" />
                </div>
                <div>
                    <button type="button" class="tw:inline-flex tw:w-full tw:items-center tw:justify-center tw:rounded-lg tw:border-0 tw:bg-brand-500 tw:px-4 tw:py-2.5 tw:text-sm tw:font-medium tw:text-white tw:hover:bg-brand-600" onclick="loadList(1)">
                        <i class="bi bi-search"></i>
                    </button>
                </div>
            </div>
        </div>
        <div class="dt-tailadmin tw:rounded-lg tw:border tw:border-gray-200 tw:bg-white tw:text-gray-700 tw:dark:border-gray-800 tw:dark:bg-white/[0.03] tw:dark:text-gray-300">
            <div class="tw:flex tw:items-center tw:gap-2 tw:px-5 tw:pt-4 tw:text-[13px] tw:text-gray-500 sm:tw:px-6 tw:dark:text-gray-400">
                <select id="selpageSize" name="pageSize" class="tw:rounded-lg tw:border tw:border-gray-300 tw:bg-white tw:px-4 tw:py-2 tw:text-[13px] tw:font-medium tw:text-gray-800 tw:shadow-theme-xs tw:focus:border-brand-300 tw:focus:ring-3 tw:focus:ring-brand-500/10 tw:focus:outline-hidden tw:dark:border-gray-700 tw:dark:bg-gray-900 tw:dark:text-white/90">
                    <option value="10">10</option>
                    <option value="25">25</option>
                    <option value="50">50</option>
                    <option value="100">100</option>
                    <option value="200">250</option>
                </select>
                <span>entries per page</span>
            </div>

            <table id="listTable" class="row-border dataTable hover order-column tw:w-full">
                <thead>
                    <tr class="tw:border-b tw:border-gray-200">
                        @{
                            string[] listHeaders = { "Item Code", "UOM", "Description", "Item Group", "Is Active", "FinishGood?", "Dimension", "Max Thickness (mm)", "Alarm?", "Action" };
                        }
                        @foreach (var header in listHeaders)
                        {
                            <th class="tw:px-5 tw:py-3.5 tw:text-left sm:tw:px-6"><span class="tw:text-sm tw:font-semibold tw:text-gray-700 tw:dark:text-gray-300">@header</span></th>
                        }
                    </tr>
                </thead>
            </table>

            <div class="tw:flex tw:flex-wrap tw:text-[13px] tw:items-center tw:justify-between tw:gap-3 tw:px-5 tw:py-4 sm:tw:px-6">
                <div class="tw:text-gray-500 tw:dark:text-gray-400">Showing <span id="lblCurCount">0</span> of <span id="lblTotal">0</span> entries</div>
                <nav aria-label="pagination" id="ulPagination" class="tw:flex tw:items-center tw:gap-1"></nav>
            </div>
        </div>
        <input type="hidden" id="txtCurPage">
        <input type="hidden" id="txtTotalRecord">
        <input type="hidden" id="txtPageSize">
        <input type="hidden" id="txtTotalPage">

    </div>
</div>

<div class="modal fade" data-bs-backdrop="static" data-bs-focus="false" id="myModal" role="dialog">
    <div class="modal-dialog">

        <div class="modal-content tw:rounded-2xl tw:border-0 tw:bg-white tw:text-gray-700 tw:shadow-theme-lg tw:dark:bg-gray-900 tw:dark:text-gray-300">
            <div class="tw:rounded-t-2xl tw:border-b tw:border-gray-100 tw:px-6 tw:py-4 tw:dark:border-gray-800">
                <h4 class="tw:text-base tw:font-semibold tw:text-gray-800 tw:mb-0 tw:dark:text-white/90">Update Item</h4>
            </div>
            <div class="tw:space-y-4 tw:px-6 tw:py-4">
                <div>
                    <label class="@labelClass" for="txtCode">Item Code</label>
                    <input type="text" class="@fieldClass" name="ItemCode" id="txtCode" aria-describedby="Item Code" maxlength="50" oninput="removeErrMsg(this.id)">
                    <div id="txtCodeError" class="error-message"></div>
                </div>
                <div>
                    <label class="@labelClass" for="txtUOM">UOM</label>
                    <input type="text" class="@fieldClass" name="UOM" id="txtUOM" aria-describedby="UOM" maxlength="50" oninput="removeErrMsg(this.id)">
                    <div id="txtUOMError" class="error-message"></div>
                </div>
                <div>
                    <label class="@labelClass" for="txtDesc">Description</label>
                    <input type="text" class="@fieldClass" name="Description" id="txtDesc" aria-describedby="Description" maxlength="255" oninput="removeErrMsg(this.id)">
                    <div id="txtDescError" class="error-message"></div>
                </div>
                <div>
                    <label class="@labelClass" for="txtDesc2">Desc2</label>
                    <input type="text" class="@fieldClass" name="Desc2" id="txtDesc2" aria-describedby="Desc2" maxlength="255">
                    <div id="txtDesc2Error" class="error-message"></div>
                </div>
                <div>
                    <label class="@labelClass" for="selItemGroup">Item Group</label>
                    <div class="tw:relative" x-data="customSelect('selItemGroup')" x-init="init()">
                        <select class="tw:hidden" id="selItemGroup" onchange="removeErrMsg(this.id)"></select>
                        <button type="button" @@click="toggle()" @@click.outside="open = false"
                            class="tw:flex tw:w-full tw:items-center tw:justify-between tw:gap-2 tw:rounded-lg tw:border tw:bg-transparent tw:px-4 tw:py-2.5 tw:text-left tw:text-sm tw:text-gray-800 tw:dark:bg-gray-900 tw:dark:text-white/90"
                            :class="hasError ? 'tw:border-error-500' : (open ? 'tw:border-brand-300 tw:ring-3 tw:ring-brand-500/10' : 'tw:border-gray-300 tw:dark:border-gray-700')">
                            <span x-text="selectedLabel || 'Select...'" :class="selectedLabel ? '' : 'tw:text-gray-400 tw:dark:text-white/30'"></span>
                            <i class="bi bi-chevron-down tw:text-xs tw:text-gray-500 tw:transition-transform tw:dark:text-gray-400" :class="open ? 'tw:rotate-180' : ''"></i>
                        </button>
                        <div x-show="open" x-transition
                            class="custom-select-scroll tw:absolute tw:z-50 tw:max-h-60 tw:w-full tw:overflow-y-auto tw:rounded-lg tw:border tw:border-gray-200 tw:bg-white tw:py-1 tw:shadow-theme-lg tw:dark:border-gray-700 tw:dark:bg-gray-900"
                            :class="dropUp ? 'tw:bottom-full tw:mb-1' : 'tw:top-full tw:mt-1'">
                            <template x-if="options.length === 0">
                                <div class="tw:px-4 tw:py-2 tw:text-sm tw:text-gray-400 tw:dark:text-white/30">No options</div>
                            </template>
                            <template x-for="opt in options" :key="opt.value">
                                <div @@click="select(opt)"
                                    class="tw:cursor-pointer tw:px-4 tw:py-2 tw:text-sm tw:hover:bg-brand-50 tw:dark:hover:bg-brand-500/15"
                                    :class="opt.value === selectedValue ? 'tw:bg-brand-50 tw:font-medium tw:text-brand-600 tw:dark:bg-brand-500/15 tw:dark:text-brand-400' : 'tw:text-gray-700 tw:dark:text-gray-300'"
                                    x-text="opt.text"></div>
                            </template>
                        </div>
                    </div>
                    <div id="selItemGroupError" class="error-message"></div>
                </div>
                <div>
                    <label class="@labelClass" for="selReelDimension">Reel Thickness (mm)</label>
                    <div class="tw:relative" x-data="customSelect('selReelDimension')" x-init="init()">
                        <select class="tw:hidden" id="selReelDimension" onchange="removeErrMsg(this.id)"></select>
                        <button type="button" @@click="toggle()" @@click.outside="open = false"
                            class="tw:flex tw:w-full tw:items-center tw:justify-between tw:gap-2 tw:rounded-lg tw:border tw:bg-transparent tw:px-4 tw:py-2.5 tw:text-left tw:text-sm tw:text-gray-800 tw:dark:bg-gray-900 tw:dark:text-white/90"
                            :class="hasError ? 'tw:border-error-500' : (open ? 'tw:border-brand-300 tw:ring-3 tw:ring-brand-500/10' : 'tw:border-gray-300 tw:dark:border-gray-700')">
                            <span x-text="selectedLabel || 'Select...'" :class="selectedLabel ? '' : 'tw:text-gray-400 tw:dark:text-white/30'"></span>
                            <i class="bi bi-chevron-down tw:text-xs tw:text-gray-500 tw:transition-transform tw:dark:text-gray-400" :class="open ? 'tw:rotate-180' : ''"></i>
                        </button>
                        <div x-show="open" x-transition
                            class="custom-select-scroll tw:absolute tw:z-50 tw:max-h-60 tw:w-full tw:overflow-y-auto tw:rounded-lg tw:border tw:border-gray-200 tw:bg-white tw:py-1 tw:shadow-theme-lg tw:dark:border-gray-700 tw:dark:bg-gray-900"
                            :class="dropUp ? 'tw:bottom-full tw:mb-1' : 'tw:top-full tw:mt-1'">
                            <template x-if="options.length === 0">
                                <div class="tw:px-4 tw:py-2 tw:text-sm tw:text-gray-400 tw:dark:text-white/30">No options</div>
                            </template>
                            <template x-for="opt in options" :key="opt.value">
                                <div @@click="select(opt)"
                                    class="tw:cursor-pointer tw:px-4 tw:py-2 tw:text-sm tw:hover:bg-brand-50 tw:dark:hover:bg-brand-500/15"
                                    :class="opt.value === selectedValue ? 'tw:bg-brand-50 tw:font-medium tw:text-brand-600 tw:dark:bg-brand-500/15 tw:dark:text-brand-400' : 'tw:text-gray-700 tw:dark:text-gray-300'"
                                    x-text="opt.text"></div>
                            </template>
                        </div>
                    </div>
                    <div id="selReelDimensionError" class="error-message"></div>
                </div>
               @*  <div class="mb-3">
                    <label class="form-label" for="txtThickness">Thickness (mm)</label>
                    <input type="number" class="form-control" name="Thickness" id="txtThickness" aria-describedby="Thickness" disabled>
                </div>
                <div class="mb-3">
                    <label class="form-label" for="txtWidth">Width (inch)</label>
                    <input type="number" class="form-control" name="Width" id="txtWidth" aria-describedby="Width" disabled>
                </div>
                <div class="mb-3">
                    <label class="form-label" for="txtMaxThickness">Max Thickness (mm)</label>
                    <input type="number" class="form-control" name="MaxThickness" id="txtMaxThickness" aria-describedby="Max Thickness" disabled>
                </div> *@
                <div class="tw:flex tw:flex-wrap tw:items-center tw:gap-6">
                    <div class="tw:flex tw:items-center tw:gap-2">
                        <input type="checkbox" class="tw:h-4 tw:w-4 tw:accent-brand-500" id="chkIsActive">
                        <label class="tw:text-sm tw:text-gray-700 tw:dark:text-gray-400" for="chkIsActive">Is Active</label>
                    </div>
                    <div class="tw:flex tw:items-center tw:gap-2">
                        <input type="checkbox" class="tw:h-4 tw:w-4 tw:accent-brand-500" id="chkIsFinishGood">
                        <label class="tw:text-sm tw:text-gray-700 tw:dark:text-gray-400" for="chkIsFinishGood">Is Finish Good</label>
                    </div>
                    <div class="tw:flex tw:items-center tw:gap-2">
                        <input type="checkbox" class="tw:h-4 tw:w-4 tw:accent-brand-500" id="chkAlarmOverMaxThickness">
                        <label class="tw:text-sm tw:text-gray-700 tw:dark:text-gray-400" for="chkAlarmOverMaxThickness">Alarm Over Max Thickness</label>
                    </div>
                </div>

                <input type="hidden" id="txtId">

            </div>
            <div class="tw:flex tw:justify-end tw:gap-3 tw:border-t tw:border-gray-100 tw:px-6 tw:py-3 tw:dark:border-gray-800">
                <button type="button" class="tw:rounded-lg tw:border-0 tw:bg-brand-500 tw:px-4 tw:py-2.5 tw:text-sm tw:font-medium tw:text-white tw:shadow-theme-xs tw:hover:bg-brand-600" onclick="saveItem()">Save</button>
                <button type="button" class="tw:bg-transparent tw:rounded-lg tw:border tw:border-gray-300 tw:px-4 tw:py-2.5 tw:text-sm tw:font-medium tw:text-gray-700 tw:hover:bg-gray-100 tw:dark:border-gray-700 tw:dark:text-gray-400 tw:dark:hover:bg-white/5" onclick="cancelForm()">Cancel</button>
