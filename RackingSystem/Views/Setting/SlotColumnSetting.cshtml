
<div class="tw:flex tw:w-full tw:items-center tw:justify-between">
    <h2 class="tw:text-lg tw:mb-0 tw:ml-2 tw:font-semibold tw:text-gray-800 tw:dark:text-white/90">Slot Column Setting</h2>
    <div class="tw:flex">
        <button type="button" class="tw:border-0 tw:inline-flex tw:items-center tw:gap-2 tw:rounded-lg tw:bg-brand-500 tw:px-4 tw:py-2.5 tw:text-sm tw:font-medium tw:text-white tw:transition
            tw:hover:bg-brand-600" onclick="updateSetting()">
            Update Setting
        </button>
    </div>
</div>

<div class="tw:mt-3">
    <div class="dt-tailadmin tw:overflow-hidden tw:rounded-xl tw:border tw:border-gray-200 tw:bg-white tw:text-gray-700 tw:dark:border-gray-800 tw:dark:bg-white/[0.03] tw:dark:text-gray-300">
        <table id="listTable" class="row-border dataTable hover order-column tw:w-full">
            <thead>
                <tr class="tw:border-b tw:border-gray-200">
                    @{
                        string[] listHeaders = { "Column No", "Empty Drawer IN Priority", "Empty Drawer OUT Priority", "Reel IN Priority", "Column Inches" };
                    }
                    @foreach (var header in listHeaders)
                    {
                        <th class="tw:px-5 tw:py-3.5 tw:text-left sm:tw:px-6"><span class="tw:text-sm tw:font-semibold tw:text-gray-700 tw:dark:text-gray-300">@header</span></th>
                    }
                </tr> 
            </thead>
        </table>
    </div>
    <input type="hidden" id="txtTotalCol">
</div>

@section Scripts
{
    <link rel="stylesheet" href="~/css/sweetalert2.min.css">
    <link rel="stylesheet" href="~/css/dataTables.dataTables.css">
    
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="../js/dataTables.js"></script>
    <script src="~/js/sweetalert2.all.min.js"></script>

    <script type="text/javascript">

        let reelWidthList = [];

        function customSelect(selectId) {
            return {
                open: false,
                dropUp: false,
                options: [],
                selectedValue: '',
                selectedLabel: '',
                hasError: false,
                init() {
                    this.syncOptions();
                    const sel = document.getElementById(selectId);
                    if (!sel) return;
                    this.hasError = sel.classList.contains('is-invalid');
                    new MutationObserver(() => {
                        this.hasError = sel.classList.contains('is-invalid');
                    }).observe(sel, { attributes: true, attributeFilter: ['class'] });
                },
                toggle() {
                    this.open = !this.open;
                    if (this.open) {
                        this.syncOptions();
                        const rect = this.$el.getBoundingClientRect();
                        const spaceBelow = window.innerHeight - rect.bottom;
                        this.dropUp = spaceBelow < 240 && rect.top > spaceBelow;
                    }
                },
                syncOptions() {
                    const sel = document.getElementById(selectId);
                    if (!sel) return;
                    this.options = Array.from(sel.options).map(o => ({ value: o.value, text: o.textContent.trim() }));
                    this.selectedValue = sel.value;
                    const selectedOpt = sel.options[sel.selectedIndex];
                    this.selectedLabel = selectedOpt ? selectedOpt.textContent.trim() : '';
                },
                select(opt) {
                    const sel = document.getElementById(selectId);
                    sel.value = opt.value;
                    this.selectedValue = opt.value;
                    this.selectedLabel = opt.text;
                    this.open = false;
                    sel.dispatchEvent(new Event('change'));
                }
            };
        }

        $(document).ready(function () {
            $('#txtTotalCol').val(0);
            loadReelWidthList();
        });

        function loadReelWidthList() {
            $.ajax({
                url: '/Setting/GetReelWidthList',
                type: 'GET',
                dataType: 'JSON',
                contentType: 'application/json; charset=utf-8',
                success: function (result) {
                    if (result.success == true) {
                        reelWidthList = result.data;
                    }
                    loadList();
                },
                error: function (error) {
                    loadList();
                }
            });
        }

        function loadList() {
            $.ajax({
                url: "/Setting/GetSlotColumnSetting/",
                type: "GET",
                dataType: 'JSON',
                contentType: 'application/json; charset=utf-8',
                beforeSend: function () {
                    Swal.fire({
                        text: 'Please Wait',
                        width: '300px',
                        allowEscapeKey: false,
                        allowOutsideClick: false,
                        showConfirmButton: false,
                    });
                    Swal.showLoading()
                },
                success: function (result) {
                    Swal.close()
                    if (result.success == true) {
                        const cellClass = 'tw:px-5 tw:py-4 tw:whitespace-nowrap sm:tw:px-6 tw:text-theme-sm tw:text-gray-700 tw:dark:text-gray-300';

                        $('#listTable').DataTable( {
                            data: result.data,
                            paging: true,
                            pageLength: 50,
                            columns: [
                                { data: 'colNo', className: cellClass },
                                {
                                    data: null,
                                    className: cellClass,
                                    render: function (data, type, row, meta) {
                                        const rowIndex = meta.row;
                                        return `<input type="hidden" id="txtId${rowIndex}" value="${row.slotColumnSetting_Id}">
                                        <input type="number" class="tw:w-full tw:rounded-lg tw:border tw:border-gray-300 tw:bg-transparent tw:px-4 tw:py-2 tw:text-sm tw:text-gray-800 tw:placeholder:text-gray-400
                                            tw:focus:border-brand-300 tw:focus:ring-3 tw:focus:ring-brand-500/10 tw:focus:outline-hidden tw:dark:border-gray-700 tw:dark:bg-gray-900 tw:dark:text-white/90
                                            tw:dark:placeholder:text-white/30 tw:dark:focus:border-brand-800" id="txtEDIn${rowIndex}" value="${row.emptyDrawer_IN_Idx}" oninput="this.classList.remove('is-invalid','is-valid'); document.getElementById(this.id+'Error').textContent='';">
                                        <div id="txtEDIn${rowIndex}Error" class="error-message"></div>`;
                                    }
                                },
                                {
                                    data: null,
                                    className: cellClass,
                                    render: function (data, type, row, meta) {
                                        const rowIndex = meta.row;
                                        return `<input type="number" class="tw:w-full tw:rounded-lg tw:border tw:border-gray-300 tw:bg-transparent tw:px-4 tw:py-2 tw:text-sm tw:text-gray-800 tw:placeholder:text-gray-400
                                            tw:focus:border-brand-300 tw:focus:ring-3 tw:focus:ring-brand-500/10 tw:focus:outline-hidden tw:dark:border-gray-700 tw:dark:bg-gray-900 tw:dark:text-white/90
                                            tw:dark:placeholder:text-white/30 tw:dark:focus:border-brand-800" id="txtEDOut${rowIndex}" value="${row.emptyDrawer_OUT_Idx}" oninput="this.classList.remove('is-invalid','is-valid'); document.getElementById(this.id+'Error').textContent='';">
                                        <div id="txtEDOut${rowIndex}Error" class="error-message"></div>`;
                                    }
                                },
                                {
                                    data: null,
                                    className: cellClass,
                                    render: function (data, type, row, meta) {
                                        const rowIndex = meta.row;
                                        return `<input type="number" class="tw:w-full tw:rounded-lg tw:border tw:border-gray-300 tw:bg-transparent tw:px-4 tw:py-2 tw:text-sm tw:text-gray-800 tw:placeholder:text-gray-400
                                            tw:focus:border-brand-300 tw:focus:ring-3 tw:focus:ring-brand-500/10 tw:focus:outline-hidden tw:dark:border-gray-700 tw:dark:bg-gray-900 tw:dark:text-white/90
                                            tw:dark:placeholder:text-white/30 tw:dark:focus:border-brand-800" id="txtRIn${rowIndex}" value="${row.reel_IN_Idx}" oninput="this.classList.remove('is-invalid','is-valid'); document.getElementById(this.id+'Error').textContent='';">
                                        <div id="txtRIn${rowIndex}Error" class="error-message"></div>`;
                                    }
                                },
                                {
                                    data: null,
                                    className: cellClass,
                                    render: function (data, type, row, meta) {
                                        const rowIndex = meta.row;
                                        const selId = `txtColInches${rowIndex}`;
                                        let options = '<option value="">-- Select --</option>';
                                        reelWidthList.forEach(function (w) {
                                            const selected = (w == row.colInches) ? 'selected' : '';
                                            options += `<option value="${w}" ${selected}>${w}</option>`;
                                        });
                                        return `<select id="${selId}" class="tw:hidden">${options}</select>
                                        <div class="tw:relative" x-data="customSelect('${selId}')" x-init="init()">
                                            <button type="button" @@click="toggle()" @@click.outside="open = false"
                                                class="tw:flex tw:w-full tw:items-center tw:justify-between tw:gap-2 tw:rounded-lg tw:border tw:bg-transparent tw:px-4 tw:py-2 tw:text-left tw:text-sm tw:text-gray-800 tw:dark:bg-gray-900 tw:dark:text-white/90"
                                                :class="hasError ? 'tw:border-error-500' : (open ? 'tw:border-brand-300 tw:ring-3 tw:ring-brand-500/10' : 'tw:border-gray-300 tw:dark:border-gray-700')">
                                                <span x-text="selectedLabel || '-- Select --'" :class="selectedLabel ? '' : 'tw:text-gray-400 tw:dark:text-white/30'"></span>
                                                <i class="bi bi-chevron-down tw:text-xs tw:text-gray-500 tw:transition-transform tw:dark:text-gray-400" :class="open ? 'tw:rotate-180' : ''"></i>
                                            </button>
                                            <div x-show="open" x-transition
                                                class="custom-select-scroll tw:absolute tw:z-50 tw:max-h-60 tw:w-full tw:overflow-y-auto tw:rounded-lg tw:border tw:border-gray-200 tw:bg-white tw:py-1 tw:shadow-theme-lg tw:dark:border-gray-700 tw:dark:bg-gray-900"
                                                :class="dropUp ? 'tw:bottom-full tw:mb-1' : 'tw:top-full tw:mt-1'">
                                                <template x-if="options.length === 0">
                                                    <div class="tw:px-4 tw:py-2 tw:text-sm tw:text-gray-400 tw:dark:text-white/30">No options</div>
                                                </template>
                                                <template x-for="opt in options" :key="opt.value">
                                                    <div @@click="select(opt)"
                                                        class="tw:cursor-pointer tw:px-4 tw:py-2 tw:text-sm tw:hover:bg-brand-50 tw:dark:hover:bg-brand-500/15"
                                                        :class="opt.value === selectedValue ? 'tw:bg-brand-50 tw:font-medium tw:text-brand-600 tw:dark:bg-brand-500/15 tw:dark:text-brand-400' : 'tw:text-gray-700 tw:dark:text-gray-300'"
                                                        x-text="opt.text"></div>
                                                </template>
                                            </div>
                                        </div>
                                        <div id="${selId}Error" class="error-message"></div>`;
                                    }
                                },
                                // {
                                //     data: null,
                                //     render: function (data, type, row, meta) {
                                //         const rowIndex = meta.row;
                                //         return '<input type="number" class="form-control" id="txtROut' + rowIndex + '" value="' + row.reel_OUT_Idx + '">' +
                                //         '<div id="txtROut' + rowIndex + 'Error" class="error-message"></div>';
                                //     }
                                // },
                                // {
                                //     data: null,
                                //     render: function (data, type, row, meta) {
                                //         return '<div style="display:flex;"><button class="btn btn-success d-grid" style="margin-right:10px;"' +
                                //         'onclick="editItemForm(\'' + row.slotColumnSetting_Id + '\', ' +
                                //         '\'' + row.maxThickness + '\', \'' + row.reserveSlot + '\', \'' + row.maxThickness + '\', \'' + row.reserveSlot + '\' )">' +
                                //         '<span><i class="bi bi-pencil-square""></i>  Edit</span></button>' +
                                //         '</div>';
                                //     }
                                // }
                            ],
                            language: {
                                searchPlaceholder: "🔍︎ Search",
                                search: ""
                            }
                        });

                        $('#txtTotalCol').val(result.totalRecords);
                    }
                    else {
                        Swal.fire({
                            icon: 'error',
                            title: "Wait",
                            text: result.errMessage
                        });
                    }
                },
                error: function (error) {
                    Swal.fire({
                        icon: 'error',
                        title: "Wait",
                        text: error.val
                    });
                }
            });
        }

        // Show error message and highlight invalid fields
        function showError(fieldId, message) {
            document.getElementById(fieldId).classList.add('is-invalid');
            document.getElementById(fieldId + 'Error').textContent = message;
        }

        function removeErrMsg(iR) {
            for (var i = 0; i < iR; i++) {
                document.getElementById("txtEDIn" + i).classList.remove('is-invalid');
                document.getElementById("txtEDIn" + i).classList.remove('is-valid');
                document.getElementById("txtEDIn" + i + 'Error').textContent = '';

                document.getElementById("txtEDOut" + i).classList.remove('is-invalid');
                document.getElementById("txtEDOut" + i).classList.remove('is-valid');
                document.getElementById("txtEDOut" + i + 'Error').textContent = '';

                document.getElementById("txtRIn" + i).classList.remove('is-invalid');
                document.getElementById("txtRIn" + i).classList.remove('is-valid');
                document.getElementById("txtRIn" + i + 'Error').textContent = '';

                document.getElementById("txtColInches" + i).classList.remove('is-invalid');
                document.getElementById("txtColInches" + i).classList.remove('is-valid');
                document.getElementById("txtColInches" + i + 'Error').textContent = '';

                // document.getElementById("txtROut" + i).classList.remove('is-invalid');
                // document.getElementById("txtROut" + i).classList.remove('is-valid');
                // document.getElementById("txtROut" + i + 'Error').textContent = '';
                // if (clearValue) document.getElementById(field).value = '';
            }
        }

        function checkInput(iR) {
            let isValid = true;
            for (var i = 0; i < iR; i++) {

                var txt = document.getElementById("txtEDIn" + i);
                if (txt.value == "") {
                    showError(txt.id, `Please enter Empty Drawer IN Priority.`);
                    isValid = false;
                }
                txt = document.getElementById("txtEDOut" + i);
                if (txt.value == "") {
                    showError(txt.id, `Please enter Empty Drawer OUT Priority.`);
                    isValid = false;
                }
                txt = document.getElementById("txtRIn" + i);
                if (txt.value == "") {
                    showError(txt.id, `Please enter Reel IN Priority.`);
                    isValid = false;
                }
                // Column Inches is optional, defaults to 0 when not selected
                // txt = document.getElementById("txtROut" + i);
                // if (txt.value == "") {
                //     showError(txt.id, `Please enter Reel OUT Priority.`);
                //     isValid = false;
                // }

            }
            return isValid;
        }

        function updateSetting() {
            var iR = Number($('#txtTotalCol').val());
            var dataList = [];

            removeErrMsg(iR);
            if (checkInput(iR) == false) {
                return;
            }

            for (var i = 0; i < iR; i++) {
                var data = {
                    SlotColumnSetting_Id: $("#txtId" + i).val(),
                    ColNo: (i + 1),
                    EmptyDrawer_IN_Idx: $("#txtEDIn" + i).val(),
                    EmptyDrawer_OUT_Idx: $("#txtEDOut" + i).val(),
                    Reel_IN_Idx: $("#txtRIn" + i).val(),
                    ColInches: $("#txtColInches" + i).val() || 0,
                    // Reel_OUT_Idx: $("#txtROut" + i).val(),
                }
                dataList.push(data);
            }

            $.ajax({
                url: '/Setting/SaveSlotColumnSetting',
                type: 'POST',
                data: JSON.stringify(dataList),
                dataType: 'JSON',
                contentType: 'application/json; charset=utf-8',
                beforeSend: function () {
                    Swal.fire({
                        text: 'Please Wait',
                        width: '300px',
                        allowEscapeKey: false,
                        allowOutsideClick: false,
                        showConfirmButton: false,
                    });
                    Swal.showLoading()
                },
                success: function (result) {
                    if (result.success == true) {
                        $("#myModal").modal("toggle");
                        Swal.fire({
                            icon: 'success',
                            title: "Success Update",
                            text: "",
                            didClose: () => {
                              window.location.reload();
                            }
                        });
                    }
                    else {
                        Swal.fire({
                            icon: 'error',
                            title: "Wait",
                            text: result.errMessage
                        });
                    }
                },
                error: function (error) {
                    Swal.fire({
                        icon: 'error',
                        title: "Wait",
                        text: error.val
                    });
                }
            });

        }

    </script>
}
