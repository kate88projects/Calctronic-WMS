
<div class="tw:flex tw:w-full tw:items-center tw:justify-between">
    <h2 class="tw:text-lg tw:mb-0 tw:ml-2 tw:font-semibold tw:text-gray-800 tw:dark:text-white/90">Reel Dimension Setting</h2>
    <div class="tw:flex">
        <button type="button" class="tw:border-0 tw:inline-flex tw:items-center tw:gap-2 tw:rounded-lg tw:bg-brand-500 tw:px-4 tw:py-2.5 tw:text-sm tw:font-medium tw:text-white tw:transition
            tw:hover:bg-brand-600" onclick="newItemForm()">
            Add New Dimension
        </button>
    </div>
</div>

<div class="tw:mt-3">
    <div class="dt-tailadmin tw:overflow-hidden tw:rounded-xl tw:border tw:border-gray-200 tw:bg-white tw:text-gray-700 tw:dark:border-gray-800 tw:dark:bg-white/[0.03] tw:dark:text-gray-300">
        <table id="listTable" class="row-border dataTable hover order-column tw:w-full">
            <thead>
                <tr class="tw:border-b tw:border-gray-200">
                    @{
                        string[] listHeaders = { "Thickness (mm)", "Width (inch)", "Max Thickness (mm)", "Action" };
                    }
                    @foreach (var header in listHeaders)
                    {
                        <th class="tw:px-5 tw:py-3.5 tw:text-left sm:tw:px-6"><span class="tw:text-sm tw:font-semibold tw:text-gray-700 tw:dark:text-gray-300">@header</span></th>
                    }
                </tr>
            </thead>
        </table>
    </div>
</div>


<div class="modal fade" id="myModal" role="dialog">
    <div class="modal-dialog">

        <div class="modal-content tw:overflow-hidden tw:rounded-2xl tw:border-0 tw:bg-white tw:text-gray-700 tw:shadow-theme-lg tw:dark:bg-gray-900 tw:dark:text-gray-300">
            <div class="tw:border-b tw:border-gray-100 tw:px-6 tw:py-4 tw:dark:border-gray-800">
                <h4 class="tw:text-base tw:font-semibold tw:text-gray-800 tw:mb-0 tw:dark:text-white/90">Update Dimension</h4>
            </div>
            <div class="tw:space-y-4 tw:px-6 tw:py-4">
                <div>
                    <label class="tw:mb-1.5 tw:block tw:text-sm tw:font-medium tw:text-gray-700 tw:dark:text-gray-400" for="txtThickness">Thickness (mm)</label>
                    <input type="number" class="tw:w-full tw:rounded-lg tw:border tw:border-gray-300 tw:bg-transparent tw:px-4 tw:py-2.5 tw:text-sm tw:text-gray-800 tw:placeholder:text-gray-400
                        tw:focus:border-brand-300 tw:focus:ring-3 tw:focus:ring-brand-500/10 tw:focus:outline-hidden tw:dark:border-gray-700 tw:dark:bg-gray-900 tw:dark:text-white/90
                        tw:dark:placeholder:text-white/30 tw:dark:focus:border-brand-800" name="Thickness" id="txtThickness" aria-describedby="Thickness" oninput="removeErrMsg(this.id)">
                    <div id="txtThicknessError" class="error-message"></div>
                </div>
                <div>
                    <label class="tw:mb-1.5 tw:block tw:text-sm tw:font-medium tw:text-gray-700 tw:dark:text-gray-400" for="txtWidth">Width (inch)</label>
                    <input type="number" class="tw:w-full tw:rounded-lg tw:border tw:border-gray-300 tw:bg-transparent tw:px-4 tw:py-2.5 tw:text-sm tw:text-gray-800 tw:placeholder:text-gray-400
                        tw:focus:border-brand-300 tw:focus:ring-3 tw:focus:ring-brand-500/10 tw:focus:outline-hidden tw:dark:border-gray-700 tw:dark:bg-gray-900 tw:dark:text-white/90
                        tw:dark:placeholder:text-white/30 tw:dark:focus:border-brand-800" name="Width" id="txtWidth" aria-describedby="Width" oninput="removeErrMsg(this.id)">
                    <div id="txtWidthError" class="error-message"></div>
                </div>
                <div class="tw:mb-0">
                    <label class="tw:mb-1.5 tw:block tw:text-sm tw:font-medium tw:text-gray-700 tw:dark:text-gray-400" for="txtMaxThickness">Max Thickness (mm)</label>
                    <input type="number" class="tw:w-full tw:rounded-lg tw:border tw:border-gray-300 tw:bg-transparent tw:px-4 tw:py-2.5 tw:text-sm tw:text-gray-800 tw:placeholder:text-gray-400
                        tw:focus:border-brand-300 tw:focus:ring-3 tw:focus:ring-brand-500/10 tw:focus:outline-hidden tw:dark:border-gray-700 tw:dark:bg-gray-900 tw:dark:text-white/90
                        tw:dark:placeholder:text-white/30 tw:dark:focus:border-brand-800" name="MaxThickness" id="txtMaxThickness" aria-describedby="Max Thickness" oninput="removeErrMsg(this.id)">
                    <div id="txtMaxThicknessError" class="error-message"></div>
                </div>

                <input type="hidden" id="txtId">

            </div>
            <div class="tw:flex tw:justify-end tw:gap-3 tw:border-t tw:border-gray-100 tw:px-6 tw:py-3 tw:dark:border-gray-800">
                <button type="button" class="save-btn tw:border-0 tw:rounded-lg tw:bg-brand-500 tw:px-4 tw:py-2.5 tw:text-sm tw:font-medium tw:text-white tw:shadow-theme-xs tw:hover:bg-brand-600" onclick="saveItem()">Save</button>
                <button type="button" class="cancel-btn tw:bg-transparent tw:rounded-lg tw:border tw:border-gray-300 tw:px-4 tw:py-2.5 tw:text-sm tw:font-medium tw:text-gray-700 tw:hover:bg-gray-100
                    tw:dark:border-gray-700 tw:dark:text-gray-400 tw:dark:hover:bg-white/5" onclick="cancelForm()">
                    Cancel
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts
{
    <link rel="stylesheet" href="~/css/sweetalert2.min.css">
    <link rel="stylesheet" href="~/css/dataTables.dataTables.css">

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="../js/dataTables.js"></script>
    <script src="~/js/sweetalert2.all.min.js"></script>

    <script type="text/javascript">

        $(document).ready(function () {
            loadList();
        });

        function loadList() {
            $.ajax({
                url: "/Setting/GetReelDimensionList/",
                type: "GET",
                dataType: 'JSON',
                contentType: 'application/json; charset=utf-8',
                beforeSend: function () {
                    Swal.fire({
                        text: 'Please Wait',
                        width: '300px',
                        allowEscapeKey: false,
                        allowOutsideClick: false,
                        showConfirmButton: false,
                    });
                    Swal.showLoading()
                },
                success: function (result) {
                    Swal.close()
                    if (result.success == true) {
                        const cellClass = 'tw:px-5 tw:py-4 tw:whitespace-nowrap sm:tw:px-6 tw:text-theme-sm tw:text-gray-700 tw:dark:text-gray-300';
                        $('#listTable').DataTable( {
                            data: result.data,
                            paging: true,
                            pageLength: 50,
                            columns: [
                                { data: 'thickness', className: cellClass },
                                { data: 'width', className: cellClass },
                                { data: 'maxThickness', className: cellClass },
                                {
                                    data: null,
                                    className: 'tw:px-5 tw:py-4 tw:whitespace-nowrap sm:tw:px-6',
                                    render: function (data, type, row, meta) {
                                        return `<div class="tw:flex tw:items-center tw:gap-2">
                                            <button class="edit-btn tw:inline-flex tw:items-center tw:gap-1.5 tw:rounded-lg tw:bg-amber-50 tw:font-medium tw:text-amber-600
                                                tw:transition-colors tw:hover:bg-amber-100 tw:dark:bg-amber-500/15 tw:dark:text-amber-400 tw:dark:hover:bg-amber-500/25"
                                                onclick="editItemForm('${row.reelDimension_Id}', '${row.thickness}', '${row.width}', '${row.maxThickness}')">
                                                <i class="bi bi-pencil-square"></i> 
                                                Edit
                                            </button>

                                            <button class="delete-btn tw:inline-flex tw:items-center tw:gap-1.5 tw:rounded-lg tw:bg-error-50 tw:font-medium tw:text-error-600 tw:transition-colors tw:hover:bg-error-100
                                                tw:dark:bg-error-500/15 tw:dark:text-error-400 tw:dark:hover:bg-error-500/25" onclick="deleteItem('${row.reelDimension_Id}', '${row.thickness}')">
                                                <i class="bi bi-trash"></i> 
                                                Delete
                                            </button>
                                        </div>`;
                                    }
                                }
                            ],
                            language: {
                                searchPlaceholder: "🔍︎ Search",
                                search: ""
                            }
                        });
                    }
                    else {
                        Swal.fire({
                            icon: 'error',
                            title: "Wait",
                            text: result.errMessage
                        });
                    }
                },
                error: function (error) {
                    Swal.fire({
                        icon: 'error',
                        title: "Wait",
                        text: error.val
                    });
                }
            });
        }

        function newItemForm() {
            removeErrMsg([]);
            $("#txtId").val("0");
            $("#txtThickness").val("");
            $("#txtWidth").val("");
            $("#txtMaxThickness").val("");
            $("#myModal").modal("show");
        }

        function editItemForm(id, h, w, maxh) {
            removeErrMsg([]);
            $("#txtId").val(id);
            $("#txtThickness").val(h);
            $("#txtWidth").val(w);
            $("#txtMaxThickness").val(maxh);
            $("#myModal").modal("show");
        }

        function cancelForm() {
            $("#myModal").modal("toggle");

            fields = ['txtThickness', 'txtWidth', 'txtMaxThickness' ];
            removeErrMsg(fields, true);
        }

        // Show error message and highlight invalid fields
        function showError(fieldId, message) {
            document.getElementById(fieldId).classList.add('is-invalid');
            document.getElementById(fieldId + 'Error').textContent = message;
        }

        function removeErrMsg(fields, clearValue = false) {
            if (fields != null) {
                if (!Array.isArray(fields)) {
                    fields = [fields];
                }

                fields.forEach(function(field) {
                    document.getElementById(field).classList.remove('is-invalid');
                    document.getElementById(field).classList.remove('is-valid');
                    document.getElementById(field + 'Error').textContent = '';
                    if (clearValue) document.getElementById(field).value = '';
                });
            }
        }

        function checkInput() {
            let isValid = true;
            var txt = document.getElementById("txtThickness");
            if (txt.value == "") {
                showError(txt.id, `Please enter Thickness.`);
                isValid = false;
            }
            txt = document.getElementById("txtWidth");
            if (txt.value == "") {
                showError(txt.id, `Please enter Width.`);
                isValid = false;
            }
            txt = document.getElementById("txtMaxThickness");
            if (txt.value == "") {
                showError(txt.id, `Please enter Max Thickness.`);
                isValid = false;
            }
            return isValid;
        }

        function saveItem() {
            removeErrMsg([]);
            if (checkInput() == false) {
                return;
            }

            var data = {
                ReelDimension_Id: $("#txtId").val(),
                Thickness: $("#txtThickness").val(),
                Width: $("#txtWidth").val(),
                MaxThickness: $("#txtMaxThickness").val(),
            }

            $.ajax({
                url: '/Setting/SaveReelDimension',
                type: 'POST',
                data: JSON.stringify(data),
                dataType: 'JSON',
                contentType: 'application/json; charset=utf-8',
                beforeSend: function () {
                    Swal.fire({
                        text: 'Please Wait',
                        width: '300px',
                        allowEscapeKey: false,
                        allowOutsideClick: false,
                        showConfirmButton: false,
                    });
                    Swal.showLoading()
                },
                success: function (result) {
                    if (result.success == true) {
                        $("#myModal").modal("toggle");
                        Swal.fire({
                            icon: 'success',
                            title: "Success Update",
                            text: "",
                            didClose: () => {
                              window.location.reload();
                            }
                        });
                    }
                    else {
                        Swal.fire({
                            icon: 'error',
                            title: "Wait",
                            text: result.errMessage
                        });
                    }
                },
                error: function (error) {
                    // console.log(error);
                    Swal.fire({
                        icon: 'error',
                        title: "Wait",
                        text: error.val
                    });
                }
            });

            // console.log(id);
        }

        function deleteItem(id, h) {

            Swal.fire({
                title: "Are you sure want to delete?",
                text: "You won't be able to recover this record!",
                icon: 'warning', 
                showCancelButton: true,
                confirmButtonText: 'Yes',
                cancelButtonText: 'Cancel',
                allowOutsideClick: false
            }).then(function(r) {
                if (r.isConfirmed == true) {

                    var data = {
                        ReelDimension_Id: id,
                    }

                    $.ajax({
                        url: '/Setting/DeleteReelDimension',
                        type: 'DELETE',
                        data: JSON.stringify(data),
                        dataType: 'json',
                        contentType: 'application/json; charset=utf-8',
                        beforeSend: function () {
                            Swal.fire({
                                text: 'Please Wait',
                                width: '300px',
                                allowEscapeKey: false,
                                allowOutsideClick: false,
                                showConfirmButton: false,
                            });
                            Swal.showLoading()
                        },
                        success: function (result) {
                            if (result.success == true) {
                                Swal.fire({
                                    icon: 'success',
                                    title: "Success Deleted",
                                    text: "",
                                    didClose: () => {
                                      window.location.reload();
                                    }
                                });
                            }
                            else {
                                Swal.fire({
                                    icon: 'error',
                                    title: "Wait",
                                    text: result.errMessage
                                });
                            }
                        },
                        error: function (error) {
                            // console.log(error);
                            Swal.fire({
                                icon: 'error',
                                title: "Wait",
                                text: error.val
                            });
                        }
                    });

                } else {
                    return;
                }
              });
            }

    </script>
}
