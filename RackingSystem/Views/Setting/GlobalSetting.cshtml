<div class="tw:flex tw:w-full tw:items-center tw:justify-between">
    <h2 class="tw:text-lg tw:mb-0 tw:ml-2 tw:font-semibold tw:text-gray-800 tw:dark:text-white/90">Global Setting</h2>
</div>


<div class="tw:mt-3">
    <div class="dt-tailadmin tw:overflow-hidden tw:rounded-xl tw:border tw:border-gray-200 tw:bg-white tw:text-gray-700 tw:dark:border-gray-800 tw:dark:bg-white/[0.03] tw:dark:text-gray-300">
        <table id="listTable" class="row-border dataTable hover order-column tw:w-full">
            <thead>
                <tr class="tw:border-b tw:border-gray-200">
                    @{
                        string[] listHeaders = { "Global Setting", "Value", "Action" };
                    }
                    @foreach (var header in listHeaders)
                    {
                        <th class="tw:px-5 tw:py-3.5 tw:text-left sm:tw:px-6"><span class="tw:text-sm tw:font-semibold tw:text-gray-700 tw:dark:text-gray-300">@header</span></th>
                    }
                </tr>
            </thead>
        </table>
    </div>
</div>
            

<div class="modal fade" id="myModal" role="dialog">
    <div class="modal-dialog">

        <div class="modal-content tw:overflow-hidden tw:rounded-2xl tw:border-0 tw:bg-white tw:text-gray-700 tw:shadow-theme-lg tw:dark:bg-gray-900 tw:dark:text-gray-300">
            <div class="tw:border-b tw:border-gray-100 tw:px-6 tw:py-4 tw:dark:border-gray-800">
                <h4 class="tw:text-base tw:font-semibold tw:text-gray-800 tw:mb-0 tw:dark:text-white/90">Update Global Setting</h4>
            </div>
            <div class="tw:space-y-4 tw:px-6 tw:py-4">
                <div>
                    <label class="tw:mb-1.5 tw:block tw:text-sm tw:font-medium tw:text-gray-700 tw:dark:text-gray-400" for="txtTitle">Global Setting</label>
                    <input type="text" class="tw:w-full tw:rounded-lg tw:border tw:border-gray-300 tw:bg-zinc-100 tw:px-4 tw:py-2.5 tw:text-sm tw:text-gray-500 tw:placeholder:text-gray-400
                        tw:dark:border-gray-700 tw:dark:bg-gray-900 tw:dark:text-gray-400" id="txtTitle" aria-describedby="Setting" disabled>
                </div>
                <div class="tw:mb-0">
                    <label class="tw:mb-1.5 tw:block tw:text-sm tw:font-medium tw:text-gray-700 tw:dark:text-gray-400" for="txtValue">Value</label>
                    <input type="text" class="tw:w-full tw:rounded-lg tw:border tw:border-gray-300 tw:bg-transparent tw:px-4 tw:py-2.5 tw:text-sm tw:text-gray-800 tw:placeholder:text-gray-400
                        tw:focus:border-brand-300 tw:focus:ring-3 tw:focus:ring-brand-500/10 tw:focus:outline-hidden tw:dark:border-gray-700 tw:dark:bg-gray-900 tw:dark:text-white/90
                        tw:dark:placeholder:text-white/30 tw:dark:focus:border-brand-800" id="txtValue" aria-describedby="Setting Value" maxlength="50" oninput="removeErrMsg(this.id)">
                    <div id="txtValueError" class="error-message"></div>
                </div>

                <input type="hidden" id="txtId">

            </div>
            <div class="tw:flex tw:justify-end tw:gap-3 tw:border-t tw:border-gray-100 tw:px-6 tw:py-3 tw:dark:border-gray-800">
                <button type="button" class="save-btn tw:border-0 tw:rounded-lg tw:bg-brand-500 tw:px-4 tw:py-2.5 tw:text-sm tw:font-medium tw:text-white tw:shadow-theme-xs tw:hover:bg-brand-600" onclick="saveItem()">Save</button>
                <button type="button" class="cancel-btn tw:bg-transparent tw:rounded-lg tw:border tw:border-gray-300 tw:px-4 tw:py-2.5 tw:text-sm tw:font-medium tw:text-gray-700 tw:hover:bg-gray-100
                    tw:dark:border-gray-700 tw:dark:text-gray-400 tw:dark:hover:bg-white/5" onclick="cancelForm()">
                    Cancel
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts
{
    <link rel="stylesheet" href="~/css/sweetalert2.min.css">
    <link rel="stylesheet" href="~/css/dataTables.dataTables.css">

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="../js/dataTables.js"></script>
    <script src="~/js/sweetalert2.all.min.js"></script>

    <script type="text/javascript">

        $(document).ready(function () {
            loadList();
        });

        function loadList() {
            $.ajax({
                url: "/Setting/GetGlobalSettingList/",
                type: "GET",
                dataType: 'JSON',
                contentType: 'application/json; charset=utf-8',
                beforeSend: function () {
                    Swal.fire({
                        text: 'Please Wait',
                        width: '300px',
                        allowEscapeKey: false,
                        allowOutsideClick: false,
                        showConfirmButton: false,
                    });
                    Swal.showLoading()
                },
                success: function (result) { 
                    Swal.close()
                    if (result.success == true) {
                        const cellClass = 'tw:px-5 tw:py-4 tw:whitespace-nowrap sm:tw:px-6 tw:text-theme-sm tw:text-gray-700 tw:dark:text-gray-300';

                        $('#listTable').DataTable( {
                            data: result.data,
                            paging: true,
                            pageLength: 50,
                            columns: [
                                { data: 'configTitle', className: cellClass },
                                { data: 'configValue', className: cellClass },
                                {
                                    data: null,
                                    className: 'tw:px-5 tw:py-4 tw:whitespace-nowrap sm:tw:px-6',
                                    render: function (row) {
                                        const rowData = JSON.stringify(row).replace(/"/g, "&quot;");
                                        return `<div class="tw:flex tw:items-center tw:gap-2">
                                            <button class="edit-btn tw:inline-flex tw:items-center tw:gap-1.5 tw:rounded-lg tw:bg-amber-50 tw:font-medium tw:text-amber-600
                                                tw:transition-colors tw:hover:bg-amber-100 tw:dark:bg-amber-500/15 tw:dark:text-amber-400 tw:dark:hover:bg-amber-500/25" data-row="${rowData}">
                                                <i class="bi bi-pencil-square"></i>  
                                                Edit
                                            </button>
                                        </div>`;
                                    }
                                }
                            ],
                             language: {
                                searchPlaceholder: "🔍︎ Search",
                                search: ""
                            },
                        });
                    }
                    else {
                        Swal.fire({
                            icon: 'error',
                            title: "Wait",
                            text: result.errMessage
                        });
                    }
                },
                error: function (error) {
                    Swal.fire({
                        icon: 'error',
                        title: "Wait",
                        text: error.val
                    });
                }
            });
        }

        $('#listTable').on('click', '.edit-btn', function () {
            const row = JSON.parse($(this).attr('data-row'));
            editItemForm(row);
        });

        // Expected format of the setting being edited ("ip", "int" or ""), sent by the server.
        let editValueType = '';

        function editItemForm(row) {
            removeErrMsg([]);
            $("#txtId").val(row.configuration_Id);
            $("#txtTitle").val(row.configTitle);
            $("#txtValue").val(row.configValue);
            editValueType = row.valueType || '';
            $("#myModal").modal("show");
        }

        function cancelForm() {
            $("#myModal").modal("toggle");

            fields = [ 'txtValue' ];
            removeErrMsg(fields, true);
        }

        // Show error message and highlight invalid fields
        function showError(fieldId, message) {
            document.getElementById(fieldId).classList.add('is-invalid');
            document.getElementById(fieldId + 'Error').textContent = message;
        }

        function removeErrMsg(fields, clearValue = false) {
            if (fields != null) {
                if (!Array.isArray(fields)) {
                    fields = [fields];
                }

                fields.forEach(function(field) {
                    document.getElementById(field).classList.remove('is-invalid');
                    document.getElementById(field).classList.remove('is-valid');
                    document.getElementById(field + 'Error').textContent = '';
                    if (clearValue) document.getElementById(field).value = '';
                });
            }
        }

        function checkInput() {
            let isValid = true;
            var txt = document.getElementById("txtValue");
            const value = txt.value.trim();
            if (value == "") {
                showError(txt.id, `Please enter Value.`);
                isValid = false;
            } else if (editValueType == 'ip' && !isValidIP(value)) {
                showError(txt.id, `Please enter a valid IP Address (e.g. 192.168.1.10).`);
                isValid = false;
            } else if (editValueType == 'int' && !(/^\d+$/.test(value) && Number(value) > 0 && Number(value) <= 32767)) {
                showError(txt.id, `Please enter a whole number between 1 and 32767.`);
                isValid = false;
            }
            return isValid;
        }

        // IPv4: four numbers 0-255 separated by dots, no leading zeros (e.g. 192.168.1.10).
        function isValidIP(value) {
            const octet = '(25[0-5]|2[0-4]\\d|1\\d\\d|[1-9]?\\d)';
            return new RegExp(`^${octet}(\\.${octet}){3}$`).test(value);
        }

        function saveItem() {
            removeErrMsg([]);
            if (checkInput() == false) {
                return;
            }

            var data = {
                Configuration_Id: $("#txtId").val(),
                ConfigTitle: $("#txtTitle").val(),
                ConfigValue: $("#txtValue").val(),
            }

            $.ajax({
                url: '/Setting/SaveGlobalSetting',
                type: 'POST',
                data: JSON.stringify(data),
                dataType: 'JSON',
                contentType: 'application/json; charset=utf-8',
                beforeSend: function () {
                    Swal.fire({
                        text: 'Please Wait',
                        width: '300px',
                        allowEscapeKey: false,
                        allowOutsideClick: false,
                        showConfirmButton: false,
                    });
                    Swal.showLoading()
                },
                success: function (result) {
                    if (result.success == true) {
                        $("#myModal").modal("toggle");
                        Swal.fire({
                            icon: 'success',
                            title: "Success Update",
                            text: "",
                            didClose: () => {
                              window.location.reload();
                            }
                        });
                    }
                    else {
                        Swal.fire({
                            icon: 'error',
                            title: "Wait",
                            text: result.errMessage
                        });
                    }
                },
                error: function (error) {
                    Swal.fire({
                        icon: 'error',
                        title: "Wait",
                        text: error.val
                    });
                }
            });

        }

    </script>
}
