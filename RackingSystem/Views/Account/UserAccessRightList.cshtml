    var permissionGroups = new (string GroupDivId, string ParentId, string ParentName, string ParentLabel, string ChildClass, (string Id, string Value, string Label)[] Items)[]
    {
        ("maintenanceGroup", "txtMaintenance", "maintenance", "Maintenance", "chkMaintenance", maintenanceItems),
        ("stockGroup", "txtStock", "stock", "Stock", "chkStock", stockItems),
        ("grnGroup", "txtGRN", "grn", "GRN", "chkGRN", grnItems),
        ("joGroup", "txtJO", "jo", "Job Order", "chkJO", joItems),
        ("qGroup", "txtQ", "jo", "Queue System", "chkQ", qItems),
        ("rackingGroup", "txtRacking", "racking", "Report", "chkRacking", rackingItems),
        ("settingGroup", "txtSetting", "setting", "Setting", "chkSetting", settingItems),
