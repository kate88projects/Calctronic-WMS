        ("txtLoaderColList", "7", "Loader Column List"),
        ("txtSlotList", "4", "Slot List"),
        ("txtSlotPulses", "8", "Slot Pulses"),
        ("txtTrolleyList", "2", "Trolley List"),
        ("txtTrolleySlotList", "3", "Trolley Slot List"),
        ("txtTrolleyPulses", "8", "Trolley Pulses"),
    };

    (string Id, string Value, string Label)[] stockItems = {
        ("txtItemGroupList", "20", "Item Group List"),
        ("txtItemList", "21", "Item List"),
    };

    (string Id, string Value, string Label)[] grnItems = {
        ("txtNewReceive", "60", "New Receive"),
        ("txtGRNDtlList", "61", "GRN Dtl List"),
        ("txtTaskGRN", "63", "New Loader Task"),
    };

    (string Id, string Value, string Label)[] joItems = {
        ("txtJOList", "80", "JO List"),
