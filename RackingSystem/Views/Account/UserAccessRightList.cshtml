    (string Id, string Value, string Label)[] settingItems = {
        ("txtUserList", "121", "User List"),
        ("txtUserAccessRight", "122", "User Access Right"),
        ("txtReelHeight", "123", "Reel Height"),
        ("txtSlotCalculation", "124", "Slot Usage"),
        ("txtSlotColumn", "125", "Slot Column"),
        ("txtGlobalSet", "126", "Global Setting"),
